<#-- a causa del css-html-javascript bootstrap italia, costruisco la navigazione senza portlet -->

<#--
	Regola di visibilità per profilo attivo (switch cittadino/operatore).
	Visibile  ⇔  NON(activeRole) OR target_role vuoto OR target_role == activeRole.
	- Guardia: se activeRole non è definito (modulo Java non deployato) → sempre visibile, nessun filtro.
	- target_role è inserito a mano nel Custom Field del Layout: normalizzo con ?trim?upper_case
	  per essere robusto agli errori di battitura (activeRole è garantito già maiuscolo dal lato Java).
	- Letto via navItem.getLayout().getExpandoBridge(), stesso idioma di pagina_per_cittadino.
	  Riutilizzabile anche per le voci figlie (getBrowsableChildren) se in futuro servisse.
-->
<#-- Legge e normalizza il target_role dal Custom Field del Layout; "" se assente. Estratto per poterlo loggare senza duplicare l'accesso all'expando. -->
<#function targetRoleOf navItem>
	<#local expando = navItem.getLayout().getExpandoBridge() />
	<#if validator.isNotNull(expando) && expando.hasAttribute("target_role") && expando.getAttribute("target_role")??>
		<#return expando.getAttribute("target_role")?string?trim?upper_case />
	</#if>
	<#return "" />
</#function>

<#function isVisibileByRuolo navItem>
	<#if !(activeRole??) || activeRole?trim == "">
		<#return false />
	</#if>
	<#local targetRole = targetRoleOf(navItem) />
	<#return targetRole != "" && targetRole == activeRole />
</#function>

<nav class="navbar navbar-expand-lg" aria-label="Navigazione principale">
	<#-- icona burger menu -->
	<button class="custom-navbar-toggler" type="button" aria-controls="navigazione-principale" aria-expanded="false" aria-label="${label_mostra_nascondi_navigazione}" data-target="#navigazione-principale">
		<svg class="icon">
			<use href="/o/portale-istituzionale-theme/svg/sprite.svg#it-burger"></use>
		</svg>
	</button>
	
	<#-- inizio navbar -->
	<div class="navbar-collapsable" id="navigazione-principale" style="display: none;">
		<div class="overlay" style="display: none;"></div>
		<#-- pulsante per chiudere sidebar -->
		<div class="close-div">
			<button class="btn close-menu" type="button">
				<span class="sr-only">${label_nascondi_navigazione}</span>
				<svg class="icon">
					<use href="/o/portale-istituzionale-theme/svg/sprite.svg#it-close-big"></use>
              	</svg>
			</button>
		</div>
		
		<#-- navigazione -->
		<div class="menu-wrapper">
		
			<#-- se l'header è nella versione sticky, viene clonato il link con logo -->
			<#-- elemento clonato logo + brand-text -->
			<#if abilita_versione_sticky>
				<div class="it-brand-wrapper cloned-header">
					<a href="${site_default_url}" title="${site_name}" aria-label="${site_name}">
						<img class="icon" alt="${label_logo} ${site_name}" src="${site_logo}" />
					</a>
				</div>
			</#if>
		
			<#-- navigazione -->
			<ul class="navbar-nav">
				<#assign contatore = 0 />	
				
				<#-- ciclo su nav_items -->
				<#list nav_items as navItem>
					
					<#assign contatore = contatore + 1 />	
					
					<#-- verifico se l'elemento corrente ha pagine figlie navigabili -->	
					<#assign showChildren = navItem.hasBrowsableChildren() && abilita_navigazione_2_livelli />
					
					<#-- se l'elemento corrente è navigabile, o se ha pagine figlie navigabili, setto alcune variabili -->
					<#if navItem.isBrowsable() || showChildren>
						<#assign
							nav_item_caret = ""
							nav_item_css_class = "nav-item"
							nav_item_href_link = ""
							nav_item_link_css_class = "nav-link"
							nav_item_link_dropdown = ""
							nav_item_link_aria_expanded = ""
						/>
	
						<#-- se l'elemento corrente è navigabile, calcolo l'href -->
						<#if navItem.isBrowsable()>
							<#assign nav_item_href_link = "href='${navItem.getURL()}'" />
						</#if>
						
						<#if showChildren>
							<#-- costruisco html icona per dropdown menu -->	
							<#assign nav_item_caret>
								<svg class="icon icon-xs">
									<use href="/o/portale-istituzionale-theme/svg/sprite.svg#it-expand"></use>
	                        	</svg>
							</#assign>
							
							<#-- costruisco l'elemento dropdown -->
							<#assign
								nav_item_css_class = "${nav_item_css_class} dropdown"
								nav_item_link_css_class = "${nav_item_link_css_class} dropdown-toggle"
								nav_item_link_dropdown = "data-toggle='dropdown'"
								nav_item_link_aria_expanded = "aria-expanded='false'"
							/>
						</#if>
	
						<#-- imposto clasi active -->
						<#if navItem.isSelected()>
							<#assign
								nav_item_css_class = "${nav_item_css_class} active"
								nav_item_link_css_class = "${nav_item_link_css_class} active"
							/>
						</#if>

						<#-- filtro per profilo attivo (switch cittadino/operatore); composizione invariata con pagina_per_cittadino -->
						<#assign visibileByRuolo = isVisibileByRuolo(navItem) />
						<#-- DEBUG: il log va qui e non dentro isVisibileByRuolo perché l'output prodotto in una #function viene scartato da FreeMarker -->
						<!-- DEBUG navigazione ruolo: pagina='${navItem.getName()}' activeRole='${activeRole!"<undef>"}' targetRole='${targetRoleOf(navItem)}' visibile=${visibileByRuolo?c} -->
						<#if !visibileByRuolo>
							<#-- non visualizzo nulla -->
						<#else>
							<li class="${nav_item_css_class}" id="layout_${navItem.getLayoutId()}">
								<a class="${nav_item_link_css_class}" ${nav_item_href_link} ${navItem.getTarget()} ${nav_item_link_dropdown} ${nav_item_link_aria_expanded} title="${label_vai_alla_pagina} ${navItem.getName()}">
									<span>${navItem.getName()}</span>${nav_item_caret}
								</a>
		
								<#if showChildren>
									<div class="dropdown-menu" role="region">
										<div class="link-list-wrapper">
											<#-- <div class="link-list-heading">Sezione</div>-->
											<ul class="link-list">
												<#list navItem.getBrowsableChildren() as childNavigationItem>
													<#assign
														nav_child_link_css_class = "list-item"
													/>
				
													<#if childNavigationItem.isSelected()>
														<#assign
															nav_child_link_css_class = "list-item active"
														/>
													</#if>
				
													<li id="layout_${childNavigationItem.getLayoutId()}">
														<a class="${nav_child_link_css_class}" href="${childNavigationItem.getURL()}" ${childNavigationItem.getTarget()} title="${label_vai_alla_pagina} ${childNavigationItem.getName()}">
															<span>${childNavigationItem.getName()}</span>
														</a>
													</li>
												</#list>
											</ul>
										</div>
									</div>
								</#if>
							</li>
						</#if>
					</#if>
				</#list>
			</ul>
			
			<#-- se impostato, viene caricato l'articolo con la navigazione secondaria, utile per gli argomenti -->
			<#if validator.isNotNull(articoloNavigazioneSecondaria) && (articoloNavigazioneSecondaria !="")>
				${articoloNavigazioneSecondaria}
			</#if>
			
			<#-- se l'header è nella versione sticky, viene clonato il pulsante per la ricerca modale -->
			<#if abilita_versione_sticky>
				<#-- portlet di ricerca -->
				<#if abilita_portlet_ricerca>
					<div class="it-search-wrapper cloned-header">
						<span class="d-none d-md-block">${label_cerca}</span>
						<a class="search-link rounded-icon" aria-label="${label_cerca_nel_sito}" href="javascript:void(0);" id="cloned-search-button">
							<svg class="icon">
								<use href="/o/portale-istituzionale-theme/svg/sprite.svg#it-search"></use>
	                		</svg>
						</a>
					</div>
				</#if>
			</#if>
			
		</div>
	</div>
</nav>