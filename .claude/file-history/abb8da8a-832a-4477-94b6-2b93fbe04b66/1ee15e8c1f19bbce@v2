package it.servizidigitali.portal.filter;

import com.liferay.portal.kernel.log.Log;
import com.liferay.portal.kernel.log.LogFactoryUtil;
import com.liferay.portal.kernel.util.ParamUtil;
import com.liferay.portal.kernel.util.Validator;
import com.liferay.portal.servlet.filters.BasePortalFilter;

import javax.servlet.Filter;
import javax.servlet.FilterChain;
import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;
import javax.servlet.http.HttpSession;

import org.osgi.service.component.annotations.Component;

import it.servizidigitali.portal.constant.ServiziDigitaliPortalConstants;

/**
 * Intercetta lo switch del profilo attivo sulle pagine del portale.
 *
 * Quando la richiesta porta il parametro {@link ServiziDigitaliPortalConstants#ROLE_SWITCH_PARAM},
 * aggiorna {@code ACTIVE_ROLE} nella sessione del portale e reindirizza alla home. Girando come
 * {@link BasePortalFilter}, opera nel contesto del portale e vede la stessa sessione in cui
 * {@code LoginPostAction} ha scritto {@code ACTIVE_ROLE} e {@code HAS_DUAL_ROLE} (a differenza di un
 * servlet OSGi su {@code /o}, che avrebbe una sessione distinta). Lo switch cambia solo la
 * navigazione, mai i permessi, ed è consentito ai soli utenti con doppio ruolo.
 *
 * @author pindi
 */
@Component(immediate = true, //
		property = { "servlet-context-name=", //
				"servlet-filter-name=Role Switch Filter", //
				"dispatcher=REQUEST", //
				"url-pattern=/web/*", //
				"url-pattern=/group/*"//
		}, //
		service = Filter.class//
)
public class RoleSwitchFilter extends BasePortalFilter {

	private static final String HOME_REDIRECT = "/";

	@Override
	protected void processFilter(HttpServletRequest request, HttpServletResponse response, FilterChain filterChain) throws Exception {

		String requestedRole = ParamUtil.getString(request, ServiziDigitaliPortalConstants.ROLE_SWITCH_PARAM);
		if (Validator.isNull(requestedRole)) {
			super.processFilter(request, response, filterChain);
			return;
		}

		applyRoleSwitch(request, requestedRole);

		response.sendRedirect(HOME_REDIRECT);
	}

	/**
	 * Aggiorna il profilo attivo in sessione solo se il valore richiesto è valido e l'utente ha doppio ruolo.
	 */
	private void applyRoleSwitch(HttpServletRequest request, String requestedRole) {
		boolean roleValido = ServiziDigitaliPortalConstants.ROLE_CITTADINO.equals(requestedRole) || ServiziDigitaliPortalConstants.ROLE_OPERATORE.equals(requestedRole);
		if (!roleValido) {
			return;
		}

		HttpSession session = request.getSession(false);
		if (session == null || !hasDualRole(session)) {
			_log.debug("RoleSwitchFilter :: switch ignorato (role=" + requestedRole + ")");
			return;
		}

		session.setAttribute(ServiziDigitaliPortalConstants.ACTIVE_ROLE, requestedRole);
	}

	private boolean hasDualRole(HttpSession session) {
		Object hasDualRoleAttr = session.getAttribute(ServiziDigitaliPortalConstants.HAS_DUAL_ROLE);
		return (hasDualRoleAttr instanceof Boolean) && (Boolean) hasDualRoleAttr;
	}

	@Override
	protected Log getLog() {
		return _log;
	}

	private static final Log _log = LogFactoryUtil.getLog(RoleSwitchFilter.class);
}
