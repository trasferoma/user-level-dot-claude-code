package it.servizidigitali.portal.constant;

/**
 * @author pindi
 *
 */
public interface ServiziDigitaliPortalConstants {

	static String CURRENT_USER_SCREEN_NAME = "CURRENT_USER_SCREEN_NAME";

	/**
	 * Chiave di sessione: profilo attivo dell'utente ({@link #ROLE_OPERATORE} o {@link #ROLE_CITTADINO}).
	 */
	static String ACTIVE_ROLE = "ACTIVE_ROLE";

	/**
	 * Chiave di sessione: true se l'utente possiede sia il ruolo cittadino sia il ruolo operatore-backoffice.
	 */
	static String HAS_DUAL_ROLE = "HAS_DUAL_ROLE";

	/**
	 * Valore di profilo attivo: operatore di backoffice.
	 */
	static String ROLE_OPERATORE = "OPERATORE";

	/**
	 * Valore di profilo attivo: cittadino.
	 */
	static String ROLE_CITTADINO = "CITTADINO";

	/**
	 * Parametro di richiesta che attiva lo switch del profilo: valore atteso {@link #ROLE_OPERATORE} o
	 * {@link #ROLE_CITTADINO}. Intercettato da {@code RoleSwitchFilter} sulle pagine del portale.
	 */
	static String ROLE_SWITCH_PARAM = "activeRoleSwitch";

	/**
	 * Chiave di sessione one-shot: profilo verso cui è appena avvenuto lo switch. Impostata da
	 * {@code RoleSwitchFilter} e consumata (rimossa) da {@code RoleSwitchNoticeDynamicInclude} per
	 * mostrare la notifica toast una sola volta dopo il redirect.
	 */
	static String ROLE_SWITCH_NOTICE = "ROLE_SWITCH_NOTICE";

}
