<%@ page import="it.servizidigitali.gestionebandi.frontend.constants.GestioneBandiFrontendPortletKeys" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<%@ taglib uri="http://java.sun.com/portlet_2_0" prefix="portlet" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<%@ taglib uri="http://liferay.com/tld/aui" prefix="aui" %>
<%@ taglib uri="http://liferay.com/tld/portlet" prefix="liferay-portlet" %>
<%@ taglib uri="http://liferay.com/tld/theme" prefix="liferay-theme" %>
<%@ taglib uri="http://liferay.com/tld/ui" prefix="liferay-ui" %>

<fieldset>
    <legend>
        <liferay-ui:message key="configurazione-bando" />
    </legend>

    <aui:row>
        <aui:col span="6">
            <aui:select label="identificativo-form-principale"
                        onChange="doOnMainFormChange(this); updateFieldsSelect(this);"
                        id="<%=GestioneBandiFrontendPortletKeys.IDENTIFICATIVO_FORM_PRINCIPALE %>"
                        name="<%=GestioneBandiFrontendPortletKeys.IDENTIFICATIVO_FORM_PRINCIPALE %>"
                        value="${idFormPrincipale}"
                        data-selectid="formPrincipaleId"
            >
                <aui:option value="" label="seleziona" disabled="true"
                            selected="true" />
                <c:forEach items="${listaFormPrincipali}" var="form">
                    <aui:option value="${form.formId}" label="${form.nome}"></aui:option>
                </c:forEach>
                <aui:validator name="required" />
            </aui:select>
        </aui:col>

       <aui:col span="6">
			<aui:select id="listaFormIntegrativeAnnullamento" label="servizi-Integrativi-annullamento" name="<%=GestioneBandiFrontendPortletKeys.FORM_SERVIZI_INTEGRATIVI_ANULLAMENTO %>" showEmptyOption="true">
				<c:forEach items="${listaFormIntegrativi}" var="formIntegrativo">
					<aui:option value="${formIntegrativo.formId}" label="${formIntegrativo.nome}" onclick="inibisciMultiValue(value)"></aui:option>
				</c:forEach>
			</aui:select>
        </aui:col>
    </aui:row>
    
    <%-- 					<%@ include file="editorFormIntegrative.jsp"%> --%>
    <%@ include file="editorFormIntegrativi.jsp"%>

    <aui:row>
        <aui:col span="6">
            <aui:select
                    name="<%=GestioneBandiFrontendPortletKeys.PROCESSO_BPMN %>"
                    value="${processoBpmn.processoId}" label="processo-bpmn">
                <aui:option value="" label="seleziona" disabled="true"
                            selected="true" />
                <c:forEach items="${listaProcessi}" var="processo">
                    <aui:option value="${processo.processoId}"
                                label="${processo.nome}"></aui:option>
                </c:forEach>
                <aui:validator name="required" />
            </aui:select>
        </aui:col>

        <aui:col span="6">
            <div class="form-group form-check pt-3 mt-3">
                <aui:input label="Abilita protocollazione integrazioni"
                           name="<%= GestioneBandiFrontendPortletKeys.PROTOCOLLA_INTEGRAZIONI %>"
                           type="checkbox"
                           value="${bando.protocollaIntegrazioni}"/>
            </div>
        </aui:col>

	</aui:row>

    <aui:row>
        <aui:col span="4">
            <div class="form-group form-check pt-3 mt-3">
                <aui:input type="hidden" name="<%=GestioneBandiFrontendPortletKeys.ID_VALORE_DATO_BANDO_DISABILITA_PROTOCOLLAZIONE_ALLEGATI_INTEGRAZIONE + \"1\"%>" value="${idValoriDatoBandoDisabilitaProtocollazioneAllegatiIntegrazione != null ? idValoriDatoBandoDisabilitaProtocollazioneAllegatiIntegrazione : 0}" />
                <aui:input label="Protocollazione allegati integrazioni"
                           name="<%=GestioneBandiFrontendPortletKeys.DISABILITA_PROTOCOLLAZIONE_ALLEGATI_INTEGRAZIONE + \"1\"%>"
                           type="checkbox"
                           value="${valoriDatoBandoDisabilitaProtocollazioneAllegatiIntegrazione.valore == 'true'}"/>
            </div>
        </aui:col>

        <aui:col span="4">
            <div class="form-group form-check pt-3 mt-3">
                <aui:input type="hidden" name="<%=GestioneBandiFrontendPortletKeys.ID_VALORE_DATO_BANDO_DISABILITA_CAMPO_OGGETTO + \"1\"%>" value="${idValoriDatoBandoDisabilitaCampoOggetto != null ? idValoriDatoBandoDisabilitaCampoOggetto : 0}" />
                <aui:input label="Campo oggetto modali operatore"
                           name="<%=GestioneBandiFrontendPortletKeys.DISABILITA_CAMPO_OGGETTO + \"1\"%>"
                           type="checkbox"
                           value="${valoriDatoBandoDisabilitaCampoOggetto.valore == 'true'}"/>
            </div>
        </aui:col>

        <aui:col span="4">
            <div class="form-group form-check pt-3 mt-3">
                <aui:input type="hidden" name="<%=GestioneBandiFrontendPortletKeys.ID_VALORE_DATO_BANDO_ABILITA_FIRMA_DATA_ISTANZA + \"1\"%>" value="${idValoriDatoBandoAbilitaFirmaDataIstanza != null ? idValoriDatoBandoAbilitaFirmaDataIstanza : 0}" />
                <aui:input label="Verifica firma rispetto alla data corrente"
                           name="<%=GestioneBandiFrontendPortletKeys.ABILITA_FIRMA_DATA_ISTANZA + \"1\"%>"
                           type="checkbox"
                           value="${empty valoriDatoBandoAbilitaFirmaDataIstanza ? true : valoriDatoBandoAbilitaFirmaDataIstanza.valore == 'true'}"/>
            </div>
        </aui:col>
    </aui:row>

    <aui:row>

        <aui:col span="4">
            <div class="form-group form-check pt-3 mt-3">
                <aui:input label="Abilita protocollazione soccorso istruttorio"
                           name="<%= GestioneBandiFrontendPortletKeys.ABILITA_PROTOCOLLAZIONE_SOCCORSO_ISTRUTTORIO %>"
                           type="checkbox"
                           value="${bando.abilitaProtocollazioneSoccorsoIstruttorio}"/>
            </div>
        </aui:col>

        <aui:col span="4">
            <div class="form-group form-check pt-3 mt-3">
                <aui:input label="Abilita scelta firma documento"
                           name="<%= GestioneBandiFrontendPortletKeys.ABILITA_SCELTA_FIRMA_DOCUMENTO %>"
                           type="checkbox"
                           value="${bando.abilitaSceltaFirmaDocumento}"/>
            </div>
        </aui:col>

        <aui:col span="4">
            <div class="form-group form-check pt-3 mt-3">
                <aui:input label="Abilita protocollazione esito domanda"
                           name="<%= GestioneBandiFrontendPortletKeys.ABILITA_PROTOCOLLAZIONE_ESITO %>"
                           type="checkbox"
                           value="${bando.abilitaProtocollazioneEsito}"/>
            </div>
        </aui:col>
    </aui:row>
	
    <aui:row>
        <aui:col span="6">
            <aui:select label="id-article-catalogo-bandi"
                        id="<%=GestioneBandiFrontendPortletKeys.BANDO_CATALOGO_BANDI_ARTICLE_ID %>"
                        name="<%=GestioneBandiFrontendPortletKeys.BANDO_CATALOGO_BANDI_ARTICLE_ID %>"
                        value="${bando.bandoArticleId}">
                <aui:option value="" label="seleziona" selected="true" />
                <c:forEach items="${listaArticleCatalogoBandi}" var="article">
                    <aui:option value="${article.articleId }">${article.articleId } - ${article.title }</aui:option>
                </c:forEach>
            </aui:select>
        </aui:col>
        <aui:col span="6">
            <aui:select label="uri-privata"
                        id="<%=GestioneBandiFrontendPortletKeys.BANDO_LAYOUT_ID %>"
                        name="<%=GestioneBandiFrontendPortletKeys.BANDO_LAYOUT_ID %>"
                        value="${bando.layoutId}">
                <aui:option value="" label="seleziona" selected="selected" />
                <c:forEach items="${listaUriPrivata }" var="uriPrivata">
                    <aui:option value="${uriPrivata.layoutId}">${uriPrivata.name}</aui:option>
                </c:forEach>
            </aui:select>
        </aui:col>
    </aui:row>

    <aui:row>
        <aui:col span="6">
            <aui:select label="id-article-faq-bandi"
                        id="<%=GestioneBandiFrontendPortletKeys.BANDO_FAQ_BANDI_ARTICLE_ID %>"
                        name="<%=GestioneBandiFrontendPortletKeys.BANDO_FAQ_BANDI_ARTICLE_ID %>"
                        value="${bando.faqArticleId}">
                <aui:option value="" label="seleziona" selected="true" />
                <c:forEach items="${listaArticleFaqBandi}" var="article">
                    <aui:option value="${article.articleId }">${article.articleId } - ${article.title }</aui:option>
                </c:forEach>
            </aui:select>
        </aui:col>
    </aui:row>


    <aui:row>
        <aui:col span="3">
            <div class="form-group form-check pt-3 mt-3">
                <aui:input label="domanda-multipla-individuale"
                           name="<%= GestioneBandiFrontendPortletKeys.DOMANDA_MULTIPLA_INDIVIDUALE %>"
                           type="checkbox"
                           value="${bando.domandaMultiplaIndividuale}" />
            </div>
        </aui:col>

        <aui:col span="3">
            <div class="form-group form-check pt-3 mt-3">
                <aui:input label="domanda-multipla-rti"
                           name="<%= GestioneBandiFrontendPortletKeys.DOMANDA_MULTIPLA_RTI %>"
                           type="checkbox" value="${bando.domandaMultiplaRti}" />
            </div>
        </aui:col>
        
        <aui:col span="3">
            <div class="form-group form-check pt-3 mt-3">
                <aui:input label="abilitazione-delega" name="<%=GestioneBandiFrontendPortletKeys.ABILITAZIONE_DELEGA %>" type="checkbox" value="${bando.abilitazioneDelega}" />
            </div>
        </aui:col>

    </aui:row>
</fieldset>