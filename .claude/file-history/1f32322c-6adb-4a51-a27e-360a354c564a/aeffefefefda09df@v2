package org.example.negoziale;

import com.fasterxml.jackson.databind.ObjectMapper;
import com.fasterxml.jackson.databind.node.ObjectNode;
import net.sf.jasperreports.engine.JasperCompileManager;
import net.sf.jasperreports.engine.JasperFillManager;
import net.sf.jasperreports.engine.JasperPrint;
import net.sf.jasperreports.engine.JasperReport;
import net.sf.jasperreports.engine.data.JsonDataSource;
import net.sf.jasperreports.engine.export.JRPdfExporter;
import net.sf.jasperreports.export.SimpleExporterInput;
import net.sf.jasperreports.export.SimpleOutputStreamExporterOutput;

import java.io.ByteArrayInputStream;
import java.io.InputStream;
import java.io.OutputStream;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.util.HashMap;
import java.util.Map;

public class GeneratorePdfNegozialeDisciplinareEsecuzione {

    private static final String MAIN_REPORT = "/negoziale/disciplinare_esecuzione.jrxml";

    private static final String PARAM_NOME_COGNOME_UTENTE = "nomeCognomeUtente";

    private static final String OUTPUT_DIR = "target/pdf";
    private static final String OUTPUT_FILE = "disciplinare_esecuzione_test.pdf";

    public void execute() throws Exception {
        ObjectMapper mapper = new ObjectMapper();
        ObjectNode data = buildData(mapper);

        generaPdf(mapper, data, OUTPUT_FILE);
    }

    private void generaPdf(ObjectMapper mapper, ObjectNode data, String outputFileName) throws Exception {
        JasperReport mainReport = compile(MAIN_REPORT);

        Map<String, Object> parameters = new HashMap<>();
        parameters.put(PARAM_NOME_COGNOME_UTENTE, "Mario Rossi");

        byte[] jsonBytes = mapper.writeValueAsBytes(data);
        JsonDataSource dataSource = new JsonDataSource(new ByteArrayInputStream(jsonBytes));

        JasperPrint jasperPrint = JasperFillManager.fillReport(mainReport, parameters, dataSource);

        writePdf(jasperPrint, outputFileName);
    }

    private JasperReport compile(String resourcePath) throws Exception {
        try (InputStream stream = getClass().getResourceAsStream(resourcePath)) {
            if (stream == null) {
                throw new IllegalStateException("Risorsa jrxml non trovata nel classpath: " + resourcePath);
            }
            return JasperCompileManager.compileReport(stream);
        }
    }

    private Path writePdf(JasperPrint jasperPrint, String outputFileName) throws Exception {
        Path outputDir = Paths.get(OUTPUT_DIR);
        Files.createDirectories(outputDir);
        Path outputPath = outputDir.resolve(outputFileName);

        try (OutputStream outputStream = Files.newOutputStream(outputPath)) {
            JRPdfExporter exporter = new JRPdfExporter();
            exporter.setExporterInput(new SimpleExporterInput(jasperPrint));
            exporter.setExporterOutput(new SimpleOutputStreamExporterOutput(outputStream));
            exporter.exportReport();
        }
        return outputPath;
    }

    private ObjectNode buildData(ObjectMapper mapper) {
        ObjectNode data = mapper.createObjectNode();

        addEnte(data);
        addProgetto(data);
        addIstanza(data);
        addVerbale(data);
        addDetermina2025(data);
        addProvvedimento2026(data);
        addAttoAmmissione2026(data);
        addCronoprogramma(data);

        return data;
    }

    private void addEnte(ObjectNode data) {
        ObjectNode ente = data.putObject("ente");
        ente.put("denominazione", "Fondazione Esempio Cultura");
        ente.put("indirizzoSedeLegale", "Via Roma 1");
        ente.put("capSedeLegale", "70121");
        ente.put("cittaSedeLegale", "Bari");
        ente.put("provinciaSedeLegale", "BA");
        ente.put("codiceFiscale", "93000000721");
        ente.put("partitaIva", "07000000721");
        ente.put("legaleRappresentante", "Mario Rossi");
        ente.put("sedeLegaleCompleta", "Via Roma 1, 70121 Bari (BA)");
    }

    private void addProgetto(ObjectNode data) {
        ObjectNode progetto = data.putObject("progetto");
        progetto.put("titolo2026", "Festival della Cultura Pugliese 2026");
        progetto.put("titolo2025", "Festival della Cultura Pugliese 2025");
        progetto.put("titoloTriennale", "Programma Artistico Triennale Puglia 2025/2027");
        progetto.put("importoAssegnato2026", "150.000,00");
        progetto.put("importoAssegnato2025", "120.000,00");
    }

    private void addIstanza(ObjectNode data) {
        ObjectNode istanza = data.putObject("istanza");
        istanza.put("id", "2025-000123");
        istanza.put("numeroProtocollo", "0098765");
        istanza.put("dataProtocollo", "18/07/2025");
    }

    private void addVerbale(ObjectNode data) {
        ObjectNode verbale = data.putObject("verbale");
        verbale.put("data", "30/09/2025");
        verbale.put("numeroProtocollo", "0123456");
        verbale.put("dataProtocollo", "02/10/2025");
    }

    private void addDetermina2025(ObjectNode data) {
        ObjectNode determina = data.putObject("determina2025");
        determina.put("codiceCifra", "CULT/2025/00045");
        determina.put("data", "15/10/2025");
        determina.put("capitoloRegionale", "U0901010");

        ObjectNode disciplinare = data.putObject("disciplinare2025");
        disciplinare.put("dataSottoscrizione", "05/11/2025");
    }

    private void addProvvedimento2026(ObjectNode data) {
        ObjectNode provvedimento = data.putObject("provvedimento2026");
        provvedimento.put("codiceCifra", "CULT/2026/00012");
        provvedimento.put("data", "10/02/2026");
        provvedimento.put("dataInvioDomanda", "20/01/2026");
        provvedimento.put("numeroProtocolloDomanda", "0004567");

        ObjectNode impegno = data.putObject("impegno2026");
        impegno.put("capitoloSpesa", "U0901010");
        impegno.put("denominazioneCapitoloSpesa", "Spese per attività culturali e di spettacolo dal vivo");
    }

    private void addAttoAmmissione2026(ObjectNode data) {
        ObjectNode atto = data.putObject("attoAmmissione2026");
        atto.put("numero", "78");
        atto.put("data", "10/02/2026");
    }

    private void addCronoprogramma(ObjectNode data) {
        ObjectNode crono = data.putObject("cronoprogramma");
        crono.put("dataInizio", "01/03/2026");
        crono.put("dataFine", "31/12/2026");
    }
}
