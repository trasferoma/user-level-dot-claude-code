package org.tasktelemetry.logging;

/**
 * Immutable logging configuration for the library.
 *
 * @param logPrefix marker prepended to every log message
 */
public record LoggingProperties(String logPrefix) {

    /** Prefix used when no configuration overrides it. */
    public static final String DEFAULT_LOG_PREFIX = "task-telemetry -";

    public LoggingProperties {
        if (logPrefix == null) {
            throw new IllegalArgumentException("logPrefix must not be null");
        }
    }

    /**
     * Returns the configuration with the {@link #DEFAULT_LOG_PREFIX default prefix}.
     *
     * @return the default configuration
     */
    public static LoggingProperties defaults() {
        return new LoggingProperties(DEFAULT_LOG_PREFIX);
    }
}
