package org.tasktelemetry.logging;

import java.io.IOException;
import java.io.InputStream;
import java.util.Map;

import org.yaml.snakeyaml.Yaml;

/**
 * Loads {@link LoggingProperties} from a YAML resource on the classpath.
 *
 * <p>The resource is optional: when it is missing, unreadable, or does not
 * define {@code log-prefix}, the loader falls back to
 * {@link LoggingProperties#defaults()}. Loading is best-effort so that a broken
 * configuration file never prevents the library from starting.
 */
public final class LoggingPropertiesLoader {

    static final String RESOURCE_NAME = "task-telemetry.yml";
    static final String LOG_PREFIX_KEY = "log-prefix";

    private LoggingPropertiesLoader() {
    }

    /**
     * Loads the configuration from the default {@code task-telemetry.yml}
     * resource.
     *
     * @return the loaded configuration, or the defaults when none is available
     */
    public static LoggingProperties load() {
        return load(RESOURCE_NAME);
    }

    static LoggingProperties load(String resourceName) {
        ClassLoader classLoader = LoggingPropertiesLoader.class.getClassLoader();
        try (InputStream input = classLoader.getResourceAsStream(resourceName)) {
            if (input == null) {
                return LoggingProperties.defaults();
            }
            return readProperties(input);
        } catch (IOException error) {
            return LoggingProperties.defaults();
        }
    }

    private static LoggingProperties readProperties(InputStream input) {
        Object loaded = new Yaml().load(input);
        if (!(loaded instanceof Map<?, ?> values)) {
            return LoggingProperties.defaults();
        }

        Object prefix = values.get(LOG_PREFIX_KEY);
        if (prefix == null) {
            return LoggingProperties.defaults();
        }

        return new LoggingProperties(prefix.toString());
    }
}
