import static org.junit.Assert.assertTrue;

import org.junit.BeforeClass;
import org.junit.Test;


public class GeneratorePdfNegozialeTest {
    /**
     * Genera il PDF del Disciplinare Esecuzione Negoziale a partire dal jrxml di test,
     * popolando i valori dinamici (le voci evidenziate nel modello) con dati di prova.
     */
    private static final String MAIN_REPORT = "/negoziale/disciplinare_esecuzione.jrxml";

    private static final String OUTPUT_DIR = "target/pdf";
    private static final String OUTPUT_FILE = "disciplinare_esecuzione_test.pdf";
    private static final String OUTPUT_FILE_IMPORTI_ZERO = "disciplinare_esecuzione_importi_zero.pdf";
    private static final String OUTPUT_FILE_TESTI_AMPI = "disciplinare_esecuzione_testi_ampi.pdf";
    private static final String OUTPUT_FILE_VALORI_MANCANTI = "disciplinare_esecuzione_valori_mancanti.pdf";

    private static final String IMPORTO_ZERO = "0.00";

    private static final Set<String> CAMPI_IMPORTO = Set.of(
            "importoAssegnato2025", "importoAssegnato2026", "importoAssegnato");

    private static final String PARAM_NOME_COGNOME_UTENTE = "nomeCognomeUtente";
    private static final String NOME_COGNOME_UTENTE = "Mario Rossi";

    @BeforeClass
    public static void setUpEnvironment() {
        System.setProperty("java.awt.headless", "true");
    }

    @Test
    public void generaPdfDisciplinareEsecuzione() throws Exception {
        ObjectMapper mapper = new ObjectMapper();
        ObjectNode data = buildData(mapper);

        generaPdf(mapper, data, OUTPUT_FILE);
    }

    /**
     * Verifica che ogni valore dinamico fornito nel JSON venga effettivamente risolto e
     * stampato nel documento. Un path errato in una fieldDescription tornerebbe null e il
     * valore non comparirebbe nel testo: in quel caso il test fallisce elencando i valori
     * non risolti.
     */
    @Test
    public void nonRestanoValoriDinamiciIrrisolti() throws Exception {
        ObjectMapper mapper = new ObjectMapper();
        ObjectNode data = buildData(mapper);

        JasperPrint jasperPrint = fillReport(mapper, data);
        String testoStampato = estraiTestoStampato(jasperPrint);

        List<String> valoriMancanti = new ArrayList<>();
        for (String valoreAtteso : raccogliValoriDinamici(data)) {
            if (!testoStampato.contains(valoreAtteso)) {
                valoriMancanti.add(valoreAtteso);
            }
        }

        assertTrue("Valori dinamici non risolti nel documento generato: " + valoriMancanti,
                valoriMancanti.isEmpty());
    }

    /**
     * Variante con tutti gli importi a zero. Serve a ispezionare visivamente come vengono
     * resi i valori monetari nulli (es. "€ 0,00") nelle premesse e nell'Art. 2.
     */
    @Test
    public void generaPdfImportiAZero() throws Exception {
        ObjectMapper mapper = new ObjectMapper();
        ObjectNode data = buildData(mapper);

        data.put("importoAssegnato2025", IMPORTO_ZERO);
        data.put("importoAssegnato2026", IMPORTO_ZERO);
        data.put("importoAssegnato", IMPORTO_ZERO);

        generaPdf(mapper, data, OUTPUT_FILE_IMPORTI_ZERO);
    }

    /**
     * Variante con stringhe molto ampie su denominazione, titoli, indirizzo e capitolo di
     * spesa. Serve a ispezionare visivamente l'assenza di sovrapposizioni di testo e il
     * comportamento del cambio pagina. L'assert verifica che il contenuto più esteso produca
     * più pagine della baseline: se il testo si sovrapponesse o venisse troncato invece di
     * espandere i band, le pagine non aumenterebbero.
     */
    @Test
    public void generaPdfTestiAmpiVerificaImpaginazione() throws Exception {
        ObjectMapper mapper = new ObjectMapper();

        int pagineBaseline = fillReport(mapper, buildData(mapper)).getPages().size();

        ObjectNode data = buildData(mapper);
        applicaTestiAmpi(data);

        JasperPrint jasperPrint = fillReport(mapper, data);
        int pagineTestiAmpi = jasperPrint.getPages().size();

        Path outputPath = writePdf(jasperPrint, OUTPUT_FILE_TESTI_AMPI);

        assertTrue("Il PDF generato non esiste: " + outputPath, Files.exists(outputPath));
        assertTrue("I testi molto ampi non hanno prodotto più pagine della baseline (baseline="
                        + pagineBaseline + ", testiAmpi=" + pagineTestiAmpi
                        + "): possibile testo troncato o non espanso correttamente.",
                pagineTestiAmpi > pagineBaseline);
    }

    /**
     * Variante con un sottoinsieme di campi vuoti. Serve a ispezionare visivamente il
     * comportamento di isBlankWhenNull (spazi al posto dei valori) senza errori di rendering.
     */
    @Test
    public void generaPdfValoriMancanti() throws Exception {
        ObjectMapper mapper = new ObjectMapper();
        ObjectNode data = buildData(mapper);

        svuotaCampi(data);

        generaPdf(mapper, data, OUTPUT_FILE_VALORI_MANCANTI);
    }

    private void applicaTestiAmpi(ObjectNode data) {
        data.put("denominazioneEnte", testoMoltoLungo(
                "Fondazione Interregionale per la Promozione della Cultura e dello Spettacolo dal Vivo", 6));
        data.put("indirizzoSedeLegale", testoMoltoLungo(
                "Via dei Mille e delle Antiche Botteghe Artigiane del Centro Storico n. 1234", 4));
        data.put("nomeCognomeLegaleRappresentante",
                "Alessandro Massimiliano Giovanni Battista de' Medici della Rovere Sforza Visconti");

        data.put("titoloProgetto2026", testoMoltoLungo(
                "Stagione Teatrale, Musicale e di Danza Contemporanea della Regione Puglia", 5));
        data.put("titoloProgrammazioneTriennale", testoMoltoLungo(
                "Programma Artistico Triennale Integrato per la Valorizzazione del Patrimonio Culturale Immateriale", 4));

        data.put("denominazioneCapitoloSpesa2026", testoMoltoLungo(
                "Spese per il sostegno alle attività culturali e di spettacolo dal vivo di interesse regionale", 4));
    }

    private void svuotaCampi(ObjectNode data) {
        data.put("importoAssegnato2025", "");
        data.put("numeroCapitoloRegionale2025", "");
        data.put("dataSottoscrizioneDisciplinare2025", "");

        data.put("importoAssegnato2026", "");
        data.put("numeroProtocolloDomandaProgetto2026", "");
        data.put("denominazioneCapitoloSpesa2026", "");

        data.put("importoAssegnato", "");
        data.put("numeroAttoDirigenzialeAmmissione2026", "");
        data.put("dataAttoDirigenzialeAmmissione2026", "");
    }

    private String testoMoltoLungo(String frase, int ripetizioni) {
        StringBuilder testo = new StringBuilder();
        for (int i = 0; i < ripetizioni; i++) {
            if (i > 0) {
                testo.append(' ');
            }
            testo.append(frase);
        }
        return testo.toString();
    }

    private void generaPdf(ObjectMapper mapper, ObjectNode data, String outputFileName) throws Exception {
        JasperPrint jasperPrint = fillReport(mapper, data);

        Path outputPath = writePdf(jasperPrint, outputFileName);

        assertTrue("Il PDF generato non esiste: " + outputPath, Files.exists(outputPath));
        assertTrue("Il PDF generato è vuoto: " + outputPath, Files.size(outputPath) > 0);
    }

    private JasperPrint fillReport(ObjectMapper mapper, ObjectNode data) throws Exception {
        JasperReport mainReport = compile(MAIN_REPORT);

        byte[] jsonBytes = mapper.writeValueAsBytes(data);
        JsonDataSource dataSource = new JsonDataSource(new ByteArrayInputStream(jsonBytes));

        Map<String, Object> parameters = new HashMap<>();
        parameters.put(PARAM_NOME_COGNOME_UTENTE, NOME_COGNOME_UTENTE);

        return JasperFillManager.fillReport(mainReport, parameters, dataSource);
    }

    private String estraiTestoStampato(JasperPrint jasperPrint) {
        StringBuilder testo = new StringBuilder();
        for (JRPrintPage page : jasperPrint.getPages()) {
            accumulaTesto(page.getElements(), testo);
        }
        return testo.toString();
    }

    private void accumulaTesto(Collection<JRPrintElement> elementi, StringBuilder testo) {
        for (JRPrintElement elemento : elementi) {
            if (elemento instanceof JRPrintText) {
                testo.append(((JRPrintText) elemento).getFullText()).append('\n');
            } else if (elemento instanceof JRPrintFrame) {
                accumulaTesto(((JRPrintFrame) elemento).getElements(), testo);
            }
        }
    }

    private List<String> raccogliValoriDinamici(JsonNode nodo) {
        List<String> valori = new ArrayList<>();
        Iterator<Map.Entry<String, JsonNode>> campi = nodo.fields();
        while (campi.hasNext()) {
            Map.Entry<String, JsonNode> campo = campi.next();
            valori.add(valoreAttesoNelDocumento(campo.getKey(), campo.getValue().asText()));
        }
        return valori;
    }

    private String valoreAttesoNelDocumento(String nomeCampo, String valore) {
        if (CAMPI_IMPORTO.contains(nomeCampo)) {
            return formattaImporto(valore);
        }
        return valore;
    }

    private String formattaImporto(String valore) {
        DecimalFormat formato = new DecimalFormat("#,##0.00", new DecimalFormatSymbols(Locale.ITALY));
        return formato.format(new BigDecimal(valore.trim()));
    }

    private JasperReport compile(String resourcePath) throws Exception {
        try (InputStream stream = getClass().getResourceAsStream(resourcePath)) {
            if (stream == null) {
                throw new IllegalStateException("Risorsa jrxml non trovata nel classpath: " + resourcePath);
            }
            return JasperCompileManager.compileReport(stream);
        }
    }

    private Path writePdf(JasperPrint jasperPrint, String outputFileName) throws Exception {
        Path outputDir = Paths.get(OUTPUT_DIR);
        Files.createDirectories(outputDir);
        Path outputPath = outputDir.resolve(outputFileName);

        try (OutputStream outputStream = Files.newOutputStream(outputPath)) {
            JRPdfExporter exporter = new JRPdfExporter();
            exporter.setExporterInput(new SimpleExporterInput(jasperPrint));
            exporter.setExporterOutput(new SimpleOutputStreamExporterOutput(outputStream));
            exporter.exportReport();
        }
        return outputPath;
    }

