    /**
     *
     * @param serviceContext
     * @return
     */
    public List<ServizioDto> getServiziPiuUtilizzati(ServiceContext serviceContext) {
        ThemeDisplay themeDisplay = serviceContext.getThemeDisplay();
        DynamicQuery dq = richiestaLocalService.dynamicQuery();
        dq.add(RestrictionsFactoryUtil.eq("companyId", serviceContext.getCompanyId()));
        dq.add(RestrictionsFactoryUtil.eq("groupId", serviceContext.getScopeGroupId()));
        if (themeDisplay != null && themeDisplay.isSignedIn()) {
            String screenName = serviceContext.getThemeDisplay().getUser().getScreenName();
            dq.add(RestrictionsFactoryUtil.ilike("codiceFiscale", screenName));
        }

        List<Richiesta> richieste = richiestaLocalService.dynamicQuery(dq);

        Map<Long, Long> scores = richieste.stream().collect(Collectors.groupingBy(x -> x.getServizioId(), Collectors.counting()));

        List<Long> top10ServiziId = scores.entrySet().stream().map(x -> x.getKey()).collect(Collectors.toList());

        DynamicQuery dynamicQuery3 = servizioEnteLocalService.dynamicQuery();
        dynamicQuery3.add(RestrictionsFactoryUtil.in("primaryKey.servizioId", top10ServiziId));
        dynamicQuery3.add(RestrictionsFactoryUtil.eq("companyId", serviceContext.getCompanyId()));
        dynamicQuery3.add(RestrictionsFactoryUtil.eq("groupId", serviceContext.getScopeGroupId()));
        dynamicQuery3.add(RestrictionsFactoryUtil.eq("attivo", true));

        List<ServizioEnte> serviziEnte = servizioEnteLocalService.dynamicQuery(dynamicQuery3);

        top10ServiziId = serviziEnte.stream().map(x -> x.getServizioId()).collect(Collectors.toList());

        DynamicQuery dq2 = servizioLocalService.dynamicQuery();
        dq2.add(RestrictionsFactoryUtil.eq("attivo", true));
        dq2.add(RestrictionsFactoryUtil.in("servizioId", top10ServiziId));

        List<Servizio> servizi = servizioLocalService.dynamicQuery(dq2);
        return servizi.stream().map(x -> mapServizio(x, scores)).sorted((x, y) -> -Long.compare(x.getScore(), y.getScore())).limit(10).collect(Collectors.toList());
    }

    private ServizioDto mapServizio(Servizio servizio, Map<Long, Long> scores) {
        AreaTematica areaTematica = areaTematicaLocalService.fetchAreaTematica(servizio.getAreaTematicaId());
        List<Tipologia> tipologie = tipologiaLocalService.getServizioTipologias(servizio.getServizioId());

        ServizioDto dto = new ServizioDto();
        dto.setServizioId(servizio.getServizioId());
        dto.setNome(servizio.getNome());
