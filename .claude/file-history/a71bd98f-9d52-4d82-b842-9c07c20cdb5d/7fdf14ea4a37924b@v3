    private ComunicazioneDto mapComunicazioni(Comunicazione comunicazione) {

        ComunicazioneDto comunicazioneDto = null;

        if (Validator.isNotNull(comunicazione)) {
            comunicazioneDto = new ComunicazioneDto();
            comunicazioneDto.setCreateDate(comunicazione.getCreateDate());
            comunicazioneDto.setId(comunicazione.getComunicazioneId());
            comunicazioneDto.setDataInvio(comunicazione.getDataInvio());

            if (Validator.isNotNull(comunicazione.getUriServizio())) {
                comunicazioneDto.setUriServizio(comunicazione.getUriServizio());
            }

            if (comunicazione.getDomandaBandoId() > 0) {
                comunicazioneDto.setDomandaBandoId(comunicazione.getDomandaBandoId());
            }

            if (comunicazione.getRichiestaId() > 0) {
                comunicazioneDto.setRichiestaId(comunicazione.getRichiestaId());
            }

            List<Messaggio> listaMessaggi = messaggioLocalService.getMessaggi(comunicazione.getComunicazioneId(), QueryUtil.ALL_POS, QueryUtil.ALL_POS);
            if (listaMessaggi != null && !listaMessaggi.isEmpty()) {

                Comparator<Date> dateComparator = (o1, o2) -> o1.compareTo(o2);
                Date dataUltimoMessaggio = listaMessaggi.stream().map(messaggio -> messaggio.getCreateDate()).collect(Collectors.maxBy(dateComparator)).get();

                comunicazioneDto.setDataUltimoMessaggio(dataUltimoMessaggio);

                List<MessaggioDTO> listaMessaggiDto = listaMessaggi.stream().map(this::mapMessaggio).collect(Collectors.toList());

                if (listaMessaggiDto != null && !listaMessaggiDto.isEmpty()) {
                    comunicazioneDto.setMessaggi(listaMessaggiDto);
                    comunicazioneDto.setNumMess(listaMessaggiDto.size());
                }
            }

            comunicazioneDto.setTipologia(TipologiaComunicazione.COMUNICAZIONE.name());
            comunicazioneDto.setTitolo(comunicazione.getTitolo());

            comunicazioneDto.setLetta(comunicazione.isLetta());
        }

        return comunicazioneDto;

    }

