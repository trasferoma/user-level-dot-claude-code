    /**
     * Recupera la lista degli stati disponibili per le domande di bando.
     * Include sia gli stati di sistema (enum StatoDomandaBandoEnum) che gli stati
     * custom configurati per lo specifico bando.
     *
     * @param bandoId l'ID del bando, maggiore di 0 per includere anche gli stati custom
     * @return la lista completa dei DTO degli stati domanda
     */
    public List<StatoDomandaDto> getStati(long bandoId) {

        List<StatoDomandaDto> listaStati = new ArrayList<StatoDomandaDto>();

        for (StatoDomandaBandoEnum statoDomandaBando : StatoDomandaBandoEnum.values()) {
            StatoDomandaDto stato = new StatoDomandaDto();
            stato.setCodice(statoDomandaBando.name());
            stato.setDescrizione(statoDomandaBando.getName());
            listaStati.add(stato);
        }

        if (bandoId > 0) {
            List<StatoDomanda> listaStatiModel = statoDomandaLocalService.getStatoDomandaByBandoIdAndAbilitaRichiedente(bandoId, true);

            if (Validator.isNotNull(listaStatiModel) && !listaStatiModel.isEmpty()) {
                for (StatoDomanda statoDomanda : listaStatiModel) {
                    if (Validator.isNotNull(statoDomanda)) {
                        StatoDomandaDto stato = new StatoDomandaDto();
                        StatoDomandaBando statoBando = statoDomandaBandoLocalService.getStatoDomandaBandoByBandoIdAndStatoId(bandoId,statoDomanda.getStatoDomandaId());
                        stato.setCodice(statoDomanda.getCodice());
                        stato.setDescrizione(statoBando.getDescrizione());
                        listaStati.add(stato);
                    }
                }
            }
        }

        return listaStati;
    }

