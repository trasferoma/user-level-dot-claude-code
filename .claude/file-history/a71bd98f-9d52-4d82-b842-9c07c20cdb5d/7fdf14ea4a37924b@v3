    public boolean checkCompilazioneQuestionarioEvento (DomandaBando domandaBando) throws PortalException {
        boolean checkCompilazioneQuestionarioEvento = false;
        Bando bando = bandoLocalService.getBando(domandaBando.getBandoId());
        TipologiaBando tipologiaBando = tipologiaBandoLocalService.getTipologiaBando(bando.getTipologiaBandoId());

        if(tipologiaBando.getCodice().equalsIgnoreCase(TipologiaBandoEnum.EVENTO.name())){
            List<BandoForm> bandoFormList = bandoFormLocalService.getListaBandoFormBandoAndType(bando.getBandoId(), "QUESTIONARIO");

            if(ListUtil.isNotNull(bandoFormList) && ListUtil.isNotEmpty(bandoFormList) && Validator.isNotNull(bandoFormList.get(0))){
                BandoForm bandoForm = bandoFormList.get(0);

                if(Validator.isNotNull(bandoForm)){
                    IstanzaDomandaBando istanzaDomandaBando = istanzaDomandaBandoLocalService.getIstanzaDomandaBandoByDomandaBandoIdAndFormId(domandaBando.getDomandaBandoId(), bandoForm.getFormId());

                    if(Validator.isNull(istanzaDomandaBando) || Validator.isNull(istanzaDomandaBando.getStato()) || !istanzaDomandaBando.getStato().equalsIgnoreCase(StatoIntegrazioneDomandaBandoEnum.CONFERMATA.name())){
                        TermineBando termineBando = termineBandoLocalService.getTermineBandoByBandoIdAndCodice(bando.getBandoId(), "SCADENZA_QUESTIONARIO_FOLLOW_UP");

                        if(Validator.isNotNull(termineBando)){
                            long giorniScadenzaQuestionario = TimeUnit.SECONDS.toDays(termineBando.getSecondi());

                            if(domandaBando.getStato().equalsIgnoreCase(StatoDomandaBandoEnum.PARTECIPAZIONE_EFFETTUATA.name())){
                                List<AzioneOperatore> azioneOperatoreList = azioneOperatoreLocalService.getByDomandaBandoIdAndCodiceAzioneSorted(domandaBando.getDomandaBandoId(), "ESITO_PROCEDIMENTO_PARTECIPAZIONE_EFFETTUATA", null);

                                if(ListUtil.isNotNull(azioneOperatoreList) && ListUtil.isNotEmpty(azioneOperatoreList) && Validator.isNotNull(azioneOperatoreList.get(0))){
                                    AzioneOperatore azioneOperatore = azioneOperatoreList.get(0);
                                    Date dataRegistrazionePartecipazione = azioneOperatore.getCreateDate();
                                    LocalDate data = dataRegistrazionePartecipazione.toInstant()
                                            .atZone(ZoneId.systemDefault())
                                            .toLocalDate();

                                    // Calcola la data limite
                                    LocalDate oggi = LocalDate.now();
                                    LocalDate dataLimite = data.plusDays(giorniScadenzaQuestionario);

                                    // Verifica se NON sono passati N giorni
                                    boolean nonSonoPassati = oggi.isBefore(dataLimite);

                                    if(nonSonoPassati) checkCompilazioneQuestionarioEvento = true;

                                }
                            }
                        }
                    }
                }
            }
        }

        return checkCompilazioneQuestionarioEvento;
    }

