    public void aggiornaStatoRichiestaReferente(long richiestaReferenteId, long userId) {
        List<Comunicazione> comunicazioniDomandaBando = comunicazioneLocalService.getByRichiestaReferenteIstanzaId(richiestaReferenteId, QueryUtil.ALL_POS, QueryUtil.ALL_POS, null);

        if (Validator.isNotNull(comunicazioniDomandaBando) && !comunicazioniDomandaBando.isEmpty()) {
            for (Comunicazione comunicazione: comunicazioniDomandaBando) {
                Messaggio messaggio = messaggioLocalService.getFirstMessaggio(comunicazione.getComunicazioneId());
                LetturaMessaggioPK letturaMessaggioPK = new LetturaMessaggioPK();
                letturaMessaggioPK.setMessaggioId(messaggio.getMessaggioId());
                letturaMessaggioPK.setUserId(userId);
                LetturaMessaggio letturaMessaggio = null;
                try {
                    letturaMessaggio = letturaMessaggioLocalService.getLetturaMessaggio(letturaMessaggioPK);
                } catch (PortalException e) {
                    log.debug("Nessuna lettura trovata per il messaggio :: " + messaggio.getMessaggioId());
                }
                if (Validator.isNull(letturaMessaggio)) {

                    if (comunicazione.getSubOrganizationId() > 0) {
                        long[] organizationIds = userLocalService.getOrganizationUserIds(comunicazione.getSubOrganizationId());
                        letturaMessaggioLocalService.setMessaggiLetti(comunicazione.getComunicazioneId(), userId, organizationIds);
                    } else {
                        letturaMessaggioLocalService.setMessaggiLetti(comunicazione.getComunicazioneId(), userId);
                    }
                }
            }
        }
    }
