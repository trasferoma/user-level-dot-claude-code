    public List<MessaggioDTO> getMessaggiDomandaBando(long domandaBandoId, long siteGroupId, boolean visibile, int start, int end, boolean paginazione, Long userId) {

        List<CommentoDomandaBando> commentiDomandaBando = commentoDomandaBandoLocalService.getCommentiDomandaBandoByDomandaBandoIdVisibile(domandaBandoId, visibile, QueryUtil.ALL_POS,
