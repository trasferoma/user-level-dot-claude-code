    /**
     * Recupera la lista delle richieste dell'utente con filtri e paginazione.
     * Esclude automaticamente i servizi di tipo pagamento. Supporta filtri per oggetto/note,
     * stato e ID richiesta, con ordinamento configurabile.
     *
     * @param codiceFiscale il codice fiscale dell'utente proprietario delle richieste
     * @param filterOggettoNote filtro testuale su oggetto e note della richiesta
     * @param filterIdRichiesta filtro per ID specifico della richiesta
     * @param stato filtro per stato della richiesta (BOZZA, INVIATA, etc.)
     * @param companyId l'ID della company, 0 per non filtrare
     * @param groupId l'ID del gruppo/site, 0 per non filtrare
     * @param cur la pagina corrente per la paginazione
     * @param delta il numero di elementi per pagina
     * @param orderByCol la colonna per l'ordinamento
     * @param orderByType il tipo di ordinamento (asc/desc)
     * @param locale il locale per la localizzazione
     * @param recuperoInformazioniPerCf true per recuperare informazioni aggiuntive per codice fiscale
     * @return la lista di DTO delle richieste con informazioni aggregate
     * @throws Exception se si verifica un errore durante il recupero
     */
    public List<RichiestaAccordionDto> getRichiesteUtente(String codiceFiscale, String filterOggettoNote, String filterIdRichiesta, String stato, long companyId, long groupId, int cur, int delta,
                                                          String orderByCol, String orderByType, Locale locale, boolean recuperoInformazioniPerCf) throws Exception {
        RichiestaFilters richiestaFilter = new RichiestaFilters();
        richiestaFilter.setCodiceFiscale(codiceFiscale);

        if(companyId > 0) {
            richiestaFilter.setCompanyId(companyId);
        }

        if(groupId > 0) {
            List<Long> groupsIds = new ArrayList<Long>();
            groupsIds.add(groupId);
            richiestaFilter.setGroupId(groupsIds);
        }

        richiestaFilter.setOrderByCol("modifiedDate");
        richiestaFilter.setOrderByType("desc");

        if (Validator.isNotNull(filterOggettoNote)) {
            richiestaFilter.setOggettoNote(filterOggettoNote);
        }

        if (Validator.isNotNull(stato)) {
            richiestaFilter.setTipo(stato);
        }

        if (Validator.isNotNull(filterIdRichiesta)) {
            try {
                Long.parseLong(filterIdRichiesta);
            }
            catch (NumberFormatException e) {
                return Collections.emptyList();
            }

            richiestaFilter.setIdRichiesta(filterIdRichiesta);
        }

        if (Validator.isNotNull(orderByCol)) {
            richiestaFilter.setOrderByCol(orderByCol);
        }

        if (Validator.isNotNull(orderByType)) {
            richiestaFilter.setOrderByType(orderByType);
        }

        List<Servizio> serviziNonPagamento = getServiziNonPagamento();

        Set<Long> serviziIds = serviziNonPagamento.stream().map(Servizio::getServizioId).collect(Collectors.toSet());
        richiestaFilter.setServiziIds(serviziIds);

        int startEnd[] = SearchPaginationUtil.calculateStartAndEnd(cur, delta);
        List<Richiesta> listaRichieste = richiestaLocalService.search(richiestaFilter, startEnd[0], startEnd[1]);

        return getRichiesteDto(listaRichieste, locale, recuperoInformazioniPerCf);
    }

    /**
     * Recupera la lista delle domande di bando dell'utente con filtri e paginazione.
     * Permette di filtrare per ID domanda, ID bando, stato e site group.
     *
     * @param codiceFiscale il codice fiscale dell'utente proprietario delle domande
     * @param domandaBandoId l'ID specifico della domanda, 0 per non filtrare
     * @param bandoId l'ID del bando di riferimento, 0 per non filtrare
     * @param stato lo stato interno della domanda (enum), null per non filtrare
     * @param statoId l'ID dello stato configurato, 0 per non filtrare
     * @param siteGroupId l'ID del site group
     * @param cur la pagina corrente per la paginazione
     * @param delta il numero di elementi per pagina
     * @param orderByType il tipo di ordinamento (asc/desc)
     * @param orderByCol la colonna per l'ordinamento
     * @param loggedUser l'utente loggato per controllo permessi
     * @param organizationId l'ID dell'organizzazione per controllo permessi
     * @return la lista di DTO delle domande di bando con informazioni aggregate
     * @throws Exception se si verifica un errore durante il recupero
     */
    public List<DomandaBandoAccorditionDto> getDomandeBandoUtente(String codiceFiscale, long domandaBandoId, long bandoId, StatoDomandaBandoEnum stato, long statoId, long siteGroupId, int cur,
                                                                  int delta, String orderByType, String orderByCol, User loggedUser, long organizationId) throws Exception {

        int[] startEnd = SearchPaginationUtil.calculateStartAndEnd(cur, delta);
        String statoInterno = "";

        if (Validator.isNotNull(stato)) {
            statoInterno = stato.name();
        }

        List<DomandaBando> listaDomandeBando = domandaBandoLocalService.searchDomandeBando(codiceFiscale, domandaBandoId, bandoId, statoInterno, statoId, siteGroupId, startEnd[0], startEnd[1],
                orderByType, orderByCol);

        return getDomandeBandoDto(listaDomandeBando, loggedUser, organizationId);
    }

    /**
     * Conta il numero totale di richieste dell'utente applicando i filtri specificati.
     * Esclude automaticamente i servizi di tipo pagamento dal conteggio.
     *
     * @param codiceFiscale il codice fiscale dell'utente proprietario delle richieste
     * @param filterOggettoNote filtro testuale su oggetto e note della richiesta
     * @param stato filtro per stato della richiesta
     * @param companyId l'ID della company, 0 per non filtrare
     * @param groupId l'ID del gruppo/site, 0 per non filtrare
     * @return il numero totale di richieste che soddisfano i criteri
     */
    public long countRichiesteUtente(String codiceFiscale, String filterOggettoNote, String stato, long companyId, long groupId) {

        RichiestaFilters richiestaFilter = new RichiestaFilters();
        richiestaFilter.setCodiceFiscale(codiceFiscale);

        if(companyId > 0) {
            richiestaFilter.setCompanyId(companyId);
        }

        if(groupId > 0) {
            List<Long> groupsIds = new ArrayList<Long>();
            groupsIds.add(groupId);
            richiestaFilter.setGroupId(groupsIds);
        }

        if (Validator.isNotNull(filterOggettoNote)) {
            richiestaFilter.setOggettoNote(filterOggettoNote);
        }

        if (Validator.isNotNull(stato)) {
            richiestaFilter.setTipo(stato);
        }

        List<Servizio> serviziNonPagamento = getServiziNonPagamento();

        Set<Long> serviziIds = serviziNonPagamento.stream().map(Servizio::getServizioId).collect(Collectors.toSet());
        richiestaFilter.setServiziIds(serviziIds);

        return richiestaLocalService.count(richiestaFilter);
    }

    /**
     * Recupera la lista delle richieste di pagamento dell'utente con filtri e paginazione.
     * Filtra automaticamente solo i servizi di tipo PAGAMENTO e le relative procedure attive o meno.
     *
     * @param codiceFiscale il codice fiscale dell'utente proprietario dei pagamenti
     * @param filterOggettoNote filtro testuale su oggetto e note della richiesta
     * @param stato filtro per stato della richiesta di pagamento
