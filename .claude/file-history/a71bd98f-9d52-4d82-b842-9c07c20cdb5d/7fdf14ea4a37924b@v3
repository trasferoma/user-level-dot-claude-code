    private List<ComunicazioneDto> getListaComunicazioniScrivaniaCittadino(ComunicazioneFilters comunicazioneFilters, Long userId) {
        List<Comunicazione> listaComunicazioni = comunicazioneLocalService.searchComunicazioni(comunicazioneFilters);
        List<ComunicazioneDto> listaComunicazioniDto = new ArrayList<ComunicazioneDto>();

        //comunicazioni non lette
        if (listaComunicazioni != null && !listaComunicazioni.isEmpty()) {
            for (Comunicazione comunicazione: listaComunicazioni) {
                List<Comunicazione> comunicazioniNonLette = new ArrayList<>();
                if (comunicazione.getSubOrganizationId() > 0) {
                    long[] organizationIds = userLocalService.getOrganizationUserIds(comunicazione.getSubOrganizationId());
                    comunicazioniNonLette = comunicazioneLocalService.findComunicazioniNonLetteByUserIdAndSubOrgIds(userId, organizationIds);
                } else {
                    comunicazioniNonLette = comunicazioneLocalService.findComunicazioniNonLetteByUserId(userId);
                }
                List<Long> comunicazioniNonLetteIds = new ArrayList<> ();
                if (Validator.isNotNull(comunicazioniNonLette) && !comunicazioniNonLette.isEmpty()) {
                    comunicazioniNonLetteIds = comunicazioniNonLette.stream().map(c -> c.getComunicazioneId()).collect(Collectors.toList());
                }
                if (comunicazioniNonLetteIds.isEmpty()) {
                    comunicazione.setLetta(true);
                } else if (Validator.isNotNull(comunicazioniNonLetteIds) && !comunicazioniNonLetteIds.isEmpty()) {
                    for (Long idComunicazione: comunicazioniNonLetteIds) {
                        if (idComunicazione == comunicazione.getComunicazioneId()) {
                            comunicazione.setLetta(false);
                            break;
                        } else {
                            comunicazione.setLetta(true);
                        }
                    }
                }
            }
            listaComunicazioniDto = listaComunicazioni.stream().map(this::mapComunicazioni).collect(Collectors.toList());
        }

        return listaComunicazioniDto;
    }

    public List<ComunicazioneDto> getListaComunicazioni(ComunicazioneFilters comunicazioneFilters, long userId, int cur, int delta, Locale locale, boolean paginazione) {
        List<ComunicazioneDto> listaComunicazioni = getListaComunicazioniScrivaniaCittadino(comunicazioneFilters, userId);
        List<ComunicazioneDto> listaCommenti = getCommentiComunicazioneScrivaniaCittadino(comunicazioneFilters, locale);

        List<ComunicazioneDto> listaCompleta = new ArrayList<ComunicazioneDto>();

        if (listaComunicazioni != null && !listaComunicazioni.isEmpty()) {
            listaCompleta.addAll(listaComunicazioni);
        }

        if (listaCommenti != null && !listaCommenti.isEmpty()) {
            listaCompleta.addAll(listaCommenti);
        }

        if (Validator.isNotNull(comunicazioneFilters)) {
            Stream<ComunicazioneDto> listaCompletaStream = listaCompleta.stream();

            if (!Validator.isBlank(comunicazioneFilters.getTitoloDescrizione())) {
                listaCompletaStream = listaCompletaStream.filter(com -> {
                    if (com.getTitolo().toLowerCase().contains(comunicazioneFilters.getTitoloDescrizione().toLowerCase())) {
                        return true;
                    }

                    return false;
                });
            }

            listaCompleta = listaCompletaStream.collect(Collectors.toList());
        }

        // Collections.sort(listaCompleta,
        // Comparator.comparing(ComunicazioneDto::getDataUltimoMessaggio).reversed());

//		if (Validator.isNotNull(listaCompleta) && !listaCompleta.isEmpty()) {
//			for (ComunicazioneDto comunicazioneDto : listaCompleta) {
//				if (Validator.isNotNull(comunicazioneDto)) {
//					TipologiaComunicazione tipologiaComunicazione = TipologiaComunicazione.getByKey(comunicazioneDto.getTipologia());
//					if (tipologiaComunicazione.equals(TipologiaComunicazione.COMUNICAZIONE)) {
//						boolean isLetta = isComunicazioneLetta(comunicazioneDto.getId(), userId);
//						comunicazioneDto.setLetta(isLetta);
//					}
//				}
//			}
//		}

        if (!listaCompleta.isEmpty()) {
            listaCompleta.sort((o1, o2) -> {

                int result = 0;

                if (o1.getDataUltimoMessaggio() != null && o2.getDataUltimoMessaggio() != null) {
                    result = o2.getDataUltimoMessaggio().compareTo(o1.getDataUltimoMessaggio());

                    if (result == 0) {
                        result = o1.getLetta().compareTo(o2.getLetta());
                    }
                }
                else {
                    if (o1.getDataUltimoMessaggio() != null) {
                        result = -1;
                    }

                    if (o2.getDataUltimoMessaggio() != null) {
                        result = 1;
                    }
                }
                return result;
            });
        }

        int start = (cur - 1) * delta;
        int end = start + delta;
        if (start >= listaCompleta.size()) {
            return Collections.emptyList();
        }

        List<ComunicazioneDto> resultList = new ArrayList<ComunicazioneDto>();

        if (paginazione) {
            resultList = listaCompleta.subList(start, Math.min(end, listaCompleta.size()));
        } else {
            resultList = listaCompleta;
        }


        return resultList;
    }

