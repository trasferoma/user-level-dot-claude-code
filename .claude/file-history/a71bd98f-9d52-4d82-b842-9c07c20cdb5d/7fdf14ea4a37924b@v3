        // QueryUtil.ALL_POS, QueryUtil.ALL_POS);
        List<Comunicazione> comunicazioniDomandaBando = comunicazioneLocalService.getByDomandaBandoId(domandaBandoId, QueryUtil.ALL_POS, QueryUtil.ALL_POS, null);

        Organization organization = null;
        if (siteGroupId > 0) {
            try {
                organization = organizationUtility.getSiteOrganization(siteGroupId);
            }
            catch (PortalException portalException) {
                log.error("Impossibile recuperare l'organizzazione. :: " + portalException.getMessage(), portalException);
            }
        }

        List<MessaggioDTO> listaFinale = new ArrayList<>();
        List<MessaggioDTO> result = new ArrayList<>();
        listaFinale.addAll(messaggioAdapterUtil.adapt(commentiDomandaBando, organization, userId));
        // result.addAll(messaggioAdapterUtil.adapt(attivitaDomandaBando));
        listaFinale.addAll(messaggioAdapterUtil.adapt(comunicazioniDomandaBando, organization, userId));

        if (paginazione) {
            if (end > listaFinale.size()) {
                end = listaFinale.size();
            }

            result = listaFinale.subList(start, end);
        } else {
            result = listaFinale;
        }
        result.sort(Comparator.comparing(MessaggioDTO::getCreateDate).reversed());

        return result;
    }

