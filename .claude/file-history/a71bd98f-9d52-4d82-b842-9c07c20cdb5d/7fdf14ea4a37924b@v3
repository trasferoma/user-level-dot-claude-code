    public List<AttivitaDomandaBandoDto> getAttivitaDomandaBandoByDomandaBandoIdActive(long domandaBandoId, long bandoId) {
        List<AttivitaDomandaBando> listaAttivitaDomandaBando = attivitaDomandaBandoLocalService.getAttivitaDomandaBandoByDomandaBandoId(domandaBandoId);
        List<StatoDomanda> statiDomandaAbilitatiRichiedente  = statoDomandaLocalService.getStatoDomandaByBandoIdAndAbilitaRichiedente(bandoId, true);
        List<AttivitaDomandaBandoDto> listaAttivitaFinale= null;

        if (Validator.isNotNull(listaAttivitaDomandaBando)) {
            for (AttivitaDomandaBando attivitaDomandaBando : listaAttivitaDomandaBando) {
                if (Validator.isNotNull(attivitaDomandaBando) && Validator.isNotNull(attivitaDomandaBando.getStato())) {
                    StatoDomandaBandoEnum stato = StatoDomandaBandoEnum.findByName(attivitaDomandaBando.getStato());

                    if (Validator.isNotNull(stato)) {
                        listaAttivitaFinale = AttivitaDomandaBandoToBandoDtoList(listaAttivitaDomandaBando);
                    }
                    else {
                        Optional<StatoDomanda> statoCustom = statiDomandaAbilitatiRichiedente.stream().filter(x -> x.getCodice().equalsIgnoreCase(attivitaDomandaBando.getStato())).findFirst();

                        if (statoCustom.isPresent()) {
                            if (Validator.isNotNull(statoCustom.get())) {
                                listaAttivitaFinale = AttivitaDomandaBandoToBandoDtoList(listaAttivitaDomandaBando);
                            }
                        }
                    }
                }
            }
        }

        return listaAttivitaFinale;
    }

    private List<AttivitaDomandaBandoDto> AttivitaDomandaBandoToBandoDtoList(List<AttivitaDomandaBando> attivitaDomandaBandoList){
        List<AttivitaDomandaBandoDto> dtoList = new ArrayList<>();

        for (AttivitaDomandaBando attivitaDomandaBando : attivitaDomandaBandoList) {
            AttivitaDomandaBandoDto dto = new AttivitaDomandaBandoDto();
            List<String> attivitaDomandaBandoDtoNote = new ArrayList<>();
            String[] noteSeparate = attivitaDomandaBando.getNote().split("\\|");

            dto.setModifiedDate(attivitaDomandaBando.getModifiedDate());
            dto.setDescrizione(attivitaDomandaBando.getDescrizione());
            dto.setStato(attivitaDomandaBando.getStato());

            if(Validator.isNotNull(attivitaDomandaBando.getNote())){
                for ( String nota : noteSeparate){
                    attivitaDomandaBandoDtoNote.add(nota);
                }
                dto.setNote(attivitaDomandaBandoDtoNote);
            }

            dtoList.add(dto);
        }

        return dtoList;
    }

