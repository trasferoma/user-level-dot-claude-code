    private List<DomandaBandoAccorditionDto> getDomandeBandoDto(List<DomandaBando> listaDomandeBando, User loggedUser, long organizationId) throws PortalException {

        List<DomandaBandoAccorditionDto> domandaBandoDto = new ArrayList<DomandaBandoAccorditionDto>();

        for (DomandaBando domandaBando : listaDomandeBando) {
            DomandaBandoAccorditionDto domandaBandoAccorditionDto = new DomandaBandoAccorditionDto();
            Bando bando = bandoLocalService.getBando(domandaBando.getBandoId());
            TipologiaBando tipologiaBando = tipologiaBandoLocalService.fetchTipologiaBando(bando.getTipologiaBandoId());
            List<BandoForm> formAnnullamento = bandoFormLocalService.getListaBandoFormBandoAndType(domandaBando.getBandoId(), TipoFormEnum.ANNULLAMENTO.name());
            domandaBandoAccorditionDto.setDomandaBando(domandaBando);
            domandaBandoAccorditionDto.setDataUltimaModificaRichiestaLabel(simpleDateFormat.format(domandaBando.getModifiedDate()));

            if (Validator.isNotNull(bando)) {
                domandaBandoAccorditionDto.setNomeBandoLabel(bando.getNome());
            }

            if (domandaBando.getStatoId() > 0) {
                //StatoDomanda statoDomanda = statoDomandaLocalService.getStatoDomanda(domandaBando.getStatoId());
                StatoDomandaBando statoDomanda = statoDomandaBandoLocalService.getStatoDomandaBandoByBandoIdAndStatoId(bando.getBandoId(),domandaBando.getStatoId());

                if (Validator.isNotNull(statoDomanda) && statoDomanda.isAbilitaRichiedente()) {
                    domandaBandoAccorditionDto.setStatoDomandaBando(statoDomanda.getDescrizione());
                } else {
                    domandaBandoAccorditionDto.setStatoDomandaBando(StatoDomandaBandoEnum.valueOf(domandaBando.getStato()).getName());
                }
            } else {
                if (Validator.isNotNull(domandaBando.getStato())) {
                    domandaBandoAccorditionDto.setStatoDomandaBando(StatoDomandaBandoEnum.valueOf(domandaBando.getStato()).getName());
                }
            }

            if (Validator.isNotNull(domandaBando.getStato())) {
                domandaBandoAccorditionDto.setStatoInternoDomandaBando(domandaBando.getStato());
            }

            if (domandaBando.getStato().equalsIgnoreCase(StatoDomandaBandoEnum.IN_LAVORAZIONE.name())) {
                List<AllegatoDomandaBando> allegatiDomandaBando = allegatoDomandaBandoLocalService.getListaAllegatoDomandaBandoByDomandaBandoIdAndVisibile(domandaBando.getDomandaBandoId(), true);
                domandaBandoAccorditionDto.setAllegatiDomandaBando(allegatiDomandaBando);
            }

            boolean showActionButtons = false;

            if(tipologiaBando.getCodice().equalsIgnoreCase(TipologiaBandoEnum.AVVISO_LIQUIDAZIONE_CONTRIBUTI.name())){
                showActionButtons = checkPermissionActionButtonsAccessoElenco(domandaBando, loggedUser, organizationId);
            }else{
                showActionButtons = checkPermissionActionButtons(domandaBando, loggedUser);
            }

            if (showActionButtons) {
                if (Validator.isNotNull(formAnnullamento) && !formAnnullamento.isEmpty()) {
                    domandaBandoAccorditionDto.setMostraAnnullamentoDomanda(true);
                }
            }

            if (bando.isAbilitaBozzeMultiple()) {
                domandaBandoAccorditionDto.setGestioneMultibozza(true);
            }


            domandaBandoDto.add(domandaBandoAccorditionDto);

        }

        return domandaBandoDto;

    }

    /**
     *
     * @param richieste
     * @param locale
     * @return
     * @throws PortalException
     */
    private List<RichiestaAccordionDto> getRichiesteDto(List<Richiesta> richieste, Locale locale, boolean recuperoInformazioniPerCf) throws PortalException {

        List<RichiestaAccordionDto> richiesteDto = new ArrayList<RichiestaAccordionDto>();

        for (Richiesta richiesta : richieste) {
            List<AllegatoRichiesta> allegatiRichiesta = allegatoRichiestaLocalService.getAllegatiRichiestaByRichiestaIdVisibile(richiesta.getRichiestaId(), true);
            RichiestaAccordionDto richiestaAccordionDto = new RichiestaAccordionDto();
            richiestaAccordionDto.setRichiesta(richiesta);
            richiestaAccordionDto.setStatoRichiestaLabel(LanguageUtil.get(locale, "stato-richiesta-" + richiesta.getStato()));

            if (richiesta.getNumeroProtocollo() != null) {
                richiestaAccordionDto.setNumeroProtocolloLabel(richiesta.getNumeroProtocolloEsteso());
            }

            if(recuperoInformazioniPerCf) {
                Organization subOrganization = organizationLocalService.getOrganization(richiesta.getSubOrganizationId());

                if(Validator.isNotNull(subOrganization)) {
                    Organization parentOrganization = subOrganization.getParentOrganization();

                    if(Validator.isNotNull(parentOrganization) && Validator.isNotNull(parentOrganization.getName())) {
                        richiestaAccordionDto.setNomeEnte(parentOrganization.getName());
                    }
                }
            }else {
                richiestaAccordionDto.setNomeEnte("");
            }

            richiestaAccordionDto.setDataUltimaModificaRichiestaLabel(simpleDateFormat.format(richiesta.getModifiedDate()));
            if (richiesta.getStato().equals(StatoRichiesta.CHIUSA_POSITIVAMENTE.name()) || richiesta.getStato().equals(StatoRichiesta.ATTESA_INTEGRAZIONI.name())) {
                // Se pagamento, aggiunta allegato ricevuta
                Long pagamentoIdRichiesta = getPagamentoIdByRichiestaIdSeCompletato(richiesta.getRichiestaId(), richiesta.getGroupId());
                if (Validator.isNotNull(pagamentoIdRichiesta)) {
                    AllegatoRichiesta allegatoRichiestaRicevutaTelematicaPagamento = allegatoRichiestaLocalService.createAllegatoRichiesta(0);
                    allegatoRichiestaRicevutaTelematicaPagamento.setUrl(String.valueOf(pagamentoIdRichiesta));
                    allegatoRichiestaRicevutaTelematicaPagamento.setNome(LanguageUtil.get(locale, "ricevuta-telematica"));
                    List<AllegatoRichiesta> allegatiRichiestaClone = new ArrayList<AllegatoRichiesta>(allegatiRichiesta);
                    allegatiRichiestaClone.add(allegatoRichiestaRicevutaTelematicaPagamento);
                    allegatiRichiesta = allegatiRichiestaClone;
                }
                richiestaAccordionDto.setAllegatiRichiesta(allegatiRichiesta);
            }

            richiesteDto.add(richiestaAccordionDto);
        }
        return richiesteDto;
    }

