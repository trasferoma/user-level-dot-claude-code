    public List<IntegrazioneDTO> getIntegrazioni(long bandoId, long domandaBandoId) {
        List<String> tipoFormList = TipoFormEnum.getTipoFormEsecuzione().stream().map(Enum::name).collect(Collectors.toList());

        List<DomandaBandoDatoAggiuntivo> domandaBandoDatoAggiuntivoList = domandaBandoDatoAggiuntivoLocalService.getDomandaBandoDatoAggiuntivoByDomandaBandoIdAndChiave(Collections.singletonList(domandaBandoId), Collections.singletonList(DatoAggiuntivoChiave.FORM_ESECUZIONE_NON_ABILITATO.name()));
        List<Long> formIdsToExclude = new ArrayList<>();
        if (Validator.isNotNull(domandaBandoDatoAggiuntivoList) && !domandaBandoDatoAggiuntivoList.isEmpty()) {
            for (DomandaBandoDatoAggiuntivo domandaBandoDatoAggiuntivo: domandaBandoDatoAggiuntivoList) {
                if (Validator.isNotNull(domandaBandoDatoAggiuntivo.getValore())) {
                    Form form = formLocalService.getFormByCodice(domandaBandoDatoAggiuntivo.getValore());
                    if (Validator.isNotNull(form)) {
                        formIdsToExclude.add(form.getFormId());
                    }
                }
            }
        }
        List<BandoForm> bandoForms = bandoFormLocalService.getListaBandoFormBandoAndTipoFormAndFormIdNotIn(bandoId, tipoFormList, formIdsToExclude);

        List<IntegrazioneDTO> integrazioni = bandoForms.stream().map(bandoForm -> formLocalService.fetchForm(bandoForm.getFormId())).map(this::mapForm).collect(Collectors.toList());

        // Soccorso istruttorio del disciplinare esecuzione: la sottoscrizione richiesta dall'operatore va
        // aggiunta in unione ai servizi di esecuzione, senza sospendere la fase.
        List<IntegrazioneDTO> sottoscrizioniDisciplinarePendenti = getSottoscrizioniDisciplinareEsecuzionePendenti(bandoId, domandaBandoId, formIdsToExclude);
        for (IntegrazioneDTO sottoscrizione : sottoscrizioniDisciplinarePendenti) {
            boolean giaPresente = integrazioni.stream().anyMatch(esistente -> sottoscrizione.getId().equals(esistente.getId()));
            if (!giaPresente) {
                integrazioni.add(sottoscrizione);
            }
        }

        // Ordinamento alfabetico locale-aware (italiano): il prefisso anno presente nel nome del form
        // (es. "2025 - ...", "2026 - ...") guida l'ordinamento mostrato in modale.
        Collator collator = Collator.getInstance(Locale.ITALY);
        integrazioni.sort(Comparator.comparing(IntegrazioneDTO::getNome, Comparator.nullsLast(collator)));

        return integrazioni;
    }

    public List<IntegrazioneDTO> getFormEsecuzione(long bandoId, long domandaBandoId) {
        List<String> tipoFormEsecuzioneList = new ArrayList<>();
        tipoFormEsecuzioneList.add(TipoFormEnum.ESECUZIONE.name());

        List<String> tipoFormIntegrazioneEsecuzioneList = new ArrayList<>();
        tipoFormIntegrazioneEsecuzioneList.add(TipoFormEnum.ESECUZIONE_INTEGRAZIONE.name());

        List<DomandaBandoDatoAggiuntivo> domandaBandoDatoAggiuntivoList = domandaBandoDatoAggiuntivoLocalService.getDomandaBandoDatoAggiuntivoByDomandaBandoIdAndChiave(Collections.singletonList(domandaBandoId), Collections.singletonList(DatoAggiuntivoChiave.FORM_ESECUZIONE_NON_ABILITATO.name()));
        List<Long> formIdsToExclude = new ArrayList<>();
        if (Validator.isNotNull(domandaBandoDatoAggiuntivoList) && !domandaBandoDatoAggiuntivoList.isEmpty()) {
            for (DomandaBandoDatoAggiuntivo domandaBandoDatoAggiuntivo: domandaBandoDatoAggiuntivoList) {
                if (Validator.isNotNull(domandaBandoDatoAggiuntivo.getValore())) {
                    Form form = formLocalService.getFormByCodice(domandaBandoDatoAggiuntivo.getValore());
                    if (Validator.isNotNull(form)) {
                        formIdsToExclude.add(form.getFormId());
                    }
                }
            }
        }

        List<IntegrazioneDTO> integrazioni = new ArrayList<>();
        List<BandoForm> bandoIntegrazioniForms = bandoFormLocalService.getListaBandoFormBandoAndTipoFormAndFormIdNotIn(bandoId, tipoFormIntegrazioneEsecuzioneList, formIdsToExclude);
        List<BandoForm> bandoForms = bandoFormLocalService.getListaBandoFormBandoAndTipoFormAndFormIdNotIn(bandoId, tipoFormEsecuzioneList, formIdsToExclude);
        for(BandoForm bandoForm :bandoForms){
            Form form = formLocalService.fetchForm(bandoForm.getFormId());
            IntegrazioneDTO esecuzioneDto = mapForm(form);

            List<String> statiDaEscludere = new ArrayList<>();
            statiDaEscludere.add(StatoIntegrazioneDomandaBandoEnum.NON_VALIDATA.name());

            IstanzaDomandaBando ultima = istanzaDomandaBandoLocalService.getUltimaIstanzaDomandaBandoByDomandaBandoIdAndTipoFormAndFormIdAndStatoNotIn(domandaBandoId, bandoForm.getTipoForm(), form.getFormId(), statiDaEscludere);

            if(ultima!= null){
                if(ultima.getStato().equals(StatoIntegrazioneDomandaBandoEnum.DA_INTEGRARE.name())){
                    esecuzioneDto.setDisabilitato(true);
                    integrazioni.add(esecuzioneDto);
                    String codiceFormIntegrazione = getFormIntegrazioneEsecuzione(form, ultima);
                    long formIdIntegrazioneEsecuzione = getFormIdIntegrazione(codiceFormIntegrazione);
                    if(formIdIntegrazioneEsecuzione > 0) {
                        for (BandoForm bandoIntegrazione : bandoIntegrazioniForms) {
                            if (bandoIntegrazione.getFormId() == formIdIntegrazioneEsecuzione) {
                                Form formIntegrazioneEsecuzione = formLocalService.fetchForm(bandoIntegrazione.getFormId());
                                IntegrazioneDTO integrazioneDto = mapForm(formIntegrazioneEsecuzione);
                                integrazioni.add(integrazioneDto);
                            }
                        }
                    }
                }else if(ultima.getStato().equals(StatoIntegrazioneDomandaBandoEnum.INTEGRATA.name())
                || ultima.getStato().equals(StatoIntegrazioneDomandaBandoEnum.CONFERMATA.name())){
                    esecuzioneDto.setDisabilitato(true);
                    integrazioni.add(esecuzioneDto);
                }else{
                    integrazioni.add(esecuzioneDto);
                }
            }else{
                integrazioni.add(esecuzioneDto);
            }

        }

        // Soccorso istruttorio del disciplinare esecuzione: la fase esecuzione resta accessibile in parallelo
        // a cittadino e operatore. Se l'operatore ha richiesto la sottoscrizione del disciplinare (istanza
        // NON_VALIDATA), il relativo form di integrazione viene aggiunto in unione ai servizi di esecuzione,
        // senza nascondere gli altri modelli selezionabili.
        List<IntegrazioneDTO> sottoscrizioniDisciplinarePendenti = getSottoscrizioniDisciplinareEsecuzionePendenti(bandoId, domandaBandoId, formIdsToExclude);
        for (IntegrazioneDTO sottoscrizione : sottoscrizioniDisciplinarePendenti) {
            boolean giaPresente = integrazioni.stream().anyMatch(esistente -> sottoscrizione.getId().equals(esistente.getId()));
            if (!giaPresente) {
                integrazioni.add(sottoscrizione);
            }
        }

        // Ordinamento alfabetico locale-aware (italiano): il prefisso anno presente nel nome del form
        // (es. "2025 - ...", "2026 - ...") guida l'ordinamento mostrato in modale.
        Collator collator = Collator.getInstance(Locale.ITALY);
        integrazioni.sort(Comparator.comparing(IntegrazioneDTO::getNome, Comparator.nullsLast(collator)));

        return integrazioni;
    }

    /**
     * Recupera i form di integrazione (sottoscrizione) del disciplinare esecuzione con una richiesta pendente
     * (istanza in stato NON_VALIDATA creata dall'operatore col soccorso istruttorio). I form ottenuti vengono
     * aggiunti in unione ai servizi di esecuzione selezionabili dal cittadino, senza sospendere la fase.
     * Ritorna lista vuota se il bando non prevede il disciplinare esecuzione o se non ci sono richieste pendenti.
     */
    private List<IntegrazioneDTO> getSottoscrizioniDisciplinareEsecuzionePendenti(long bandoId, long domandaBandoId, List<Long> formIdsToExclude) {
        List<IntegrazioneDTO> pendenti = new ArrayList<>();

        List<BandoForm> bandoFormDisciplinare = bandoFormLocalService.getListaBandoFormBandoAndTipoFormAndFormIdNotIn(
                bandoId, Collections.singletonList(TipoFormEnum.INTEGRAZIONE_OPERATORE_ESECUZIONE.name()), Collections.emptyList());
        if (bandoFormDisciplinare == null || bandoFormDisciplinare.isEmpty()) {
            return pendenti;
        }

        List<String> tipiFormIntegrazioneDisciplinare = new ArrayList<>();
        tipiFormIntegrazioneDisciplinare.add(TipoFormEnum.ESECUZIONE_INTEGRAZIONE.name());
        tipiFormIntegrazioneDisciplinare.add(TipoFormEnum.ESECUZIONE_INTEGRAZIONE_DISCIPLINARE.name());

        List<BandoForm> bandoFormIntegrazione = bandoFormLocalService.getListaBandoFormBandoAndTipoFormAndFormIdNotIn(
                bandoId, tipiFormIntegrazioneDisciplinare, formIdsToExclude);
        if (bandoFormIntegrazione == null || bandoFormIntegrazione.isEmpty()) {
            return pendenti;
        }

        // Si interrogano direttamente le istanze della domanda e si cerca, per ciascun form di integrazione,
        // una richiesta ancora pendente (stato NON_VALIDATA). La lettura diretta evita l'indirezione su
        // BandoForm del finder per tipoForm, che dipende dall'associazione bando-form anziché dall'istanza.
        List<IstanzaDomandaBando> istanzeDomanda = istanzaDomandaBandoLocalService.getIstanzeDomandeBandoByDomandaBandoId(domandaBandoId);

        for (BandoForm bandoForm : bandoFormIntegrazione) {
            Form form = formLocalService.fetchForm(bandoForm.getFormId());
            if (form == null || form.isPrincipale()) {
                continue;
            }

            if (haRichiestaIntegrazionePendente(istanzeDomanda, form.getFormId())) {
                pendenti.add(mapForm(form));
            }
        }

        return pendenti;
    }

    private boolean haRichiestaIntegrazionePendente(List<IstanzaDomandaBando> istanzeDomanda, long formId) {
        return istanzeDomanda.stream()
                .filter(istanza -> istanza.getFormId() == formId)
                .anyMatch(istanza -> StatoIntegrazioneDomandaBandoEnum.NON_VALIDATA.name().equals(istanza.getStato()));
    }

