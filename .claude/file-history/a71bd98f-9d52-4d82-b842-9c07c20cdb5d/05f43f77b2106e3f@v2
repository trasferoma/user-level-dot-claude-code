    protected void doProcessAction(ActionRequest request, ActionResponse response) throws Exception {
        ThemeDisplay themeDisplay = (ThemeDisplay) request.getAttribute(WebKeys.THEME_DISPLAY);


        long domandaBandoId = ParamUtil.getLong(request, PresentatoreFormsPortletKeys.DOMANDABANDO_ID);

        MutableRenderParameters renderParameters = response.getRenderParameters();
        List<AttivitaDomandaBando> attivitaDomandaBandoList = new ArrayList<>();
        AttivitaDomandaBando attivitaDomandaBando = null;


        try {
            ServiceContext serviceContext = ServiceContextFactory.getInstance(request);
            DomandaBando domandaBando = domandaBandoLocalService.getDomandaBando(domandaBandoId);

            if (domandaBando.getUserId() != serviceContext.getUserId()) {
                throw new UserMismatchException();
            }

            if (!StatoDomandaBandoEnum.ATTESA_INTEGRAZIONI.name().equals(domandaBando.getStato()) &&
                !StatoDomandaBandoEnum.IN_LAVORAZIONE.name().equals((domandaBando.getStato())) &&
                !StatoDomandaBandoEnum.NUOVA.name().equals((domandaBando.getStato()))) {
                throw new WrongStateException();
            }

            IstanzaDomandaBandoFilters filters = new IstanzaDomandaBandoFilters();
            filters.setStatoIn(Collections.singletonList(StatoIntegrazioneDomandaBandoEnum.VALIDATA.name()));

            Bando bando = bandoLocalService.getBando(domandaBando.getBandoId());

            List<String> tipoFormList = TipoFormEnum.getTipoFormEsecuzione().stream().map(Enum::name).collect(Collectors.toList());
            if(bando.getAbilitaEsecuzioneIntegrazione()){
                tipoFormList.add(TipoFormEnum.ESECUZIONE_INTEGRAZIONE.name());
                tipoFormList.add(TipoFormEnum.ESECUZIONE_INTEGRAZIONE_DISCIPLINARE.name());
            }
            List<IstanzaDomandaBando> istanzeDomandaBando = presentatoreFormFrontendService.getIstanzeFormIntegrativiDomandaByTipoForm(domandaBandoId, tipoFormList, QueryUtil.ALL_POS, QueryUtil.ALL_POS, filters);
            if(Validator.isNotNull(istanzeDomandaBando) && !istanzeDomandaBando.isEmpty()) {
            	for (IstanzaDomandaBando istanzaDomandaBando : istanzeDomandaBando) {
                    istanzaDomandaBando.setStato(StatoIntegrazioneDomandaBandoEnum.CONFERMATA.name());
                    istanzaDomandaBando.setDataInvio(new Date());
                    istanzaDomandaBandoLocalService.updateIstanzaDomandaBando(istanzaDomandaBando);
                    Form form = formLocalService.getForm(istanzaDomandaBando.getFormId());
                    HashMap<String, String> formInformation = getFormInformation(form, istanzaDomandaBando);

                    attivitaDomandaBandoList = attivitaDomandaBandoLocalService.getAttivitaDomandaBandoByDomandaBandoId(domandaBandoId);
                    List <BandoForm> bandoFormList =  bandoFormLocalService.getBandoFormBandoAndForm(bando.getBandoId(),form.getFormId());

                    if (ListUtil.isNotNull(attivitaDomandaBandoList) && ListUtil.isNotEmpty(attivitaDomandaBandoList)) {
                        attivitaDomandaBando = attivitaDomandaBandoList.get(attivitaDomandaBandoList.size() - 1);

                        if (Validator.isNotNull(attivitaDomandaBando)) {
                            if (ListUtil.isNotNull(bandoFormList) && ListUtil.isNotEmpty(bandoFormList) && bandoFormList.size() == 1){
                                if (bandoFormList.get(0).getTipoForm().equalsIgnoreCase(TipoFormEnum.ESECUZIONE_ANTICIPO.name())){
                                    if (Validator.isNotNull(attivitaDomandaBando.getNote())) {
                                        attivitaDomandaBando.setNote(attivitaDomandaBando.getNote() + "|" + INVIO_DOMANDA_DI_ANTICIPO);
                                    } else {
                                        attivitaDomandaBando.setNote(INVIO_DOMANDA_DI_ANTICIPO);
                                    }
                                }
                                else if (bandoFormList.get(0).getTipoForm().equalsIgnoreCase(TipoFormEnum.ESECUZIONE_PRIMO_ANTICIPO.name())) {
                                    if (Validator.isNotNull(attivitaDomandaBando.getNote())) {
                                        attivitaDomandaBando.setNote(attivitaDomandaBando.getNote() + "|" + INVIO_PRIMA_DOMANDA_DI_ANTICIPO);
                                    } else {
                                        attivitaDomandaBando.setNote(INVIO_PRIMA_DOMANDA_DI_ANTICIPO);
                                    }
                                }
                                else if (bandoFormList.get(0).getTipoForm().equalsIgnoreCase(TipoFormEnum.ESECUZIONE_SECONDO_ANTICIPO.name())) {
                                    if (Validator.isNotNull(attivitaDomandaBando.getNote())) {
                                        attivitaDomandaBando.setNote(attivitaDomandaBando.getNote() + "|" + INVIO_SECONDA_DOMANDA_DI_ANTICIPO);
                                    } else {
                                        attivitaDomandaBando.setNote(INVIO_SECONDA_DOMANDA_DI_ANTICIPO);
                                    }
                                }
                                else if (bandoFormList.get(0).getTipoForm().equalsIgnoreCase(TipoFormEnum.ESECUZIONE_SALDO.name())){
                                    if (Validator.isNotNull(attivitaDomandaBando.getNote())){
                                        attivitaDomandaBando.setNote(attivitaDomandaBando.getNote() + '|' + INVIO_DOMANDA_DI_SALDO);
                                    }
                                    else{
                                        attivitaDomandaBando.setNote(INVIO_DOMANDA_DI_SALDO);
                                    }
                                }
                                else if (bandoFormList.get(0).getTipoForm().equalsIgnoreCase(TipoFormEnum.ESECUZIONE_RINUNCIA.name())){

                                    if (Validator.isNotNull(attivitaDomandaBando.getNote())) {
                                        attivitaDomandaBando.setNote(attivitaDomandaBando.getNote() + "|" + INVIO_DOMANDA_DI_RINUNCIA);
                                    } else {
                                        attivitaDomandaBando.setNote(INVIO_DOMANDA_DI_RINUNCIA);
                                    }

                                    DomandaBandoDatoAggiuntivo domandaBandoDatoAggiuntivoNew = domandaBandoDatoAggiuntivoLocalService.createDomandaBandoDatoAggiuntivo(counterLocalService.increment());
                                    domandaBandoDatoAggiuntivoNew.setChiave(DatoAggiuntivoChiave.FORM_ESECUZIONE_NON_ABILITATO.name());
                                    domandaBandoDatoAggiuntivoNew.setValore(form.getCodice());
                                    domandaBandoDatoAggiuntivoNew.setDomandaBandoId(domandaBando.getDomandaBandoId());
                                    domandaBandoDatoAggiuntivoNew.setCompanyId(domandaBando.getCompanyId());
                                    domandaBandoDatoAggiuntivoNew.setUserId(domandaBando.getUserId());
                                    domandaBandoDatoAggiuntivoNew.setUserName(domandaBando.getUserName());
                                    domandaBandoDatoAggiuntivoNew.setGroupId(domandaBando.getGroupId());
                                    domandaBandoDatoAggiuntivoLocalService.updateDomandaBandoDatoAggiuntivo(domandaBandoDatoAggiuntivoNew);

                                    DomandaBandoDatoAggiuntivo domandaBandoDatoAggiuntivoDisabilitaEsecuzione = domandaBandoDatoAggiuntivoLocalService.createDomandaBandoDatoAggiuntivo(counterLocalService.increment());
                                    domandaBandoDatoAggiuntivoDisabilitaEsecuzione.setChiave(DatoAggiuntivoChiave.DISABILITA_FORM_ESECUZIONE.name());
                                    domandaBandoDatoAggiuntivoDisabilitaEsecuzione.setValore("true");
                                    domandaBandoDatoAggiuntivoDisabilitaEsecuzione.setDomandaBandoId(domandaBando.getDomandaBandoId());
                                    domandaBandoDatoAggiuntivoDisabilitaEsecuzione.setCompanyId(domandaBando.getCompanyId());
                                    domandaBandoDatoAggiuntivoDisabilitaEsecuzione.setUserId(domandaBando.getUserId());
                                    domandaBandoDatoAggiuntivoDisabilitaEsecuzione.setUserName(domandaBando.getUserName());
                                    domandaBandoDatoAggiuntivoDisabilitaEsecuzione.setGroupId(domandaBando.getGroupId());
                                    domandaBandoDatoAggiuntivoLocalService.updateDomandaBandoDatoAggiuntivo(domandaBandoDatoAggiuntivoDisabilitaEsecuzione);
                                }
                            }
                            attivitaDomandaBandoLocalService.updateAttivitaDomandaBando(attivitaDomandaBando);
                        }
                    }

                    if(bando.getAbilitaEsecuzioneIntegrazione()){
                        String tipoFormCompilato = bandoFormList.get(0).getTipoForm();
                        boolean isEsecuzioneIntegrazione = TipoFormEnum.ESECUZIONE_INTEGRAZIONE.name().equalsIgnoreCase(tipoFormCompilato)
                                || TipoFormEnum.ESECUZIONE_INTEGRAZIONE_DISCIPLINARE.name().equalsIgnoreCase(tipoFormCompilato);
                        if (isEsecuzioneIntegrazione) {
                            updateIstanzaDaIntegrare(istanzaDomandaBando);
                        }
                    }

                    if(!formInformation.isEmpty()) {
                        for (Map.Entry<String, String> entry : formInformation.entrySet()) {
                            List<DomandaBandoDatoAggiuntivo> domandaBandoDatoAggiuntivoList = domandaBandoDatoAggiuntivoLocalService.getDomandaBandoDatoAggiuntivoByDomandaBandoIdAndChiave(Collections.singletonList(domandaBandoId), Collections.singletonList(DatoAggiuntivoChiave.FORM_ESECUZIONE_NON_ABILITATO.name()));

                            if (Validator.isNotNull(entry.getValue())) {
                                // Caso standard: e' presente un form da mostrare. Si rivela il form da mostrare
                                // (rimuovendolo dai non abilitati) e si nasconde il form attuale appena compilato.
                                if (Validator.isNotNull(domandaBandoDatoAggiuntivoList) && !domandaBandoDatoAggiuntivoList.isEmpty()) {
                                    Iterator<DomandaBandoDatoAggiuntivo> iterator = domandaBandoDatoAggiuntivoList.iterator();
                                    boolean found = false;

                                    while (iterator.hasNext() && !found) {
                                        DomandaBandoDatoAggiuntivo domandaBandoDatoAggiuntivo = iterator.next();
                                        if (domandaBandoDatoAggiuntivo.getValore().equalsIgnoreCase(entry.getValue())) {
                                            domandaBandoDatoAggiuntivoLocalService.deleteDomandaBandoDatoAggiuntivo(domandaBandoDatoAggiuntivo.getDomandaBandoDatoAggiuntivoId());
                                            creaFormEsecuzioneNonAbilitato(domandaBando, entry.getKey());
                                            found = true;
                                        }

                                    }
                                }
                            } else {
                                // Caso form attuale senza form da mostrare: si nasconde semplicemente il form
                                // compilato aggiungendolo ai non abilitati (se non gia' presente).
                                boolean giaPresente = Validator.isNotNull(domandaBandoDatoAggiuntivoList)
                                        && domandaBandoDatoAggiuntivoList.stream()
                                                .anyMatch(dato -> entry.getKey().equalsIgnoreCase(dato.getValore()));
                                if (!giaPresente) {
                                    creaFormEsecuzioneNonAbilitato(domandaBando, entry.getKey());
                                }
                            }
                        }
                    }
                    if(Validator.isNotNull(domandaBando)) {
                        String nomeEnte = presentatoreFormFrontendService.getNomeOrganizzazione(domandaBando.getGroupId());
                        AccountDto emailAccount = presentatoreFormFrontendService.getEmailAccountByBando(bando);
                        String note = "";
                        if (ListUtil.isNotNull(bandoFormList) && ListUtil.isNotEmpty(bandoFormList) && bandoFormList.size() == 1){
                            if (bandoFormList.get(0).getTipoForm().equalsIgnoreCase(TipoFormEnum.ESECUZIONE_ANTICIPO.name())
                                    || bandoFormList.get(0).getTipoForm().equalsIgnoreCase(TipoFormEnum.ESECUZIONE_PRIMO_ANTICIPO.name())
                                    || bandoFormList.get(0).getTipoForm().equalsIgnoreCase(TipoFormEnum.ESECUZIONE_SECONDO_ANTICIPO.name())){
                                note = NOTE_ATTESA_APPROVAZIONE;
                            }
                        } else {
                            log.info("Non é stato possibile individuare univocamente il form di anticipo");
                        }
                        communicationService.sendNotificaDocumentoEsecuzioneBackOffice(nomeEnte, domandaBandoId, domandaBando.getOggetto(), form.getNome(), domandaBando.getProcessInstanceId(), emailAccount, domandaBando.getRagioneSociale());
                        communicationService.sendNotificaDocumentoEsecuzioneCittadino(nomeEnte, domandaBandoId, domandaBando.getOggetto(), form.getNome(), domandaBando.getProcessInstanceId(), emailAccount, note, domandaBando.getUserId());

                    }
                }
            }



            response.sendRedirect(config.scrivaniaPath());
        } catch (UserMismatchException | WrongStateException e) {
        	auditService.saveErrorLog(request, e.getMessage());
            log.error(e);
            SessionErrors.add(request, e.getClass());
            renderParameters.setValue("mvcPath", PresentatoreFormsPortletKeys.JSP_ERROR);
        } catch (Exception e) {
        	auditService.saveErrorLog(request, e.getMessage());
            log.error(e);
            renderParameters.setValue("mvcRenderCommandName", PresentatoreFormsPortletKeys.LISTA_FORM_INTEGRATIVI_RENDER_COMMAND);
            SessionErrors.add(request, PresentatoreFormsPortletKeys.ERRORE_GENERICO);
        }
    }

    private void updateIstanzaDaIntegrare(IstanzaDomandaBando istanzaDomandaBando) {
        IstanzaDomandaBandoFilters filters = new IstanzaDomandaBandoFilters();
        filters.setStatoIn(Collections.singletonList(StatoIntegrazioneDomandaBandoEnum.DA_INTEGRARE.name()));
        List<String> tipoFormList = TipoFormEnum.getTipoFormEsecuzione().stream().map(Enum::name).collect(Collectors.toList());
        tipoFormList.add(TipoFormEnum.ESECUZIONE_INTEGRAZIONE.name());
        tipoFormList.add(TipoFormEnum.ESECUZIONE_INTEGRAZIONE_DISCIPLINARE.name());
        List<IstanzaDomandaBando> istanzeDomandaBando = presentatoreFormFrontendService.getIstanzeFormIntegrativiDomandaByTipoForm(istanzaDomandaBando.getDomandaBandoId(), tipoFormList, QueryUtil.ALL_POS, QueryUtil.ALL_POS, filters);
        for (IstanzaDomandaBando istanzaDb : istanzeDomandaBando) {
            Form formEsecuzione = formLocalService.fetchForm(istanzaDb.getFormId());
            String codiceFormIntegrazione = getFormIntegrazioneEsecuzione(formEsecuzione, istanzaDb);
            Form formIntegrazione = formLocalService.getFormByCodice(codiceFormIntegrazione);
            if(istanzaDomandaBando.getFormId() == formIntegrazione.getFormId()){
                istanzaDb.setStato(StatoIntegrazioneDomandaBandoEnum.INTEGRATA.name());
                //istanzaDb.setDataInvio(new Date());
                istanzaDomandaBandoLocalService.updateIstanzaDomandaBando(istanzaDb);
            }
        }

    }

    private String getFormIntegrazioneEsecuzione(Form form, IstanzaDomandaBando istanzaDomandaBando) {
        String response= null;
        List<FormField> listaField = new ArrayList<>();

        Set<Option> jsonPathOptions = new HashSet<Option>();
        jsonPathOptions.add(Option.SUPPRESS_EXCEPTIONS);
        jsonPathOptions.add(Option.ALWAYS_RETURN_LIST);

        Configuration jsonPathConfiguration = Configuration.builder()
                .jsonProvider(new JacksonJsonNodeJsonProvider()).mappingProvider(new JacksonMappingProvider())
                .options(jsonPathOptions).build();
        JsonObject formObject = new JsonParser().parse(istanzaDomandaBando.getJson()).getAsJsonObject();
        if (Validator.isNotNull(formObject) && formObject.has("alpaca")) {
            String jsonForm = formObject.get("alpaca").toString();
            listaField = JsonPathUtil.getFormFields(jsonForm, typesCustomFormEsecuzione);
        }
        JsonNode fieldOptions = null;

        if (Validator.isNotNull(listaField) && !listaField.isEmpty()) {
            for (FormField campo : listaField) {
                String field = campo.getPath().substring(campo.getPath().indexOf(".") + 1);
                String[] splitFields = field.split("(?<=\\])(?=\\[)");
                String jsonPathOptionsField = ALPACA_OPTIONS_FIELD + ALPACA_FIELDS_FIELD + splitFields[0] + ALPACA_FIELDS_FIELD + splitFields[1];
                fieldOptions = JsonPath.using(jsonPathConfiguration).parse(form.getJson()).read(jsonPathOptionsField);
                if (Validator.isNotNull(fieldOptions) && !fieldOptions.isEmpty()) {
                    JsonNode options = fieldOptions.get(0);
                    if (options.has("formDaMostrare")) {
                        response = options.get("formDaMostrare").asText();
                    }
                }
            }
        }
        return response;
    }

    @Activate
