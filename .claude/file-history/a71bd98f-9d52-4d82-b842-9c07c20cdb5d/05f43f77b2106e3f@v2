        config = ConfigurableUtil.createConfigurable(PresentatoreFormsConfig.class, properties);
    }

    private HashMap<String, String> getFormInformation(Form form, IstanzaDomandaBando istanzaDomandaBando) {
        HashMap<String, String> response = new HashMap<>();
        List<FormField> listaField = new ArrayList<>();

        Set<Option> jsonPathOptions = new HashSet<Option>();
        jsonPathOptions.add(Option.SUPPRESS_EXCEPTIONS);
        jsonPathOptions.add(Option.ALWAYS_RETURN_LIST);

        Configuration jsonPathConfiguration = Configuration.builder()
                .jsonProvider(new JacksonJsonNodeJsonProvider()).mappingProvider(new JacksonMappingProvider())
                .options(jsonPathOptions).build();
        JsonObject formObject = new JsonParser().parse(istanzaDomandaBando.getJson()).getAsJsonObject();
        if (Validator.isNotNull(formObject) && formObject.has("alpaca")) {
            String jsonForm = formObject.get("alpaca").toString();
            listaField = JsonPathUtil.getFormFields(jsonForm, typesCustomFormEsecuzione);
        }
        JsonNode fieldOptions = null;

        if (Validator.isNotNull(listaField) && !listaField.isEmpty()) {
            for (FormField campo : listaField) {
                String field = campo.getPath().substring(campo.getPath().indexOf(".") + 1);
                String[] splitFields = field.split("(?<=\\])(?=\\[)");
                String jsonPathOptionsField = ALPACA_OPTIONS_FIELD + ALPACA_FIELDS_FIELD + splitFields[0] + ALPACA_FIELDS_FIELD + splitFields[1];
                fieldOptions = JsonPath.using(jsonPathConfiguration).parse(form.getJson()).read(jsonPathOptionsField);
                if (Validator.isNotNull(fieldOptions) && !fieldOptions.isEmpty()) {
                    JsonNode options = fieldOptions.get(0);
                    String formAttuale = null;
                    String formDaMostrare = null;
                    if (options.has("formAttuale")) {
                        formAttuale = options.get("formAttuale").asText();
                    }

                    if (options.has("formDaMostrare")) {
                        formDaMostrare = options.get("formDaMostrare").asText();
                    }

                    // Il form attuale e' sufficiente per gestire il nascondimento del form compilato.
                    // formDaMostrare resta opzionale (puo' essere null se non esiste un form successivo da mostrare).
                    if (Validator.isNotNull(formAttuale)) {
                        response.put(formAttuale, formDaMostrare);
                    }
                }
            }
        }

        return response;
    }

