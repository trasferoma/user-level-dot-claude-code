    private AlpacaJsonStructure convert(AlpacaJsonStructure alpaca) {
        AlpacaJsonStructure converted = new AlpacaJsonStructure();
        converted.setData(asJsonObject(alpaca.getData()));
        converted.setOptions(asJsonObject(alpaca.getOptions()));
        converted.setSchema(asJsonObject(alpaca.getSchema()));
        converted.setView(asJsonObject(alpaca.getView()));
        return converted;
    }

    private JsonObject asJsonObject(Object data) {
        String json = gson.toJson(data);
        return gson.fromJson(json, JsonObject.class);
    }
