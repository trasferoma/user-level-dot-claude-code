    private void salvaIntegrazioniDati(ActionRequest actionRequest, long bandoId, ThemeDisplay themeDisplay) throws Exception {
        List<BandoIntegrazioniDati> listaChiaviValoriVecchi = bandoIntegrazioniDatiLocalService.dynamicQuery(
            bandoIntegrazioniDatiLocalService.dynamicQuery()
                .add(RestrictionsFactoryUtil.eq("bandoId", bandoId))
        );
        List<BandoIntegrazioniDati> listaChiaviValoriNuovi = estraiChiaviValore(actionRequest, bandoId, themeDisplay);

        List<BandoIntegrazioniDati> listaDaAggiornare = calcolaListaDaAggiornare(listaChiaviValoriVecchi, listaChiaviValoriNuovi);
        List<BandoIntegrazioniDati> listaDaRimuovere = calcolaListaDaRimuovere(listaChiaviValoriVecchi, listaChiaviValoriNuovi);

        for (BandoIntegrazioniDati chiaveValore : listaDaAggiornare) {
            bandoIntegrazioniDatiLocalService.updateBandoIntegrazioniDati(chiaveValore);
        }
        for (BandoIntegrazioniDati chiaveValore : listaDaRimuovere) {
            bandoIntegrazioniDatiLocalService.deleteBandoIntegrazioniDati(chiaveValore);
        }
    }

    private List<BandoIntegrazioniDati> estraiChiaviValore(ActionRequest actionRequest, long bandoId, ThemeDisplay themeDisplay) throws Exception {
        KeystoreCryptoUtilProps keystoreUtil = new KeystoreCryptoUtilProps();
        List<BandoIntegrazioniDati> listaChiaviValore = new ArrayList<>();

        long groupId = themeDisplay.getScopeGroupId();
        long userId = themeDisplay.getUserId();
        String userName = themeDisplay.getUser().getFullName();

        int contatoreServiziEsterni = ParamUtil.getInteger(actionRequest, "countServiziEsterni");
        for (int i = 1; i <= contatoreServiziEsterni; i++) {
            long idServizioEsterno = ParamUtil.getLong(actionRequest, "servizioEsternoId" + i);
            int contatoreChiavi = ParamUtil.getInteger(actionRequest, "countChiavi" + i);

            for (int j = 1; j <= contatoreChiavi; j++) {
                String chiave = ParamUtil.getString(actionRequest, "chiave_" + i + "_" + j);
                String valore = ParamUtil.getString(actionRequest, "valore_" + i + "_" + j);

                String valoreCifrato = null;
                if (Validator.isNotNull(valore)) {
                    valoreCifrato = keystoreUtil.encrypt(valore);
                }

                BandoIntegrazioniDati chiaveValore = bandoIntegrazioniDatiLocalService.createBandoIntegrazioniDati(0);
                chiaveValore.setChiave(chiave);
                chiaveValore.setValore(valoreCifrato);
                chiaveValore.setTipologiaServizioEsternoIntegrazioniId(idServizioEsterno);
                chiaveValore.setBandoId(bandoId);
                chiaveValore.setGroupId(groupId);
                chiaveValore.setUserId(userId);
                chiaveValore.setUserName(userName);
                chiaveValore.setCompanyId(themeDisplay.getCompanyId());
                chiaveValore.setCreateDate(new Date());
                chiaveValore.setModifiedDate(new Date());

                listaChiaviValore.add(chiaveValore);
            }
        }

        return listaChiaviValore;
    }

    private List<BandoIntegrazioniDati> calcolaListaDaAggiornare(List<BandoIntegrazioniDati> listaVecchi, List<BandoIntegrazioniDati> listaNuovi) {
        Map<Tuple, BandoIntegrazioniDati> mappaChiaviValore = listaVecchi.stream()
                .collect(Collectors.toMap(e -> new Tuple(e.getTipologiaServizioEsternoIntegrazioniId(), e.getChiave()), e -> e));

        List<BandoIntegrazioniDati> risultato = new ArrayList<>();
        for (BandoIntegrazioniDati cv : listaNuovi) {
            if (Validator.isNotNull(cv.getValore())) {
                BandoIntegrazioniDati cvSalvato = mappaChiaviValore.get(new Tuple(cv.getTipologiaServizioEsternoIntegrazioniId(), cv.getChiave()));

                if (Validator.isNotNull(cvSalvato)) {
                    cvSalvato.setValore(cv.getValore());
                    risultato.add(cvSalvato);
                } else {
                    long id = counterLocalService.increment(BandoIntegrazioniDati.class.getName());
                    cv.setBandoIntegrazioniDatiId(id);
                    risultato.add(cv);
                }
            }
        }
        return risultato;
    }

    private List<BandoIntegrazioniDati> calcolaListaDaRimuovere(List<BandoIntegrazioniDati> listaVecchi, List<BandoIntegrazioniDati> listaNuovi) {
        Set<Tuple> insiemeChiaviValore = new HashSet<>();
        listaNuovi.forEach(cv -> insiemeChiaviValore.add(new Tuple(cv.getTipologiaServizioEsternoIntegrazioniId(), cv.getChiave())));

        return listaVecchi.stream()
                .filter(e -> !insiemeChiaviValore.contains(new Tuple(e.getTipologiaServizioEsternoIntegrazioniId(), e.getChiave())))
                .collect(Collectors.toList());
    }
