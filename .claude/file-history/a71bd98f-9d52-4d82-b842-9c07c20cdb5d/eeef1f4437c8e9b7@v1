    private void checkCriteriValutazione(ActionRequest actionRequest) {
        int rowIndexesCriteri = ParamUtil.getInteger(actionRequest, "rowIndexesCriteri");

        for (int i = 1; i <= rowIndexesCriteri; i++) {
            List<Integer> visitati = new ArrayList<>();

            int curOrdine = ParamUtil.getInteger(actionRequest, GestioneBandiFrontendPortletKeys.ORDINE + i);
            while (true) {
                if (visitati.contains(curOrdine)) {
                    visitati.add(curOrdine);
                    String loop = visitati.stream().map(String::valueOf).collect(Collectors.joining("->"));
                    throw new CriteriLoopException("Ciclo nei criteri valutazione: " + loop);
                }

                int criterioParentOrdine = ParamUtil.getInteger(actionRequest, GestioneBandiFrontendPortletKeys.CRITERIO_SUPERIORE + curOrdine);

                if (criterioParentOrdine <= 0) {
                    break;
                }

                visitati.add(curOrdine);

                curOrdine = criterioParentOrdine;
            }
        }
    }

    private boolean validateTemplateNativo(ActionRequest actionRequest, UploadPortletRequest uploadPortletRequest, String idKey, String fileKey) throws PortalException{
        boolean valid = false;

        try{
            long        id          = ParamUtil.getLong(actionRequest, idKey);
            InputStream template    = uploadPortletRequest.getFileAsStream(fileKey);

            if(id > 0 || (id == 0 && Validator.isNotNull(template))){
                valid = true;
            }
            else{
                auditService.saveErrorLog(actionRequest, "template[" + fileKey + "] is null");
                SessionErrors.add(actionRequest, GestioneBandiFrontendPortletKeys.SESSION_ERROR_CAMPI_OBBLIGATORI);
                _log.error("GestioneBando :: salvaCrea :: template[" + fileKey + "] is null!");
                //actionResponse.getRenderParameters().setValue("jspPage", GestioneBandiFrontendPortletKeys.JSP_AGGIUNGI_MODIFICA_BANDO);
            }
        }
        catch(IOException e){
            throw new PortalException(e);
        }

        return valid;
    }

    private ValoreDatoBando getValoriDatoBando(long datoBandoId, long valoreId, String valore, long idBando, String userFullName, long userId, long siteGroupId, long companyId){
