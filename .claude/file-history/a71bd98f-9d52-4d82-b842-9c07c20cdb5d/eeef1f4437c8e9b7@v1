    private String normalizeTemplateFileName(String originalFileName, String codiceTemplate) {
        if (Validator.isNull(originalFileName) || Validator.isNull(codiceTemplate)) {
            return originalFileName;
        }

        int lastDotIndex = originalFileName.lastIndexOf('.');
        if (lastDotIndex == -1) {
            return originalFileName;
        }

        String fileNameWithoutExt = originalFileName.substring(0, lastDotIndex);
        String extension = originalFileName.substring(lastDotIndex); // includes the dot

        String suffix = "_" + codiceTemplate.toLowerCase();

        if (fileNameWithoutExt.toLowerCase().endsWith(suffix.toLowerCase())) {
            return originalFileName;
        }

        String[] possibleSuffixes = {
            "_istanza", "_richiesta_soccorso_istruttorio", "_istanza_soccorso_istruttorio",
            "_istanza_annullamento", "_disciplinare", "_prima_domanda_anticipo",
            "_seconda_domanda_anticipo", "_esito_domanda"
        };

        for (String possibleSuffix : possibleSuffixes) {
            if (fileNameWithoutExt.toLowerCase().endsWith(possibleSuffix.toLowerCase())) {
                fileNameWithoutExt = fileNameWithoutExt.substring(0, fileNameWithoutExt.length() - possibleSuffix.length());
                break;
            }
        }

        return fileNameWithoutExt + suffix + extension;
    }

