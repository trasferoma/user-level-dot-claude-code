import it.servizidigitali.scrivaniacittadino.frontend.service.ScrivaniaCittadinoMiddlewareService;

/**
 * Portlet principale della Scrivania Cittadino per la gestione dell'area personale dell'utente.
 * Fornisce una dashboard unificata con accesso a:
 * - Richieste e pratiche inviate
 * - Domande di bandi e contributi
 * - Comunicazioni e messaggi
 * - Pagamenti e dovuti attesi
 * - Prenotazioni appuntamenti
 * - Calendario scadenze
 *
 * @author pindi
 */
@Component(//
		immediate = true, //
		property = {
				"com.liferay.portlet.instanceable=true",
				"com.liferay.portlet.display-category=category.servizidigitali", //
				"com.liferay.portlet.header-portlet-css=/css/main.css", //
				"com.liferay.portlet.header-portlet-css=/libs/simple-calendar/simple-calendar.css",
				"com.liferay.portlet.header-portlet-css=/libs/jquery.datetimepicker/jquery.datetimepicker.min.css",
				"com.liferay.portlet.footer-portlet-javascript=/libs/moment/moment-with-locales.js",
				"com.liferay.portlet.footer-portlet-javascript=/libs/jquery.datetimepicker/jquery.datetimepicker.full.min.js",
				"com.liferay.portlet.footer-portlet-javascript=/libs/jquery.datetimepicker/jquery.datetimepicker-initializer.js",
				"com.liferay.portlet.footer-portlet-javascript=/libs/simple-calendar/jquery.simple-calendar.min.js",
				"javax.portlet.display-name=ScrivaniaCittadino", //
				"javax.portlet.init-param.template-path=/", //
				"javax.portlet.init-param.view-template=/view.jsp", //
				"javax.portlet.name=" + ScrivaniaCittadinoPortletKeys.SCRIVANIACITTADINO, //
				"javax.portlet.resource-bundle=content.Language", //
				"javax.portlet.security-role-ref=power-user,user", //
		}, //
		service = Portlet.class//
) //
public class ScrivaniaCittadinoPortlet extends MVCPortlet {

	private static final Log _log = LogFactoryUtil.getLog(ScrivaniaCittadinoPortlet.class);

	private ConfigurationProvider configurationProvider;

	@Reference
	protected void setConfigurationProvider(ConfigurationProvider configurationProvider) {
		this.configurationProvider = configurationProvider;
	}

	@Reference
	private ComunicazioneLocalService comunicazioneLocalService;

	@Reference
	private TipologiaComunicazioneLocalService tipologiaComunicazioneLocalService;

	@Reference
	private TipologiaLocalService tipologiaLocalService;

	@Reference
	private AuditService auditService;
	
	@Reference
	private ScrivaniaCittadinoMiddlewareService scrivaniaCittadinoMiddlewareService;

	@Override
	public void render(RenderRequest renderRequest, RenderResponse renderResponse) throws IOException, PortletException {
		
		ThemeDisplay themeDisplay = (ThemeDisplay) renderRequest.getAttribute(WebKeys.THEME_DISPLAY);

		MessageUtility messageUtility = new MessageUtility(ScrivaniaCittadinoPortletKeys.BUNDLE_SYMBOLIC_NAME, themeDisplay.getSiteDefaultLocale());

		String tabAttivaValue = ParamUtil.getString(renderRequest, ScrivaniaCittadinoPortletKeys.TAB_ATTIVA);
		List<TipologiaComunicazione> listaTipologiaComunicazione = new ArrayList<TipologiaComunicazione>();
		List<Tipologia> listaTipologiaServizi = new ArrayList<Tipologia>();
		try {
			listaTipologiaComunicazione = tipologiaComunicazioneLocalService.getTipologiaComunicaziones(QueryUtil.ALL_POS, QueryUtil.ALL_POS);
			listaTipologiaServizi = tipologiaLocalService.getTipologias(QueryUtil.ALL_POS, QueryUtil.ALL_POS);
		}
		catch (Exception e) {
			auditService.saveErrorLog(renderRequest, e.getMessage());
			_log.error("render :: " + e.getMessage(), e);
		}

		try {
			User loggedUser = themeDisplay.getUser();
			ComunicazioneFilters comunicazioneFilters = new ComunicazioneFilters();
			comunicazioneFilters.setGroupId(themeDisplay.getScopeGroupId());
			comunicazioneFilters.setCompanyId(themeDisplay.getCompanyId());
			comunicazioneFilters.setUsername(loggedUser.getScreenName());
			
			long totaleMessaggiNonletti = scrivaniaCittadinoMiddlewareService.getNumTotaleComunicazioni(loggedUser.getUserId());

			List<String> tabsValues = new ArrayList<>(
					Arrays.asList(ScrivaniaCittadinoPortletKeys.SEZIONE_APPUTAMENTI,
							ScrivaniaCittadinoPortletKeys.SEZIONE_ATTIVITA,
							ScrivaniaCittadinoPortletKeys.SEZIONE_PAGAMENTI,
							ScrivaniaCittadinoPortletKeys.SEZIONE_DOMANDE_BANDO,
							ScrivaniaCittadinoPortletKeys.SEZIONE_RICHIESTE_REFERENTE,
							ScrivaniaCittadinoPortletKeys.DETTAGLIO_MESSAGGI,
							ScrivaniaCittadinoPortletKeys.SEZIONE_SERVIZI
					));

			ServiziDigitaliCommonConfiguration serviziDigitaliConfiguration = configurationProvider.getGroupConfiguration(ServiziDigitaliCommonConfiguration.class, themeDisplay.getScopeGroupId());
			boolean bandiEnabled = serviziDigitaliConfiguration.bandiEnabled();
			boolean pagamentiEnabled = serviziDigitaliConfiguration.pagamentiEnabled();
			if (!bandiEnabled) {
				tabsValues.remove(ScrivaniaCittadinoPortletKeys.SEZIONE_DOMANDE_BANDO);
			}
			
			if (!pagamentiEnabled) {
				tabsValues.remove(ScrivaniaCittadinoPortletKeys.SEZIONE_PAGAMENTI);
			}

			/**
			 * Verifica e gestisce
			 * la presenza di servizi dinamici aggiuntivi
			 * da visualizzare sulla scrivania del cittadino.
			 */
			if(serviziDigitaliConfiguration.abilitaServiziDinamiciAggiuntivi()) {
				try {
					ObjectMapper om = new ObjectMapper();
					TypeReference<List<ServizioAggiuntivoConfig>> t = new TypeReference<List<ServizioAggiuntivoConfig>>() {};
					List<ServizioAggiuntivoConfig> serviziAggiuntivi  = om.readValue(serviziDigitaliConfiguration.serviziDinamiciAggiuntiviJson(), t);

					for (ServizioAggiuntivoConfig s : serviziAggiuntivi) {
						if(s.isAbilitato()){
							tabsValues.add(s.getLabelServizio());
						}
					}

					renderRequest.setAttribute(ScrivaniaCittadinoPortletKeys.SERVIZI_DINAMICI_AGGIUNTIVI_CONFIGS,
							serviziAggiuntivi);

				}catch (Exception e) {
					_log.error("Errori nel parsing dei tab dinamici", e);
				}
			}

			String tabsValuesCommaSeparated = String.join(",", tabsValues);

			renderRequest.setAttribute(ScrivaniaCittadinoPortletKeys.TABS_VALUES, tabsValuesCommaSeparated);
			renderRequest.setAttribute(ScrivaniaCittadinoPortletKeys.BANDI_ENABLED, bandiEnabled);
			renderRequest.setAttribute(ScrivaniaCittadinoPortletKeys.PAGAMENTI_ENABLED, pagamentiEnabled);
			renderRequest.setAttribute(ScrivaniaCittadinoPortletKeys.NUMERO_MESSAGGI_NON_LETTI, totaleMessaggiNonletti);
			renderRequest.setAttribute(ScrivaniaCittadinoPortletKeys.SERVIZI_DINAMICI_AGGIUNTIVI_ABILITATI,
					serviziDigitaliConfiguration.abilitaServiziDinamiciAggiuntivi());
		}
		catch (ConfigurationException e) {
			_log.error("render :: " + e.getMessage(), e);
		}

		renderRequest.setAttribute(ScrivaniaCittadinoPortletKeys.LISTA_TIPOLOGIA_COMUNICAZIONE, listaTipologiaComunicazione);
		renderRequest.setAttribute(ScrivaniaCittadinoPortletKeys.LISTA_STATO, Arrays.asList(StatoRichiesta.values()));
		renderRequest.setAttribute(ScrivaniaCittadinoPortletKeys.LISTA_STATO_RICHIESTA_REFERENTE, Arrays.asList(it.servizidigitali.gestione.referente.istanze.common.enumeration.StatoRichiesta.values()));
		renderRequest.setAttribute(ScrivaniaCittadinoPortletKeys.LISTA_TIPOLOGIA_RICHIESTA, listaTipologiaServizi);
		renderRequest.setAttribute(ScrivaniaCittadinoPortletKeys.TAB_ATTIVA, tabAttivaValue);

		super.render(renderRequest, renderResponse);
	}

}