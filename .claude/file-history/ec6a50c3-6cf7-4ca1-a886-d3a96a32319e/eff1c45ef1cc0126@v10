public class FdrVerificaTest {
    private static final String TOKEN_URL = "https://api-gw.regione.puglia.it/token";
    private static final String CONSUMER_KEY = "rPFxGs9ERQHEZPQS6amktR3Pclsa";
    private static final String SECRET_KEY = "537QeHdoDDtJRMNqF3flk9e4gpIa";

    private static final String RESOURCE_FILE = "/documento-non-firmato.pdf";
    // Fixture: PDF firmato nel passato con certificato valido all'epoca della firma ma scaduto a oggi.
    private static final String RESOURCE_FILE_FIRMATO_PASSATO = "/documento-firmato-nel-passato.pdf";
    private static final String FILE_MIME = "application/pdf";
    private static final String VERIFICA_URL =
            "https://api-gw.regione.puglia.it/api-fdr/1.0/verifica/sigilli?ts_date_validity=0&codice_sigillo=ANY";

    // Apposizione firma (PAdES). Valorizzare il path con getServiceApposizioneFirmaPath().
    private static final String APPOSIZIONE_URL =
            "https://api-gw.regione.puglia.it/api-fdr/1.0/firma/pades";

    // Credenziali di firma (FirmaRemotaRestEnteConfiguration). Solo per esecuzione manuale.
    private static final String SIGN_CODICE_CERTIFICATO = "test01_cert";
    private static final String SIGN_CODICE_FISCALE = "NNVTTD99A41A662K";
    private static final String SIGN_PASSWORD = "tecnopolis";
    private static final String SIGN_OTP = "";

    private static final Duration CONNECT_TIMEOUT = Duration.ofSeconds(30);
    private static final Duration REQUEST_TIMEOUT = Duration.ofSeconds(120);

    @org.junit.Test
    public void verificaDocumentoNonFirmato() throws Exception {
        HttpClient httpClient = HttpClient.newBuilder()
                .version(HttpClient.Version.HTTP_1_1)
                .connectTimeout(CONNECT_TIMEOUT)
                .build();

        String accessToken = ottieniToken(httpClient);
        assertThat(accessToken).as("access_token").isNotBlank();

        byte[] fileBytes = leggiRisorsa(RESOURCE_FILE);
        HttpResponse<String> verifica = verificaDocumento(httpClient, accessToken, fileBytes);

        System.out.println("=== VERIFICA - Status: " + verifica.statusCode() + " ===");
        System.out.println(verifica.body());

        // La risposta e arrivata e l'operazione di verifica e andata a buon fine (HTTP 200, esito OK).
        assertThat(verifica.statusCode()).as("HTTP status verifica").isEqualTo(200);
        assertThat(verifica.body()).as("body risposta verifica").isNotNull();

        String body = verifica.body().replaceAll("\\s", "");
        assertThat(body).as("esito operazione di verifica").contains("\"esito\":\"OK\"");

        // Documento NON firmato: la condizione di "firmato" non e soddisfatta -> firmato=false.
        assertThat(body).as("documento non firmato").contains("\"firmato\":false");
    }

    private String ottieniToken(HttpClient httpClient) throws Exception {
        String url = TOKEN_URL + "?grant_type=client_credentials";
        String credentials = CONSUMER_KEY + ":" + SECRET_KEY;
        String basic = Base64.getEncoder().encodeToString(credentials.getBytes(StandardCharsets.UTF_8));

        HttpRequest request = HttpRequest.newBuilder()
                .uri(new URI(url))
                .method("POST", HttpRequest.BodyPublishers.noBody())
                .header("Authorization", "Basic " + basic)
                .header("Content-Type", "application/x-www-form-urlencoded")
                .header("Accept", "application/json")
                .timeout(REQUEST_TIMEOUT)
                .build();

        HttpResponse<String> response = httpClient.send(request, HttpResponse.BodyHandlers.ofString());

        System.out.println("=== TOKEN - Status: " + response.statusCode() + " ===");

        return estraiAccessToken(response.body());
    }

    private HttpResponse<String> verificaDocumento(HttpClient httpClient, String accessToken, byte[] fileBytes)
            throws Exception {

        String boundary = "----FdrVerificaTestBoundary" + System.nanoTime();
        byte[] body = buildMultipartFilePart(boundary, fileBytes);

        HttpRequest request = HttpRequest.newBuilder()
                .uri(new URI(VERIFICA_URL))
                .method("POST", HttpRequest.BodyPublishers.ofByteArray(body))
                .header("Accept", "application/json")
                .header("Authorization", "Bearer " + accessToken)
                .header("Content-Type", "multipart/form-data; boundary=" + boundary)
                .timeout(REQUEST_TIMEOUT)
                .build();

        return httpClient.send(request, HttpResponse.BodyHandlers.ofString());
    }

    private byte[] buildMultipartFilePart(String boundary, byte[] fileBytes) throws Exception {
        String header = "--" + boundary + "\r\n"
                + "Content-Disposition: form-data; name=\"file\"; filename=\"" + RESOURCE_FILE.substring(1) + "\"\r\n"
                + "Content-Type: " + FILE_MIME + "\r\n\r\n";
        String footer = "\r\n--" + boundary + "--\r\n";

        ByteArrayOutputStream out = new ByteArrayOutputStream();
        out.write(header.getBytes(StandardCharsets.UTF_8));
        out.write(fileBytes);
        out.write(footer.getBytes(StandardCharsets.UTF_8));
        return out.toByteArray();
    }

    private byte[] leggiRisorsa(String resource) throws Exception {
        try (InputStream inputStream = getClass().getResourceAsStream(resource)) {
            if (inputStream == null) {
                throw new IllegalStateException("Risorsa di test non trovata nel classpath: " + resource);
            }
            return inputStream.readAllBytes();
        }
    }

    private String estraiAccessToken(String json) {
        if (json == null) {
            return null;
        }
        Matcher matcher = Pattern.compile("\"access_token\"\\s*:\\s*\"([^\"]+)\"").matcher(json);
        return matcher.find() ? matcher.group(1) : null;
    }

    @org.junit.Test
    public void verificaDocumentoFirmato() throws Exception {
        HttpClient httpClient = HttpClient.newBuilder()
                .version(HttpClient.Version.HTTP_1_1)
                .connectTimeout(CONNECT_TIMEOUT)
                .build();

        String accessToken = ottieniToken(httpClient);
        assertThat(accessToken).as("access_token").isNotBlank();

        // 1) Documento letto a runtime e firmato tramite l'endpoint di apposizione (logica di signWithPades).
        byte[] pdfDaFirmare = leggiRisorsa(RESOURCE_FILE);
        HttpResponse<byte[]> firma = firmaDocumento(httpClient, accessToken, pdfDaFirmare);

        System.out.println("=== FIRMA - Status: " + firma.statusCode() + " ===");
        if (firma.statusCode() != 200) {
            System.out.println(new String(firma.body(), StandardCharsets.UTF_8));
        }
        assertThat(firma.statusCode()).as("HTTP status apposizione firma").isEqualTo(200);

        byte[] pdfFirmato = firma.body();
        assertThat(pdfFirmato).as("PDF firmato").isNotNull();
        assertThat(pdfFirmato.length).as("dimensione PDF firmato").isGreaterThan(0);

        // 2) Verifica del documento appena firmato.
        HttpResponse<String> verifica = verificaDocumento(httpClient, accessToken, pdfFirmato);

        System.out.println("=== VERIFICA - Status: " + verifica.statusCode() + " ===");
        System.out.println(verifica.body());

        assertThat(verifica.statusCode()).as("HTTP status verifica").isEqualTo(200);
        String body = verifica.body().replaceAll("\\s", "");
        assertThat(body).as("esito operazione di verifica").contains("\"esito\":\"OK\"");

        assertThat(body).as("documento firmato")
                .contains("\"firmato\":true");
    }

    /**
     * Riproduce il problema segnalato dal cliente: un documento firmato nel passato, con certificato
     * valido al momento della firma ma scaduto a oggi, viene considerato NON valido perche la verifica
     * controlla la validita rispetto alla data odierna (parametro ts_date_validity=0 nell'URL).
     *
     * <p>Esito atteso (negativo): il documento risulta firmato ({@code firmato:true}) ma con firma non
     * valida ({@code firmaValida:false}).</p>
     */
    @org.junit.Test
    public void verificaDocumentoFirmatoNelPassato() throws Exception {
        HttpClient httpClient = HttpClient.newBuilder()
                .version(HttpClient.Version.HTTP_1_1)
                .connectTimeout(CONNECT_TIMEOUT)
                .build();

        String accessToken = ottieniToken(httpClient);
        assertThat(accessToken).as("access_token").isNotBlank();

        byte[] fileBytes = leggiRisorsa(RESOURCE_FILE_FIRMATO_PASSATO);
        HttpResponse<String> verifica = verificaDocumento(httpClient, accessToken, fileBytes);

        System.out.println("=== VERIFICA (firmato nel passato) - Status: " + verifica.statusCode() + " ===");
        System.out.println(verifica.body());

        assertThat(verifica.statusCode()).as("HTTP status verifica").isEqualTo(200);
        String body = verifica.body().replaceAll("\\s", "");
        assertThat(body).as("esito operazione di verifica").contains("\"esito\":\"OK\"");

        // Esito negativo atteso: documento firmato ma considerato non valido (validita verificata a oggi).
        assertThat(body).as("documento firmato")
                .contains("\"firmato\":true");
        assertThat(body).as("firma considerata non valida perche verificata a data odierna")
                .contains("\"firmaValida\":false");
    }

    private HttpResponse<byte[]> firmaDocumento(HttpClient httpClient, String accessToken, byte[] pdfBytes)
            throws Exception {

        String authJson = buildAuthJson();
        String padesParamJson = buildPadesParamJson();

        String boundary = "----FdrFirmaTestBoundary" + System.nanoTime();
        byte[] body = buildMultipartFirma(boundary, pdfBytes, authJson, padesParamJson);

        HttpRequest request = HttpRequest.newBuilder()
                .uri(new URI(APPOSIZIONE_URL))
                .method("POST", HttpRequest.BodyPublishers.ofByteArray(body))
                .header("Accept", "application/pdf")
                .header("Authorization", "Bearer " + accessToken)
                .header("Content-Type", "multipart/form-data; boundary=" + boundary)
                .timeout(REQUEST_TIMEOUT)
                .build();

        return httpClient.send(request, HttpResponse.BodyHandlers.ofByteArray());
    }

    private String buildAuthJson() {
        StringBuilder json = new StringBuilder("{");
        json.append("\"codiceFiscale\":\"").append(SIGN_CODICE_FISCALE).append("\",");
        json.append("\"codiceCertificato\":\"").append(SIGN_CODICE_CERTIFICATO).append("\",");
        json.append("\"password\":\"").append(SIGN_PASSWORD).append("\",");
        if (SIGN_OTP != null && !SIGN_OTP.isEmpty()) {
            json.append("\"otp\":\"").append(SIGN_OTP).append("\"");
        } else {
            json.append("\"otp\":null");
        }
        json.append("}");
        return json.toString();
    }

    private String buildPadesParamJson() {
        return "{\"flagVisibile\":false,\"page\":0,\"leftx\":0,\"lefty\":0,\"rightx\":0,\"righty\":0,\"padesProfile\":\"PADESBES\"}";
    }

    private byte[] buildMultipartFirma(String boundary, byte[] pdfBytes, String authJson, String padesParamJson)
            throws Exception {

        ByteArrayOutputStream out = new ByteArrayOutputStream();
        writePart(out, boundary, "file", FILE_MIME, pdfBytes);
        writePart(out, boundary, "auth", "application/json", authJson.getBytes(StandardCharsets.UTF_8));
        writePart(out, boundary, "padesParam", "application/json", padesParamJson.getBytes(StandardCharsets.UTF_8));
        out.write(("--" + boundary + "--\r\n").getBytes(StandardCharsets.UTF_8));
        return out.toByteArray();
    }

    private void writePart(ByteArrayOutputStream out, String boundary, String name, String contentType, byte[] content)
            throws Exception {

        String header = "--" + boundary + "\r\n"
                + "Content-Disposition: form-data; name=\"" + name + "\"\r\n"
                + "Content-Type: " + contentType + "\r\n\r\n";
        out.write(header.getBytes(StandardCharsets.UTF_8));
        out.write(content);
        out.write("\r\n".getBytes(StandardCharsets.UTF_8));
    }
}
