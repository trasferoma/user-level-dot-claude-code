import java.util.ArrayList;
import java.util.Collections;
import java.util.Date;
import java.util.List;
import java.util.Locale;
import java.util.stream.Collectors;

import javax.portlet.PortletException;
import javax.portlet.RenderRequest;
import javax.portlet.RenderResponse;

import org.osgi.service.component.annotations.Component;
import org.osgi.service.component.annotations.Reference;

import it.servizidigitali.common.utility.MessageUtility;
import it.servizidigitali.common.utility.OrganizationUtility;
import it.servizidigitali.gestionebandi.model.CommentoDomandaBando;
import it.servizidigitali.gestionebandi.service.CommentoDomandaBandoLocalService;
import it.servizidigitali.gestionecomunicazioni.model.Comunicazione;
import it.servizidigitali.gestionecomunicazioni.model.Messaggio;
import it.servizidigitali.gestionecomunicazioni.service.ComunicazioneLocalService;
import it.servizidigitali.gestionecomunicazioni.service.LetturaMessaggioLocalService;
import it.servizidigitali.gestionecomunicazioni.service.MessaggioLocalService;
import it.servizidigitali.scrivaniacittadino.frontend.constants.ScrivaniaCittadinoPortletKeys;
import it.servizidigitali.scrivaniacittadino.frontend.dto.ComunicazioneDto;
import it.servizidigitali.scrivaniacittadino.frontend.dto.MessaggioDTO;
import it.servizidigitali.scrivaniacittadino.frontend.enums.TipologiaComunicazione;
import it.servizidigitali.scrivaniacittadino.frontend.service.ScrivaniaCittadinoMiddlewareService;
import it.servizidigitali.scrivaniaoperatore.model.CommentoRichiesta;
import it.servizidigitali.scrivaniaoperatore.service.CommentoRichiestaLocalService;

@Component(immediate = true, service = MVCRenderCommand.class, property = {
		"javax.portlet.name=" + ScrivaniaCittadinoPortletKeys.SCRIVANIACITTADINO,
		"mvc.command.name=/render/comunicazione"
})
public class DettaglioComunicazioneRenderCommand implements MVCRenderCommand {
	
	private static final Log log = LogFactoryUtil.getLog(DettaglioComunicazioneRenderCommand.class);
	public static final String ROLE_CITTADINO = "Cittadino";
	
	public static final int MESSAGGI_MAX = 5;

	@Reference
	private ComunicazioneLocalService comunicazioneLocalService;
	
	@Reference
	private MessaggioLocalService messaggioLocalService;
	
	@Reference
	private OrganizationUtility organizationUtility;

	@Reference
	private CommentoDomandaBandoLocalService commentoDomandaBandoLocalService;

	@Reference
	private CommentoRichiestaLocalService commentoRichiestaLocalService;
	
	@Reference
	private UserLocalService userLocalService;
	
	@Reference
	private RoleLocalService roleLocalService;
	
	@Reference
	private LetturaMessaggioLocalService letturaMessaggioLocalService;
	
	@Reference
	private ScrivaniaCittadinoMiddlewareService scrivaniaCittadinoMiddlewareService;
	
	@Override
	public String render(RenderRequest renderRequest, RenderResponse renderResponse) throws PortletException {
		int cur = ParamUtil.getInteger(renderRequest, "cur", 1);
		int delta = ParamUtil.getInteger(renderRequest, "delta", 5);
		int listCur = ParamUtil.getInteger(renderRequest, ScrivaniaCittadinoPortletKeys.PARAM_LIST_CUR, 1);
		long comunicazioneId = ParamUtil.getLong(renderRequest, ScrivaniaCittadinoPortletKeys.PARAM_COMUNICAZIONE_ID);
		String tipologiaComunicazioneString = ParamUtil.getString(renderRequest, ScrivaniaCittadinoPortletKeys.PARAM_TIPOLOGIA_COMUNICAZIONE);
		TipologiaComunicazione tipologiaComunicazione = TipologiaComunicazione.getByKey(tipologiaComunicazioneString);

		ThemeDisplay themeDisplay = (ThemeDisplay) renderRequest.getAttribute(WebKeys.THEME_DISPLAY);

		int[] limits = SearchPaginationUtil.calculateStartAndEnd(cur, delta);
		int start = limits[0];
		int end = limits[1];

		ComunicazioneDto dto = getDettaglioComunicazione(comunicazioneId, 
				tipologiaComunicazione, 
				start, end, 
				themeDisplay.getCompanyId(), 
				themeDisplay.getScopeGroupId(), 
				themeDisplay.getSiteDefaultLocale(),
				themeDisplay.getUserId());

		renderRequest.setAttribute("comunicazione", dto);
		renderRequest.setAttribute(ScrivaniaCittadinoPortletKeys.PARAM_LIST_CUR, listCur);

		switch (tipologiaComunicazione){
			case COMUNICAZIONE:
				if (dto.getSubOrganizationId() > 0) {
	        		long[] organizationIds = userLocalService.getOrganizationUserIds(dto.getSubOrganizationId());
	        		letturaMessaggioLocalService.setMessaggiLetti(comunicazioneId, themeDisplay.getUserId(), organizationIds);
				} else {
					letturaMessaggioLocalService.setMessaggiLetti(comunicazioneId, themeDisplay.getUserId());
				}
				break;
			case COMMENTO_DOMANDA_BANDO:
				scrivaniaCittadinoMiddlewareService.setLetturaCommentoDomandaBando(comunicazioneId);
				break;
			case COMMENTO_RICHIESTA_SERVIZIO:
				scrivaniaCittadinoMiddlewareService.setLetturaCommentoRichiesta(comunicazioneId);
				break;
			default:
				throw new PortletException("TipologiaComunicazione non definita");
	}
		
		
		return "/comunicazione.jsp";
	}

	private ComunicazioneDto getDettaglioComunicazione(long comunicazioneId, TipologiaComunicazione tipologiaComunicazione, int start, int end, long companyId, long scoupeGroupId, Locale locale, long userId) throws PortletException {
		MessageUtility messageUtility = new MessageUtility(ScrivaniaCittadinoPortletKeys.BUNDLE_SYMBOLIC_NAME, locale);

		ComunicazioneDto dto = null;

		if(comunicazioneId > 0 && tipologiaComunicazione != null){
			try{
				switch (tipologiaComunicazione){
					case COMUNICAZIONE:
						dto = getComunicazione(comunicazioneId, start, end, companyId, scoupeGroupId, userId);
						break;
					case COMMENTO_DOMANDA_BANDO:
						dto = getCommentoDomandaBando(comunicazioneId, messageUtility);
						break;
					case COMMENTO_RICHIESTA_SERVIZIO:
						dto = getCommentoRichiesta(comunicazioneId, messageUtility);
						break;
					default:
						throw new PortletException("TipologiaComunicazione non definita");
				}

				hideBackOfficeName(dto,companyId, scoupeGroupId);

			}catch(PortalException portalException){
				throw new PortletException(portalException);
			}
		}

		return dto;
	}

	private ComunicazioneDto getComunicazione(long comunicazioneId, int start, int end, long companyId, long scoupeGroupId, long userId) throws PortletException {
		ComunicazioneDto comunicazioneDto = null;
		try {
			Comunicazione comunicazione = comunicazioneLocalService.getComunicazione(comunicazioneId);

			if(comunicazione != null){
				comunicazioneDto = mapComunicazione(comunicazione, start, end, companyId, scoupeGroupId, userId);
			}
		} catch (PortalException e) {
			throw new PortletException(e);
		}

		return comunicazioneDto;
	}

	private ComunicazioneDto getCommentoDomandaBando(long commentoId, MessageUtility messageUtility) throws PortletException {
		ComunicazioneDto commentoDto = null;

		try {
			CommentoDomandaBando commentoDomandaBando = commentoDomandaBandoLocalService.getCommentoDomandaBando(commentoId);
			if(commentoDomandaBando != null){
				commentoDto = new ComunicazioneDto();
				commentoDto.setCreateDate(commentoDomandaBando.getCreateDate());
				commentoDto.setDomandaBandoId(commentoDomandaBando.getDomandaBandoId());

				commentoDto.setTitolo(messageUtility.getMessage("titolo-comunicazione-domanda-bando", commentoDomandaBando.getDomandaBandoId()));
				MessaggioDTO messaggioDTO = new MessaggioDTO();
				messaggioDTO.setContenuto(commentoDomandaBando.getTesto());
				messaggioDTO.setUserId(commentoDomandaBando.getUserId());
				commentoDto.setMessaggi(Collections.singletonList(messaggioDTO));

				commentoDto.setTipologia(TipologiaComunicazione.COMMENTO_DOMANDA_BANDO.getKey());
			}
		} catch (PortalException e) {
			throw new PortletException(e);
		}

		return commentoDto;
	}

	private ComunicazioneDto getCommentoRichiesta(long commentoId, MessageUtility messageUtility) throws PortletException {
		ComunicazioneDto commentoDto = null;

		try {
			CommentoRichiesta commentoDomandaBando = commentoRichiestaLocalService.getCommentoRichiesta(commentoId);
			if(commentoDomandaBando != null){
				commentoDto = new ComunicazioneDto();
				commentoDto.setCreateDate(commentoDomandaBando.getCreateDate());
				commentoDto.setRichiestaId(commentoDomandaBando.getRichiestaId());

				commentoDto.setTitolo(messageUtility.getMessage("titolo-comunicazione-richiesta-servizio", commentoDomandaBando.getRichiestaId()));
				MessaggioDTO messaggioDTO = new MessaggioDTO();
				messaggioDTO.setContenuto(commentoDomandaBando.getTesto());
				messaggioDTO.setUserId(commentoDomandaBando.getUserId());
				commentoDto.setMessaggi(Collections.singletonList(messaggioDTO));

				commentoDto.setTitolo(commentoDomandaBando.getTesto());
				commentoDto.setTipologia(TipologiaComunicazione.COMMENTO_RICHIESTA_SERVIZIO.getKey());
			}
		} catch (PortalException e) {
			throw new PortletException(e);
		}

		return commentoDto;
	}

	private ComunicazioneDto mapComunicazione(Comunicazione comunicazione, int start, int end, long companyId, long scoupeGroupId, long userId) {
		List<Messaggio> messaggi = messaggioLocalService.getMessaggi(comunicazione.getComunicazioneId(), start, end);

		ComunicazioneDto dto = new ComunicazioneDto();
		dto.setId(comunicazione.getComunicazioneId());
		dto.setNumMess(messaggioLocalService.countMessaggi(comunicazione.getComunicazioneId()));
		
		List<MessaggioDTO> messaggiDto = new ArrayList<MessaggioDTO>();
		int size = 0;
		do {
			
			messaggi = messaggioLocalService.getMessaggi(comunicazione.getComunicazioneId(), start + size, end + size);
			messaggiDto.addAll(messaggi.stream()
					.filter(messaggio -> filterMessaggio(messaggio, companyId, userId))
					.map(this::mapMessaggio)
					.collect(Collectors.toList()));
			
			size = messaggiDto.size() + 1;
		}while(size < MESSAGGI_MAX && !messaggi.isEmpty());
		
		
		dto.setMessaggi(messaggiDto);
		dto.setRichiestaId(comunicazione.getRichiestaId());
		dto.setDomandaBandoId(comunicazione.getDomandaBandoId());
		dto.setTipologia(TipologiaComunicazione.COMUNICAZIONE.getKey());
		dto.setSoloLettura(comunicazione.getReply());
		
		if(companyId > 0 && scoupeGroupId > 0) {
			try {
				hideBackOfficeName(dto, companyId, scoupeGroupId);
			} catch (Exception e) {
				log.error("errore in aggiornamento nomi back office", e);
				throw new RuntimeException(e);
			}
		}
		dto.setSubOrganizationId(comunicazione.getSubOrganizationId());
		return dto;
	}

	private boolean filterMessaggio(Messaggio messaggio, long companyId, long loggedUserId) {
		long userId = messaggio.getUserId();
		
		if (userId == loggedUserId || userId == 0) {
			return true;
		}
		
		User user;
		try {
			user = userLocalService.getUser(userId);
		} catch (PortalException e) {
			throw new RuntimeException(e);
		}
		
		Role roleCittadino;
		try {
			roleCittadino = RoleLocalServiceUtil.getRole(companyId, ROLE_CITTADINO);
		} catch (PortalException e) {
			throw new RuntimeException(e);
		}
		boolean isGestore = !user.getRoles().contains(roleCittadino);
		return isGestore;
	}

	private void hideBackOfficeName(ComunicazioneDto dto, long companyId, long scoupeGroupId) throws PortalException {
		final Role roleCittadino = RoleLocalServiceUtil.getRole(companyId, ROLE_CITTADINO);
		final Organization organization = organizationUtility.getSiteOrganization(scoupeGroupId);
		dto.getMessaggi().forEach(messaggio->{
			
			User userMessaggio = null;
			try {
				userMessaggio = UserLocalServiceUtil.getUser(messaggio.getUserId());
			} catch (PortalException e) {
				userMessaggio = null;
			}
			
			if((userMessaggio == null) || (userMessaggio!=null && !userMessaggio.getRoles().contains(roleCittadino))) {
				messaggio.setUsername(organization.getName());
			}
		});
	}

	private MessaggioDTO mapMessaggio(Messaggio messaggio) {
		MessaggioDTO dto = new MessaggioDTO();
		dto.setUsername(messaggio.getUserName());
		dto.setContenuto(messaggio.getContenuto());
		dto.setUserId(messaggio.getUserId());
		dto.setData(messaggio.getCreateDate());
		return dto;
	}
	
}
