<script id="comunicazioneTpl" type="text/x-jsrender">
<div class="collapse-header" id="heading{{>id}}">
		<button class="text-decoration-none py-0" data-toggle="collapse" data-target="#collapse{{>id }}" aria-expanded="false" aria-controls="collapse{{>id }}">
			<div class="d-flex justify-content-between">
				<span class="text-uppercase">
					{{if tipologia == "COMMENTO_RICHIESTA_SERVIZIO" }}
						<liferay-ui:message key="titolo-comunicazione-richiesta-servizio" arguments="{{>richiestaId}}"/>	
					{{/if}} 

					{{if tipologia == "COMMENTO_DOMANDA_BANDO"}}
						<liferay-ui:message key="titolo-comunicazione-domanda-bando" arguments="{{>domandaBandoId}}"/>
					{{/if}}

					{{if tipologia == "COMUNICAZIONE" }}
						{{>titolo}}
					{{/if}}
							         
				</span>

                <span class="apri-collapse">Apri</span>
                <span class="chiudi-collapse" >Chiudi</span>
			</div>

                <div class="d-flex short-info" id="shortInfo{{>id }}">
                    {{if dataUltimoMessaggio}}
						<small class="mr-3"><liferay-ui:message key="data-ultimo-messaggio" />: {{localDateTime:dataUltimoMessaggio}}</small>
					{{/if}}
					
					{{if letta!=null && letta==true}}
						<small class="mr-3"><liferay-ui:message key="stato-lettura" />: <liferay-ui:message key="letta" /></small>
          		  	{{/if}}

					{{if letta!=null && letta==false}}
						<small class="mr-3"><liferay-ui:message key="stato-lettura" />: <liferay-ui:message key="non-letta" /></small>
          		  	{{/if}}
					
                </div>
		</button>
	</div>
	<div id="collapse{{>id}}" class="collapse" role="region" aria-labelledby="heading{{>id}}">	
		<div class="collapse-body py-3">
			<a class="d-none" href="{{>uriServizio ? uriServizio : "#" }}"><span class="t-primary underline"><liferay-ui:message key="vai-al-servizio"/></span></a>  
			
			<portlet:renderURL var="comunicazioneURL">
				<portlet:param name="mvcRenderCommandName" value="/render/comunicazione" />
			</portlet:renderURL>
			<a class="btn btn-outline-primary" href="${comunicazioneURL}&<portlet:namespace />comunicazioneId={{>id}}&<portlet:namespace />tipologiaComunicazione={{>tipologia}}"><liferay-ui:message key="dettaglio" /></a>
		</div>
	</div>
</script>

<script id="richiestaReferenteTpl" type="text/x-jsrender">
    <div class="collapse-header" id="heading{{>richiestaReferenteId }}">
      <button class="text-decoration-none py-0" data-toggle="collapse" data-target="#collapse{{>richiestaReferenteId }}" aria-expanded="false" aria-controls="collapse{{>richiestaReferenteId }}">
        <div class="d-flex justify-content-between">
          <span class="text-uppercase">
           <liferay-ui:message key="variazione-referente" /> - {{>dominio}}
           {{if richiestaId > 0}}
               | <liferay-ui:message key="istanza-di-riferimento" />: {{>richiestaId}}
           {{else partitaIva}}
               | <liferay-ui:message key="p-iva" />: {{>partitaIva}}
           {{/if}}
          </span>
          <span class="apri-collapse">Apri</span>
          <span class="chiudi-collapse" >Chiudi</span>
        </div>
        <div class="d-flex short-info" id="shortInfo{{>richiestaReferenteId }}">
            <small class="mr-3"><liferay-ui:message key="id-richiesta-referente" />: {{>richiestaReferenteId}}</small>
            <small class="mr-3"><liferay-ui:message key="data-inserimento" />: {{localDate:dataInvio}}</small>
            <small class="mr-3"><liferay-ui:message key="stato" />: {{>statoLabel}}</small>
            {{if nomeEnte }}
                <small><liferay-ui:message key="ente" />: {{>nomeEnte}}</small>
            {{/if}}
        </div>
      </button>
    </div>
    <div id="collapse{{>richiestaReferenteId }}" class="collapse" role="region" aria-labelledby="heading{{>richiestaReferenteId}}">
        <div class="collapse-body py-3">
               <a class="btn btn-outline-primary" href="${dettaglioRichiestaReferenteURL}&<portlet:namespace/>richiestaReferenteId={{>richiestaReferenteId}}">
                <liferay-ui:message key="dettaglio" />
            </a>
            <a class="btn btn-outline-primary" href="#" style='display: none !important;'>
                <liferay-ui:message key="vai-al-servizio" />
            </a>
          </div>
    </div>
</script>

<script type="text/javascript">

	$( document ).ready(function() {
		//registro template
	 	$.templates("accordion", {
				markup: "#accordionTpl",
				templates: {
					richiesta: "#richiestaTpl",
	 				pagamento: "#pagamentoTpl",
	 				comunicazione: "#comunicazioneTpl",
	 				domandaBando : "#domandaBandoTpl",
	 				richiestaReferente: "#richiestaReferenteTpl"
				},
			}
		);
		
	 	$.templates({
	 		alert: "#alertTpl"
	 	}); 
		
	 	$.templates({
	 		serviziPiuUtilizzati: "#serviziPiuUtilizzatiTpl"
	 	}); 
	
		$.views.converters(
			{
				localDate: function(date){
					const options = { year: 'numeric', month: 'numeric', day: 'numeric'};
					var date = new Date(date);
					var formatted = date.toLocaleDateString(navigator.language, options);
					return formatted;			
				},
				localDateTime: function(date) {
					var date = new Date(date);
	                return moment(date).format("DD/MM/YYYY HH:mm");
				}
			}
		);
		
		document.dispatchEvent(new CustomEvent("scrivaniaCittadinoTemplateLoaded"));
	});
</script>