@Component(property = "model.class.name=it.servizidigitali.gestionecomunicazioni.model.Comunicazione", service = AopService.class)
public class ComunicazioneLocalServiceImpl extends ComunicazioneLocalServiceBaseImpl {

	@Reference
	private MessaggioLocalService messaggioLocalService;

	@Override
	public Comunicazione addComunicazione(ServiceContext serviceContext, String titolo, 
			String messaggio, Date dataInizio, Date dataFine, boolean interna,
			Dominio dominio, String itemId, 
			long tipologiaId, long subOrganizationId, boolean reply
	) throws PortalException {
		if (titolo == null || titolo.isBlank()) {
			throw new ComunicazioneTitoloException();
		}

		if (messaggio == null || messaggio.isEmpty()) {
			throw new ComunicazioneMessaggioException();
		}

		if (subOrganizationId == 0) {
			throw new ComunicazioneOrganizzazioneException();
		}

		if (dataInizio != null && dataFine != null) {
			if (dataFine.before(dataInizio)) {
				throw new ComunicazioneDataFineException();
			}
		}
		
		User user = userLocalService.getUser(serviceContext.getUserId());

		Comunicazione model = comunicazionePersistence.create(counterLocalService.increment());
		
		if (Dominio.SERVIZIO.equals(dominio)) {
			model.setCodiceServizio(itemId);
			model.setBandoId(0);
		} else {
			model.setCodiceServizio(null);
			model.setBandoId(Long.parseLong(itemId));
		}
		
		model.setGroupId(serviceContext.getScopeGroupId());
		model.setCompanyId(serviceContext.getCompanyId());
		model.setUserId(serviceContext.getUserId());
		model.setUserName(user.getFullName());
		model.setOrganizationId(serviceContext.getScopeGroup().getOrganizationId());
		model.setTitolo(titolo.trim());
		model.setDataInizio(dataInizio);
		model.setDataFine(dataFine);
		model.setTipologiaComunicazioneId(tipologiaId);
		model.setDestinatarioOrganizationId(serviceContext.getScopeGroup().getOrganizationId());
		model.setSubOrganizationId(subOrganizationId);
		model.setInterna(interna);
		model.setReply(reply);
		
		Comunicazione comunicazioneCreated = comunicazionePersistence.update(model);

		messaggioLocalService.aggiungiMessaggio(serviceContext, comunicazioneCreated.getComunicazioneId(), messaggio);

		return comunicazioneCreated;
	}

	@Override
	public List<Comunicazione> searchComunicazioni(ComunicazioneFilters filters, int cur, int delta) {
		int[] limit = SearchPaginationUtil.calculateStartAndEnd(cur, delta);
		int start = limit[0];
		int end = limit[1];

		return comunicazioneFinder.findByFilters(filters, start, end);
	}

	@Override
	public List<Comunicazione> searchComunicazioni(ComunicazioneFilters filters) {
		return comunicazioneFinder.findByFilters(filters, QueryUtil.ALL_POS, QueryUtil.ALL_POS);
	}

	@Override
	public int countComunicazioni(ComunicazioneFilters filters) {
		return comunicazioneFinder.countByFilters(filters);
	}

	@Override
	public List<Comunicazione> getNonInviate() {
		return comunicazioneFinder.findNotInviateAndNotInterna();
	}

	@Override
	public List<Comunicazione> getByRichiestaId(long richiestaId, int start, int end, OrderByComparator<Comunicazione> orderByComparator){
		return comunicazioneFinder.findByRichiestaId(richiestaId, start, end, orderByComparator);
	}

	@Override
	public List<Comunicazione> getByDomandaBandoId(long domandaBandoId, int start, int end, OrderByComparator<Comunicazione> orderByComparator){
		return comunicazioneFinder.findByDomandaBandoId(domandaBandoId, start, end, orderByComparator);
	}

	@Override
	public int countByRichiestaId(long richiestaId){
		return comunicazioneFinder.countByRichiestaId(richiestaId);
	}

	@Override
	public int countByDomandaBandoId(long domandaBandoId){
		return comunicazioneFinder.countByDomandaBandoId(domandaBandoId);
	}
	
	@Override
	public List<Comunicazione> findComunicazioniNonLetteByUserId(Long userId) {
		return comunicazioneFinder.findComunicazioniNonLetteByUserId(userId);
	}
	
	@Override
	public List<Comunicazione> findComunicazioniNonLetteByUserIdAndSubOrgIds(Long userId, long[] userIds) {
		return comunicazioneFinder.findComunicazioniNonLetteByUserIdAndSubOrgIds(userId, userIds);
	}

	@Override
	public long countComunicazioniNonLetteByUserId(long userId) {
		return  comunicazioneFinder.countComunicazioniNonLetteByUserId(userId);
	}

	@Override
	public long countComunicazioniNonLetteByUserId(long userId, long groupId, long companyId) {
		return comunicazioneFinder.countComunicazioniNonLetteByUserId(userId, groupId, companyId);
	}

    @Override
    public List<Comunicazione> getByRichiestaReferenteIstanzaId(long richiestaReferenteId, int start, int end, OrderByComparator<Comunicazione> orderByComparator){
        return comunicazioneFinder.findByRichiestaReferenteIstanzaId(richiestaReferenteId, start, end, orderByComparator);
    }

    @Override
    public int countByRichiestaReferenteIstanzaId(long richiestaReferenteId){
        return comunicazioneFinder.countByRichiestaReferenteIstanzaId(richiestaReferenteId);
    }
