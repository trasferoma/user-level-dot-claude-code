<%@ include file="init.jsp" %>

<portlet:renderURL var="indietroURL">
	<portlet:param name="<%=ScrivaniaCittadinoPortletKeys.TAB_ATTIVA %>" value="<%=ScrivaniaCittadinoPortletKeys.DETTAGLIO_MESSAGGI %>" />
	<portlet:param name="<%=ScrivaniaCittadinoPortletKeys.PARAM_LIST_CUR %>" value="${listCur}" />
</portlet:renderURL>

<section class="scrivania-cittadino-frontend">
    <liferay-portlet:renderURL varImpl="iteratorURL">
        <portlet:param name="mvcRenderCommandName" value="/render/comunicazione" />
        <portlet:param name="comunicazioneId" value="${comunicazione.id}" />
        <portlet:param name="tipologiaComunicazione" value="${comunicazione.tipologia}" />
    </liferay-portlet:renderURL>

    <liferay-ui:search-container total="${comunicazione.numMess}"
                                 iteratorURL="${iteratorURL}"
                                 delta="5">
        <liferay-ui:search-container-results results="${comunicazione.messaggi}" />

        <liferay-ui:search-container-row modelVar="messaggio" className="it.servizidigitali.scrivaniacittadino.frontend.dto.ComunicazioneDto">
        	<div class="container">
				<c:choose>
				    <c:when test="${(not empty user) && (user.userId == messaggio.userId)}">
	  					<c:set var="rightAlign" value="justify-content-end" />
				    </c:when>    
				    <c:otherwise>
				    	<c:set var="rightAlign" value="" />
				    </c:otherwise>
				</c:choose>

  				<div class="row ${rightAlign}">
  					<div class="col-6">
			            <div class="card">
			                <div class="card-header bg-primary text-white">
			                    <fmt:formatDate value="${messaggio.data}" pattern="dd/MM/yyyy HH:mm" var="messaggioData" />
			                    <span>
			                        <c:out value="${messaggio.username}" />
			                        <small class="float-right">${messaggioData}</small>
			                    </span>
			                </div>
			                <div class="card-body">
			                    ${messaggio.contenuto}
			                </div>
			            </div>
  					</div>
  				</div>
  			</div>
        </liferay-ui:search-container-row>

        <liferay-ui:search-iterator />
    </liferay-ui:search-container>
	
	<c:if test="${(comunicazione.richiestaId==0) && (comunicazione.domandaBandoId==0) && (!comunicazione.soloLettura)}">
		<div class="row">
			<div class="col">
				<portlet:actionURL var="commentaURL" name="/action/aggiungiMessaggio">
				</portlet:actionURL>
			
				<legend><liferay-ui:message key="rispondi" /></legend>
					
				<aui:form action="${commentaURL}">
					<aui:input type="hidden" name="comunicazioneId" value="${comunicazione.id}" />
					<aui:input type="hidden" name="tipologia" value="${comunicazione.tipologia}" />
					
					<liferay-editor:editor name="contenuto"
		                                   placeholder="messaggio"
		                                   editorName="ckeditor" />
		
					<aui:button cssClass="float-right mt-2" type="submit" value="invia"></aui:button>
				</aui:form>
			</div>
		</div>
	</c:if>

	<div class="row mt-3">
		<div class="col">
			<a href="${indietroURL}" class="btn btn-secondary scrivania-cittadino-button-indietro"><liferay-ui:message key="indietro" /></a>
		</div>
	</div>
</section>
