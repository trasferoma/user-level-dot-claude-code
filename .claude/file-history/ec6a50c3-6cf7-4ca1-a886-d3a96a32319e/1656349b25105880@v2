         Criterion criterion = PropertyFactoryUtil.forName("comunicazioneId").in(destinatarioComunicazioneQuery);
         dynamicQuery.add(criterion);
      }

      if (Validator.isNotNull(filters.getOrganizzazioniIDs()) && !filters.getOrganizzazioniIDs().isEmpty()) {
         Criterion criterion = PropertyFactoryUtil.forName("subOrganizationId").in(filters.getOrganizzazioniIDs());
         dynamicQuery.add(criterion);
      }
      
      
      if (filters.getStato() != null) {
    	
    	DynamicQuery letturaQuery = LetturaMessaggioLocalServiceUtil.dynamicQuery();
		letturaQuery.add(RestrictionsFactoryUtil.eq("primaryKey.userId", filters.getUserId()));
		letturaQuery.add(RestrictionsFactoryUtil.isNotNull("dataLettura"));
		letturaQuery.setProjection(ProjectionFactoryUtil.property("primaryKey.messaggioId"));
			
			
			
		DynamicQuery messaggioQuery = MessaggioLocalServiceUtil.dynamicQuery();
		//where messaggioId not in
		Criterion letturaCriterion = PropertyFactoryUtil.forName("messaggioId").in(letturaQuery);
		messaggioQuery.add(RestrictionsFactoryUtil.not(letturaCriterion));
		//select comunicazioneId
		ProjectionList projectionList = ProjectionFactoryUtil.projectionList();
		projectionList.add(ProjectionFactoryUtil.groupProperty("comunicazioneId"));
