package it.servizidigitali.common.fdr.client.api.impl;

import static org.assertj.core.api.Assertions.assertThat;

import java.io.ByteArrayOutputStream;
import java.io.InputStream;
import java.net.URI;
import java.net.http.HttpClient;
import java.net.http.HttpRequest;
import java.net.http.HttpResponse;
import java.nio.charset.StandardCharsets;
import java.time.Duration;
import java.util.Base64;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

public class FdrVerificaTest {
    private static final String TOKEN_URL = "https://api-gw.regione.puglia.it/token";
    private static final String CONSUMER_KEY = "rPFxGs9ERQHEZPQS6amktR3Pclsa";
    private static final String SECRET_KEY = "537QeHdoDDtJRMNqF3flk9e4gpIa";

    private static final String RESOURCE_FILE = "/documento-non-firmato.pdf";
    private static final String FILE_MIME = "application/pdf";
    private static final String VERIFICA_URL =
            "https://api-gw.regione.puglia.it/api-fdr/1.0/verifica/sigilli?ts_date_validity=0&codice_sigillo=ANY";

    private static final Duration CONNECT_TIMEOUT = Duration.ofSeconds(30);
    private static final Duration REQUEST_TIMEOUT = Duration.ofSeconds(120);

    @org.junit.Test
    public void verificaDocumentoNonFirmato() throws Exception {
        HttpClient httpClient = HttpClient.newBuilder()
                .version(HttpClient.Version.HTTP_1_1)
                .connectTimeout(CONNECT_TIMEOUT)
                .build();

        String accessToken = ottieniToken(httpClient);
        assertThat(accessToken).as("access_token").isNotBlank();

        byte[] fileBytes = leggiRisorsa(RESOURCE_FILE);
        HttpResponse<String> verifica = verificaDocumento(httpClient, accessToken, fileBytes);

        System.out.println("=== VERIFICA - Status: " + verifica.statusCode() + " ===");
        System.out.println(verifica.body());

        // La risposta e arrivata e l'operazione di verifica e andata a buon fine (HTTP 200, esito OK).
        assertThat(verifica.statusCode()).as("HTTP status verifica").isEqualTo(200);
        assertThat(verifica.body()).as("body risposta verifica").isNotNull();

        String body = verifica.body().replaceAll("\\s", "");
        assertThat(body).as("esito operazione di verifica").contains("\"esito\":\"OK\"");

        // Esito atteso "di fallimento" per un PDF non firmato: nessuna firma, nessun sigillo qualificato.
        assertThat(body).as("documento non firmato")
                .contains("\"firmato\":false")
                .contains("\"sigilloQualificato\":false")
                .contains("\"numeroFirme\":0");
    }

    private String ottieniToken(HttpClient httpClient) throws Exception {
        String url = TOKEN_URL + "?grant_type=client_credentials";
        String credentials = CONSUMER_KEY + ":" + SECRET_KEY;
        String basic = Base64.getEncoder().encodeToString(credentials.getBytes(StandardCharsets.UTF_8));

        HttpRequest request = HttpRequest.newBuilder()
                .uri(new URI(url))
                .method("POST", HttpRequest.BodyPublishers.noBody())
                .header("Authorization", "Basic " + basic)
                .header("Content-Type", "application/x-www-form-urlencoded")
                .header("Accept", "application/json")
                .timeout(REQUEST_TIMEOUT)
                .build();

        HttpResponse<String> response = httpClient.send(request, HttpResponse.BodyHandlers.ofString());

        System.out.println("=== TOKEN - Status: " + response.statusCode() + " ===");

        return estraiAccessToken(response.body());
    }

    private HttpResponse<String> verificaDocumento(HttpClient httpClient, String accessToken, byte[] fileBytes)
            throws Exception {

        String boundary = "----FdrVerificaTestBoundary" + System.nanoTime();
        byte[] body = buildMultipartFilePart(boundary, fileBytes);

        HttpRequest request = HttpRequest.newBuilder()
                .uri(new URI(VERIFICA_URL))
                .method("POST", HttpRequest.BodyPublishers.ofByteArray(body))
                .header("Accept", "application/json")
                .header("Authorization", "Bearer " + accessToken)
                .header("Content-Type", "multipart/form-data; boundary=" + boundary)
                .timeout(REQUEST_TIMEOUT)
                .build();

        return httpClient.send(request, HttpResponse.BodyHandlers.ofString());
    }

    private byte[] buildMultipartFilePart(String boundary, byte[] fileBytes) throws Exception {
        String header = "--" + boundary + "\r\n"
                + "Content-Disposition: form-data; name=\"file\"; filename=\"" + RESOURCE_FILE.substring(1) + "\"\r\n"
                + "Content-Type: " + FILE_MIME + "\r\n\r\n";
        String footer = "\r\n--" + boundary + "--\r\n";

        ByteArrayOutputStream out = new ByteArrayOutputStream();
        out.write(header.getBytes(StandardCharsets.UTF_8));
        out.write(fileBytes);
        out.write(footer.getBytes(StandardCharsets.UTF_8));
        return out.toByteArray();
    }

    private byte[] leggiRisorsa(String resource) throws Exception {
        try (InputStream inputStream = getClass().getResourceAsStream(resource)) {
            if (inputStream == null) {
                throw new IllegalStateException("Risorsa di test non trovata nel classpath: " + resource);
            }
            return inputStream.readAllBytes();
        }
    }

    private String estraiAccessToken(String json) {
        if (json == null) {
            return null;
        }
        Matcher matcher = Pattern.compile("\"access_token\"\\s*:\\s*\"([^\"]+)\"").matcher(json);
        return matcher.find() ? matcher.group(1) : null;
    }
}
