package it.servizidigitali.gestionebandi.service.impl;

import com.liferay.portal.aop.AopService;

import com.liferay.portal.kernel.exception.PortalException;
import com.liferay.portal.kernel.model.User;
import com.liferay.portal.kernel.service.ServiceContext;

import it.servizidigitali.gestionebandi.exception.NoSuchCommentoDomandaBandoException;
import it.servizidigitali.gestionebandi.model.CommentoDomandaBando;
import it.servizidigitali.gestionebandi.service.base.CommentoDomandaBandoLocalServiceBaseImpl;

import org.osgi.service.component.annotations.Component;

import java.util.Date;
import java.util.List;

/**
 * @author Brian Wing Shun Chan
 */
@Component(
	property = "model.class.name=it.servizidigitali.gestionebandi.model.CommentoDomandaBando",
	service = AopService.class
)
public class CommentoDomandaBandoLocalServiceImpl
	extends CommentoDomandaBandoLocalServiceBaseImpl {

	@Override
	public List<CommentoDomandaBando> getCommentiDomandaBandoByDomandaBandoIdVisibile(long domandaBandoId, boolean visibile, int start, int end){
		return commentoDomandaBandoPersistence.findByDomandaBandoIdAndVisibile(domandaBandoId, visibile, start, end);
	}

	@Override
	public int countCommentiDomandaBandoByDomandaBandoIdVisibile(long domandaBandoId, boolean visibile) {
		return commentoDomandaBandoPersistence.countByDomandaBandoIdAndVisibile(domandaBandoId, visibile);
	}

	@Override
	public CommentoDomandaBando addCommento(ServiceContext serviceContext, long domandaBandoId, boolean visibile,
											String testo, String taskId) {
		return addCommento(serviceContext, domandaBandoId, visibile, null, testo, taskId);
	}

	@Override
	public CommentoDomandaBando addCommento(ServiceContext serviceContext, long domandaBandoId, boolean visibile,
											String oggetto, String testo, String taskId) {
		User user;
		try {
			user = userLocalService.getUser(serviceContext.getUserId());
		} catch (PortalException e) {
			throw new RuntimeException(e);
		}

		long id = counterLocalService.increment(CommentoDomandaBando.class.getName());
		CommentoDomandaBando commento = commentoDomandaBandoPersistence.create(id);
		commento.setGroupId(serviceContext.getScopeGroupId());
		commento.setCompanyId(serviceContext.getCompanyId());
		commento.setUserId(serviceContext.getUserId());
		commento.setUserName(user.getFullName());
		commento.setCreateDate(new Date());
		commento.setModifiedDate(new Date());
		commento.setOggetto(oggetto);
		commento.setTesto(testo);
		commento.setTaskId(taskId);
		commento.setVisibile(visibile);
		commento.setDomandaBandoId(domandaBandoId);
		return commentoDomandaBandoPersistence.update(commento);
	}

	@Override
	public List<CommentoDomandaBando> listCommenti(long domandaBandoId, int start, int end) {
		return commentoDomandaBandoPersistence.findByDomandaBandoId(domandaBandoId, start, end);
	}

	@Override
	public int countCommenti(long domandaBandoId) {
		return commentoDomandaBandoPersistence.countByDomandaBandoId(domandaBandoId);
	}
	
	@Override
	public List<CommentoDomandaBando> findCommentiByCodiceFiscaleAndVisibileAndCompanyId(String codiceFiscale, long companyId){
		return commentoDomandaBandoFinder.findCommentiByCodiceFiscaleAndVisibileAndCompanyId(codiceFiscale, companyId);
	}

	@Override
	public long countCommentiNonLettiByCodiceFiscaleAndCompanyId(String codiceFiscale, long companyId){
		return commentoDomandaBandoFinder.countCommentiNonLettiByCodiceFiscaleAndCompanyId(codiceFiscale, companyId);
	}
	
	@Override
	public CommentoDomandaBando getCommentoByCommentoDomandaBandoId(long commentoDomandaBandoId) throws NoSuchCommentoDomandaBandoException {
		return commentoDomandaBandoPersistence.findByPrimaryKey(commentoDomandaBandoId);
	}

	@Override
	public boolean hasCommentiNonLetti(Long praticaId, Long userId) {
		return commentoDomandaBandoFinder.countCommentiNonLettiByDomandaBandoIdAndUserId(praticaId, userId)
				> 0;
	}

	@Override
	public List<Long> getCommentIdsNonLettiByDomandaBandoIdAndUserId(long domandaBandoId, long userId) {
		return commentoDomandaBandoFinder.findCommentIdsNonLettiByDomandaBandoIdAndUserId(domandaBandoId, userId);
	}
}