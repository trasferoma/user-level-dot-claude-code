package it.servizidigitali.scrivaniaoperatore.service.persistence.impl;

import java.util.List;

import org.osgi.service.component.annotations.Component;

import com.liferay.portal.kernel.dao.orm.DynamicQuery;
import com.liferay.portal.kernel.dao.orm.DynamicQueryFactoryUtil;
import com.liferay.portal.kernel.dao.orm.PropertyFactoryUtil;
import com.liferay.portal.kernel.dao.orm.RestrictionsFactoryUtil;
import com.liferay.portal.kernel.util.Validator;

import it.servizidigitali.scrivaniaoperatore.model.CommentoRichiesta;
import it.servizidigitali.scrivaniaoperatore.service.CommentoRichiestaLocalServiceUtil;
import it.servizidigitali.scrivaniaoperatore.service.LetturaCommentoRichiestaLocalServiceUtil;
import it.servizidigitali.scrivaniaoperatore.service.RichiestaLocalServiceUtil;
import it.servizidigitali.scrivaniaoperatore.service.persistence.CommentoRichiestaFinder;

@Component(service = CommentoRichiestaFinder.class)
public class CommentoRichiestaFinderImpl extends CommentoRichiestaFinderBaseImpl implements CommentoRichiestaFinder {

    @Override
    public List<CommentoRichiesta> findCommentiByCodiceFiscaleAndVisibileAndCompanyId(String codiceFiscale, long companyId) {

        ClassLoader classLoader = getClass().getClassLoader();

        DynamicQuery dynamicQuery = DynamicQueryFactoryUtil.forClass(CommentoRichiesta.class, classLoader);

        if (Validator.isNotNull(codiceFiscale)) {
            DynamicQuery richiestaDynamicQuery = RichiestaLocalServiceUtil.dynamicQuery();
            richiestaDynamicQuery.add(RestrictionsFactoryUtil.eq("codiceFiscale", codiceFiscale));
            richiestaDynamicQuery.setProjection(PropertyFactoryUtil.forName("richiestaId"));
            dynamicQuery.add(PropertyFactoryUtil.forName("richiestaId").in(richiestaDynamicQuery));
            dynamicQuery.add(PropertyFactoryUtil.forName("visibile").eq(true));

            if (companyId > 0) {
                dynamicQuery.add(PropertyFactoryUtil.forName("companyId").eq(companyId));
            }

        }

        return commentoRichiestaPersistence.findWithDynamicQuery(dynamicQuery);

    }

    @Override
    public List<CommentoRichiesta> findCommentiByCodiceFiscaleAndCompanyIdAndRichiestaId(String codiceFiscale, long companyId, long richiestaId) {

        ClassLoader classLoader = getClass().getClassLoader();

        DynamicQuery dynamicQuery = DynamicQueryFactoryUtil.forClass(CommentoRichiesta.class, classLoader);

        if (richiestaId > 0) {
            dynamicQuery.add(PropertyFactoryUtil.forName("richiestaId").eq(richiestaId));
            dynamicQuery.add(PropertyFactoryUtil.forName("visibile").eq(true));
        } else {
            DynamicQuery richiestaDynamicQuery = RichiestaLocalServiceUtil.dynamicQuery();
            richiestaDynamicQuery.add(RestrictionsFactoryUtil.eq("codiceFiscale", codiceFiscale));
            richiestaDynamicQuery.setProjection(PropertyFactoryUtil.forName("richiestaId"));
            dynamicQuery.add(PropertyFactoryUtil.forName("richiestaId").in(richiestaDynamicQuery));
            dynamicQuery.add(PropertyFactoryUtil.forName("visibile").eq(true));
        }

        if (companyId > 0) {
            dynamicQuery.add(PropertyFactoryUtil.forName("companyId").eq(companyId));
        }
        return commentoRichiestaPersistence.findWithDynamicQuery(dynamicQuery);

    }

    @Override
    public long countCommentiNonLettiByRichiestaIdAndUserId(long praticaId, long userId) {
        DynamicQuery commentiQuery = createCommentiNonLettiDynamicQuery(praticaId, userId);

        return commentoRichiestaPersistence.countWithDynamicQuery(commentiQuery);
    }

    @Override
    public List<Long> findCommentIdsNonLettiByRichiestaIdAndUserId(long praticaId, long userId) {
        DynamicQuery commentiQuery = createCommentiNonLettiDynamicQuery(praticaId, userId);

        commentiQuery.setProjection(PropertyFactoryUtil.forName("commentoRichiestaId"));

        return commentoRichiestaPersistence.findWithDynamicQuery(commentiQuery);
    }

    private DynamicQuery createCommentiNonLettiDynamicQuery(long praticaId, long userId) {
        DynamicQuery lettureSubQuery = LetturaCommentoRichiestaLocalServiceUtil.dynamicQuery();

        lettureSubQuery.add(
                RestrictionsFactoryUtil.eq("primaryKey.userId", userId));
        lettureSubQuery.setProjection(
                PropertyFactoryUtil.forName("primaryKey.commentoRichiestaId"));

        DynamicQuery commentiQuery = CommentoRichiestaLocalServiceUtil.dynamicQuery();

        commentiQuery.add(
                RestrictionsFactoryUtil.eq("richiestaId", praticaId));
        commentiQuery.add(
                RestrictionsFactoryUtil.ne("userId", userId));
        commentiQuery.add(
                PropertyFactoryUtil.forName("commentoRichiestaId")
                        .notIn(lettureSubQuery));

        return commentiQuery;
    }
}
