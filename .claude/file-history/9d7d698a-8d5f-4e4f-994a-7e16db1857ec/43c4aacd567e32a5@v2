package org.example.negoziale;

import com.fasterxml.jackson.databind.ObjectMapper;
import com.fasterxml.jackson.databind.node.ObjectNode;
import net.sf.jasperreports.engine.JasperCompileManager;
import net.sf.jasperreports.engine.JasperFillManager;
import net.sf.jasperreports.engine.JasperPrint;
import net.sf.jasperreports.engine.JasperReport;
import net.sf.jasperreports.engine.data.JsonDataSource;
import net.sf.jasperreports.engine.export.JRPdfExporter;
import net.sf.jasperreports.export.SimpleExporterInput;
import net.sf.jasperreports.export.SimpleOutputStreamExporterOutput;

import java.io.ByteArrayInputStream;
import java.io.InputStream;
import java.io.OutputStream;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.util.HashMap;
import java.util.Map;

import static org.junit.Assert.assertTrue;

import org.junit.BeforeClass;
import org.junit.Test;


public class GeneratorePdfNegozialeTest {
    /**
     * Genera il PDF del Disciplinare Esecuzione Negoziale a partire dal jrxml di test,
     * popolando i valori dinamici (le voci evidenziate nel modello) con dati di prova.
     */
    private static final String MAIN_REPORT = "/negoziale/disciplinare_esecuzione.jrxml";

    private static final String OUTPUT_DIR = "target/pdf";
    private static final String OUTPUT_FILE = "disciplinare_esecuzione_test.pdf";

    private static final String PARAM_NOME_COGNOME_UTENTE = "nomeCognomeUtente";
    private static final String NOME_COGNOME_UTENTE = "Mario Rossi";

    @BeforeClass
    public static void setUpEnvironment() {
        System.setProperty("java.awt.headless", "true");
    }

    @Test
    public void generaPdfDisciplinareEsecuzione() throws Exception {
        ObjectMapper mapper = new ObjectMapper();
        ObjectNode data = buildData(mapper);

        generaPdf(mapper, data, OUTPUT_FILE);
    }

    private void generaPdf(ObjectMapper mapper, ObjectNode data, String outputFileName) throws Exception {
        JasperReport mainReport = compile(MAIN_REPORT);

        byte[] jsonBytes = mapper.writeValueAsBytes(data);
        JsonDataSource dataSource = new JsonDataSource(new ByteArrayInputStream(jsonBytes));

        Map<String, Object> parameters = new HashMap<>();
        parameters.put(PARAM_NOME_COGNOME_UTENTE, NOME_COGNOME_UTENTE);

        JasperPrint jasperPrint = JasperFillManager.fillReport(mainReport, parameters, dataSource);

        Path outputPath = writePdf(jasperPrint, outputFileName);

        assertTrue("Il PDF generato non esiste: " + outputPath, Files.exists(outputPath));
        assertTrue("Il PDF generato è vuoto: " + outputPath, Files.size(outputPath) > 0);
    }

    private JasperReport compile(String resourcePath) throws Exception {
        try (InputStream stream = getClass().getResourceAsStream(resourcePath)) {
            if (stream == null) {
                throw new IllegalStateException("Risorsa jrxml non trovata nel classpath: " + resourcePath);
            }
            return JasperCompileManager.compileReport(stream);
        }
    }

    private Path writePdf(JasperPrint jasperPrint, String outputFileName) throws Exception {
        Path outputDir = Paths.get(OUTPUT_DIR);
        Files.createDirectories(outputDir);
        Path outputPath = outputDir.resolve(outputFileName);

        try (OutputStream outputStream = Files.newOutputStream(outputPath)) {
            JRPdfExporter exporter = new JRPdfExporter();
            exporter.setExporterInput(new SimpleExporterInput(jasperPrint));
            exporter.setExporterOutput(new SimpleOutputStreamExporterOutput(outputStream));
            exporter.exportReport();
        }
        return outputPath;
    }

    private ObjectNode buildData(ObjectMapper mapper) {
        ObjectNode data = mapper.createObjectNode();

        // Ente beneficiario
        ObjectNode ente = data.putObject("ente");
        ente.put("denominazioneEnte", "Fondazione Teatro Pubblico Pugliese");
        ente.put("indirizzoSedeLegale", "Via Imbriani 67");
        ente.put("capSedeLegale", "70121");
        ente.put("cittaSedeLegale", "Bari");
        ente.put("provinciaSedeLegale", "BA");
        ente.put("codiceFiscaleEnte", "93000000727");
        ente.put("pIvaEnte", "12345678901");
        ente.put("nomeCognomeLegaleRappresentante", "Mario Rossi");

        // Titoli progetto / programmazione
        ObjectNode progetto = data.putObject("progetto");
        progetto.put("titoloProgetto2026", "Puglia in Scena 2026");
        progetto.put("titoloProgetto2025", "Puglia in Scena 2025");
        progetto.put("titoloProgrammazioneTriennale", "Puglia Cultura 2025/2027");

        // Istanza principale
        ObjectNode istanzaPrincipale = data.putObject("istanzaPrincipale");
        istanzaPrincipale.put("idIstanzaPrincipale", "100245");
        istanzaPrincipale.put("numeroProtocolloIstanzaPrincipale", "0098765");
        istanzaPrincipale.put("dataProtocolloIstanzaPrincipale", "18/07/2025");

        // Verbale esiti procedura
        ObjectNode verbaleEsiti = data.putObject("verbaleEsiti");
        verbaleEsiti.put("dataVerbaleEsitiProcedura", "10/09/2025");
        verbaleEsiti.put("numeroProtocolloVerbaleEsitiProcedura", "0123456");
        verbaleEsiti.put("dataProtocolloVerbaleEsitiProcedura", "12/09/2025");

        // Determina dirigenziale 2025
        ObjectNode determina2025 = data.putObject("determina2025");
        determina2025.put("codiceCifraDeterminaApprovazione2025", "ABC/2025/00123");
        determina2025.put("dataDeterminaApprovazione2025", "30/09/2025");
        determina2025.put("importoAssegnato2025", "150.000,00");
        determina2025.put("numeroCapitoloRegionale2025", "U0901010");
        determina2025.put("dataSottoscrizioneDisciplinare2025", "15/10/2025");

        // Provvedimento di approvazione 2026
        ObjectNode provvedimento2026 = data.putObject("provvedimento2026");
        provvedimento2026.put("codiceCifraProvvedimentoApprovazione2026", "ABC/2026/00045");
        provvedimento2026.put("dataProvvedimentoApprovazione2026", "20/02/2026");
        provvedimento2026.put("dataInvioDomandaProgetto2026", "15/01/2026");
        provvedimento2026.put("numeroProtocolloDomandaProgetto2026", "0011223");
        provvedimento2026.put("importoAssegnato2026", "180.000,00");
        provvedimento2026.put("numeroCapitoloSpesa2026", "U0901011");
        provvedimento2026.put("denominazioneCapitoloSpesa2026", "Spese per attività culturali e di spettacolo dal vivo");

        // Atto di ammissione a finanziamento 2026 (Art. 2)
        ObjectNode attoAmmissione2026 = data.putObject("attoAmmissione2026");
        attoAmmissione2026.put("importoAssegnato", "175.000,00");
        attoAmmissione2026.put("numeroAttoDirigenzialeAmmissione2026", "215");
        attoAmmissione2026.put("dataAttoDirigenzialeAmmissione2026", "01/03/2026");

        // Cronoprogramma (Art. 5)
        ObjectNode cronoprogramma = data.putObject("cronoprogramma");
        cronoprogramma.put("dataInizioAttivita2026", "01/04/2026");
        cronoprogramma.put("dataFineAttivita2026", "31/12/2026");

        return data;
    }
}
