    private List<ServizioEsterno> recuperaServiziEsterni(long bandoId) {
        if (bandoId <= 0) {
            return Collections.emptyList();
        }
        List<BandoIntegrazioniDati> listaChiaviValori = bandoIntegrazioniDatiLocalService.dynamicQuery(
            bandoIntegrazioniDatiLocalService.dynamicQuery()
                .add(com.liferay.portal.kernel.dao.orm.RestrictionsFactoryUtil.eq("bandoId", bandoId))
        );
        Map<Long, List<BandoIntegrazioniDati>> gruppi = listaChiaviValori.stream()
            .collect(Collectors.groupingBy(BandoIntegrazioniDati::getTipologiaServizioEsternoIntegrazioniId));
        return gruppi.entrySet().stream().map(this::mappaServizioEsterno).collect(Collectors.toList());
    }

    private ServizioEsterno mappaServizioEsterno(Entry<Long, List<BandoIntegrazioniDati>> gruppo) {
        List<ChiaveValore> listaChiavi = gruppo.getValue().stream().map(this::mappaChiaveValore).collect(Collectors.toList());
        ServizioEsterno servizioEsterno = new ServizioEsterno();
        servizioEsterno.setTipologiaId(gruppo.getKey());
        servizioEsterno.setChiavi(listaChiavi);
        return servizioEsterno;
    }

    private ChiaveValore mappaChiaveValore(BandoIntegrazioniDati dato) {
        String valoreDecifrato;
        try {
            valoreDecifrato = gestioneBandiMiddlewareService.decrypt(dato.getValore());
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
        ChiaveValore chiaveValore = new ChiaveValore();
        chiaveValore.setChiave(dato.getChiave());
        chiaveValore.setValore(valoreDecifrato);
        return chiaveValore;
    }
