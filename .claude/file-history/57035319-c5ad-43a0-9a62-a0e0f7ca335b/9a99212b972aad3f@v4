	function calcolaTotalePunteggio(){
		var sizeListaCriteri = $('#<portlet:namespace />sizeListaCriteri').val();
		var totale = 0;
		var punteggiValidi = validatePunteggi(sizeListaCriteri);

		if(sizeListaCriteri){
			if(punteggiValidi){
				for (let i = 0; i < sizeListaCriteri; i++) {
					  let punteggio = $('#<portlet:namespace />criterioValutazionePunteggio' + i).val().replace(",",".");
					  let minAttr = parseFloat($('#<portlet:namespace />criterioValutazionePunteggio' + i).attr("minValue").replace(",","."));
					  let maxAttr = parseFloat($('#<portlet:namespace />criterioValutazionePunteggio' + i).attr("maxValue").replace(",","."));
					  let punteggioNumber = parseFloat(punteggio);

					  if(punteggioNumber >= minAttr && punteggioNumber <= maxAttr){
						  totale += punteggioNumber;
						  $('#totalePunteggio').val(totale.toFixed(2).toString().replace(/\./g, ','));

						  var calcoloAutomaticoImportoAmmissibile = ${calcoloAutomaticoImportoAmmissibile};
						  console.log("calcoloAutomaticoImportoAmmissibile: " + calcoloAutomaticoImportoAmmissibile);
						  if (calcoloAutomaticoImportoAmmissibile){
							  var importoAmmissibile = convertiPunteggioInImporto(totale);
							  $('#<portlet:namespace />importoAmmissibileFaseValutazione').val(importoAmmissibile);
							  $('#importoAmmissibileFaseValutazioneHtml').val(importoAmmissibile);

						  }
					  }

				}
			}
		}
	}

	function validatePunteggi(sizeListaCriteri){
		let punteggiValidi = true;

		if(sizeListaCriteri){
			for (let i = 0; i < sizeListaCriteri; i++) {
				  let punteggio = $('#<portlet:namespace />criterioValutazionePunteggio' + i).val().replace(",",".");
				  console.log("validatePunteggi");
				  let punteggioNumber = parseFloat(punteggio);

				  if(countDecimals(punteggioNumber) > 2){
					  if($("#errorCriterioValutazioneFormato" + i).hasClass("d-none")){
						  $("#errorCriterioValutazioneFormato" + i).removeClass("d-none");
					  }

					  punteggiValidi = false;
				  }else{
					  if(!$("#errorCriterioValutazioneFormato" + i).hasClass("d-none")){
						  $("#errorCriterioValutazioneFormato" + i).addClass("d-none");
					  }
				  }
			}

		}

		return punteggiValidi;
	}

	function countDecimals(value){
		if(value && !isNaN(value)){
		    if(Math.floor(value) === value) return 0;
		    return value.toString().split(".")[1].length || 0;
		}
	}

