<%@ include file="init.jsp" %>

<c:if test="${queryTabParent == 'in.lavorazione'}">
	<c:forEach items="${azioni}" var="azione">
		<c:choose>

			<c:when test="${azione.codiceAzioneUtente == 'ASSEGNA_RESPONSABILE'}">
				<jsp:include page="/dettaglio_domanda_bando_modale_assegna_responsabile.jsp" />
			</c:when>

			<c:when test="${azione.codiceAzioneUtente == 'ASSEGNA_ALTRO_RESPONSABILE'}">
				<jsp:include page="/dettaglio_domanda_bando_modale_assegna_altro_responsabile.jsp" />
			</c:when>

			<c:when test="${azione.codiceAzioneUtente == 'ESITO_PROCEDIMENTO_POSITIVO'}">
				<jsp:include page="/dettaglio_domanda_bando_modale_esito_positivo.jsp" />
			</c:when>

			<c:when test="${azione.codiceAzioneUtente == 'ESITO_PROCEDIMENTO_PARTECIPAZIONE_EFFETTUATA'}">
				<div class="modal fade" tabindex="-1" id="<portlet:namespace />partecipazioneEffettuataModal" style="display: none;">
					<portlet:actionURL var="dichiaraPartecipazioneURL" name="/action/dichiaraPartecipazione">
					</portlet:actionURL>

					<aui:form action="${dichiaraPartecipazioneURL}" name="chiudiPartecipazioneEffettuataForm">
						<aui:input type="hidden" name="domandaBandoId" value="${domandaBandoId}" />
						<aui:input type="hidden" name="queryTab" value="${queryTab}" />
						<aui:input type="hidden" name="variableSet" value="${azione.variableSet}" />
						<aui:input type="hidden" name="variableVal" value="${azione.variableValue}" />

						<div class="modal-dialog">
							<div class="modal-content">
								<div class="modal-header">
									<h5 class="modal-title"><liferay-ui:message key="partecipazione-effettuata-modal-title" /></h5>
									<button type="button" class="close" data-dismiss="modal">
										&times;
									</button>
								</div>
								<div class="modal-body">
									<span><liferay-ui:message key="partecipazione-effettuata-message" /></span>
									<br>
									<h5><liferay-ui:message key="seleziona-allegati-condividere" /></h5>
									<liferay-ui:search-container total="${allegatiModal.size()}"
											 					 emptyResultsMessage="non-sono-presenti-allegati"
											 					 delta="${allegatiModal.size()}">
						     			<liferay-ui:search-container-results results="${allegatiModal}" />

										<liferay-ui:search-container-row className="it.servizidigitali.gestionebandi.operatore.frontend.dto.AllegatoDTO"
										                                 modelVar="elem">
		                                    <liferay-ui:search-container-column-text name="">
												<div class="form-group form-check">
													<c:set var="checkedAttr" value="${elem.visibileAlCittadino ? 'checked' : '' }" />
													<input type="checkbox" class="form-check-input" value="${elem.idDocumentale}" name="<portlet:namespace />selezionati" ${checkedAttr}>
												</div>
				                            </liferay-ui:search-container-column-text>
											<liferay-ui:search-container-column-text name="nome-file" value="${elem.nomeFile}" />
				    						<liferay-ui:search-container-column-text name="dimensione" value="${elem.dimensione}" />
				    						<liferay-ui:search-container-column-text name="azioni">
				    						    <portlet:resourceURL id="/downloadFile" var="downloadFileUrl">
                                                    <portlet:param name="idDocumentale" value="${elem.idDocumentale}" />
                                                </portlet:resourceURL>

                                                <a href="${downloadFileUrl}" target="_blank">
                                                    <i class="fas fa-download"></i>
                                                </a>
				    						</liferay-ui:search-container-column-text>
				   						</liferay-ui:search-container-row>

										<liferay-ui:search-iterator markupView="lexicon" paginate="false" />
									</liferay-ui:search-container>
									<div class="form-group">
										<label>
											<liferay-ui:message key="commento" />
										</label>
										<textarea class="form-control" name="<portlet:namespace />commento"></textarea>
									</div>
								</div>
								<div class="modal-footer d-flex justify-content-end">
									<button type="button" class="btn btn-secondary" data-dismiss="modal"><liferay-ui:message key="annulla" /></button>

									<button type="submit" class="btn btn-primary ml-1">
										<liferay-ui:message key="conferma" />
									</button>
								</div>
							</div>
						</div>
					</aui:form>
				</div>
			</c:when>

			<c:when test="${azione.codiceAzioneUtente == 'ESITO_PROCEDIMENTO_PARTECIPAZIONE_NON_EFFETTUATA'}">
				<div class="modal fade" tabindex="-1" id="<portlet:namespace />partecipazioneNonEffettuataModal" style="display: none;">
					<portlet:actionURL var="dichiaraPartecipazioneURL" name="/action/dichiaraPartecipazione">
					</portlet:actionURL>

					<aui:form action="${dichiaraPartecipazioneURL}" name="chiudiPartecipazioneEffettuataForm">
						<aui:input type="hidden" name="domandaBandoId" value="${domandaBandoId}" />
						<aui:input type="hidden" name="queryTab" value="${queryTab}" />
						<aui:input type="hidden" name="variableSet" value="${azione.variableSet}" />
						<aui:input type="hidden" name="variableVal" value="${azione.variableValue}" />

						<div class="modal-dialog">
							<div class="modal-content">
								<div class="modal-header">
									<h5 class="modal-title"><liferay-ui:message key="partecipazione-non-effettuata-modal-title" /></h5>
									<button type="button" class="close" data-dismiss="modal">
										&times;
									</button>
								</div>
								<div class="modal-body">
									<span><liferay-ui:message key="partecipazione-non-effettuata-message" /></span>
									<br>
									<h5><liferay-ui:message key="seleziona-allegati-condividere" /></h5>
									<liferay-ui:search-container total="${allegatiModal.size()}"
											 					 emptyResultsMessage="non-sono-presenti-allegati"
											 					 delta="${allegatiModal.size()}">
						     			<liferay-ui:search-container-results results="${allegatiModal}" />

										<liferay-ui:search-container-row className="it.servizidigitali.gestionebandi.operatore.frontend.dto.AllegatoDTO"
										                                 modelVar="elem">
		                                    <liferay-ui:search-container-column-text name="">
												<div class="form-group form-check">
													<c:set var="checkedAttr" value="${elem.visibileAlCittadino ? 'checked' : '' }" />
													<input type="checkbox" class="form-check-input" value="${elem.idDocumentale}" name="<portlet:namespace />selezionati" ${checkedAttr}>
												</div>
				                            </liferay-ui:search-container-column-text>
											<liferay-ui:search-container-column-text name="nome-file" value="${elem.nomeFile}" />
				    						<liferay-ui:search-container-column-text name="dimensione" value="${elem.dimensione}" />
				    						<liferay-ui:search-container-column-text name="azioni">
				    						    <portlet:resourceURL id="/downloadFile" var="downloadFileUrl">
                                                    <portlet:param name="idDocumentale" value="${elem.idDocumentale}" />
                                                </portlet:resourceURL>

                                                <a href="${downloadFileUrl}" target="_blank">
                                                    <i class="fas fa-download"></i>
                                                </a>
				    						</liferay-ui:search-container-column-text>
				   						</liferay-ui:search-container-row>

										<liferay-ui:search-iterator markupView="lexicon" paginate="false" />
									</liferay-ui:search-container>
									<div class="form-group">
										<label>
											<liferay-ui:message key="commento" />
										</label>
										<textarea class="form-control" name="<portlet:namespace />commento"></textarea>
									</div>
								</div>
								<div class="modal-footer d-flex justify-content-end">
									<button type="button" class="btn btn-secondary" data-dismiss="modal"><liferay-ui:message key="annulla" /></button>

									<button type="submit" class="btn btn-primary ml-1">
										<liferay-ui:message key="conferma" />
									</button>
								</div>
							</div>
						</div>
					</aui:form>
				</div>
			</c:when>

			<c:when test="${azione.codiceAzioneUtente == 'ESITO_PROCEDIMENTO_PARTECIPAZIONE_NON_EFFETTUATA_GIUSTIFICATIVO'}">
				<div class="modal fade" tabindex="-1" id="<portlet:namespace />partecipazioneGiustificativoModal" style="display: none;">
					<portlet:actionURL var="dichiaraPartecipazioneURL" name="/action/dichiaraPartecipazione">
					</portlet:actionURL>

					<aui:form action="${dichiaraPartecipazioneURL}" name="partecipazioneGiustificativoForm">
						<aui:input type="hidden" name="domandaBandoId" value="${domandaBandoId}" />
						<aui:input type="hidden" name="queryTab" value="${queryTab}" />
						<aui:input type="hidden" name="variableSet" value="${azione.variableSet}" />
						<aui:input type="hidden" name="variableVal" value="${azione.variableValue}" />

						<div class="modal-dialog">
							<div class="modal-content">
								<div class="modal-header">
									<h5 class="modal-title"><liferay-ui:message key="partecipazione-giustificativo-modal-title" /></h5>
									<button type="button" class="close" data-dismiss="modal">
										&times;
									</button>
								</div>
								<div class="modal-body">
									<span><liferay-ui:message key="partecipazione-giustificativo-message" /></span>
									<br>
									<h5><liferay-ui:message key="seleziona-allegati-condividere" /></h5>
									<liferay-ui:search-container total="${allegatiModal.size()}"
											 					 emptyResultsMessage="non-sono-presenti-allegati"
											 					 delta="${allegatiModal.size()}">
						     			<liferay-ui:search-container-results results="${allegatiModal}" />

										<liferay-ui:search-container-row className="it.servizidigitali.gestionebandi.operatore.frontend.dto.AllegatoDTO"
										                                 modelVar="elem">
		                                    <liferay-ui:search-container-column-text name="">
												<div class="form-group form-check">
													<c:set var="checkedAttr" value="${elem.visibileAlCittadino ? 'checked' : '' }" />
													<input type="checkbox" class="form-check-input" value="${elem.idDocumentale}" name="<portlet:namespace />selezionati" ${checkedAttr}>
												</div>
				                            </liferay-ui:search-container-column-text>
											<liferay-ui:search-container-column-text name="nome-file" value="${elem.nomeFile}" />
				    						<liferay-ui:search-container-column-text name="dimensione" value="${elem.dimensione}" />
				    						<liferay-ui:search-container-column-text name="azioni">
				    						    <portlet:resourceURL id="/downloadFile" var="downloadFileUrl">
                                                    <portlet:param name="idDocumentale" value="${elem.idDocumentale}" />
                                                </portlet:resourceURL>

                                                <a href="${downloadFileUrl}" target="_blank">
                                                    <i class="fas fa-download"></i>
                                                </a>
				    						</liferay-ui:search-container-column-text>
				   						</liferay-ui:search-container-row>

										<liferay-ui:search-iterator markupView="lexicon" paginate="false" />
									</liferay-ui:search-container>
									<div class="form-group">
										<label>
											<liferay-ui:message key="commento" />
										</label>
										<textarea class="form-control" name="<portlet:namespace />commento"></textarea>
									</div>
								</div>
								<div class="modal-footer d-flex justify-content-end">
									<button type="button" class="btn btn-secondary" data-dismiss="modal"><liferay-ui:message key="annulla" /></button>

									<button type="submit" class="btn btn-primary ml-1">
										<liferay-ui:message key="conferma" />
									</button>
								</div>
							</div>
						</div>
					</aui:form>
				</div>
			</c:when>

			<c:when test="${azione.codiceAzioneUtente == 'ESITO_PROCEDIMENTO_NEGATIVO'}">
				<jsp:include page="/dettaglio_domanda_bando_modale_esito_negativo.jsp" />
			</c:when>

			<c:when test="${azione.codiceAzioneUtente == 'RILASCIA_TASK'}">
				<jsp:include page="/dettaglio_domanda_bando_modale_rilascia.jsp" />
			</c:when>

			<c:when test="${azione.variableSet == 'ESITO_LAVORAZIONE'}">
				<div class="modal fade" tabindex="-1" id="<portlet:namespace />chiudiEsitoModal" style="display: none;">
					<portlet:actionURL var="chiudiEsitoURL" name="/action/chiudiPratica">
					</portlet:actionURL>

					<aui:form action="${chiudiEsitoURL}" name="chiudiEsitoForm">
						<aui:input type="hidden" name="domandaBandoId" value="${domandaBandoId}" />
						<aui:input type="hidden" name="queryTab" value="${queryTab}" />
						<aui:input type="hidden" name="variableSet" value="${azione.variableSet}" />
						<aui:input type="hidden" id="variableValId" name="variableVal" value="${azione.variableValue}" />

						<div class="modal-dialog">
							<div class="modal-content">
								<div class="modal-header">
									<h5 class="modal-title"><liferay-ui:message key="completa-attivita" /></h5>
									<button type="button" class="close" data-dismiss="modal">
										&times;
									</button>
								</div>
								<div class="modal-body">
									<span><liferay-ui:message key="chiudi-esito-message-generic" /></span>
								</div>

								<div class="modal-footer d-flex justify-content-end">
									<button type="button" class="btn btn-secondary" data-dismiss="modal"><liferay-ui:message key="annulla" /></button>

									<button type="submit" class="btn btn-primary ml-1">
										<liferay-ui:message key="conferma" />
									</button>
								</div>
							</div>
						</div>
					</aui:form>
				</div>
			</c:when>

			<c:when test="${azione.codiceAzioneUtente == 'TIPO_OPERAZIONE_CONCESSIONE'}">
                <div class="modal fade" tabindex="-1" id="<portlet:namespace />inoltraaConcessioneModal" style="display: none;">
                    <portlet:actionURL var="chiudiEsitoURL" name="/inviaAConcessione">
                    </portlet:actionURL>
                    <aui:form action="${chiudiEsitoURL}" name="chiudiEsitoForm">
                        <aui:input type="hidden" name="domandaBandoId" value="${domandaBandoId}" />
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title"><liferay-ui:message key="completa-attivita" /></h5>
                                    <button type="button" class="close" data-dismiss="modal">
                                        &times;
                                    </button>
                                </div>
                                <div class="modal-body">
                                    <span><liferay-ui:message key="invia-a-concessione-message" /></span>
                                </div>
                                <div class="modal-footer d-flex justify-content-end">
                                    <button type="button" class="btn btn-secondary" data-dismiss="modal"><liferay-ui:message key="annulla" /></button>
                                    <button type="submit" class="btn btn-primary ml-1">
                                        <liferay-ui:message key="conferma" />
                                    </button>
                                </div>
                            </div>
                        </div>
                    </aui:form>
                </div>
            </c:when>

            <c:when test="${azione.codiceAzioneUtente == 'TIPO_OPERAZIONE_ESECUZIONE'}">
                <div class="modal fade" tabindex="-1" id="<portlet:namespace />inoltraaEsecuzioneModal" style="display: none;">
                    <portlet:actionURL var="chiudiEsitoURL" name="/inviaAEsecuzione">
                    </portlet:actionURL>
                    <aui:form action="${chiudiEsitoURL}" name="chiudiEsitoForm">
                        <aui:input type="hidden" name="domandaBandoId" value="${domandaBandoId}" />
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title"><liferay-ui:message key="completa-attivita" /></h5>
                                    <button type="button" class="close" data-dismiss="modal">
                                        &times;
                                    </button>
                                </div>
                                <div class="modal-body">
                                    <span><liferay-ui:message key="invia-a-esecuzione-message" /></span>
                                </div>
                                <div class="modal-footer d-flex justify-content-end">
                                    <button type="button" class="btn btn-secondary" data-dismiss="modal"><liferay-ui:message key="annulla" /></button>
                                    <button type="submit" class="btn btn-primary ml-1">
                                        <liferay-ui:message key="conferma" />
                                    </button>
                                </div>
                            </div>
                        </div>
                    </aui:form>
                </div>
            </c:when>

			<c:when test="${azione.codiceAzioneUtente == 'RICHIESTA_INTEGRAZIONE'}">
				<jsp:include page="/dettaglio_domanda_bando_modale_richiesta_integrazione.jsp" />
			</c:when>

			<c:when test="${azione.codiceAzioneUtente == 'ATTIVITA_BENEFICIARIO' }">
                <div class="modal fade" tabindex="-1" id="<portlet:namespace />richiediAttivitaBeneficiarioModal" style="display: none;">
                    <portlet:actionURL var="richiediIntegrazioneURL" name="/action/richiediIntegrazione">
                    </portlet:actionURL>

                    <aui:form action="${richiediIntegrazioneURL}" name="richiediModificheForm">
                        <aui:input type="hidden" name="domandaBandoId" value="${domandaBandoId}" />
                        <aui:input type="hidden" name="queryTab" value="${queryTab}" />
                        <aui:input type="hidden" name="codiceAzioneUtente" value="${azione.codiceAzioneUtente}" />

                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">
                                         <liferay-ui:message key="selezione_allegati_attivit_beneficiario"/>
                                    </h5>
                                    <button type="button" class="close" data-dismiss="modal">
                                        &times;
                                    </button>
                                </div>
                                <div class="modal-body">
                                    <c:choose>
                                        <c:when test="${empty integrazioni}">
                                            <span><liferay-ui:message key="non-sono-previste-integrazioni" /></span>
                                        </c:when>
                                        <c:otherwise>
                                            <span><liferay-ui:message key="integrazioni-message" /></span>

                                            <div class="form-group">
                                                <label><liferay-ui:message key="note" /></label>
                                                <textarea class="form-control" name="<portlet:namespace />note"></textarea>
                                            </div>

                                            <h5><liferay-ui:message key="seleziona-documenti-integrazione" /></h5>
                                            <liferay-ui:search-container total="${integrazioni.size()}"
                                                                         delta="${integrazioni.size()}">
                                                <liferay-ui:search-container-results results="${integrazioni}" />

                                                <liferay-ui:search-container-row className="it.servizidigitali.gestionebandi.operatore.frontend.dto.IntegrazioneDTO"
                                                                         modelVar="elem">
                                                    <liferay-ui:search-container-column-text name="">
                                                        <div class="form-group form-check">
                                                            <input type="checkbox" class="form-check-input" value="${elem.id}" name="<portlet:namespace />integrazioni">
                                                        </div>
                                                    </liferay-ui:search-container-column-text>

                                                    <liferay-ui:search-container-column-text name="integrazione" value="${elem.nome}" />
                                                </liferay-ui:search-container-row>

                                                <liferay-ui:search-iterator markupView="lexicon" paginate="false" />
                                            </liferay-ui:search-container>

                                            <h5><liferay-ui:message key="seleziona-allegati-condividere" /></h5>
                                            <liferay-ui:search-container total="${allegatiModal.size()}"
                                                                         delta="${allegatiModal.size()}"
                                                                 emptyResultsMessage="non-sono-presenti-allegati">
                                                <liferay-ui:search-container-results results="${allegatiModal}" />

                                                <liferay-ui:search-container-row className="it.servizidigitali.gestionebandi.operatore.frontend.dto.AllegatoDTO"
                                                                                 modelVar="elem">
                                                    <liferay-ui:search-container-column-text name="">
                                                        <div class="form-group form-check">
                                                            <c:set var="checkedAttr" value="${elem.visibileAlCittadino ? 'checked' : '' }" />
                                                            <input type="checkbox" class="form-check-input" value="${elem.idDocumentale}" name="<portlet:namespace />allegati" ${checkedAttr}>
                                                        </div>
                                                    </liferay-ui:search-container-column-text>
                                                    <liferay-ui:search-container-column-text name="nome-file" value="${elem.nomeFile}" />
                                                    <liferay-ui:search-container-column-text name="dimensione" value="${elem.dimensione}" />
                                                    <liferay-ui:search-container-column-text name="azioni">
                                                        <portlet:resourceURL id="/downloadFile" var="downloadFileUrl">
                                                            <portlet:param name="idDocumentale" value="${elem.idDocumentale}" />
                                                        </portlet:resourceURL>

                                                        <a href="${downloadFileUrl}" target="_blank">
                                                            <i class="fas fa-download"></i>
                                                        </a>
                                                    </liferay-ui:search-container-column-text>
                                                </liferay-ui:search-container-row>

                                                <liferay-ui:search-iterator markupView="lexicon" paginate="false" />
                                            </liferay-ui:search-container>
                                        </c:otherwise>
                                    </c:choose>
                                </div>
                                <div class="modal-footer d-flex justify-content-end">
                                    <button type="button" class="btn btn-secondary" data-dismiss="modal">
                                        <liferay-ui:message key="annulla" />
                                    </button>
                                    <c:if test="${not empty integrazioni}">
                                        <button type="submit" class="btn btn-primary ml-1">
                                            <liferay-ui:message key="conferma" />
                                        </button>
                                    </c:if>
                                </div>
                            </div>
                        </div>
                    </aui:form>
                </div>
            </c:when>

			<c:when test="${azione.codiceAzioneUtente == 'TIPO_OPERAZIONE_RIMANDA_REFERENTE'}">
				<div class="modal fade" tabindex="-1" id="<portlet:namespace />rimandaAlReferenteModal" style="display: none;">
					<portlet:actionURL var="rimandaAlReferenteURL" name="/action/rimandaAlReferente">
					</portlet:actionURL>

					<aui:form action="${rimandaAlReferenteURL}" name="rimandaAlReferenteForm">
						<aui:input type="hidden" name="domandaBandoId" value="${domandaBandoId}" />
						<aui:input type="hidden" name="queryTab" value="${queryTab}" />
						<aui:input type="hidden" name="variableSet" value="${azione.variableSet}" />
						<aui:input type="hidden" name="variableVal" value="${azione.variableValue}" />

						<div class="modal-dialog">
							<div class="modal-content">
								<div class="modal-header">
									<h5 class="modal-title"><liferay-ui:message key="rimanda-al-referente" /></h5>
									<button type="button" class="close" data-dismiss="modal">
										&times;
									</button>
								</div>
								<div class="modal-body">
									<div class="form-group">
										<label>
											<liferay-ui:message key="commento" />
										</label>
										<textarea class="form-control" name="<portlet:namespace />commento"></textarea>
									</div>
								</div>
								<div class="modal-footer d-flex justify-content-end">
									<button type="button" class="btn btn-secondary" data-dismiss="modal">
										<liferay-ui:message key="annulla" />
									</button>
									<button type="submit" class="btn btn-primary ml-1">
										<liferay-ui:message key="conferma" />
									</button>
								</div>
							</div>
						</div>
					</aui:form>
