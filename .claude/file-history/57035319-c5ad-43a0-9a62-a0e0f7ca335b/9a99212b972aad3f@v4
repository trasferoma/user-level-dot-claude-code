    AUI().use('node', function(A) {
    	A.one('body').delegate('focusout', function(event) {
            if (event.target.hasClass('punteggioValue')) {
                formatDecimalInput(event.target);
            }
        }, '.punteggioValue');

		A.one('body').delegate('focusout', function(event) {
			if (event.target.hasClass('importoValue')) {
				formatDecimalInput(event.target);
			}
		}, '.importoValue');

        function formatDecimalInput(input) {
            let value = parseFloat(input.get('value').replace(",","."));
            if (!isNaN(value)) {
                input.set('value', value.toFixed(2).toString().replace(".",","));
            }
        }

        A.one('body').delegate('keydown', function(event) {
            if (event.target.hasClass('no-dot')) {
                if (event.keyCode === 190 || event.keyCode === 110 || (event.keyCode >= 65 && event.keyCode <= 90)) {
                    event.preventDefault();
                }
            }
        }, '.no-dot');

        A.one('body').delegate('input', function(event) {
            if (event.target.hasClass('punteggioValue')) {
                validateDecimalInput(event.target);
            }
        }, '.punteggioValue');

        function validateDecimalInput(input) {
            if(input.hasClass("punt-tot")){
                validateDecimalInputUnsigned(input);
            }else{
                let value = input.get('value');
                const regex = /^-?\d{0,3}(,\d{0,2})?$/;

                // Allow a single '-' character
                if (value === '-') {
                    return;
                }

                if (!regex.test(value)) {
                    let validValue = value;

                    // Rimuovi gli ultimi caratteri fino a trovare una stringa valida o fino a che la stringa diventa vuota
                    while (validValue.length > 0 && !regex.test(validValue)) {
                        validValue = validValue.slice(0, -1);
                    }

                    // Special case: handle negative sign only input
                    if (validValue === '-') {
                        validValue = '';
                    }

                    input.set('value', validValue);
                }
            }
        }

        function validateDecimalInputUnsigned(input) {
            const value = input.get('value');
            const regex = /^\d{1,3}(\,\d{0,2})?$/;

            if (!regex.test(value)) {
                let validValue = value.slice(0, -1);

                while (!regex.test(validValue) && validValue.length > 0) {
                    validValue = validValue.slice(0, -1);
                }

                input.set('value', validValue);
            }
        }
    });
</aui:script>

