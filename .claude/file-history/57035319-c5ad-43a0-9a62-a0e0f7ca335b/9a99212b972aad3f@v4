<c:if test="${calcoloAutomaticoImportoAmmissibile}">
	<script>
		function convertiPunteggioInImporto(punteggio){
			console.log("convertiPunteggioInImporto: "+ punteggio);
			var listaRangeImportiValutazione = ${listaRangeImportiValutazione};	    
			var importo = 0;
			listaRangeImportiValutazione.forEach(function(element) {
				if (parseFloat(punteggio) >= parseFloat(element.punteggioMin) && parseFloat(punteggio) <= parseFloat(element.punteggioMax)){
					importo = element.importo;
				}
			});
			return importo.toFixed(2).toString().replace(/\./g, ',');
		}
	</script>
</c:if>