package it.servizidigitali.gestionebandi.operatore.frontend.enums;

public enum CamundaActionsVariable {

	// Azioni Operatore
	VAR_IMPOSTAZIONE_VARIABILI("IMPOSTAZIONE_VARIABILI"),
	VAR_ASSEGNAZIONE_RESPONSABILE("ASSEGNAZIONE_RESPONSABILE"),
	VAR_RICHIESTA_INTEGRAZIONE("RICHIESTA_INTEGRAZIONE"),
	VAR_COMPILA_DISCIPLINARE("COMPILA_DISCIPLINARE"),
	VAR_COMPILA_DISCIPLINARE_ESECUZIONE("VAR_COMPILA_DISCIPLINARE_ESECUZIONE"),
	VAR_VERIFICA_RESPONSABILE("VERIFICA_RESPONSABILE"),
	VAR_COMPILA_REVOCA("COMPILA_REVOCA"),
	VAR_RILASCIA_TASK("RILASCIA_TASK"),
	VAR_INSERIMENTO_VALUTAZIONI("VALUTAZIONE"),
	VAR_CONFERMA_ESITO("CONFERMA_ESITO"),
	VAR_ISTRUTTORIA("ISTRUTTORIA"),
	VAR_FASE_GRADUATORIA("GRADUATORIA"),
	VAR_ATTIVITA_BENEFICIARIO("ATTIVITA_BENEFICIARIO"),
	VAR_FASE_CONCESSIONE("CONCESSIONE"),
	VAR_FASE_ESECUZIONE("ESECUZIONE"),
	VAR_CONTROLLO_SCADENZE("CONTROLLO_SCADENZE"),
	VAR_GESTISCI_EROGAZIONI("GESTISCI_EROGAZIONI"),
	VAL_SEPARATOR(":");
	
	private String value;
	
	private CamundaActionsVariable(String value){
		this.setValue(value);
	}

	/**
	 * @return the value
	 */
	public String getValue() {
		return value;
	}

	/**
	 * @param name the value to set
	 */
	private void setValue(String value) {
		this.value = value;
	}
}
