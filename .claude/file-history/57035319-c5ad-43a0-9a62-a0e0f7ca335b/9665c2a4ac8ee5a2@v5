    @Override
    public String getToken() {
        WebClient client = getClient(baseUrl + tokenPath);
        client.query("grant_type", "client_credentials");

        String credentials = clientId + ":" + clientSecret;
        String basic = Base64.getEncoder().encodeToString(credentials.getBytes());
        String authorization = "Basic " + basic;
        client.header("Authorization", authorization);
        MultivaluedMap<String,String> map = new MultivaluedHashMap<String,String>();

        String response = client.post(Entity.form(map), String.class);
        String token = toToken(response);

        return token;
    }

    private WebClient getClient(String url) {
        WebClient client;
        List<Object> providers = new ArrayList<>();
        providers.add(new JacksonJsonProvider());
        client = WebClient.create(url, providers, null);
        return client;
    }

    private WebClient getClientForList(String url) {
        WebClient client;
        List<Object> providers = new ArrayList<>();
        providers.add(new JacksonJsonProvider());
        client = WebClient.create(url, providers, null);
        return client;
    }

    private String toToken(String json) {
        String token = "";
        JsonObject jsonObject = new JsonParser().parse(json).getAsJsonObject();
        if (jsonObject.has("access_token")) {
            token = jsonObject.get("access_token").getAsString();
        }
        return token;
    }

