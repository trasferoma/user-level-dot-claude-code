    public List<DomandaBandoConAmmissibilitaDTO> scartaBozzeEOttieniListaConAmmissibilita(List<DomandaBando> listaDomande, boolean conValutazione, boolean isBandoProceduraNegozialeValutazione) {
        List<DomandaBandoConAmmissibilitaDTO> listaDomandeConAmmissibilita = new ArrayList<>();

        if (listaDomande.isEmpty()) {
            return listaDomandeConAmmissibilita;
        }

        // Pre-fetch dati bando-level (costanti per tutte le domande dello stesso bando)
        Bando bando = null;
        List<CriterioValutazione> listaCriteri = null;
        BigDecimal budgetResiduo = BigDecimal.ZERO;
        boolean nessunaDomandaInConcessione = false;
        String gestioneBudgetResiduo = null;

        try {
            bando = bandoLocalService.getBando(listaDomande.get(0).getBandoId());
            gestioneBudgetResiduo = bando.getGestioneBudgetResiduo();
            List<String> statiEsclusiBudget = StatoDomandaBandoEnum.getNamesByEscludereBudget(true);
            BigDecimal budgetTotale = budgetBandoLocalService.getBudgetTotaleByBandoId(bando.getBandoId());
            BigDecimal totaleImportiAssegnati = domandaBandoLocalService.getTotaleImportiAssegnatiByBandoIdAndStatoNotIn(bando.getBandoId(), statiEsclusiBudget);
            budgetResiduo = budgetTotale.subtract(totaleImportiAssegnati);
            nessunaDomandaInConcessione = domandaBandoLocalService.getNessunaDomandaInConcessioneBandoIdAndStatiNotIn(bando.getBandoId(), statiEsclusiBudget);
            listaCriteri = criterioValutazioneLocalService.getCriterioValutazioneByBandoIdAndNotCodice(bando.getBandoId(), null);
        } catch (Exception e) {
            log.error("scartaBozzeEOttieniListaConAmmissibilita :: Errore nel pre-fetch dati bando: " + e.getMessage(), e);
        }

        for (DomandaBando domanda : listaDomande) {
            if (Validator.isNotNull(domanda.getProcessInstanceId())) {
                ValutazioneAmmissibilita valutazioneAmmissibilita = null;
                List<ValutazioneAmmissibilita> listaValutazioniAmmissibilita = valutazioneAmmissibilitaLocalService.getValutazioneAmissibilitaDomandaBando(domanda.getDomandaBandoId());
                if(Validator.isNotNull(listaValutazioniAmmissibilita) && !listaValutazioniAmmissibilita.isEmpty() && listaValutazioniAmmissibilita.size()==1) {
                    valutazioneAmmissibilita = listaValutazioniAmmissibilita.get(0);
                }

                DomandaBandoConAmmissibilitaDTO domandaConAmmissibilita = new DomandaBandoConAmmissibilitaDTO();
                domandaConAmmissibilita.setDomandaBandoId(domanda.getDomandaBandoId());
                domandaConAmmissibilita.setDataArrivo(domanda.getDataArrivo());
                domandaConAmmissibilita.setRagioneSociale(domanda.getRagioneSociale());
                domandaConAmmissibilita.setTitoloProgetto(domanda.getTitoloProgetto());
                domandaConAmmissibilita.setImportoRichiesto(domanda.getImportoRichiesto());
                domandaConAmmissibilita.setImportoAmmissibile(domanda.getImportoAmmissibile());
                domandaConAmmissibilita.setImportoAssegnato(domanda.getImportoAssegnato());
                domandaConAmmissibilita.setImportoConfermato(domanda.getImportoConfermato());
                domandaConAmmissibilita.setNumeroProtocolloEsteso(domanda.getNumeroProtocolloEsteso());
                
                List<DomandaBandoDatoAggiuntivo> datiAggiuntiviDomandaBandoProvincia = 
                		domandaBandoDatoAggiuntivoLocalService.getDomandaBandoDatoAggiuntivoByDomandaBandoIdAndChiave(
                				Collections.singletonList(domanda.getDomandaBandoId()), Collections.singletonList(ScrivaniaOperatoreBandiPortletKeys.PROVINCIA_SEDE_LEGALE_ENTE));
                
                domandaConAmmissibilita.setProvincia(
                		datiAggiuntiviDomandaBandoProvincia.size() > 0 ? datiAggiuntiviDomandaBandoProvincia.get(0).getValore()
                													   : StringPool.BLANK );

                String statoDomandaDescrizione = "-";

                if (domanda.getStatoId() > 0) {
                    //StatoDomanda statoDomanda = statoDomandaLocalService.fetchStatoDomanda(domanda.getStatoId());
                    StatoDomandaBando statoDomanda = statoDomandaBandoLocalService.getStatoDomandaBandoByBandoIdAndStatoId(domanda.getBandoId(),domanda.getStatoId());
                    if(Validator.isNotNull(statoDomanda)) {
                        statoDomandaDescrizione = statoDomanda.getDescrizione();
                        domandaConAmmissibilita.setStatoDomandaBando(domanda.getStato());
                    }
                } else {
                    if(Validator.isNotNull(domanda.getStato())) {
                        statoDomandaDescrizione = StatoDomandaBandoEnum.findByName(domanda.getStato()).getName();
                        domandaConAmmissibilita.setStatoDomandaBando(domanda.getStato());
                    }
                }

                domandaConAmmissibilita.setStato(statoDomandaDescrizione);

                if (isBandoProceduraNegozialeValutazione) {
                    List<DomandaBandoDatoAggiuntivo> datiAggiuntiviDomandaBando = domandaBandoDatoAggiuntivoLocalService.getDomandaBandoDatoAggiuntivoByDomandaBandoIdAndChiave(Collections.singletonList(domanda.getDomandaBandoId()), Collections.singletonList(ScrivaniaOperatoreBandiPortletKeys.VALUTAZIONE_FINANZIAMENTO_DOMANDA));
                    if (ListUtil.isNotNull(datiAggiuntiviDomandaBando) && ListUtil.isNotEmpty(datiAggiuntiviDomandaBando) && datiAggiuntiviDomandaBando.size() == 1) {
                        ValutazioneFinanziamento valutazioneFinanziamento = ValutazioneFinanziamento.valueOf(datiAggiuntiviDomandaBando.get(0).getValore());
                        if (Validator.isNotNull(valutazioneFinanziamento)) {
                            domandaConAmmissibilita.setEsitoAmmissibilita(valutazioneFinanziamento.getDescrizione());
                            domandaConAmmissibilita.setConvalidataValutazioneAmmissibilita(true);
                        }
                    }else {
                        if (valutazioneAmmissibilita != null) {
                            domandaConAmmissibilita.setConvalidataValutazioneAmmissibilita(valutazioneAmmissibilita.getConvalidata());
                        }else{
                            domandaConAmmissibilita.setConvalidataValutazioneAmmissibilita(false);
                        }
                    }
                } else {
                    if (valutazioneAmmissibilita != null) {
                        domandaConAmmissibilita.setEsitoAmmissibilita(valutazioneAmmissibilita.getEsito());
                        domandaConAmmissibilita.setConvalidataValutazioneAmmissibilita(valutazioneAmmissibilita.getConvalidata());
                    }else{
                        domandaConAmmissibilita.setEsitoAmmissibilita("-");
                    }
                }

                if(conValutazione){
                    domandaConAmmissibilita.setGraduatoria(verificaValoreVariabileCamunda(domanda, CustomProcessVariables.ESITO_LAVORAZIONE, ScrivaniaOperatoreBandiPortletKeys.GRADUATORIA));

                    if(domandaConAmmissibilita.getConvalidataValutazioneAmmissibilita()){

                        List<Valutazione> listaValutazioni = valutazioneLocalService.getValutazioneByDomandaBandoId(domanda.getDomandaBandoId());
                        Valutazione valutazione = null;

                        if(Validator.isNotNull(listaValutazioni) && !listaValutazioni.isEmpty() && listaValutazioni.size()==1) {
                            valutazione = listaValutazioni.get(0);
                        }else{
                            domandaConAmmissibilita.setPunteggioTotale("-");
                        }
                        if (valutazione != null) {
                            domandaConAmmissibilita.setConvalidataValutazione(valutazione.getConvalidata());
                            if(listaCriteri!=null){
                                List<Punteggio> listaPunteggiDomanda = punteggioLocalService.getListaPunteggiByValutazioneId(valutazione.getValutazioneId());
                                domandaConAmmissibilita.setPunteggioTotale(String.valueOf(recuperaPunteggioTotale(listaPunteggiDomanda, listaCriteri, bando)));
                            }
                        }else{
                            domandaConAmmissibilita.setPunteggioTotale("-");
                        }
                    }else{
                        domandaConAmmissibilita.setPunteggioTotale("-");
                    }
                    domandaConAmmissibilita.setNonIdoneitaPunteggio(checkNonIdoneitaPunteggioAvvisoSportelloValutazione(domanda.getDomandaBandoId()));

                }else{

                    domandaConAmmissibilita.setGraduatoria(verificaValoreVariabileCamunda(domanda, CustomProcessVariables.ESITO_LAVORAZIONE, ScrivaniaOperatoreBandiPortletKeys.VALUTAZIONE)
                            || verificaValoreVariabileCamunda(domanda, CustomProcessVariables.ESITO_LAVORAZIONE, ScrivaniaOperatoreBandiPortletKeys.GRADUATORIA) ||
                            verificaValoreVariabileCamunda(domanda, CustomProcessVariables.ESITO_LAVORAZIONE, ScrivaniaOperatoreBandiPortletKeys.CAMUNDA_VAR_CONFERMA_ESITO));

                    domandaConAmmissibilita.setConvalidataValutazione(false);
                    domandaConAmmissibilita.setNonIdoneitaPunteggio(false);

                    List<DomandaBandoDatoAggiuntivo> datiAggiuntiviDomandaBando = domandaBandoDatoAggiuntivoLocalService.getDomandaBandoDatoAggiuntivoByDomandaBandoIdAndChiave(Collections.singletonList(domanda.getDomandaBandoId()), Collections.singletonList(DatoAggiuntivoChiave.DATA_CONFERMA_EVENTO.name()));

                    if(ListUtil.isNotNull(datiAggiuntiviDomandaBando) && ListUtil.isNotEmpty(datiAggiuntiviDomandaBando)){
                        domandaConAmmissibilita.setAbilitaAzioniDomandaEvento(false);
                    }else{
                        domandaConAmmissibilita.setAbilitaAzioniDomandaEvento(true);
                    }
                }

                // Calcolo finanziabile usando i dati bando-level pre-fetchati e i dati per-domanda giá disponibili
                domandaConAmmissibilita.setFinanziabile(
                        isFinanziabile(valutazioneAmmissibilita, domandaConAmmissibilita.getNonIdoneitaPunteggio(),
                                domanda.getImportoAmmissibile(), budgetResiduo, nessunaDomandaInConcessione, gestioneBudgetResiduo)
                );

                listaDomandeConAmmissibilita.add(domandaConAmmissibilita);
            }
        }

        return listaDomandeConAmmissibilita;
    }

