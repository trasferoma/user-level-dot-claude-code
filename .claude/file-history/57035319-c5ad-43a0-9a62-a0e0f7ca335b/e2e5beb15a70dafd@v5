    public List<IntegrazioneDTO> getIntegrazioni(long bandoId, boolean inEsecuzione, long domandaBandoId) {
        List<BandoForm> bandoForms = bandoFormLocalService.getListaBandoFormBando(bandoId);
        List<IntegrazioneDTO> result;
        // Bando bando = bandoLocalService.fetchBando(bandoId);
        // TODO ot

        Stream<BandoForm> stream;
        if (!inEsecuzione) {
            stream = bandoForms.stream().filter(bandoForm -> bandoForm.getTipoForm().isEmpty() || TipoFormEnum.INTEGRAZIONE.name().equals(bandoForm.getTipoForm()));
        }
        else {
            stream = getBandoFormStreamDaIntegrareByDomandaBandoId(bandoForms, domandaBandoId);

            // In esecuzione, se è presente il disciplinare esecuzione, il soccorso istruttorio deve essere consentito
            // anche senza un'istanza di servizio esecuzione: si includono i form di integrazione selezionabili dall'operatore
            // (stesso insieme della fase di concessione).
            boolean disciplinareEsecuzionePresente = bandoForms.stream()
                    .anyMatch(bandoForm -> TipoFormEnum.INTEGRAZIONE_OPERATORE_ESECUZIONE.name().equals(bandoForm.getTipoForm()));
            if (disciplinareEsecuzionePresente) {
                Stream<BandoForm> formIntegrazione = bandoForms.stream()
                        .filter(bandoForm -> bandoForm.getTipoForm().isEmpty() || TipoFormEnum.INTEGRAZIONE.name().equals(bandoForm.getTipoForm()));
                stream = Stream.concat(stream, formIntegrazione);
            }
        }

        List<DomandaBandoDatoAggiuntivo> domandaBandoDatoAggiuntivoList = domandaBandoDatoAggiuntivoLocalService.getDomandaBandoDatoAggiuntivoByDomandaBandoIdAndChiave(Collections.singletonList(domandaBandoId), Collections.singletonList("FORM_ESECUZIONE_NON_ABILITATO"));
        Set<String> formDaEscludere = new HashSet<>();

        if (ListUtil.isNotNull(domandaBandoDatoAggiuntivoList) && ListUtil.isNotEmpty(domandaBandoDatoAggiuntivoList)) {
            formDaEscludere = domandaBandoDatoAggiuntivoList.stream().map(DomandaBandoDatoAggiuntivo::getValore).collect(Collectors.toSet());
        }

        if (Validator.isNotNull(formDaEscludere) && !formDaEscludere.isEmpty()) {
            Set<String> finalFormDaEscludere = formDaEscludere;
            result = stream.map(bandoForm -> formLocalService.fetchForm(bandoForm.getFormId()))
                    .filter(form -> !form.isPrincipale())
                    .filter(form -> !finalFormDaEscludere.contains(form.getCodice()))
                    .map(this::mapForm).collect(Collectors.toList());

        } else {
            result = stream.map(bandoForm -> formLocalService.fetchForm(bandoForm.getFormId()))
                    .filter(form -> !form.isPrincipale())
                    .map(this::mapForm).collect(Collectors.toList());
        }
        return result;
    }

    private IntegrazioneDTO mapForm(Form form) {
        IntegrazioneDTO dto = new IntegrazioneDTO();
        dto.setId(form.getFormId());
        dto.setNome(form.getNome());
        return dto;
    }

    public void richiediIntegrazioni(ServiceContext serviceContext, long domandaBandoId, String tipoIntegrazione, String oggetto, String note, List<Long> integrazioni, List<String> allegati, String azioneUtente, String codiceOtpFirma, String password, boolean checkFirmaRichiestaIntegrazione) throws CommunicationException,
            FirmaDigitaleRemotaException, KosmosException, DataAccessException {

        DomandaBando domandaBando = null;
        long organizationId = 0;
        User currentUser = null;
        User cittadino = null;
        Organization organization = null;
        List<IstanzaDomandaBando> istanzaDomandaBandos = new ArrayList<IstanzaDomandaBando>();
        Bando bando = null;

        try {
            domandaBando = domandaBandoLocalService.getDomandaBando(domandaBandoId);
            bando = bandoLocalService.fetchBando(domandaBando.getBandoId());
            if (integrazioni == null || integrazioni.isEmpty()) {
                throw new PortalException("Nessun form integrativo selezionato per la richiesta: ID RICHIESTA " + domandaBandoId);
            }

            CommentoDomandaBando commentoDomandaBando = null;

            String taskId = getTaskId(domandaBando);

            organizationId = serviceContext.getScopeGroup().getOrganizationId();
            String tenantId = String.valueOf(organizationId);

            currentUser = userLocalService.getUser(serviceContext.getUserId());
            cittadino = userLocalService.getUser(domandaBando.getUserId());
            organization = organizationLocalService.getOrganization(organizationId);
            TipoIntegrazione tipoIntegrazioneEnum = TipoIntegrazione.valueOf(tipoIntegrazione);

            if (Validator.isNotNull(note)) {
                commentoDomandaBando = commentoDomandaBandoLocalService.addCommento(serviceContext, domandaBandoId, true, oggetto, note, taskId);
            }

            long commentoDomandaBandoId = 0;
            if(Validator.isNotNull(commentoDomandaBando)) {
                commentoDomandaBandoId = commentoDomandaBando.getCommentoDomandaBandoId();
            }

            // Creazione istanze form aggiuntive
            for (Long formId : integrazioni) {
                IstanzaDomandaBando istanzaDomandaBando = istanzaDomandaBandoLocalService.createIstanzaForm(domandaBandoId, formId, commentoDomandaBandoId);
                istanzaDomandaBandos.add(istanzaDomandaBando);
            }

            FaseWorkflowBandoEnum faseCorrente = recuperaFaseWorkflow(serviceContext, domandaBandoId);
            integrationDeadlinePopulator.populateDeadlines(domandaBandoId, domandaBando.getBandoId(), faseCorrente, istanzaDomandaBandos);

            Map<String, String> anticipazioneInfo = getAnticipazioneProtocolInfo(domandaBandoId, domandaBando.getBandoId(), integrazioni);

            List<AllegatoDomandaBando> allegatiEsterni = recuperaAllegatiPerIdDocumentale(allegati);

            boolean abilitaProtocollazioneSoccorsoIstruttorio = bando.isAbilitaProtocollazioneSoccorsoIstruttorio();
            boolean istanzePresenti = ListUtil.isNotNull(istanzaDomandaBandos) && ListUtil.isNotEmpty(istanzaDomandaBandos);

            // La verifica della dimensione complessiva ha senso solo se gli allegati aggiuntivi verranno
            // effettivamente protocollati (flag DISABILITA_PROTOCOLLAZIONE_ALLEGATI_INTEGRAZIONE attivo).
            boolean protocollazioneAllegatiAttiva = isDatoBandoFlagAttivo(bando.getBandoId(), CodiceDatoBandoEnum.DISABILITA_PROTOCOLLAZIONE_ALLEGATI_INTEGRAZIONE);

            if (abilitaProtocollazioneSoccorsoIstruttorio && istanzePresenti) {
                if (protocollazioneAllegatiAttiva) {
                    verificaDimensioneComplessivaProtocollazione(bando, domandaBando, istanzaDomandaBandos, allegatiEsterni,
                            serviceContext.getPortalURL(), commentoDomandaBandoId, currentUser.getUserId(), anticipazioneInfo);
                }

                for (IstanzaDomandaBando istanzaDomandaBando : istanzaDomandaBandos) {
                    if (Validator.isNull(istanzaDomandaBando)) {
                        continue;
                    }

                    RollbackContext rollbackCtx = RollbackContext.perRichiestaIntegrazione(domandaBando, istanzaDomandaBandos, commentoDomandaBandoId, "Exception generica");

                    try {
                        if (checkFirmaRichiestaIntegrazione) {
                            protocollazioneIntegrazioniService.protocollaRichiestaIntegrazioneCompleto(rollbackCtx, bando, istanzaDomandaBando, serviceContext.getPortalURL(), commentoDomandaBandoId, organizationId, currentUser.getUserId(), codiceOtpFirma, password, anticipazioneInfo, allegatiEsterni);
                        } else {
                            protocollazioneIntegrazioniService.protocollaRichiestaIntegrazioneCompleto(rollbackCtx, bando, istanzaDomandaBando, serviceContext.getPortalURL(), commentoDomandaBandoId, organizationId, currentUser.getUserId(), null, null, anticipazioneInfo, allegatiEsterni);
                        }
                    } catch(FirmaDigitaleRemotaException e) {
                        rollbackCtx.setEccezione("FirmaDigitaleRemotaException");
                        rollbackProtocollazioneService.rollbackRichiestaIntegrazione(rollbackCtx);
                        throw e;
                    } catch(KosmosException e) {
                        rollbackCtx.setEccezione("KosmosException");
                        rollbackProtocollazioneService.rollbackRichiestaIntegrazione(rollbackCtx);
                        throw e;
                    } catch(DataAccessException e) {
                        rollbackCtx.setEccezione("DataAccessException");
                        rollbackProtocollazioneService.rollbackRichiestaIntegrazione(rollbackCtx);
                        throw e;
                    } catch(Exception e) {
                        log.error("richiediIntegrazioni :: errore per domanda bando ID " + domandaBandoId, e);
                        rollbackCtx.setEccezione("Exception generica");
                        rollbackProtocollazioneService.rollbackRichiestaIntegrazione(rollbackCtx);
                        // Cerca ricorsivamente se l'eccezione originale è una delle nostre eccezioni custom
                        Throwable cause = e;
                        while (cause != null) {
                            if (cause instanceof FirmaDigitaleRemotaException) {
                                throw (FirmaDigitaleRemotaException) cause;
                            } else if (cause instanceof KosmosException) {
                                throw (KosmosException) cause;
                            } else if (cause instanceof DataAccessException) {
                                throw (DataAccessException) cause;
                            }
                            cause = cause.getCause();
                        }
                        throw new DataAccessException("Si è verificato un errore durante l'elaborazione della richiesta. Si prega di riprovare più tardi.", e);
                    }
                }
            }


            impostaAllegatiVisibili(allegatiEsterni);

            boolean isEsecuzione = verificaFaseCamunda(serviceContext,domandaBando.getDomandaBandoId(),"ATTIVITA_BENEFICIARIO");

            if (isEsecuzione && bando.getAbilitaEsecuzioneIntegrazione()) {

                if (ListUtil.isNotNull(istanzaDomandaBandos) && ListUtil.isNotEmpty(istanzaDomandaBandos)) {
                    List<String> tipoFormEsecuzioneList = new ArrayList<>();
                    tipoFormEsecuzioneList.add(TipoFormEnum.ESECUZIONE.name());
                    List<Long> formIdsToExclude = new ArrayList<>();

                    List<BandoForm> esecuzioneForms = bandoFormLocalService.getListaBandoFormBandoAndTipoFormAndFormIdNotIn(domandaBando.getBandoId(), tipoFormEsecuzioneList, formIdsToExclude);

                    List<IstanzaDomandaBando> tutteLeIstanze =
                            istanzaDomandaBandoLocalService.getIstanzeDomandeBandoByDomandaBandoId(domandaBandoId);

                    Map<Long, IstanzaDomandaBando> ultimaIstanzaPerForm = tutteLeIstanze.stream()
                            .collect(Collectors.toMap(
                                    IstanzaDomandaBando::getFormId,
                                    i -> i,
                                    (i1, i2) -> i1.getCreateDate().after(i2.getCreateDate()) ? i1 : i2
                            ));

                    for (IstanzaDomandaBando istanzaCorrente : istanzaDomandaBandos) {
                        Form formCorrente = formLocalService.fetchForm(istanzaCorrente.getFormId());
                        if (formCorrente == null) continue;

                        String codiceFormCorrente = formCorrente.getCodice();

                        for (BandoForm bfEsecuzione : esecuzioneForms) {

                            IstanzaDomandaBando ultimaIstanza = ultimaIstanzaPerForm.get(bfEsecuzione.getFormId());
                            if (ultimaIstanza == null) continue;

                            Form formEsecuzione = formLocalService.fetchForm(bfEsecuzione.getFormId());
                            if (formEsecuzione == null) continue;

                            Map<String, String> infoMap = getFormInformation(formEsecuzione, ultimaIstanza);

                            infoMap.forEach((formAttuale, formDaMostrare) -> {
                                if (codiceFormCorrente.equals(formDaMostrare)) {
                                    IstanzaDomandaBando istanzaDomandaBando = istanzaDomandaBandoLocalService.fetchIstanzaDomandaBando(ultimaIstanza.getIstanzaDomandaBandoId());
                                    istanzaDomandaBando.setStato(StatoIntegrazioneDomandaBandoEnum.DA_INTEGRARE.name());
                                    istanzaDomandaBando = istanzaDomandaBandoLocalService.updateIstanzaDomandaBando(istanzaDomandaBando);

                                    azioneOperatoreLocalService.addAzioneOperatore(
                                            serviceContext,
                                            istanzaDomandaBando.getDomandaBandoId(),
                                            serviceContext.getUserId(),
                                            new Date(),
                                            AzioniOperatoreCodes.RICHIESTA_INTEGRAZIONE_SERVIZIO_ESECUZIONE.name()
                                    );

                                    sendNotificaCittadinoRichiestaIntegrazioneEsecuzione(istanzaDomandaBando);
                                }
                            });
                        }
                    }
                }
            }else{
                camundaClient.updateProcessInstanceVariableByBusinessKey(domandaBando.getProcessInstanceId(), CustomProcessVariables.CAMBIO_STATO_WORKFLOW, String.valueOf(false), CustomProcessVariables.TYPE_BOOLEAN);

                List<Task> tasksByBusinessKey = camundaClient.getTasksByBusinessKey(tenantId, String.valueOf(domandaBandoId));
                if (tasksByBusinessKey != null) {

                    for (Task task : tasksByBusinessKey) {
                        if (taskId.equalsIgnoreCase(task.getId()) && String.valueOf(currentUser.getUserId()).equalsIgnoreCase(task.getAssignee())) {
                            List<TermineBando> terminiBando = termineBandoLocalService.getTermineBandoByBandoId(domandaBando.getBandoId());

                            List<Entry<String, String>> variables = new ArrayList<>();
                            Predicate<TermineBando> soloGiorniSolari = TermineBandoModel::isFestivi;
                            List<Entry<String, String>> listFestiviTrue = calcolaVariabiliTermini(terminiBando, soloGiorniSolari, DateUtils::getDuration);
                            variables.addAll(listFestiviTrue);

                            LocalDateTime inizioCalcolo = LocalDateTime.now();
                            Predicate<TermineBando> giorniSolariPiuFestivi = t -> !t.isFestivi();
                            List<Entry<String, String>> listFestiviFalse = calcolaVariabiliTermini(terminiBando, giorniSolariPiuFestivi, secondi -> DateUtils.getDurationConFestivi(inizioCalcolo, secondi));
                            variables.addAll(listFestiviFalse);

                            try {
                                camundaClient.completeTask(taskId, variables);
                            } catch (Exception e) {
                                log.error("Errore durante il completamento del task per domanda bando ID: " + domandaBandoId, e);
                                if (ListUtil.isNotNull(istanzaDomandaBandos) && ListUtil.isNotEmpty(istanzaDomandaBandos)) {
                                    for (IstanzaDomandaBando istanzaDomandaBando: istanzaDomandaBandos) {
                                        List<AllegatoDomandaBando> allegatoDomandaBandos = allegatoDomandaBandoLocalService.getListaAllegatiByIstanzaDomandaBandoIdAndInterno(istanzaDomandaBando.getIstanzaDomandaBandoId(), true);
                                        if (ListUtil.isNotNull(allegatoDomandaBandos) && ListUtil.isNotEmpty(allegatoDomandaBandos) && allegatoDomandaBandos.size() == 1) {
                                            AllegatoDomandaBando allegatoDomandaBando = allegatoDomandaBandos.get(0);
                                            fileServiceFactory.getActiveFileService().deleteRequestFile(allegatoDomandaBando.getIdDocumentale(), domandaBando.getGroupId());
                                            allegatoDomandaBandoLocalService.deleteAllegatoDomandaBando(allegatoDomandaBando);
                                        }
                                    }
                                }
                                throw new DataAccessException("Si è verificato un errore durante l'elaborazione della richiesta. Si prega di riprovare più tardi.");
                            }
                        }
                    }
                }

                camundaClient.updateProcessInstanceVariableByBusinessKey(domandaBando.getProcessInstanceId(),
                        Arrays.asList(new Variable(CustomProcessVariables.TIPO_INTEGRAZIONE, CustomProcessVariables.TYPE_STRING, tipoIntegrazioneEnum.name())));

                String stato = StatoDomandaBandoEnum.ATTESA_INTEGRAZIONI.name();

                if(tipoIntegrazioneEnum.equals(TipoIntegrazione.BROCHURE)){
                    stato = StatoDomandaBandoEnum.ATTESA_BROCHURE.name();
                }

                domandaBandoLocalService.updateStato(domandaBandoId, stato);

                azioneOperatoreLocalService.addAzioneOperatore(serviceContext, domandaBandoId, serviceContext.getUserId(), new Date(), AzioniOperatoreCodes.RICHIESTA_INTEGRAZIONE.name());
            }
        }
        catch (Exception e) {
            log.error("Errore durante richiediIntegrazioni per domanda bando ID: " + domandaBandoId, e);
            // Cerca ricorsivamente se l'eccezione originale è una delle nostre eccezioni custom
            Throwable cause = e;
            while (cause != null) {
                if (cause instanceof FirmaDigitaleRemotaException) {
                    throw (FirmaDigitaleRemotaException) cause;
                } else if (cause instanceof KosmosException) {
                    throw (KosmosException) cause;
                } else if (cause instanceof DataAccessException) {
                    throw (DataAccessException) cause;
                }
                cause = cause.getCause();
            }
            throw new DataAccessException("Si è verificato un errore durante l'elaborazione della richiesta. Si prega di riprovare più tardi.", e);
        }

        // invio email al cittadino

        String statoRichiestaLabel = getStatoLabel(domandaBando);
        Utente utente = getUtente(cittadino);

        AccountDto emailAccount = getEmailAccountByBandoId(domandaBando.getBandoId());
        communicationService.sendRichiestaIntegrazioneBandiCommunication(organization.getName(), domandaBandoId, domandaBando.getOggetto(), statoRichiestaLabel, utente, domandaBando.getCompanyId(), domandaBando.getGroupId(), emailAccount);
    }

    private List<Entry<String, String>> calcolaVariabiliTermini(
            List<TermineBando> termini,
            Predicate<TermineBando> filtroTermini,
            LongFunction<Duration> calcoloDurata) {

        return termini.stream()
                .filter(t -> Validator.isNull(t.getDataScadenza()))
                .filter(filtroTermini)
                .map(t -> Map.entry(t.getCodice(), calcoloDurata.apply(t.getSecondi()).toString()))
                .collect(Collectors.toList());
    }

    private List<AllegatoDomandaBando> recuperaAllegatiPerIdDocumentale(List<String> idDocumentali) {
        if (idDocumentali == null || idDocumentali.isEmpty()) {
            return Collections.emptyList();
