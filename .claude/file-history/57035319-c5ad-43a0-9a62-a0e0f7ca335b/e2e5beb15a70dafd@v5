    public Map<String, Task> getOrganizationTasks(ServiceContext serviceContext, List<VariableQueryParameter> variableQueryParameters, Integer firstResult, Integer maxResults,
                                                  VariableSortOrder variableSortOrder) {
        try {
            List<Long> organizationIds = getUserSubOrganizationIds(serviceContext);

            List<String> organizationIdsStrings = organizationIds.stream().map(Object::toString).collect(Collectors.toList());

            log.debug("organizationIdsStrings: " + organizationIdsStrings.toString());

            List<String> tenantIds = new ArrayList<String>();
            tenantIds.add(String.valueOf(serviceContext.getScopeGroup().getOrganizationId()));

            List<Task> searchTasks = camundaClient.searchTasks(tenantIds, organizationIdsStrings, null, false, variableQueryParameters,
                    firstResult, maxResults, variableSortOrder.getSortName(), variableSortOrder.getSortOrder(), variableSortOrder.getSortType());

            log.debug("searchTasks: " + searchTasks);

            Map<String, Task> map = new LinkedHashMap<>();
            for (Task task : searchTasks) {
                map.put(task.getProcessInstanceId(), task);
            }

            return map;
        }
        catch (PortalException e1) {
            log.error("getProcessInstanceIds :: " + e1.getMessage(), e1);
        }
        catch (CamundaClientException e1) {
            log.error("getProcessInstanceIds :: " + e1.getMessage(), e1);
        }
        return null;
    }

    public List<AzioneUtenteDTO> getAzioni(ServiceContext serviceContext, long domandaBandoId, boolean isEsecuzione, boolean isAbilitaEsecuzioneIntegrazione) {

        List<AzioneUtenteDTO> azioniUtente = new ArrayList<>();
        try {
            long userId = serviceContext.getUserId();
            User currentUser = userLocalService.getUser(userId);

            String tenantId = String.valueOf(serviceContext.getScopeGroup().getOrganizationId());
            List<Task> tasksByBusinessKey = camundaClient.getTasksByBusinessKey(tenantId, String.valueOf(domandaBandoId));
            if (tasksByBusinessKey != null) {
                for (Task task : tasksByBusinessKey) {
                    String assignee = task.getAssignee();
                    if (assignee != null && assignee.contentEquals(String.valueOf(currentUser.getUserId()))) {
                        List<VariableInstance> variablesByTaskId = camundaClient.getVariablesByExecutionId(tenantId, task.getExecutionId());
                        if (variablesByTaskId != null) {
                            for (VariableInstance variableInstance : variablesByTaskId) {
                                azioniUtente.addAll(getActionByVariable(variableInstance));
                            }
                        }
                        boolean richiestaIntegrazionePresente = azioniUtente.stream()
                                .anyMatch(a -> CamundaCodiciOperazioniUtente.RICHIESTA_INTEGRAZIONE.name().equals(a.getCodiceAzioneUtente()));

                        if (!richiestaIntegrazionePresente && isEsecuzione && isAbilitaEsecuzioneIntegrazione) {
                            AzioneUtenteDTO integrazione = new AzioneUtenteDTO();
                            integrazione.setCodiceAzioneUtente(CamundaCodiciOperazioniUtente.RICHIESTA_INTEGRAZIONE.name());
                            integrazione.setDescrizione("Richiedi Modifiche\\Integrazioni al Richiedente");
                            azioniUtente.add(integrazione);
                        }

                        if (task.getCandidateGroups() != null && !task.getCandidateGroups().isEmpty()) {
                            AzioneUtenteDTO e = new AzioneUtenteDTO();
                            e.setCodiceAzioneUtente(CamundaCodiciOperazioniUtente.RILASCIA_TASK.getValue());
                            e.setDescrizione("Rilascia");
                            azioniUtente.add(e);
                        }

                        break;
                    }
                }
            }
        }
        catch (CamundaClientException | PortalException e) {
            log.error("getAzioniUtenteDettaglioRichiesta :: " + e.getMessage(), e);
        }

        for (AzioneUtenteDTO azioneutente : azioniUtente) {
            azioneutente.setNumeroOrdine(AzioniOperatoreCodes.findPrioritaByAzione(azioneutente.getCodiceAzioneUtente()));
        }

        azioniUtente.sort(Comparator.comparing(AzioneUtenteDTO::getNumeroOrdine));
        return azioniUtente;
    }

