    public void sendNotificaApprovazione(long domandaBandoId, TipoFormEnum tipoForm) throws CommunicationException, PortalException {
        DomandaBando domandaBando = domandaBandoLocalService.fetchDomandaBando(domandaBandoId);
        List<Long> formIds = istanzaDomandaBandoLocalService.getFormIdByBandoIdAndTipoForm(domandaBando.getBandoId(), Collections.singletonList(tipoForm.name()), domandaBandoId);

        if(ListUtil.isNotNull(formIds) && ListUtil.isNotEmpty(formIds) && formIds.size() == 1){
            Form form = formLocalService.fetchForm(formIds.get(0));

            Bando bando = bandoLocalService.fetchBando(domandaBando.getBandoId());
            User user = userLocalService.getUser(domandaBando.getUserId());
            List<IstanzaDomandaBando> istanzaDomandaBandoList = istanzaDomandaBandoLocalService.getListIstanzaDomandaBandoByDomandaBandoIdAndListaFormId(domandaBandoId, formIds);
            IstanzaDomandaBando istanzaDomandaBando = null;
            if (ListUtil.isNotNull(istanzaDomandaBandoList) && ListUtil.isNotEmpty(istanzaDomandaBandoList) && istanzaDomandaBandoList.size() == 1) {
                istanzaDomandaBando = istanzaDomandaBandoList.get(0);
            }

            DomandaBandoIntegrazione domandaBandoIntegrazione = null;
            if (Validator.isNotNull(istanzaDomandaBando)) {
                domandaBandoIntegrazione = domandaBandoIntegrazioneLocalService.getDomandaBandoIntegrazione(istanzaDomandaBando.getIstanzaDomandaBandoId());
            }
            TipologiaBandoEnum tipologiaBandoEnum = getTipologiaBandoEnum(bando.getTipologiaBandoId());
            boolean isAvvisoLiquidazioneContributi = false;

            if (Validator.isNotNull(tipologiaBandoEnum)) {
                isAvvisoLiquidazioneContributi = tipologiaBandoEnum.equals(TipologiaBandoEnum.AVVISO_LIQUIDAZIONE_CONTRIBUTI);
            }

            SimpleDateFormat sdf = new SimpleDateFormat("dd/MM/yyyy");
            if(Validator.isNotNull(domandaBando)) {
                Utente utente = getUtente(user);
                AccountDto emailAccount = getEmailAccountByBando(bando);
                switch (tipoForm) {
                    case ESECUZIONE_ANTICIPO:
                        communicationService.sendNotificaApprovazioneBackOffice(domandaBando.getDomandaBandoId(), domandaBando.getCompanyId(), domandaBando.getGroupId(), utente, bando.getNome(), form.getNome(), emailAccount, domandaBando.getRagioneSociale());
                        break;
                    case ESECUZIONE_PRIMO_ANTICIPO:
                        if (Validator.isNotNull(domandaBandoIntegrazione) && Validator.isNotNull(istanzaDomandaBando)) {
                            communicationService.sendNotificaApprovazionePrimoAnticipoBackOffice(domandaBandoId, utente, domandaBando.getCompanyId(), domandaBando.getGroupId(), emailAccount, bando.getDescrizioneBreve(), domandaBandoIntegrazione.getNumeroProtocollo(), sdf.format(domandaBandoIntegrazione.getDataProtocollo()), sdf.format(domandaBando.getDataArrivo()), isAvvisoLiquidazioneContributi, domandaBando.getRagioneSociale());
                        }
                        break;
                    case ESECUZIONE_SECONDO_ANTICIPO:
                        if (Validator.isNotNull(domandaBandoIntegrazione) && Validator.isNotNull(istanzaDomandaBando)) {
                            communicationService.sendNotificaApprovazioneSecondoAnticipoBackOffice(domandaBandoId, utente, domandaBando.getCompanyId(), domandaBando.getGroupId(), emailAccount, bando.getDescrizioneBreve(), domandaBandoIntegrazione.getNumeroProtocollo(), sdf.format(domandaBandoIntegrazione.getDataProtocollo()), sdf.format(domandaBando.getDataArrivo()), isAvvisoLiquidazioneContributi, domandaBando.getRagioneSociale());
                        }
                        break;
                }

            }
        }

    }

    public List<AllegatoDTO> getListaAllegatiByIstanza(long istanzaDomandaBandoId, boolean interno, int start, int end) {
        List<AllegatoDomandaBando> listaAllegati = allegatoDomandaBandoLocalService.getAllegatiByIstanzaDomandaBandoIdAndInterno(istanzaDomandaBandoId, interno, start, end);
        Set<Long> idsUsati = caricaIdsAllegatiUsatiPerListaAllegati(listaAllegati);
        return listaAllegati.stream()
                .map(allegato -> mapAllegato(allegato, idsUsati))
                .collect(Collectors.toList());
    }

