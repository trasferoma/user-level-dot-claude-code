    private DataAccessException buildEccezioneDimensioneSuperata() {
        return new DataAccessException("La dimensione complessiva dei documenti da protocollare supera il limite consentito di " + DIMENSIONE_MAX_PROTOCOLLAZIONE_MEGA + " MB. Rimuovere alcuni allegati e riprovare.");
    }

    private void verificaDimensioneComplessivaChiusura(Bando bando, DomandaBando domandaBando, List<AllegatoDomandaBando> allegatiEsterni, String portalURL, long commentoDomandaBandoId, long userIdOperatore, StatoDomandaBandoEnum statoDomandaBando) throws DataAccessException {
        if (allegatiEsterni.isEmpty()) {
            return;
        }

        long dimensioneTotale = stimaDimensionePdfChiusura(bando, domandaBando, portalURL, commentoDomandaBandoId, userIdOperatore, statoDomandaBando, allegatiEsterni);
        if (dimensioneTotale > DIMENSIONE_MAX_PROTOCOLLAZIONE_BYTES) {
            throw buildEccezioneDimensioneSuperata();
        }

        for (AllegatoDomandaBando allegato : allegatiEsterni) {
            dimensioneTotale += recuperaDimensioneAllegato(allegato);
            if (dimensioneTotale > DIMENSIONE_MAX_PROTOCOLLAZIONE_BYTES) {
                throw buildEccezioneDimensioneSuperata();
            }
        }
    }

    private long stimaDimensionePdfChiusura(Bando bando, DomandaBando domandaBando, String portalURL, long commentoDomandaBandoId, long userIdOperatore, StatoDomandaBandoEnum statoDomandaBando, List<AllegatoDomandaBando> allegatiEsterni) throws DataAccessException {
        try {
            TipoGenerazionePDF tipoGenerazionePDF = TipoGenerazionePDF.valueOf(bando.getTipoGenerazionePDFEsitoDomanda());
            PDFService pdfService = pdfServiceFactory.getPDFService(tipoGenerazionePDF);
            byte[] pdfGenerato = pdfService.generaPDFEsitoDomanda(domandaBando, CodiceTemplatePdf.ESITO_DOMANDA.name(), portalURL, commentoDomandaBandoId, userIdOperatore, statoDomandaBando, allegatiEsterni);
            if (pdfGenerato == null) {
