    private String getTaskId(DomandaBando domandaBando) {
        List<Task> tasks = camundaClient.searchTasks(domandaBando.getProcessInstanceId());
        if (tasks.isEmpty()) {
            throw new RuntimeException("No task");
        }

        if (tasks.size() > 1) {
            log.warn("Piu task per processo " + domandaBando.getProcessInstanceId());
        }

        return tasks.get(0).getId();
    }

    public void chiudiPratica(ServiceContext serviceContext, long domandaBandoId, String variableSet, String variableVal, String oggetto, String commento, List<String> selezionati, long groupId, String portalURL, String riconoscimentoAssegnato, String codiceOtp, String password, boolean checkFirmaRichiesta) {
        try {
            DomandaBando domandaBando = domandaBandoLocalService.getDomandaBando(domandaBandoId);
            Bando bando = bandoLocalService.fetchBando(domandaBando.getBandoId());
            String taskId = getTaskId(domandaBando);
            long organizationId = serviceContext.getScopeGroup().getOrganizationId();

            String tenantId = String.valueOf(serviceContext.getScopeGroup().getOrganizationId());

            User currentUser = userLocalService.getUser(serviceContext.getUserId());

            List<Task> tasksByBusinessKey = camundaClient.getTasksByBusinessKey(tenantId, String.valueOf(domandaBandoId));

            long commentoDomandaBandoId = 0;
            if (Validator.isNotNull(commento)) {
                CommentoDomandaBando commentoDomandaBando = commentoDomandaBandoLocalService.addCommento(serviceContext, domandaBandoId, true, oggetto, commento, taskId);

                if(Validator.isNotNull(commentoDomandaBando)){
                    commentoDomandaBandoId = commentoDomandaBando.getCommentoDomandaBandoId();
                }
            }

            List<AllegatoDomandaBando> allegatiEsterni = recuperaAllegatiPerIdDocumentale(selezionati);

            if (bando.isAbilitaProtocollazioneEsito()){
                StatoDomandaBandoEnum statoDomandaBando;
                if (CustomProcessVariables.ESITO_PROCEDIMENTO_POSITIVO.equalsIgnoreCase(variableVal)) {
                    statoDomandaBando = StatoDomandaBandoEnum.CHIUSA_POSITIVAMENTE;
                } else {
                    statoDomandaBando = StatoDomandaBandoEnum.CHIUSA_NEGATIVAMENTE;
                }

                if (!allegatiEsterni.isEmpty()) {
                    verificaDimensioneComplessivaChiusura(bando, domandaBando, allegatiEsterni,
                            serviceContext.getPortalURL(), commentoDomandaBandoId,
                            currentUser.getUserId(), statoDomandaBando);
                }

                TipoProvvedimentoDomandaBando tipoProvvedimentoDomandaBando = mapStatoDomandaInTipoProvvedimento(statoDomandaBando);
                RollbackContext rollbackCtx = RollbackContext.perChiusuraDomanda(domandaBando, commentoDomandaBandoId, tipoProvvedimentoDomandaBando, "Errore protocollazione chiusura domanda");

                try {
                    if (checkFirmaRichiesta) {
                        protocollazioneIntegrazioniService.protocollaChiusuraDomanda(rollbackCtx, bando, domandaBando, commentoDomandaBandoId, serviceContext.getPortalURL(), organizationId, currentUser.getUserId(), codiceOtp, password, statoDomandaBando, allegatiEsterni);
                    } else {
                        protocollazioneIntegrazioniService.protocollaChiusuraDomanda(rollbackCtx, bando, domandaBando, commentoDomandaBandoId, serviceContext.getPortalURL(), organizationId, currentUser.getUserId(), null, null, statoDomandaBando, allegatiEsterni);
                    }
                } catch(FirmaDigitaleRemotaException e) {
                    rollbackCtx.setEccezione("FirmaDigitaleRemotaException");
                    rollbackProtocollazioneService.rollbackChiusuraDomanda(rollbackCtx);
                    throw e;
                } catch(KosmosException e) {
                    rollbackCtx.setEccezione("KosmosException");
                    rollbackProtocollazioneService.rollbackChiusuraDomanda(rollbackCtx);
                    throw e;
                } catch(DataAccessException e) {
                    rollbackCtx.setEccezione("DataAccessException");
                    rollbackProtocollazioneService.rollbackChiusuraDomanda(rollbackCtx);
                    throw e;
                } catch(Exception e) {
                    log.error("richiediIntegrazioni :: errore per domanda bando ID " + domandaBandoId, e);
                    rollbackCtx.setEccezione("Exception generica");
                    rollbackProtocollazioneService.rollbackChiusuraDomanda(rollbackCtx);
                    // Cerca ricorsivamente se l'eccezione originale è una delle nostre eccezioni custom
                    Throwable cause = e;
                    while (cause != null) {
                        if (cause instanceof FirmaDigitaleRemotaException) {
                            throw (FirmaDigitaleRemotaException) cause;
                        } else if (cause instanceof KosmosException) {
                            throw (KosmosException) cause;
                        } else if (cause instanceof DataAccessException) {
                            throw (DataAccessException) cause;
                        }
                        cause = cause.getCause();
                    }
                    throw new DataAccessException("Si è verificato un errore durante l'elaborazione della richiesta. Si prega di riprovare più tardi.", e);
                }

            }

            impostaAllegatiVisibili(allegatiEsterni);

            if (tasksByBusinessKey != null) {
                for (Task task : tasksByBusinessKey) {
                    if (taskId.equalsIgnoreCase(task.getId()) && String.valueOf(currentUser.getUserId()).equalsIgnoreCase(task.getAssignee())) {
                        List<Entry<String, String>> variables = new ArrayList<>();

                        if (Validator.isNotNull(variableSet)) {
                            variables.add(new AbstractMap.SimpleEntry<>(variableSet, variableVal));
                        }
                        camundaClient.completeTask(taskId, variables);
                    }
                }
            }

            if (CustomProcessVariables.ESITO_PROCEDIMENTO_POSITIVO.equals(variableVal)) {
                if (Validator.isNotNull(bando) && Validator.isNotNull(bando.getTipologiaBandoId())) {
                    TipologiaBando tipoBando = tipologiaBandoLocalService.fetchTipologiaBando(bando.getTipologiaBandoId());
                    if (Validator.isNotNull(tipoBando)) {
                        if (tipoBando.getCodice().equalsIgnoreCase(TipologiaBandoEnum.ISCRIZIONE_ELENCO.name())) {
                            exportInserimentoElencoConfiguration = configurationProvider.getGroupConfiguration(BandiInserimentoElencoConfiguration.class, groupId);
                            String codiBandiInsegneStoriche = exportInserimentoElencoConfiguration.codiciBandiInsegneStoriche();
                            List<String> listaCodiBandiInsegneStoriche = Arrays.asList(codiBandiInsegneStoriche.split(","));
                            //se il codice bando � presente nella configurazione, salvo i dati in tabella
                            if (listaCodiBandiInsegneStoriche.contains(bando.getCodice())){
                                salvaRiconoscimentoAssegnato(domandaBando, riconoscimentoAssegnato, currentUser);
                                salvaInsegnaStorica(domandaBando,portalURL, riconoscimentoAssegnato);
                            }
                        }
                    }
                }
            }

           azioneOperatoreLocalService.addAzioneOperatore(serviceContext, domandaBandoId, serviceContext.getUserId(), new Date(),
                    CustomProcessVariables.ESITO_PROCEDIMENTO_POSITIVO.equals(variableVal) ? AzioniOperatoreCodes.ESITO_PROCEDIMENTO_POSITIVO.name()
                            : AzioniOperatoreCodes.ESITO_PROCEDIMENTO_NEGATIVO.name());
        } catch (Exception e) {
            log.error("Errore durante richiediIntegrazioni per domanda bando ID: " + domandaBandoId, e);
            // Cerca ricorsivamente se l'eccezione originale è una delle nostre eccezioni custom
            Throwable cause = e;
            while (cause != null) {
                if (cause instanceof FirmaDigitaleRemotaException) {
                    throw (FirmaDigitaleRemotaException) cause;
                } else if (cause instanceof KosmosException) {
                    throw (KosmosException) cause;
                } else if (cause instanceof DataAccessException) {
                    throw (DataAccessException) cause;
                }
                cause = cause.getCause();
            }
            throw new DataAccessException("Si è verificato un errore durante l'elaborazione della richiesta. Si prega di riprovare più tardi.", e);
        }
    }

    private void salvaRiconoscimentoAssegnato(DomandaBando domandaBando, String riconoscimentoAssegnato, User operatoreUser) {
        Map.of(
                "TIPOLOGIA_RICONOSCIMENTO_INSEGNA", riconoscimentoAssegnato
        ).forEach((chiave, valore) -> {
            long id = counterLocalService.increment();
            DomandaBandoDatoAggiuntivo datoAggiuntivo = domandaBandoDatoAggiuntivoLocalService.createDomandaBandoDatoAggiuntivo(id);
            datoAggiuntivo.setGroupId(domandaBando.getGroupId());
            datoAggiuntivo.setCompanyId(domandaBando.getCompanyId());
            datoAggiuntivo.setUserId(operatoreUser.getUserId());
            datoAggiuntivo.setUserName(operatoreUser.getFullName());
            datoAggiuntivo.setChiave(chiave);
            datoAggiuntivo.setValore(valore);
            datoAggiuntivo.setDomandaBandoId(domandaBando.getDomandaBandoId());

            domandaBandoDatoAggiuntivoLocalService.updateDomandaBandoDatoAggiuntivo(datoAggiuntivo);
        });
    }

    public void chiudiPraticaConCancellazioneProcesso(ServiceContext serviceContext, long domandaBandoId, String commento, List<String> selezionati, String codiceOtp, String password, boolean checkFirmaRichiesta) {
        try {
            DomandaBando domandaBando = domandaBandoLocalService.getDomandaBando(domandaBandoId);
            Bando bando = bandoLocalService.fetchBando(domandaBando.getBandoId());
            long organizationId = serviceContext.getScopeGroup().getOrganizationId();
            User currentUser = userLocalService.getUser(serviceContext.getUserId());

            String processInstanceId = domandaBando.getProcessInstanceId();
            if (Validator.isNotNull(processInstanceId) && camundaClient.existProcess(processInstanceId)) {
                String tenantId = String.valueOf(organizationId);

                boolean supportaCorrelateMessage = false;
                try {
                    List<VariableInstance> variables = camundaClient.getVariablesByProcessInstanceId(processInstanceId);
                    if (variables != null) {
                        supportaCorrelateMessage = variables.stream()
                                .anyMatch(v -> GestioneBandiCommonConstants.SUPPORTA_CHIUDI_PRATICA_ESITO_NEGATIVO.equals(v.getName()));
                    }
                } catch (Exception e) {
                    log.warn("Errore nel recupero variabili processo per domanda bando ID: " + domandaBandoId, e);
                }

                if (supportaCorrelateMessage) {
                    try {
                        camundaClient.correlateMessage(tenantId, CustomProcessVariablesBandi.CHIUDI_PRATICA_PRE_CONCESSIONE.name(), String.valueOf(domandaBandoId));
                    } catch (CamundaClientException e) {
                        log.warn("Correlate message CHIUDI_PRATICA_ESITO_NEGATIVO non riuscito per domanda bando ID: " + domandaBandoId + ". Fallback a cancellazione processo.", e);
                    }
                }else{
                    camundaClient.deleteProcessInstance(domandaBando.getProcessInstanceId());
                }
            }

            domandaBandoLocalService.updateStato(domandaBandoId, StatoDomandaBandoEnum.CHIUSA_NEGATIVAMENTE.name());

            long commentoDomandaBandoId = 0;
            if (Validator.isNotNull(commento)) {
                CommentoDomandaBando commentoDomandaBando = commentoDomandaBandoLocalService.addCommento(serviceContext, domandaBandoId, true, commento, null);

                if (Validator.isNotNull(commentoDomandaBando)) {
                    commentoDomandaBandoId = commentoDomandaBando.getCommentoDomandaBandoId();
                }
            }

            StatoDomandaBandoEnum statoDomandaBando = StatoDomandaBandoEnum.CHIUSA_NEGATIVAMENTE;
            TipoProvvedimentoDomandaBando tipoProvvedimentoDomandaBando = mapStatoDomandaInTipoProvvedimento(statoDomandaBando);
            RollbackContext rollbackCtx = RollbackContext.perChiusuraDomanda(domandaBando, commentoDomandaBandoId, tipoProvvedimentoDomandaBando, "Errore protocollazione chiusura domanda");

            if (bando.isAbilitaProtocollazioneEsito()) {
                try {
                    domandaBando = domandaBandoLocalService.getDomandaBando(domandaBandoId);

                    if (checkFirmaRichiesta) {
                        protocollazioneIntegrazioniService.protocollaChiusuraDomanda(rollbackCtx, bando, domandaBando, commentoDomandaBandoId, serviceContext.getPortalURL(), organizationId, currentUser.getUserId(), codiceOtp, password, statoDomandaBando, Collections.emptyList());
                    } else {
                        protocollazioneIntegrazioniService.protocollaChiusuraDomanda(rollbackCtx, bando, domandaBando, commentoDomandaBandoId, serviceContext.getPortalURL(), organizationId, currentUser.getUserId(), null, null, statoDomandaBando, Collections.emptyList());
                    }
                } catch (Exception e) {
                    String idDocumentale = rollbackCtx.getIdDocumentaliGenerati().stream()
                            .findFirst()
                            .orElse(null);

                    if (idDocumentale != null) {
                        fileServiceFactory.getActiveFileService().deleteRequestFile(idDocumentale, domandaBando.getGroupId());
                        AllegatoDomandaBando allegatoDomandaBando = allegatoDomandaBandoLocalService.getAllegatoByIdDocumentale(idDocumentale);
                        allegatoDomandaBandoLocalService.deleteAllegatoDomandaBando(allegatoDomandaBando);
                    }

                    if (commentoDomandaBandoId > 0) {
                        try {
                            commentoDomandaBandoLocalService.deleteCommentoDomandaBando(commentoDomandaBandoId);
                        } catch (Exception rollbackEx) {
                            log.error("Errore durante il rollback del commento, domanda bando ID: " + domandaBandoId, rollbackEx);
                        }
                    }
                    log.error("Errore durante la protocollazione della chiusura domanda bando, ID: " + domandaBandoId, e);
                }
            }

            azioneOperatoreLocalService.addAzioneOperatore(serviceContext, domandaBandoId, serviceContext.getUserId(), new Date(), AzioniOperatoreCodes.ESITO_PROCEDIMENTO_NEGATIVO.name());
        } catch (CamundaClientException e) {
            throw new RuntimeException("Errore nella cancellazione del processo Camunda per domanda bando ID: " + domandaBandoId, e);
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
    }

