    public void rimandaReferente(ServiceContext serviceContext, long domandaBandoId, String variableSet, String variableVal, String commento) {
        try {
            String tenantId = String.valueOf(serviceContext.getScopeGroup().getOrganizationId());

            User currentUser = userLocalService.getUser(serviceContext.getUserId());

            DomandaBando domandaBando = domandaBandoLocalService.getDomandaBando(domandaBandoId);

            String taskId = getTaskId(domandaBando);

            // Completa task
            List<Task> tasksByBusinessKey = camundaClient.getTasksByBusinessKey(tenantId, String.valueOf(domandaBandoId));
            if (tasksByBusinessKey != null) {

                for (Task task : tasksByBusinessKey) {
                    if (taskId.equalsIgnoreCase(task.getId()) && String.valueOf(currentUser.getUserId()).equalsIgnoreCase(task.getAssignee())) {
                        List<Entry<String, String>> variables = new ArrayList<>();

                        if (Validator.isNotNull(variableSet)) {
                            variables.add(new AbstractMap.SimpleEntry<>(variableSet, variableVal));
                        }
                        camundaClient.completeTask(taskId, variables);
                    }
                }
            }

            // Aggiunta commento, se presente
            if (Validator.isNotNull(commento)) {
                commentoDomandaBandoLocalService.addCommento(serviceContext, domandaBandoId, false, commento, taskId);
            }

            azioneOperatoreLocalService.addAzioneOperatore(serviceContext, domandaBandoId, serviceContext.getUserId(), new Date(), AzioniOperatoreCodes.TIPO_OPERAZIONE_RIMANDA_REFERENTE.name());
        }
        catch (Exception e) {
            throw new RuntimeException(e);
        }
    }

