                            if(Validator.isNotNull(domandaBando)) {
                                if(Validator.isNotNull(domandaBando.getDomandaBandoId())) {
                                    graduatoriaSoggettoDTO.setDomandaBandoId(domandaBando.getDomandaBandoId());
