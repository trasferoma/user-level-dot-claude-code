        List<Long> domandaBandoIds = domande.stream().map(DomandaBando::getDomandaBandoId).collect(Collectors.toList());

        List<DatoAggiuntivoChiave> chiaviCandidate = DatoAggiuntivoChiave.getChiaviConExcelLabel();
        List<String> chiaviStr = chiaviCandidate.stream().map(DatoAggiuntivoChiave::name).collect(Collectors.toList());

        Set<String> chiaviTrovate = new HashSet<>();
        if (!domandaBandoIds.isEmpty() && !chiaviStr.isEmpty()) {
            List<DomandaBandoDatoAggiuntivo> datiAggiuntivi = domandaBandoDatoAggiuntivoLocalService
                    .getDomandaBandoDatoAggiuntivoByDomandaBandoIdAndChiave(domandaBandoIds, chiaviStr);
            chiaviTrovate = datiAggiuntivi.stream()
                    .map(DomandaBandoDatoAggiuntivo::getChiave)
                    .collect(Collectors.toSet());
        }

        Set<String> chiaviTrovateFinali = chiaviTrovate;
        List<DatoAggiuntivoChiave> chiaviPresenti = chiaviCandidate.stream()
                .filter(c -> chiaviTrovateFinali.contains(c.name()))
                .sorted(NUMERO_ORDINE_COMP)
                .collect(Collectors.toList());

        return chiaviPresenti;
    }

    public void loadDatiAggiuntivi(List<DomandaBandoConAmmissibilitaDTO> domandeBando, List<DatoAggiuntivoChiave> chiavi) throws Exception {
        List<Long> domandaBandoIds = domandeBando.stream().map(db -> db.getDomandaBandoId()).collect(Collectors.toList());
        List<String> chiaviStr = chiavi.stream().map(c -> c.name()).collect(Collectors.toList());

        List<DomandaBandoDatoAggiuntivo> datiAggiuntivi = domandaBandoDatoAggiuntivoLocalService.getDomandaBandoDatoAggiuntivoByDomandaBandoIdAndChiave(domandaBandoIds, chiaviStr);
        Map<Long, List<DomandaBandoDatoAggiuntivoDTO>> datiAggiuntiviMap = datiAggiuntivi.stream().collect(Collectors.groupingBy(da -> da.getDomandaBandoId(), Collectors.mapping(da -> new DomandaBandoDatoAggiuntivoDTO(DatoAggiuntivoChiave.valueOf(da.getChiave()), da.getValore()), Collectors.toList())));

        domandeBando.forEach(db -> {
            List<DomandaBandoDatoAggiuntivoDTO> lista = datiAggiuntiviMap.get(db.getDomandaBandoId());
            if (Validator.isNull(lista)) {
                lista = Collections.emptyList();
            }
            db.setDatiAggiuntivi(lista);
        });

        for (DomandaBandoConAmmissibilitaDTO db : domandeBando) {
            try {
                List<Valutazione> listaValutazioni = valutazioneLocalService.getValutazioneByDomandaBandoId(db.getDomandaBandoId());
                if (Validator.isNotNull(listaValutazioni) && listaValutazioni.size() == 1) {
                    Valutazione valutazione = listaValutazioni.get(0);
                    List<Punteggio> punteggi = punteggioLocalService.getListaPunteggiByValutazioneId(valutazione.getValutazioneId());
                    if (Validator.isNotNull(punteggi) && !punteggi.isEmpty()) {
                        List<CriterioDTO> listaPunteggiDTO = new ArrayList<>();
                        for (Punteggio p : punteggi) {
                            CriterioValutazione criterio = criterioValutazioneLocalService.fetchCriterioValutazione(p.getCriterioValutazioneId());
                            if (Validator.isNotNull(criterio)) {
                                listaPunteggiDTO.add(new CriterioDTO(criterio.getDescrizione(), p.getValore().intValue()));
                            }
                        }
                        db.setDettaglioValutazione(listaPunteggiDTO);
                    }
                }
            } catch (Exception e) {
                log.error("Errore nel caricamento punteggi per domandaBandoId " + db.getDomandaBandoId(), e);
            }
        }
    }

