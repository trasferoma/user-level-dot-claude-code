                                if(Validator.isNotNull(domandaBando.getTitoloProgetto())) {
                                    graduatoriaSoggettoDTO.setTitoloProgetto(domandaBando.getTitoloProgetto());
                                }

                                if(Validator.isNotNull(domandaBando.getRagioneSociale())) {
                                    graduatoriaSoggettoDTO.setRagioneSociale(domandaBando.getRagioneSociale());
                                }

                                if(Validator.isNotNull(domandaBando.getImportoAssegnato())) {
                                    graduatoriaSoggettoDTO.setImportoAssegnato(domandaBando.getImportoAssegnato());
                                }

                                if(Validator.isNotNull(domandaBando.getCostiAmmissibili())) {
                                    graduatoriaSoggettoDTO.setCostiAmmissibili(domandaBando.getCostiAmmissibili());
                                }

                                if(Validator.isNotNull(domandaBando.getStato())) {
                                    graduatoriaSoggettoDTO.setStatoDomandaBando(domandaBando.getStato());
                                }

                                if(Validator.isNotNull(graduatoriaSoggetto.getEsito())) {
