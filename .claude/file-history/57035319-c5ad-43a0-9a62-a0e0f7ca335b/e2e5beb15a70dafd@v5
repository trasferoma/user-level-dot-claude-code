    private byte[] creaZipAllegati(List<AllegatoDomandaBando> allegati, long domandaBandoId, long groupId) throws Exception {
        String identificativoRichiedente = null;
        try {
            DomandaBando domandaBando = domandaBandoLocalService.getDomandaBando(domandaBandoId);
            if (Validator.isNotNull(domandaBando)) {
                if (Validator.isNotNull(domandaBando.getPartitaIva())) {
                    identificativoRichiedente = domandaBando.getPartitaIva();
                } else if (Validator.isNotNull(domandaBando.getCodiceFiscale())) {
                    identificativoRichiedente = domandaBando.getCodiceFiscale();
                }
            }
        } catch (Exception e) {
            log.warn("creaZipAllegati :: impossibile recuperare DomandaBando con id=" + domandaBandoId + ": " + e.getMessage());
        }

        ByteArrayOutputStream byteArrayOutputStream = new ByteArrayOutputStream();
        try (ZipOutputStream zipOutputStream = new ZipOutputStream(byteArrayOutputStream)) {
            Map<String, Integer> nomiUtilizzati = new HashMap<>();

            for (AllegatoDomandaBando allegato : allegati) {
                String idDocumentale = allegato.getIdDocumentale();

                if (Validator.isNull(idDocumentale)) {
                    log.warn("creaZipAllegati :: allegato con id=" + allegato.getAllegatoDomandaBandoId() + " non ha idDocumentale, ignorato");
                    continue;
                }

                byte[] contenutoFile = null;
                try {
                    it.servizidigitali.file.utility.model.File fileScaricato =
                            fileServiceFactory.getActiveFileService().getRequestFile(idDocumentale, groupId);
                    if (Validator.isNotNull(fileScaricato)) {
                        contenutoFile = fileScaricato.getInputStream().readAllBytes();
                    }
                } catch (Exception e) {
                    log.warn("creaZipAllegati :: impossibile recuperare il file con idDocumentale=" + idDocumentale + " per allegato id=" + allegato.getAllegatoDomandaBandoId() + ": " + e.getMessage());
                    continue;
                }

                if (contenutoFile == null) {
                    log.warn("creaZipAllegati :: file null per idDocumentale=" + idDocumentale + ", ignorato");
                    continue;
                }

                String nomeFile = costruisciNomeFileAllegato(domandaBandoId, allegato, identificativoRichiedente);

                if (nomiUtilizzati.containsKey(nomeFile)) {
                    int contatore = nomiUtilizzati.get(nomeFile) + 1;
                    nomiUtilizzati.put(nomeFile, contatore);
                    int indicePunto = nomeFile.lastIndexOf('.');
                    if (indicePunto > 0) {
                        nomeFile = nomeFile.substring(0, indicePunto) + "_" + contatore + nomeFile.substring(indicePunto);
                    } else {
                        nomeFile = nomeFile + "_" + contatore;
                    }
                } else {
                    nomiUtilizzati.put(nomeFile, 1);
                }

                ZipEntry zipEntry = new ZipEntry(nomeFile);
                zipOutputStream.putNextEntry(zipEntry);
                zipOutputStream.write(contenutoFile);
                zipOutputStream.closeEntry();
            }
        }

        return byteArrayOutputStream.toByteArray();
    }

    private String costruisciNomeFileAllegato(long domandaBandoId, AllegatoDomandaBando allegato, String identificativoRichiedente) {
        String nomeOriginale = allegato.getNome();
        String estensione = "";
        if (Validator.isNotNull(nomeOriginale)) {
            int indicePunto = nomeOriginale.lastIndexOf('.');
            if (indicePunto >= 0) {
                estensione = nomeOriginale.substring(indicePunto);
            }
        }

        String nomeFileProcedura = null;
        boolean ripetibile = false;
        long definizioneAllegatoId = allegato.getDefinizioneAllegatoId();
        if (definizioneAllegatoId != 0) {
            try {
                it.servizidigitali.gestioneforms.model.DefinizioneAllegato definizioneAllegato =
                        definizioneAllegatoLocalService.fetchDefinizioneAllegato(definizioneAllegatoId);
                if (Validator.isNotNull(definizioneAllegato)) {
                    nomeFileProcedura = definizioneAllegato.getDenominazione().replaceAll("[/\\\\:*?\"<>|.]", "_");
                    ripetibile = definizioneAllegato.isRipetibile();
                }
            } catch (Exception e) {
                log.warn("costruisciNomeFileAllegato :: impossibile recuperare DefinizioneAllegato con id=" + definizioneAllegatoId + ": " + e.getMessage());
            }
        }

        if (Validator.isNull(nomeFileProcedura)) {
            return Validator.isNotNull(nomeOriginale) ? nomeOriginale : String.valueOf(allegato.getAllegatoDomandaBandoId());
        }

        StringBuilder sb = new StringBuilder();
        sb.append(domandaBandoId);

        if (ripetibile) {
            String identificativoAllegato = allegato.getIdentificativo();
            if (Validator.isNotNull(identificativoAllegato)) {
                sb.append("_").append(identificativoAllegato);
            } else if (Validator.isNotNull(identificativoRichiedente)) {
                sb.append("_").append(identificativoRichiedente);
            }
        }

        sb.append("_").append(nomeFileProcedura).append(estensione);

        return sb.toString();

    }

    private Stream<BandoForm> getBandoFormStreamDaIntegrareByDomandaBandoId(
            List<BandoForm> bandoForms, long domandaBandoId) {

        // Recupero tutte le istanze della domanda
        List<IstanzaDomandaBando> istanze = istanzaDomandaBandoLocalService
                .getIstanzeDomandeBandoByDomandaBandoId(domandaBandoId);

        // Mappa: formId → ultima istanza (per createDate, poi id per tie-break)
        Map<Long, IstanzaDomandaBando> ultimaIstanzaPerForm = istanze.stream()
                .collect(Collectors.toMap(
                        IstanzaDomandaBando::getFormId,
                        i -> i,
                        (i1, i2) -> {
                            int cmp = i1.getCreateDate().compareTo(i2.getCreateDate());
                            return (cmp > 0 || (cmp == 0 && i1.getIstanzaDomandaBandoId() > i2.getIstanzaDomandaBandoId()))
                                    ? i1 : i2;
                        }
                ));

        //Preload Form per evitare N+1
        Map<Long, Form> formMap = bandoForms.stream()
                .map(BandoForm::getFormId)
                .distinct()
                .map(formLocalService::fetchForm)
                .filter(Objects::nonNull)
                .collect(Collectors.toMap(Form::getFormId, f -> f));

        Set<String> codiciFormDaMostrare = new HashSet<>();

        List<BandoForm> bandoFormsInEsecuzione = bandoForms.stream()
                .filter(bf -> TipoFormEnum.ESECUZIONE.name().equals(bf.getTipoForm()))
                .collect(Collectors.toList());

        // Itero solo i BandoForm di tipo ESECUZIONE
        for (BandoForm bandoForm : bandoFormsInEsecuzione) {

            IstanzaDomandaBando ultimaIstanza = ultimaIstanzaPerForm.get(bandoForm.getFormId());

            // Nessuna istanza → ESCLUDI
            if (ultimaIstanza == null) {
                continue;
            }

            // Stato non valido → ESCLUDI
            if (!"INTEGRATA".equals(ultimaIstanza.getStato()) &&
                    !"CONFERMATA".equals(ultimaIstanza.getStato())) {
                continue;
            }

            Form form = formMap.get(bandoForm.getFormId());

            if (form != null) {
                String codice = getFormIntegrazioneEsecuzione(form, ultimaIstanza);

                // Se c'è formDaMostrare → includi
                if (Validator.isNotNull(codice)) {
                    codiciFormDaMostrare.add(codice);
                }
            }
        }

        // Filtro finale: ritorna solo i BandoForm i cui form hanno codice valido
        return bandoForms.stream()
                .filter(bf -> {
                    Form form = formMap.get(bf.getFormId());
                    return form != null && codiciFormDaMostrare.contains(form.getCodice());
                });
    }

