    //fasi camunda
    public boolean verificaFaseCamunda(ServiceContext serviceContext, long domandaBandoId, String fase) {
        try {
            long userId = serviceContext.getUserId();
            User currentUser = userLocalService.getUser(userId);
            String tenantId = String.valueOf(serviceContext.getScopeGroup().getOrganizationId());
            List<Task> tasksByBusinessKey = camundaClient.getTasksByBusinessKey(tenantId, String.valueOf(domandaBandoId));
            if (tasksByBusinessKey != null) {
                for (Task task : tasksByBusinessKey) {
                    String assignee = task.getAssignee();
                    if (assignee != null && assignee.contentEquals(String.valueOf(currentUser.getUserId()))) {
                        List<VariableInstance> variablesByTaskId = camundaClient.getVariablesByExecutionId(tenantId, task.getExecutionId());
                        if (variablesByTaskId != null) {
                            for (VariableInstance variableInstance : variablesByTaskId) {
                                if (fase.equals(variableInstance.getName())) return true;
                            }
                        }
                    }
                }
            }
        }
        catch (CamundaClientException | PortalException e) {
            log.error("verificaFaseCamunda :: " + e.getMessage(), e);
        }
        return false;
    }

    public List<String> handleDropdownAzioniDettaglioBando(List<String> listaRuoli, Bando bando) {
        ArrayList<String> azioni = new ArrayList<String>();

        if (Validator.isNotNull(bando) && Validator.isNotNull(bando.getBandoId())) {
            long bandoId = bando.getBandoId();
            boolean isAvvisoSportello = checkBandoIsAvvisoSportello(bandoId);
            boolean isEvento = checkBandoIsEvento(bandoId);
            boolean isConfidi = checkBandoIsConfidi(bandoId);
            boolean isIscrizioneElenco = checkBandoIsIscrizioneElenco(bandoId);
            boolean isProceduraNegozialeConValutazione = checkProceduraNegozialeConValutazione(bandoId);
            boolean graduatoriaProvvisoriaPresente = checkGraduatoriaProvvisoriaPresente(bandoId);
            boolean graduatoriaDefinitivaPresente = checkGraduatoriaDefinitivaPresente(bandoId);

            // AZIONI PER RUOLO GESTORE ATTIVITA STROICHE
            if (listaRuoli.contains(RuoliGestoreEnum.GESTORE_ATTIVITA_STORICHE.getRuolo())) {
                if (isIscrizioneElenco && bando.isBandoInsegneStoriche()) {
                    azioni.add(AzioniDettaglioBandoEnum.VISUALIZZA_INSEGNE_STORICHE.getValue());
                }
            }

            //AZIONI PER RUOLO GESTORE ATTIVITA STROICHE
            if (listaRuoli.contains(RuoliGestoreEnum.GESTORE_AVVISI_SPORTELLO.getRuolo())) {
                if (isAvvisoSportello) {
                    if (checkPresenzaDomandeAmmissibiliAvvisiSportello(bandoId)) {
                        azioni.add(AzioniDettaglioBandoEnum.VISUALIZZA_LISTA_DOMANDE.getValue());
                    }
                }
            }

            //AZIONI PER RUOLO GESTORE ENTE
            if (listaRuoli.contains(RuoliGestoreEnum.GESTORE_EVENTI.getRuolo())) {
                if (isEvento) {
                    //TODO creare metodo per EVENTI
//					if (checkPresenzaDomandeAmmissibiliAvvisiSportello(bandoId)) {
                    azioni.add(AzioniDettaglioBandoEnum.VISUALIZZA_LISTA_DOMANDE.getValue());
//					}
                }
            }

            //AZIONI PER RUOLO GESTORE PROCEDURA NEGOZIALE CON VALUTAZIONE
            if (listaRuoli.contains(RuoliGestoreEnum.GESTORE_PROCEDURA_NEGOZIALE_VAL.getRuolo())) {
                if (isProceduraNegozialeConValutazione) {
                    azioni.add(AzioniDettaglioBandoEnum.VISUALIZZA_LISTA_DOMANDE.getValue());
                }
            }

            // AZIONI PER RUOLO GESTORE ATTIVITA STORICHE
            if (listaRuoli.contains(RuoliGestoreEnum.GESTORE_GRADUATORIE.getRuolo()) && !isAvvisoSportello && !isIscrizioneElenco && !isProceduraNegozialeConValutazione) {
                if (!graduatoriaDefinitivaPresente) {
                    if (graduatoriaProvvisoriaPresente) {
                        azioni.add(AzioniDettaglioBandoEnum.VISUALIZZA_GRADUATORIA_PROVVISIORIA.getValue());
                        if (isConfidi) {
                            azioni.add(AzioniDettaglioBandoEnum.GENERA_GRADUATORIA_DEFINITIVA_CONFIDI.getValue());
                        } else {
                            azioni.add(AzioniDettaglioBandoEnum.GENERA_GRADUATORIA_DEFINITIVA.getValue());
                        }
                    } else {
                        azioni.add(AzioniDettaglioBandoEnum.GENERA_GRADUATORIA_PROVVISIORIA.getValue());
                    }
                } else {
                    azioni.add(AzioniDettaglioBandoEnum.VISUALIZZA_GRADUATORIA_DEFINITIVA.getValue());
                    azioni.add(AzioniDettaglioBandoEnum.VISUALIZZA_GRADUATORIA_PROVVISIORIA.getValue());
                }
            }

        }
        return azioni;
    }

