                                            if(!valutazione.getConvalidata() && !StatoGraduatoriaSoggettoEnum.CHIUSA_CON_ESITO_NEGATIVO.equals(graduatoriaSoggettoDTO.getEsito())) {
                                                graduatoriaSoggettoDTO.setEsito(StatoGraduatoriaSoggettoEnum.RICHIESTA_NUOVA_VALUTAZIONE_AMMISSIBILITA);
                                            }
                                        }
                                    }
                                }
                            }
                        }


                        graduatoriaSoggettoDTO.setPunteggioTotale(graduatoriaSoggetto.getPunteggioTotale());


