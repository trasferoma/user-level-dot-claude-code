                for(GraduatoriaSoggetto graduatoriaSoggetto : listaGraduatoriaSoggettoOrdinata) {

                    if(Validator.isNotNull(graduatoriaSoggetto)) {
                        GraduatoriaSoggettoDTO graduatoriaSoggettoDTO = new GraduatoriaSoggettoDTO();
