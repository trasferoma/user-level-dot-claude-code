    private boolean checkDomandaBandoAbilitatoCaricamentoDocumenti(DomandaBando domandaBando) {
        boolean isAbilitatoCaricamentoDocumenti = true;
        List<DomandaBandoDatoAggiuntivo> domandaBandoDatoAggiuntivoByDomandaBandoIdAndChiave = domandaBandoDatoAggiuntivoLocalService.getDomandaBandoDatoAggiuntivoByDomandaBandoIdAndChiave(List.of(domandaBando.getDomandaBandoId()), List.of(DatoAggiuntivoChiave.DATA_INIZIO_UPLOAD_DOCUMENTI.name(), DatoAggiuntivoChiave.DATA_FINE_UPLOAD_DOCUMENTI.name()));
        if (ListUtil.isNotEmpty(domandaBandoDatoAggiuntivoByDomandaBandoIdAndChiave)) {
            DomandaBandoDatoAggiuntivo domandaBandoDatoAggiuntivoDataInizioUploadDocumenti = domandaBandoDatoAggiuntivoByDomandaBandoIdAndChiave.stream().filter(db -> db.getChiave().equals(DatoAggiuntivoChiave.DATA_INIZIO_UPLOAD_DOCUMENTI.name())).findAny().orElse(null);
            DomandaBandoDatoAggiuntivo domandaBandoDatoAggiuntivoDataFineUploadDocumenti = domandaBandoDatoAggiuntivoByDomandaBandoIdAndChiave.stream().filter(db -> db.getChiave().equals(DatoAggiuntivoChiave.DATA_FINE_UPLOAD_DOCUMENTI.name())).findAny().orElse(null);
            if (domandaBandoDatoAggiuntivoDataInizioUploadDocumenti != null && domandaBandoDatoAggiuntivoDataFineUploadDocumenti != null) {
                String domandaBandoDatoAggiuntivoDataInizioUploadDocumentiValore = domandaBandoDatoAggiuntivoDataInizioUploadDocumenti.getValore();
                String domandaBandoDatoAggiuntivoDataFineUploadDocumentiValore = domandaBandoDatoAggiuntivoDataFineUploadDocumenti.getValore();

                LocalDateTime domandaBandoDatoAggiuntivoDataInizioUploadDocumentiValoreDateTime = LocalDateTime.parse(domandaBandoDatoAggiuntivoDataInizioUploadDocumentiValore);
                LocalDateTime domandaBandoDatoAggiuntivoDataFineUploadDocumentiValoreDateTime = LocalDateTime.parse(domandaBandoDatoAggiuntivoDataFineUploadDocumentiValore);
                LocalDateTime now = LocalDateTime.now();
                if ((now.isAfter(domandaBandoDatoAggiuntivoDataInizioUploadDocumentiValoreDateTime) || now.equals(domandaBandoDatoAggiuntivoDataInizioUploadDocumentiValoreDateTime))
                        && (now.isBefore(domandaBandoDatoAggiuntivoDataFineUploadDocumentiValoreDateTime) || now.equals(domandaBandoDatoAggiuntivoDataFineUploadDocumentiValoreDateTime))) {
                    isAbilitatoCaricamentoDocumenti = false;
                }
            }
        }

        return isAbilitatoCaricamentoDocumenti;
    }

    public void abilitaInvioDocumenti(long domandaBandoId) {
        DomandaBando domandaBando = domandaBandoLocalService.fetchDomandaBando(domandaBandoId);
        Bando bando = bandoLocalService.fetchBando(domandaBando.getBandoId());
        TermineBando scadenza = termineBandoLocalService.getTermineBandoByBandoIdAndCodice(bando.getBandoId(), TerminiBando.SCADENZA_INTEGRAZIONE_VOLONTARIA.name());
        long secondi = scadenza.getSecondi();
        LocalDateTime dataInizioUploadDocumenti = LocalDateTime.now();
        LocalDateTime dataFineUploadDocumenti = LocalDateTime.now().plusSeconds(secondi);

        DomandaBandoDatoAggiuntivo domandaBandoDatoAggiuntivoInizio = domandaBandoDatoAggiuntivoLocalService.createDomandaBandoDatoAggiuntivo(counterLocalService.increment());
        domandaBandoDatoAggiuntivoInizio.setChiave(DatoAggiuntivoChiave.DATA_INIZIO_UPLOAD_DOCUMENTI.name());
        domandaBandoDatoAggiuntivoInizio.setValore(dataInizioUploadDocumenti.with(LocalTime.MIN).toString());
        domandaBandoDatoAggiuntivoInizio.setDomandaBandoId(domandaBando.getDomandaBandoId());
        domandaBandoDatoAggiuntivoInizio.setCompanyId(domandaBando.getCompanyId());
        domandaBandoDatoAggiuntivoInizio.setUserId(domandaBando.getUserId());
        domandaBandoDatoAggiuntivoInizio.setUserName(domandaBando.getUserName());
        domandaBandoDatoAggiuntivoInizio.setGroupId(domandaBando.getGroupId());
