    public Long getIdPrimaDomanda(List<DomandaBando> listaDomandeBando,long bandoId, boolean checkBandoIsAvvisoSportelloConValutazione, TipologiaBando tipologiaBando,ServiceContext serviceContext){
        Long idPrimaDomanda = null;

        if (listaDomandeBando != null && !listaDomandeBando.isEmpty()) {
            for (DomandaBando domandaBando : listaDomandeBando) {

                if (!domandaBando.getStato().equals(StatoDomandaBandoEnum.CHIUSA_NEGATIVAMENTE.name())
                        && !domandaBando.getStato().equals(StatoDomandaBandoEnum.ASSENZA_GIUSTIFICATA.name())
                        && !domandaBando.getStato().equals(StatoDomandaBandoEnum.ASSENZA_NON_GIUSTIFICATA.name())
                        && !domandaBando.getStato().equals(StatoDomandaBandoEnum.ANNULLATA.name())
                        && !domandaBando.getStato().equals(StatoDomandaBandoEnum.BOZZA.name())
                        && !domandaBando.getStato().equals(StatoDomandaBandoEnum.PARTECIPAZIONE_EFFETTUATA.name())) {

                    List<ValutazioneAmmissibilita> listaValutazioniAmmissibilita =
                            valutazioneAmmissibilitaLocalService.getValutazioneAmissibilitaDomandaBando(domandaBando.getDomandaBandoId());

                    if (idPrimaDomanda == null &&
                            (listaValutazioniAmmissibilita == null || listaValutazioniAmmissibilita.isEmpty())) {
                        idPrimaDomanda = domandaBando.getDomandaBandoId();
                        break;
                    }

                    if (idPrimaDomanda == null
                            && Validator.isNotNull(listaValutazioniAmmissibilita)
                            && listaValutazioniAmmissibilita.size() == 1
                            && !listaValutazioniAmmissibilita.get(0).getEsito().equals(AmmissibilitaEnum.NON_AMMISSIBILE.name())
                            && !listaValutazioniAmmissibilita.get(0).getEsito().equals(AmmissibilitaEnum.AMMISSIBILE_CON_RISERVA.name())
                            && domandaBando.getImportoAssegnato() == null
                            && !domandaBando.getImportoConfermato()) {

                        if (checkBandoIsAvvisoSportelloConValutazione) {
                            List<Valutazione> listaValutazioni =
                                    valutazioneLocalService.getValutazioneByDomandaBandoId(domandaBando.getDomandaBandoId());

                            if (idPrimaDomanda == null
                                    && (listaValutazioni == null || listaValutazioni.isEmpty())) {
                                idPrimaDomanda = domandaBando.getDomandaBandoId();
                                break;
                            }

                            if (idPrimaDomanda == null
                                    && Validator.isNotNull(listaValutazioni)
                                    && listaValutazioni.size() == 1
                                    && !checkNonIdoneitaPunteggioAvvisoSportelloValutazione(domandaBando.getDomandaBandoId())) {
                                idPrimaDomanda = domandaBando.getDomandaBandoId();
                                break;
                            }

                            if (idPrimaDomanda == null
                                    && Validator.isNotNull(listaValutazioni)
                                    && listaValutazioni.size() == 1
                                    && checkNonIdoneitaPunteggioAvvisoSportelloValutazione(domandaBando.getDomandaBandoId())
                                    && !listaValutazioni.get(0).getConvalidata()) {
                                idPrimaDomanda = domandaBando.getDomandaBandoId();
                                break;
                            }
                        } else {
                            List<DomandaBandoDatoAggiuntivo> domandaBandoDatoAggiuntivoList = domandaBandoDatoAggiuntivoLocalService.
                                    getDomandaBandoDatoAggiuntivoByDomandaBandoIdAndChiave(Arrays.asList(domandaBando.getDomandaBandoId()), Arrays.asList(DatoAggiuntivoChiave.DATA_CONFERMA_EVENTO.name()));

                            if(ListUtil.isNull(domandaBandoDatoAggiuntivoList) || ListUtil.isEmpty(domandaBandoDatoAggiuntivoList)){
                                idPrimaDomanda = domandaBando.getDomandaBandoId();
                                break;
                            }
                        }
                    }
                }
            }
        }
        return idPrimaDomanda;
    }

