    public FaseWorkflowBandoEnum recuperaFaseWorkflow(ServiceContext serviceContext, long domandaBandoId) {
        String fase = getFaseDomandaBando(serviceContext, domandaBandoId);
        if (Validator.isNotNull(fase) && !fase.isEmpty()) {
            try {
                return FaseWorkflowBandoEnum.valueOf(fase);
            } catch (IllegalArgumentException e) {
                log.warn("recuperaFaseWorkflow :: valore fase non riconosciuto: " + fase);
            }
        }

        // Fallback: determina la fase in base alle variabili di processo Camunda
        try {
            String tenantId = String.valueOf(serviceContext.getScopeGroup().getOrganizationId());
            List<Task> tasksByBusinessKey = camundaClient.getTasksByBusinessKey(tenantId, String.valueOf(domandaBandoId));
            if (tasksByBusinessKey != null) {
                for (Task task : tasksByBusinessKey) {
                    List<VariableInstance> variablesByTaskId = camundaClient.getVariablesByExecutionId(tenantId, task.getExecutionId());
                    if (variablesByTaskId != null) {
                        for (VariableInstance variableInstance : variablesByTaskId) {
                            String varName = variableInstance.getName();
                            if (CamundaActionsVariable.VAR_ISTRUTTORIA.getValue().equals(varName)) {
                                return FaseWorkflowBandoEnum.ISTRUTTORIA;
                            }
                            if (CamundaActionsVariable.VAR_VERIFICA_RESPONSABILE.getValue().equals(varName)) {
                                return FaseWorkflowBandoEnum.VERIFICA_RESPONSABILE;
                            }
                            if (CamundaActionsVariable.VAR_COMPILA_DISCIPLINARE.getValue().equals(varName)) {
                                return FaseWorkflowBandoEnum.CONCESSIONE;
                            }
                            if (CamundaActionsVariable.VAR_ATTIVITA_BENEFICIARIO.getValue().equals(varName)) {
                                return FaseWorkflowBandoEnum.ESECUZIONE;
                            }
                        }
                    }
                }
            }
        } catch (CamundaClientException | PortalException e) {
            log.error("recuperaFaseWorkflow :: " + e.getMessage(), e);
        }

        return FaseWorkflowBandoEnum.VALUTAZIONE;
    }

