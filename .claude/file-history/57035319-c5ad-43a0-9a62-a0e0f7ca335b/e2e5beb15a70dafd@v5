                                // "selezioneTipoNegozio" possibili valori: "ATTIVITA", "NEGOZIOSTORICO", "NEGOZIOPATRIMONIO"
                                jsonPath = ALPACA_ALPACA_FIELD + ALPACA_DATA_FIELD + "['selezioneTipoNegozio']";
