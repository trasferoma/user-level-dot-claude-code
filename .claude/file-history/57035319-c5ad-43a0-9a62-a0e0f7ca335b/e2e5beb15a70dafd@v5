    private Map<String, String> getAnticipazioneProtocolInfoEsecuzione(IstanzaDomandaBando istanzaDomandaBando) {
        SimpleDateFormat sdf = new SimpleDateFormat("dd/MM/yyyy");
        Map<String, String> result = new HashMap<>();
        result.put(TESTO_ANTICIPAZIONE, "");
        result.put("numeroProtocollo", "");
        result.put("dataProtocollo", "");
        Form form = formLocalService.fetchForm(istanzaDomandaBando.getFormId());
        DomandaBando domandaBando = domandaBandoLocalService.fetchDomandaBando(istanzaDomandaBando.getDomandaBandoId());
        List<BandoForm> bandoFormList = bandoFormLocalService.getBandoFormBandoAndForm(domandaBando.getBandoId(), form.getFormId());
        DomandaBandoIntegrazione domandaBandoIntegrazione = domandaBandoIntegrazioneLocalService.fetchDomandaBandoIntegrazione(istanzaDomandaBando.getIstanzaDomandaBandoId());

        if (ListUtil.isNotNull(bandoFormList) && ListUtil.isNotEmpty(bandoFormList) && bandoFormList.size() == 1) {
            BandoForm bandoForm = bandoFormList.get(0);
            TipoFormEnum tipoFormEnum = TipoFormEnum.valueOf(bandoForm.getTipoForm());
            if (Validator.isNotNull(tipoFormEnum) && Validator.isNotNull(domandaBandoIntegrazione)
                    && Validator.isNotNull(domandaBandoIntegrazione.getDataProtocollo()) && Validator.isNotNull(domandaBandoIntegrazione.getNumeroProtocollo())) {
                switch (tipoFormEnum) {
                    case ESECUZIONE_PRIMO_ANTICIPO:
                        result.put(TESTO_ANTICIPAZIONE, "di prima anticipazione");
                        result.put("numeroProtocollo", domandaBandoIntegrazione.getNumeroProtocollo());
                        result.put("dataProtocollo", sdf.format(domandaBandoIntegrazione.getDataProtocollo()));
                        break;
                    case ESECUZIONE_SECONDO_ANTICIPO:
                        result.put(TESTO_ANTICIPAZIONE, "di seconda anticipazione");
                        result.put("numeroProtocollo", domandaBandoIntegrazione.getNumeroProtocollo());
                        result.put("dataProtocollo", sdf.format(domandaBandoIntegrazione.getDataProtocollo()));
                        break;
                }
            }
            //TODO valorizzare le tre entry in base al tipo form
        }
        return result;
    }

    private void getDocumentoProtocollo(DomandaBando domandaBando, long istanzaDomandaBandoId, String tipoGenerazionePDFPrimaDomandaAnticipo, long commentoDomandaBandoId,
                                        long groupId, long userId, String portalURL, String codiceBando, Contesto contesto,
                                        String codiceTemplatePdf, String nomeFile, String descrizioneFile, Map<String, String> anticipazioneInfo) throws Exception {
        TipoGenerazionePDF tipoGenerazionePDF = TipoGenerazionePDF.valueOf(tipoGenerazionePDFPrimaDomandaAnticipo);
        PDFService pdfService = pdfServiceFactory.getPDFService(tipoGenerazionePDF);
        CodiceTemplatePdf codiceTemplatePdfEnum = CodiceTemplatePdf.valueOf(codiceTemplatePdf);
        if (Validator.isNotNull(codiceTemplatePdfEnum)) {
            byte[] pdfFirmato = null;
            switch (codiceTemplatePdfEnum) {
                case PRIMA_DOMANDA_ANTICIPO:
                    pdfFirmato = pdfService.generaPDFPrimaDomandaAnticipo(domandaBando, istanzaDomandaBandoId, codiceTemplatePdf, portalURL, commentoDomandaBandoId, userId, anticipazioneInfo);
                    break;
                case SECONDA_DOMANDA_ANTICIPO:
                    pdfFirmato = pdfService.generaPDFSecondaDomandaAnticipo(domandaBando, istanzaDomandaBandoId, codiceTemplatePdf, portalURL, commentoDomandaBandoId, userId, anticipazioneInfo);
                    break;

            }

            if(Validator.isNotNull(pdfFirmato)){
                pdfFirmato = pdfServiceUtil.generaPDFArchive(pdfFirmato);
                pdfFirmato = firmaRemotaService.applicaSigillo(groupId, 0, contesto, pdfFirmato, null, null);
                salvaAllegatoDomanda(pdfFirmato, domandaBando.getDomandaBandoId(), domandaBando.getOggetto(), codiceBando, nomeFile, descrizioneFile, userId, groupId);
            }
        }

    }

    private void salvaAllegatoDomanda(byte[] pdfGenerato, long domandaBandoId, String nomeBando, String codiceBando, String nome, String descrizioneFile, long userId, long groupId) {
        AllegatoDomandaBando allegatoDomandaBando = null;

        if(Validator.isNotNull(pdfGenerato)){
            InputStream stream = new ByteArrayInputStream(pdfGenerato);
            String nomeFile = nome + domandaBandoId + ".pdf";
            String descrizione = descrizioneFile + nomeBando + "' - ID: " + domandaBandoId;
            String mimeType = MimeTypesUtil.getContentType(stream, nomeFile);
            File savedFile = fileServiceFactory.getActiveFileService().saveRequestFile(nomeFile, nomeFile, descrizione, codiceBando, domandaBandoId, stream, mimeType, userId, groupId);


            if (Validator.isNotNull(savedFile != null && savedFile.getId() != null)) {
                String idDocumentale = savedFile.getId();
                allegatoDomandaBando = allegatoDomandaBandoLocalService.createAllegatoDomandaBando(counterLocalService.increment());
                allegatoDomandaBando.setGroupId(groupId);
                allegatoDomandaBando.setUserId(userId);
                allegatoDomandaBando.setNome(nomeFile);
                allegatoDomandaBando.setTitolo(nomeFile);
                allegatoDomandaBando.setDescrizione(descrizione);
                allegatoDomandaBando.setIdDocumentale(idDocumentale);
                allegatoDomandaBando.setDomandaBandoId(domandaBandoId);
                allegatoDomandaBando.setInterno(true);
                allegatoDomandaBando.setVisibile(true);
                allegatoDomandaBandoLocalService.updateAllegatoDomandaBando(allegatoDomandaBando);
            }
        }
    }

