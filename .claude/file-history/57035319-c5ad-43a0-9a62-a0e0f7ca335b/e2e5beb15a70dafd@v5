    private void aggiornaValutazioniDomandaBando(GraduatoriaBando graduatoriaBando) {

        if(Validator.isNotNull(graduatoriaBando)) {

            long bandoId = graduatoriaBando.getBandoId();

            if(graduatoriaBando.getDefinitiva()) {
                GraduatoriaBando graduatoriaProvvisoria = graduatoriaBandoLocalService.getGraduatoriaBandoByBandoIdAndDefinitivaAndConvalidata(bandoId, false, true);

                if(Validator.isNotNull(graduatoriaProvvisoria)) {
                    List<Valutazione> valutazioniProvvisorie = valutazioneLocalService.getValutazioneByGraduatoriaBandoId(graduatoriaProvvisoria.getGraduatoriaBandoId());
                    List<Valutazione> valutazioniDefinitive = valutazioneLocalService.getValutazioneByGraduatoriaBandoId(graduatoriaBando.getGraduatoriaBandoId());
                    List<ValutazioneAmmissibilita> valutazioniAmmissibilitaProvvisorie = valutazioneAmmissibilitaLocalService.getValutazioneAmissibilitaByGraduatoriaBandoId(graduatoriaProvvisoria.getGraduatoriaBandoId());
                    List<ValutazioneAmmissibilita> valutazioniAmmissibilitaDefinitive = valutazioneAmmissibilitaLocalService.getValutazioneAmissibilitaByGraduatoriaBandoId(graduatoriaBando.getGraduatoriaBandoId());

                    if(Validator.isNull(valutazioniDefinitive) || (Validator.isNotNull(valutazioniDefinitive) && valutazioniDefinitive.isEmpty())) {
                        if(valutazioniProvvisorie!=null && !valutazioniProvvisorie.isEmpty()) {
                            for(Valutazione valutazioneProvvisoria : valutazioniProvvisorie) {
                                if(Validator.isNotNull(valutazioneProvvisoria)) {
                                    Valutazione valutazioneDefinitiva = valutazioneLocalService.createValutazione(counterLocalService.increment());
                                    valutazioneDefinitiva.setDataValutazione(valutazioneProvvisoria.getDataValutazione());
                                    valutazioneDefinitiva.setDomandaBandoId(valutazioneProvvisoria.getDomandaBandoId());
                                    valutazioneDefinitiva.setGroupId(valutazioneProvvisoria.getGroupId());
                                    valutazioneDefinitiva.setUserId(valutazioneProvvisoria.getUserId());
                                    valutazioneDefinitiva.setUserName(valutazioneProvvisoria.getUserName());
                                    valutazioneDefinitiva.setGraduatoriaBandoId(graduatoriaBando.getGraduatoriaBandoId());
                                    valutazioneDefinitiva.setConvalidata(true);
                                    valutazioneDefinitiva = valutazioneLocalService.updateValutazione(valutazioneDefinitiva);

                                    List<Punteggio> punteggiValutazioneProvvisoria = punteggioLocalService.getListaPunteggiByValutazioneId(valutazioneProvvisoria.getValutazioneId());

                                    if(punteggiValutazioneProvvisoria!=null && !punteggiValutazioneProvvisoria.isEmpty()) {
                                        for(Punteggio punteggioProvvisorio : punteggiValutazioneProvvisoria) {
                                            if(Validator.isNotNull(punteggioProvvisorio)) {
                                                Punteggio punteggioDefinitivo = punteggioLocalService.createPunteggio(counterLocalService.increment());

                                                punteggioDefinitivo.setValore(punteggioProvvisorio.getValore());

                                                if(Validator.isNotNull(punteggioProvvisorio.getNote())) {
                                                    punteggioDefinitivo.setNote(punteggioProvvisorio.getNote());
                                                }

                                                punteggioDefinitivo.setValutazioneId(valutazioneDefinitiva.getValutazioneId());
                                                punteggioDefinitivo.setCriterioValutazioneId(punteggioProvvisorio.getCriterioValutazioneId());
                                                punteggioDefinitivo.setGroupId(punteggioProvvisorio.getGroupId());
                                                punteggioDefinitivo.setUserId(punteggioProvvisorio.getUserId());
                                                punteggioDefinitivo.setUserName(punteggioProvvisorio.getUserName());

                                                punteggioLocalService.updatePunteggio(punteggioDefinitivo);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if(Validator.isNull(valutazioniAmmissibilitaDefinitive) || (Validator.isNotNull(valutazioniAmmissibilitaDefinitive) && valutazioniAmmissibilitaDefinitive.isEmpty())) {
                        if(valutazioniAmmissibilitaProvvisorie!=null && !valutazioniAmmissibilitaProvvisorie.isEmpty()) {

                            for(ValutazioneAmmissibilita valutazioneAmmissibilita : valutazioniAmmissibilitaProvvisorie) {
                                if(Validator.isNotNull(valutazioneAmmissibilita)) {
                                    ValutazioneAmmissibilita valutazioneAmmissibilitaDefinitiva = valutazioneAmmissibilitaLocalService.createValutazioneAmmissibilita(counterLocalService.increment());
                                    valutazioneAmmissibilitaDefinitiva.setGroupId(valutazioneAmmissibilita.getGroupId());
                                    valutazioneAmmissibilitaDefinitiva.setUserId(valutazioneAmmissibilita.getUserId());
                                    valutazioneAmmissibilitaDefinitiva.setUserName(valutazioneAmmissibilita.getUserName());
                                    valutazioneAmmissibilitaDefinitiva.setEsito(valutazioneAmmissibilita.getEsito());
                                    valutazioneAmmissibilitaDefinitiva.setDomandaBandoId(valutazioneAmmissibilita.getDomandaBandoId());
                                    valutazioneAmmissibilitaDefinitiva.setGraduatoriaBandoId(graduatoriaBando.getGraduatoriaBandoId());
                                    valutazioneAmmissibilitaDefinitiva.setConvalidata(true);
                                    valutazioneAmmissibilitaLocalService.updateValutazioneAmmissibilita(valutazioneAmmissibilitaDefinitiva);
                                }
                            }
                        }
                    }

                }
            }else {

                List<Valutazione> listaValutazioni = valutazioneLocalService.findByBando(bandoId);
                List<ValutazioneAmmissibilita> valutazioniAmmissibilita = valutazioneAmmissibilitaLocalService.getValutazioneAmissibilitaByBandoId(bandoId);

                if(listaValutazioni!=null && !listaValutazioni.isEmpty()) {
                    for(Valutazione valutazione : listaValutazioni) {
                        if(Validator.isNotNull(valutazione)) {
                            valutazione.setGraduatoriaBandoId(graduatoriaBando.getGraduatoriaBandoId());
                            valutazioneLocalService.updateValutazione(valutazione);
                        }
                    }
                }

                if(valutazioniAmmissibilita!=null && !valutazioniAmmissibilita.isEmpty()) {
                    for(ValutazioneAmmissibilita valutazioneAmmissibilita : valutazioniAmmissibilita) {
                        if(Validator.isNotNull(valutazioneAmmissibilita)) {
                            valutazioneAmmissibilita.setGraduatoriaBandoId(graduatoriaBando.getGraduatoriaBandoId());
                            valutazioneAmmissibilitaLocalService.updateValutazioneAmmissibilita(valutazioneAmmissibilita);
                        }
                    }
                }
            }
        }
    }

