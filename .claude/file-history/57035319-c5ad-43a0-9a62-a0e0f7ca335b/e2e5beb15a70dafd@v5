    public void azzeraImportoAssegnatoBando(ServiceContext serviceContext, long domandaBandoId){
        try {
            DomandaBandoUtil.clearCache();
            DomandaBando domandaBando = domandaBandoLocalService.fetchDomandaBando(domandaBandoId);

            if(Validator.isNull(domandaBando) || Validator.isNull(domandaBando.getImportoAssegnato()) || domandaBando.getImportoAssegnato().compareTo(BigDecimal.ZERO) <= 0){
                return;
            }

            Bando bando = bandoLocalService.getBando(domandaBando.getBandoId());

            if(!bando.getRimodulazioneBudgetGraduatoria()){
                return;
            }

            DomandaBandoDatoAggiuntivo domandaBandoDatoAggiuntivoImportoAssegnato = domandaBandoDatoAggiuntivoLocalService.createDomandaBandoDatoAggiuntivo(counterLocalService.increment());
            domandaBandoDatoAggiuntivoImportoAssegnato.setChiave(DatoAggiuntivoChiave.IMPORTO_REVOCATO.name());
            domandaBandoDatoAggiuntivoImportoAssegnato.setValore(domandaBando.getImportoAssegnato().toPlainString());
            domandaBandoDatoAggiuntivoImportoAssegnato.setDomandaBandoId(domandaBando.getDomandaBandoId());
            domandaBandoDatoAggiuntivoImportoAssegnato.setCompanyId(domandaBando.getCompanyId());
            domandaBandoDatoAggiuntivoImportoAssegnato.setUserId(domandaBando.getUserId());
            domandaBandoDatoAggiuntivoImportoAssegnato.setUserName(domandaBando.getUserName());
            domandaBandoDatoAggiuntivoImportoAssegnato.setGroupId(domandaBando.getGroupId());
            domandaBandoDatoAggiuntivoLocalService.updateDomandaBandoDatoAggiuntivo(domandaBandoDatoAggiuntivoImportoAssegnato);

            domandaBando.setImportoAssegnato(null);
            domandaBandoLocalService.updateDomandaBando(domandaBando);

            azioneOperatoreLocalService.addAzioneOperatore(serviceContext, domandaBandoId, serviceContext.getUserId(), new Date(), AzioniOperatoreCodes.AZZERAMENTO_IMPORTO_ASSEGNATO.name());
        } catch (Exception e) {
            log.error("azzeraImportoAssegnatoBando", e);
            throw new RuntimeException(e);
        }
    }

