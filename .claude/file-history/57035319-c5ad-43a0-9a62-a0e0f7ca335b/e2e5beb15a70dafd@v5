    private boolean checkPresenzaDomandeAmmissibiliAvvisiSportello(long bandoId){
        List<DomandaBando> listaDomande = domandaBandoLocalService.getDomandeBandoByBandoId(bandoId);
        boolean checkPresenzaDomandeAmmissibili = false;
        for (DomandaBando domanda : listaDomande) {
            List<ValutazioneAmmissibilita> listaValutazioniAmmissibilita = valutazioneAmmissibilitaLocalService.getValutazioneAmissibilitaDomandaBando(domanda.getDomandaBandoId());

            if(Validator.isNotNull(listaValutazioniAmmissibilita) && !listaValutazioniAmmissibilita.isEmpty() && listaValutazioniAmmissibilita.size()==1){
                ValutazioneAmmissibilita valutazioneAmmissibilita = listaValutazioniAmmissibilita.get(0);
                if(valutazioneAmmissibilita.getEsito().equals(AmmissibilitaEnum.AMMISSIBILE.name())&&valutazioneAmmissibilita.getConvalidata()){
                    checkPresenzaDomandeAmmissibili = true;
                    break;
                }
            }
        }

        if(checkPresenzaDomandeAmmissibili){
            boolean checkAvvisoSportelloValutazione = false;
            long tipologiaBandoId = bandoLocalService.fetchBando(bandoId).getTipologiaBandoId();
            TipologiaBando tipoBando = tipologiaBandoLocalService.fetchTipologiaBando(tipologiaBandoId);
            if(tipoBando.getCodice().equalsIgnoreCase(TipologiaBandoEnum.AVVISO_SPORTELLO_VALUTAZIONE.name()))
                checkAvvisoSportelloValutazione = true;

            if(checkAvvisoSportelloValutazione){
                for (DomandaBando domanda : listaDomande) {
                    List<Valutazione> listaValutazioni= valutazioneLocalService.getValutazioneByDomandaBandoId(domanda.getDomandaBandoId());

                    if(Validator.isNotNull(listaValutazioni) && !listaValutazioni.isEmpty() && listaValutazioni.size()==1){
                        Valutazione valutazione = listaValutazioni.get(0);
                        if(valutazione.getConvalidata()){
                            checkPresenzaDomandeAmmissibili = true;
                            break;
                        }else{
                            checkPresenzaDomandeAmmissibili = false;
                        }
                    }else{
                        checkPresenzaDomandeAmmissibili = false;
                    }
                }
            }
        }

        return checkPresenzaDomandeAmmissibili;
    }

