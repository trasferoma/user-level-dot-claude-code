    private boolean checkNonIdoneitaPunteggi(List<Punteggio> listaPunteggi) {
        boolean nonIdoneo = false;
        Iterator<Punteggio> it = listaPunteggi.iterator();

        try {
            while (nonIdoneo == false && it.hasNext()) {
                Punteggio punteggio = it.next();

                if (Validator.isNotNull(punteggio)) {

                    CriterioValutazione critValutazione = criterioValutazioneLocalService.getCriterioValutazione(punteggio.getCriterioValutazioneId());

                    if (Validator.isNotNull(critValutazione)) {
                        if (punteggio.getValore().compareTo(critValutazione.getSogliaMinima()) < 0) {
                            nonIdoneo = true;
                        }
                    }
                }
            }
        }
        catch (Exception e) {
            log.error(e.getMessage());
        }

        return nonIdoneo;
    }

