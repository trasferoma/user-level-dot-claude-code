    private long correlateUser(HistoryVariable variable, List<HistoryUserOperation> operations) {
        return operations.stream().filter(op -> UserOperationCodes.CLAIM.equals(op.getOperation())).filter(op -> variable.getTimestamp().after(op.getTimestamp())).map(op -> op.getValue())
                .mapToLong(id -> {
                    try {
                        return Long.parseLong(id);
                    }
                    catch (NumberFormatException e) {
                        log.warn("Operatore " + id);
                        return 0L;
                    }
                }).findFirst().orElse(0L);
    }

