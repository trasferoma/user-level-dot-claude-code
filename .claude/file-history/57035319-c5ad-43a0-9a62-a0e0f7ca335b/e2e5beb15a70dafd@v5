                TipoFormEnum.ESECUZIONE_PRIMO_ANTICIPO.name(),
                TipoFormEnum.ESECUZIONE_SECONDO_ANTICIPO.name(),
                TipoFormEnum.ESECUZIONE_ANTICIPO_INTEGRAZIONE.name(),
                TipoFormEnum.ESECUZIONE_SALDO.name(),
                TipoFormEnum.ESECUZIONE_SALDO_INTEGRAZIONE.name(),
                TipoFormEnum.ESECUZIONE_ANTICIPO.name(),
                TipoFormEnum.ESECUZIONE_RINUNCIA.name()
        );

        //Recupero i formId dei tipi da escludere
        List<Long> formIdDaEscludere = new ArrayList<>();
        for (String tipo : tipiDaEscludere) {
            List<BandoForm> forms = bandoFormLocalService.getListaBandoFormBandoAndType(bandoId, tipo);
            if (Validator.isNotNull(forms)) {
                formIdDaEscludere.addAll(forms.stream()
                        .map(BandoForm::getFormId)
                        .filter(Objects::nonNull)
                        .collect(Collectors.toList()));
            }
        }

        //Aggiungo i form principali
        List<Form> formsPrincipali = formLocalService.getFormsByIdsAndPrincipale(
                bandoFormLocalService.getListaBandoFormBando(bandoId)
                        .stream()
                        .map(BandoForm::getFormId)
                        .filter(Objects::nonNull)
                        .collect(Collectors.toList()));

        formIdDaEscludere.addAll(formsPrincipali.stream()
                .map(Form::getFormId)
                .filter(Objects::nonNull)
                .collect(Collectors.toList()));

        return (int) istanzaDomandaBandoLocalService.countIstanzeDomandaBandoExcludingStatesAndForms(
                domandaBandoId,
                Collections.singletonList(StatoIntegrazioneDomandaBandoEnum.NON_VALIDATA.name()),
                formIdDaEscludere
        );
    }

