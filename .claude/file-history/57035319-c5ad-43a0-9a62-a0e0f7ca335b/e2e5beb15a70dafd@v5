    private void verificaDimensioneComplessivaProtocollazione(Bando bando, DomandaBando domandaBando, List<IstanzaDomandaBando> istanze, List<AllegatoDomandaBando> allegatiEsterni, String portalURL, long commentoDomandaBandoId, long userIdOperatore, Map<String, String> anticipazioneInfo) throws DataAccessException {
        if (allegatiEsterni.isEmpty()) {
            return;
        }

        long dimensioneTotale = 0L;

        for (IstanzaDomandaBando istanza : istanze) {
            if (Validator.isNotNull(istanza)) {
                dimensioneTotale += stimaDimensionePdfRichiestaIntegrazione(bando, domandaBando, portalURL, commentoDomandaBandoId, userIdOperatore, anticipazioneInfo, allegatiEsterni);
                if (dimensioneTotale > DIMENSIONE_MAX_PROTOCOLLAZIONE_BYTES) {
                    throw buildEccezioneDimensioneSuperata();
                }
            }
        }

        for (AllegatoDomandaBando allegato : allegatiEsterni) {
            dimensioneTotale += recuperaDimensioneAllegato(allegato);
            if (dimensioneTotale > DIMENSIONE_MAX_PROTOCOLLAZIONE_BYTES) {
                throw buildEccezioneDimensioneSuperata();
            }
        }
    }

    private long stimaDimensionePdfRichiestaIntegrazione(Bando bando, DomandaBando domandaBando, String portalURL, long commentoDomandaBandoId, long userIdOperatore, Map<String, String> anticipazioneInfo, List<AllegatoDomandaBando> allegatiEsterni) throws DataAccessException {
        try {
            TipoGenerazionePDF tipoGenerazionePDF = TipoGenerazionePDF.valueOf(bando.getTipoGenerazionePDFSoccorsoIstruttorio());
            PDFService pdfService = pdfServiceFactory.getPDFService(tipoGenerazionePDF);
            byte[] pdfGenerato = pdfService.generaPDFRichiestaSoccorsoIstruttoria(domandaBando, CodiceTemplatePdf.RICHIESTA_SOCCORSO_ISTRUTTORIO.name(), portalURL, commentoDomandaBandoId, userIdOperatore, anticipazioneInfo, allegatiEsterni);
            if (pdfGenerato == null) {
                return 0L;
            }
            return pdfGenerato.length;
        } catch (Exception e) {
            throw new DataAccessException("Errore durante la stima della dimensione del PDF di richiesta integrazione per domanda bando ID: " + domandaBando.getDomandaBandoId(), e);
        }
    }

    private long recuperaDimensioneAllegato(AllegatoDomandaBando allegato) throws DataAccessException {
        try {
            File file = fileServiceFactory.getActiveFileService().getRequestFile(allegato.getIdDocumentale(), allegato.getGroupId());
            if (Validator.isNull(file) || Validator.isNull(file.getSize())) {
                return 0L;
            }
            return file.getSize();
        } catch (Exception e) {
            throw new DataAccessException("Errore durante il recupero della dimensione dell'allegato ID: " + allegato.getAllegatoDomandaBandoId(), e);
        }
    }


    private void impostaAllegatiVisibili(List<AllegatoDomandaBando> allegatiEsterni) throws DataAccessException {
        if (ListUtil.isNull(allegatiEsterni) || ListUtil.isEmpty(allegatiEsterni)) {
