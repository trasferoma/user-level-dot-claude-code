    public ValutazioneDTO createValutazioneDomandaBando(DomandaBando domandaBando) {

        ValutazioneDTO valutazioneDTO = new ValutazioneDTO();
        valutazioneDTO.setValutazioneAmmissibilita(AmmissibilitaEnum.NON_AMMISSIBILE.name());
        valutazioneDTO.setValutazioneMerito(false);

        try {
            MessageUtility messageUtility = new MessageUtility(ScrivaniaOperatoreBandiPortletKeys.BUNDLE_SYMBOLIC_NAME, Locale.ITALY);

            GraduatoriaBando graduatoriaProvvisoria = graduatoriaBandoLocalService.getGraduatoriaBandoByBandoIdAndDefinitiva(domandaBando.getBandoId(), false);
            GraduatoriaBando graduatoriaDefinitiva = graduatoriaBandoLocalService.getGraduatoriaBandoByBandoIdAndDefinitiva(domandaBando.getBandoId(), true);
            long graduatoriaBandoId = 0;

            if(Validator.isNotNull(graduatoriaProvvisoria)) {
                graduatoriaBandoId = graduatoriaProvvisoria.getGraduatoriaBandoId();
            }

            if(Validator.isNotNull(graduatoriaDefinitiva)) {
                graduatoriaBandoId = graduatoriaDefinitiva.getGraduatoriaBandoId();
            }

            ValutazioneAmmissibilita valutazioneAmmissibilita = valutazioneAmmissibilitaLocalService.getValutazioneAmmissibilitaByDomandaBandoAndGraduatoriaBando(domandaBando.getDomandaBandoId(), graduatoriaBandoId);



            if (Validator.isNotNull(valutazioneAmmissibilita) && Validator.isNotNull(valutazioneAmmissibilita.getEsito())) {

                if(valutazioneAmmissibilita.getEsito().equalsIgnoreCase(AmmissibilitaEnum.AMMISSIBILE.name())) {
                    valutazioneDTO.setValutazioneAmmissibilita(AmmissibilitaEnum.AMMISSIBILE.name());
                }

                if(valutazioneAmmissibilita.getEsito().equalsIgnoreCase(AmmissibilitaEnum.AMMISSIBILE_CON_RISERVA.name())) {
                    valutazioneDTO.setValutazioneAmmissibilita(AmmissibilitaEnum.AMMISSIBILE_CON_RISERVA.name());
                }

                String[] dettagliAmmissibilita = new String[]{valutazioneAmmissibilita.getUserName(), null, null};

                SimpleDateFormat sdf = new SimpleDateFormat("dd/MM/yyyy");
                dettagliAmmissibilita[1] = sdf.format(valutazioneAmmissibilita.getModifiedDate());
                sdf = new SimpleDateFormat("HH:mm");
                dettagliAmmissibilita[2] = sdf.format(valutazioneAmmissibilita.getModifiedDate());
                valutazioneDTO.setDettagliAmmissibilita(dettagliAmmissibilita);

                Valutazione valutazione = valutazioneLocalService.getValutazioneByGraduatoriaBandoAndDomandaBando(graduatoriaBandoId, domandaBando.getDomandaBandoId());
                if (Validator.isNotNull(valutazione)) {
                    valutazioneDTO.setValutazioneMerito(true);

                    List<Punteggio> punteggi = punteggioLocalService.getListaPunteggiByValutazioneId(valutazione.getValutazioneId());
                    if (Validator.isNotNull(punteggi) && !punteggi.isEmpty()) {
                        List<PunteggioDTO> punteggiList = new ArrayList<PunteggioDTO>();
                        BigDecimal punteggioTotale = BigDecimal.ZERO;

                        for(Punteggio p : punteggi){
                            CriterioValutazione criteriovalutazione = criterioValutazioneLocalService.fetchCriterioValutazione(p.getCriterioValutazioneId());
                            if (Validator.isNull(criteriovalutazione)) {
                                continue;
                            }
                            PunteggioDTO punteggioDTO = new PunteggioDTO();
                            punteggioDTO.setDescrizionePunteggio(criteriovalutazione.getDescrizione());
                            punteggioDTO.setValorePunteggio(p.getValore());
                            punteggioDTO.setNote(p.getNote());
                            punteggioDTO.setCriterioPunteggioTotale(false);

                            punteggioTotale = punteggioTotale.add(p.getValore());
                            punteggiList.add(punteggioDTO);
                        }

                        String[] dettagliPunteggiMerito = new String[]{valutazione.getUserName(), null, null};
                        sdf = new SimpleDateFormat("dd/MM/yyyy");
                        dettagliPunteggiMerito[1] = sdf.format(valutazione.getModifiedDate());
                        sdf = new SimpleDateFormat("HH:mm");
                        dettagliPunteggiMerito[2] = sdf.format(valutazione.getModifiedDate());

                        PunteggioDTO punteggioTotaleDto = new PunteggioDTO();
                        punteggioTotaleDto.setDescrizionePunteggio(messageUtility.getMessage("punteggio-totale"));
                        punteggioTotaleDto.setValorePunteggio(punteggioTotale);
                        punteggioTotaleDto.setCriterioPunteggioTotale(true);
                        punteggiList.add(punteggioTotaleDto);

                        valutazioneDTO.setDettagliPunteggiMerito(dettagliPunteggiMerito);
                        valutazioneDTO.setPunteggi(punteggiList);
                        valutazioneDTO.setPunteggioTotale(punteggioTotale);
                    }
                }

            }
        }catch(Exception e) {
            log.error("createValutazioneDomandaBando :: " + e.getMessage(), e);
        }

        return valutazioneDTO;

    }

    public boolean checkConvalide(long domandaBandoId, long graduatoriaBandoId) {
