     * campo oggetto viene mostrato ed è obbligatorio.
     */
    public boolean isCampoOggettoAttivo(long domandaBandoId) {
        DomandaBando domandaBando = domandaBandoLocalService.fetchDomandaBando(domandaBandoId);
        if (domandaBando == null) {
            return false;
        }
        return isDatoBandoFlagAttivo(domandaBando.getBandoId(), CodiceDatoBandoEnum.DISABILITA_CAMPO_OGGETTO);
