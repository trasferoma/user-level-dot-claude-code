    public Map<String, List<ScadenzaDTO>> getScadenzeGroupedByDate(long bandoId, Date dateStart, Date dateEnd) {
        try {
            List<ScadenzaDTO> scadenzaDomandaList = Optional.ofNullable(this.termineDomandaLocalService.findByBandoIdAndDataScadenza(bandoId, dateStart, dateEnd)).orElseGet(ArrayList::new).stream()
                    .map(termineDomanda -> {
                        ScadenzaDTO scadenzaDTO = new ScadenzaDTO();
                        scadenzaDTO.setDomandaId(termineDomanda.getDomandaBandoId());
                        scadenzaDTO.setTipoScadenza("Domanda");
                        scadenzaDTO.setDataScadenza(termineDomanda.getDataScadenza());
                        scadenzaDTO.setDescrizione(termineDomanda.getDescrizione());
                        return scadenzaDTO;
                    }).collect(Collectors.toList());

            List<ScadenzaDTO> scadenzaAllegatoDomandaList = Optional.ofNullable(this.allegatoDomandaBandoLocalService.getAllegatiByBandoIdAndDataScadenza(bandoId, dateStart, dateEnd))
                    .orElseGet(ArrayList::new).stream().map(allegatoDomandaBando -> {
                        ScadenzaDTO scadenzaDTO = new ScadenzaDTO();
                        scadenzaDTO.setDomandaId(allegatoDomandaBando.getDomandaBandoId());
                        scadenzaDTO.setTipoScadenza("Documento");
                        scadenzaDTO.setDataScadenza(allegatoDomandaBando.getDataScadenza());
                        scadenzaDTO.setDescrizione(allegatoDomandaBando.getNome() + " [" + allegatoDomandaBando.getTitolo() + "]");
                        return scadenzaDTO;
                    }).collect(Collectors.toList());

            Map<String, List<ScadenzaDTO>> scadenze = Stream.of(scadenzaDomandaList, scadenzaAllegatoDomandaList).flatMap(List::stream).sorted(Comparator.comparingLong(ScadenzaDTO::getDomandaId))
                    .collect(Collectors.groupingBy(scadenza -> DateUtil.getDate(scadenza.getDataScadenza(), "yyyy/MM/dd", Locale.ITALY)));

            return scadenze;
        }
        catch (Exception e) {
            throw e;
        }
    }

    public void sincronizza(ServiceContext serviceContext) {
        List<DomandaBando> domande = domandaBandoLocalService.findByCompanyIdAndGroupId(serviceContext);

        for (DomandaBando domanda : domande) {
            if (Validator.isNotNull(domanda.getProcessInstanceId())) {
                if (camundaClient.existProcess(domanda.getProcessInstanceId())) {
                    Bando bando;
                    try {
                        bando = bandoLocalService.getBando(domanda.getBandoId());
                    }
                    catch (PortalException e) {
                        throw new RuntimeException(e);
                    }

                    camundaClient.updateProcessInstanceVariableByBusinessKey(domanda.getProcessInstanceId(),
                            Arrays.asList(new Variable(CustomProcessVariables.RAGIONE_SOCIALE, CustomProcessVariables.TYPE_STRING, domanda.getRagioneSociale()),
                                    new Variable(CustomProcessVariables.DATA_CREAZIONE_DOMANDA_SEARCH, CustomProcessVariables.TYPE_LONG, domanda.getCreateDate().getTime()),
                                    new Variable(CustomProcessVariables.DATA_INVIO_DOMANDA, CustomProcessVariables.TYPE_DATE, CAMUNDA_DATE_FORMAT.format(domanda.getDataArrivo())),
                                    new Variable(CustomProcessVariables.DATA_INVIO_DOMANDA_SEARCH, CustomProcessVariables.TYPE_LONG, domanda.getDataArrivo().getTime()),
                                    new Variable(CustomProcessVariables.NUMERO_PROTOCOLLO_ESTESO, CustomProcessVariables.TYPE_STRING, domanda.getNumeroProtocolloEsteso()),
                                    new Variable(CustomProcessVariables.INVIO_GUEST, CustomProcessVariables.TYPE_STRING, domanda.getInvioGuest()),
                                    new Variable(CustomProcessVariables.CODICE_BANDO, CustomProcessVariables.TYPE_STRING, bando.getCodice()),
                                    new Variable(CustomProcessVariables.STATO_DOMANDA, CustomProcessVariables.TYPE_STRING, getStatoCodice(domanda))));
                    log.info("Sincronizzata domanda " + domanda.getDomandaBandoId() + " con processo " + domanda.getProcessInstanceId());
                }
            }
        }
    }

    public void sincronizzaAzioniOperatore(ServiceContext serviceContext) {
        List<DomandaBando> domande = domandaBandoLocalService.findByCompanyIdAndGroupId(serviceContext);

        for (DomandaBando domanda : domande) {
            if (Validator.isNotNull(domanda.getProcessInstanceId())) {
                List<HistoryUserOperation> userOps = camundaClient.getHistoryUserOperationsByProcessInstanceId(domanda.getProcessInstanceId());
                List<HistoryVariable> vars = camundaClient.getHistoryVariablesByProcessInstanceId(domanda.getProcessInstanceId());

                userOps.forEach(op -> {
                    if (Arrays.asList(UserOperationCodes.ASSIGN, UserOperationCodes.CLAIM).contains(op.getOperation())) {
                        if (op.getValue() == null) {
                            long userId;

                            try {
                                userId = Long.parseLong(op.getPrevValue());
                            }
                            catch (NumberFormatException e) {
                                userId = 0;
                                log.warn("Operatore non numerico " + op.getPrevValue() + " nella domanda " + domanda.getDomandaBandoId());
                            }

                            azioneOperatoreLocalService.addAzioneOperatore(serviceContext, domanda.getDomandaBandoId(), userId, op.getTimestamp(), AzioniOperatoreCodes.RILASCIA_TASK.name());
                        }
                        else {
                            long userId;

                            try {
                                userId = Long.parseLong(op.getValue());
                            }
                            catch (NumberFormatException e) {
                                userId = 0;
                                log.warn("Operatore non numerico " + op.getValue() + " nella domanda " + domanda.getDomandaBandoId());
                            }

                            azioneOperatoreLocalService.addAzioneOperatore(serviceContext, domanda.getDomandaBandoId(), userId, op.getTimestamp(), AzioniOperatoreCodes.PRESA_IN_CARICO.name());
                        }
                    }
                });

                // TODO mappa azioni operatore
                userOps.sort(Collections.reverseOrder(Comparator.comparing(HistoryUserOperation::getTimestamp)));

                vars.forEach(var -> {
                    if (CustomProcessVariables.ESITO_LAVORAZIONE.equals(var.getName())) {
                        if (CustomProcessVariables.ESITO_LAVORAZIONE_VERIFICA_RESPONSABILE.equals(var.getValue())) {
                            long userId = correlateUser(var, userOps);
                            azioneOperatoreLocalService.addAzioneOperatore(serviceContext, domanda.getDomandaBandoId(), userId, var.getTimestamp(), AzioniOperatoreCodes.ASSEGNA_RESPONSABILE.name());
                        }
                        else if (CustomProcessVariables.ESITO_LAVORAZIONE_RIMANDA_REFERENTE.equals(var.getValue())) {
                            long userId = correlateUser(var, userOps);
                            azioneOperatoreLocalService.addAzioneOperatore(serviceContext, domanda.getDomandaBandoId(), userId, var.getTimestamp(), AzioniOperatoreCodes.TIPO_OPERAZIONE_RIMANDA_REFERENTE.name());
                        }
                    }
                    else if (CustomProcessVariables.ESITO_PROCEDIMENTO.equals(var.getName())) {
                        if (CustomProcessVariables.ESITO_PROCEDIMENTO_POSITIVO.equals(var.getValue())) {
                            long userId = correlateUser(var, userOps);
                            azioneOperatoreLocalService.addAzioneOperatore(serviceContext, domanda.getDomandaBandoId(), userId, var.getTimestamp(),
                                    AzioniOperatoreCodes.ESITO_PROCEDIMENTO_POSITIVO.name());
                        }
                        else if (CustomProcessVariables.ESITO_PROCEDIMENTO_NEGATIVO.equals(var.getValue())) {
                            long userId = correlateUser(var, userOps);
                            azioneOperatoreLocalService.addAzioneOperatore(serviceContext, domanda.getDomandaBandoId(), userId, var.getTimestamp(),
                                    AzioniOperatoreCodes.ESITO_PROCEDIMENTO_NEGATIVO.name());
                        }
                    }
                });
            }
        }
    }

    public List<VariableQueryParameter> getVariableQueryParameters(DomandaFilters filters, String codiceBando) {
        List<VariableQueryParameter> variableQueryParameters = new ArrayList<>();

        variableQueryParameters.add(new VariableQueryParameter(CustomProcessVariables.CODICE_BANDO, codiceBando, OperatorEnum.EQ));

        if (filters.getQueryNome() != null) {
            variableQueryParameters.add(new VariableQueryParameter(CustomProcessVariables.DENOMINAZIONE_RICHIEDENTE, "%" + filters.getQueryNome() + "%", OperatorEnum.LIKE));
        }
        if (filters.getQueryCf() != null) {
            variableQueryParameters.add(new VariableQueryParameter(CustomProcessVariables.COD_FISCALE_RICHIEDENTE, "%" + filters.getQueryCf().toUpperCase() + "%", OperatorEnum.LIKE));
        }

        if (filters.getQueryDomandaBandoId() != null) {
            long filterId;
            try {
                filterId = Long.parseLong(filters.getQueryDomandaBandoId());
            }
            catch (NumberFormatException e) {
                filterId = 0;
            }
            variableQueryParameters.add(new VariableQueryParameter(CustomProcessVariables.ID_DOMANDA_BANDO, filterId, OperatorEnum.EQ));
        }

        if (filters.getQueryNumProtocollo() != null) {
            variableQueryParameters.add(new VariableQueryParameter(CustomProcessVariables.NUMERO_PROTOCOLLO_ESTESO, "%" + filters.getQueryNumProtocollo() + "%", OperatorEnum.LIKE));
        }

        if (filters.getQueryDataArrivoDa() != null) {
            variableQueryParameters.add(new VariableQueryParameter(CustomProcessVariables.DATA_INVIO_DOMANDA_SEARCH, filters.getQueryDataArrivoDa().getTime(), OperatorEnum.GTEQ));
        }
        if (filters.getQueryDataArrivoA() != null) {
            variableQueryParameters.add(new VariableQueryParameter(CustomProcessVariables.DATA_INVIO_DOMANDA_SEARCH, filters.getQueryDataArrivoA().getTime(), OperatorEnum.LTEQ));
        }

        if (filters.getQueryInvioGuest() != null) {
            variableQueryParameters.add(new VariableQueryParameter(CustomProcessVariables.INVIO_GUEST, String.valueOf(filters.getQueryInvioGuest()), OperatorEnum.EQ));
        }

        if (filters.getPartitaIva() != null) {
            variableQueryParameters.add(new VariableQueryParameter(CustomProcessVariables.PARTITA_IVA_RICHIEDENTE, filters.getPartitaIva() + "%", OperatorEnum.LIKE));
        }

        if (filters.getRagioneSociale() != null) {
            variableQueryParameters.add(new VariableQueryParameter(CustomProcessVariables.RAGIONE_SOCIALE, "%" + filters.getRagioneSociale() + "%", OperatorEnum.LIKE));
        }

        String tipo = filters.getQueryCodiceStato();
        if (tipo != null) {
            variableQueryParameters.add(new VariableQueryParameter(CustomProcessVariables.STATO_DOMANDA_SEARCH, tipo, OperatorEnum.EQ));
        }

        return variableQueryParameters;
    }

