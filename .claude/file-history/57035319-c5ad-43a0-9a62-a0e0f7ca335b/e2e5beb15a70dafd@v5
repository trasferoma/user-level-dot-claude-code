     * @param domandaBandoId
     */
    public void deleteValutazioniSenzaGraduatoriaConvalidata(long domandaBandoId) {
        DomandaBando domandaBando;
        try {
            domandaBando = domandaBandoLocalService.getDomandaBando(domandaBandoId);
        } catch (PortalException e) {
            throw new RuntimeException(e);
        }

        GraduatoriaBando graduatoriaProvvisoria = graduatoriaBandoLocalService.getGraduatoriaBandoByBandoIdAndDefinitivaAndConvalidata(domandaBando.getBandoId(), false, false);
        GraduatoriaBando graduatoriaDefinitiva = graduatoriaBandoLocalService.getGraduatoriaBandoByBandoIdAndDefinitivaAndConvalidata(domandaBando.getBandoId(), true, false);
        long graduatoriaBandoId = 0;

        if(Validator.isNotNull(graduatoriaProvvisoria)) {
            graduatoriaBandoId = graduatoriaProvvisoria.getGraduatoriaBandoId();
        }

        if(Validator.isNotNull(graduatoriaDefinitiva)) {
            graduatoriaBandoId = graduatoriaDefinitiva.getGraduatoriaBandoId();
        }

        Valutazione valutazione = valutazioneLocalService.getValutazioneByGraduatoriaBandoAndDomandaBando(graduatoriaBandoId, domandaBandoId);

        if(Validator.isNotNull(valutazione)) {
            List<Punteggio> listaPunteggi = punteggioLocalService.getListaPunteggiByValutazioneId(valutazione.getValutazioneId());

            if(!listaPunteggi.isEmpty()) {
