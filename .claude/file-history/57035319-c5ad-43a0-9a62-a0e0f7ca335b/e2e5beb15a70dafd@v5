                                jsonPath = ALPACA_ALPACA_FIELD + ALPACA_DATA_FIELD + "['selezioneTipoLocale']";
                                fieldValues = JsonPath.using(jsonPathConfiguration).parse(jsonForm).read(jsonPath);
                                if (Validator.isNotNull(fieldValues) && Validator.isNotNull(fieldValues.get(0))) {
                                    String selezioneTipoNegozio = fieldValues.get(0).asText();
                                    if (Validator.isNotNull(selezioneTipoNegozio)) {
