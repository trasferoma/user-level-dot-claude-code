    public List<GraduatoriaSoggettoDTO> creaGraduatoriaBando(long groupId, long userId, long companyId, String userName, long bandoId, boolean definitiva) {
        GraduatoriaBando graduatoria = null;
        List<GraduatoriaSoggettoDTO> graduatoriaFinale = new ArrayList<GraduatoriaSoggettoDTO>();

        if (bandoId > 0) {

            graduatoria = graduatoriaBandoLocalService.getGraduatoriaBandoByBandoIdAndDefinitiva(bandoId, definitiva);

            if (Validator.isNotNull(graduatoria)) {
                if (definitiva) {
                    List<GraduatoriaSoggetto> listaSoggetti = graduatoriaSoggettoLocalService.getListaGraduatoriaSoggettoByGraduatoriaBando(graduatoria.getGraduatoriaBandoId());
                    if (Validator.isNotNull(listaSoggetti) && !listaSoggetti.isEmpty()) {
                        for (GraduatoriaSoggetto soggetto : listaSoggetti) {
                            if (Validator.isNotNull(soggetto)) {
                                DomandaBando domanda = domandaBandoLocalService.fetchDomandaBando(soggetto.getDomandaBandoId());
                                if (Validator.isNotNull(domanda) && Validator.isNotNull(domanda.getImportoAssegnato())) {
                                    domanda.setImportoAssegnato(null);
                                    domandaBandoLocalService.updateDomandaBando(domanda);
                                }
                            }
                        }
                    }
                }
                graduatoriaSoggettoLocalService.cancellaListaGraduatoriaSoggettoByGraduatoriaBando(graduatoria.getGraduatoriaBandoId());
            }
            else {
                graduatoria = graduatoriaBandoLocalService.createGraduatoriaBando(counterLocalService.increment());
                graduatoria.setBandoId(bandoId);
                graduatoria.setDefinitiva(definitiva);
                graduatoria.setDataPubblicazione(new Date());
                graduatoria.setGroupId(groupId);
                graduatoria.setUserId(userId);
                graduatoria.setCompanyId(companyId);
                graduatoria.setUserName(userName);

                graduatoria = graduatoriaBandoLocalService.updateGraduatoriaBando(graduatoria);

                aggiornaValutazioniDomandaBando(graduatoria);
            }

        }

        List<GraduatoriaSoggettoDTO> graduatoriaAmmessi = creaGraduatoriaSoggetto(graduatoria, bandoId, EsitoGraduatoriaEnum.AMMESSI);

        if (definitiva) {
            ripartizioneBudgetGraduatoria(graduatoriaAmmessi);
        }

        List<GraduatoriaSoggettoDTO> graduatoriaNonAmmessiCriterio = creaGraduatoriaSoggetto(graduatoria, bandoId, EsitoGraduatoriaEnum.NON_AMMESSO_CRITERIO);
        List<GraduatoriaSoggettoDTO> graduatoriaNonAmmissibili = creaGraduatoriaSoggetto(graduatoria, bandoId, EsitoGraduatoriaEnum.NON_AMMESSO);
        List<GraduatoriaSoggettoDTO> graduatoriaRinunciatari = creaGraduatoriaSoggetto(graduatoria, bandoId, EsitoGraduatoriaEnum.ANNULLATE);
        List<GraduatoriaSoggettoDTO> graduatoriaEsitiNegativi = creaGraduatoriaSoggetto(graduatoria, bandoId, EsitoGraduatoriaEnum.ESITO_NEGATIVO);

        graduatoriaFinale.addAll(graduatoriaAmmessi);
        graduatoriaFinale.addAll(graduatoriaNonAmmessiCriterio);
        graduatoriaFinale.addAll(graduatoriaNonAmmissibili);
        graduatoriaFinale.addAll(graduatoriaRinunciatari);
        graduatoriaFinale.addAll(graduatoriaEsitiNegativi);
        salvaGraduatoria(graduatoriaFinale, graduatoria.getGraduatoriaBandoId(), groupId, userId, companyId, userName);

        return graduatoriaFinale;
    }

    private List<GraduatoriaSoggettoDTO> creaGraduatoriaSoggetto(GraduatoriaBando graduatoriaBando, long bandoId, EsitoGraduatoriaEnum tipoGraduatoria) {
        List<DomandaBando> listaDomandaBando = new ArrayList<DomandaBando>();
        List<GraduatoriaSoggettoDTO> graduatoria = new ArrayList<GraduatoriaSoggettoDTO>();

        MessageUtility messageUtility = new MessageUtility(ScrivaniaOperatoreBandiPortletKeys.BUNDLE_SYMBOLIC_NAME, Locale.ITALY);

        try {
            if (bandoId > 0) {
                listaDomandaBando = domandaBandoLocalService.getDomandeBandoByBandoId(bandoId);
                Bando bando = bandoLocalService.getBando(bandoId);
                List<CriterioValutazione> listaCriteri = criterioValutazioneLocalService.getCriterioValutazioneByBandoIdAndNotCodice(bando.getBandoId(), null);

                if (listaDomandaBando != null && !listaDomandaBando.isEmpty()) {
                    for (DomandaBando domanda : listaDomandaBando) {
                        if (Validator.isNotNull(domanda)) {

                            List<Punteggio> listaPunteggiDomanda = punteggioLocalService.getListaPunteggiDomandaBando(domanda.getDomandaBandoId(), graduatoriaBando.getGraduatoriaBandoId());

                            boolean checkNonIdoneita = checkNonIdoneitaPunteggi(listaPunteggiDomanda, listaCriteri, bando);

                            String note = "";
                            String ammissibilita = "";
                            ValutazioneAmmissibilita valutazioneAmmissibilita = valutazioneAmmissibilitaLocalService.getValutazioneAmmissibilitaByDomandaBandoAndGraduatoriaBando(domanda.getDomandaBandoId(), graduatoriaBando.getGraduatoriaBandoId());

                            if(Validator.isNotNull(valutazioneAmmissibilita) && Validator.isNotNull(valutazioneAmmissibilita.getEsito())) {
                                ammissibilita = valutazioneAmmissibilita.getEsito();

                            }

                            switch (tipoGraduatoria) {
                                case AMMESSI:
                                    if (ammissibilita.equalsIgnoreCase(AmmissibilitaEnum.AMMISSIBILE.name())
                                            && (!checkNonIdoneita || domanda.getStato().equalsIgnoreCase(StatoDomandaBandoEnum.CHIUSA_NEGATIVAMENTE.name()))) {
                                        GraduatoriaSoggettoDTO soggettoGraduatoria = null;
                                        if (Validator.isNotNull(domanda.getStato()) && domanda.getStato().equalsIgnoreCase(StatoDomandaBandoEnum.CHIUSA_NEGATIVAMENTE.name())) {
                                            soggettoGraduatoria = getPunteggioTotaleDomandaBando(listaPunteggiDomanda, domanda, bandoId, StatoGraduatoriaSoggettoEnum.CHIUSA_CON_ESITO_NEGATIVO, graduatoriaBando);
                                        } else {
                                            soggettoGraduatoria = getPunteggioTotaleDomandaBando(listaPunteggiDomanda, domanda, bandoId,  StatoGraduatoriaSoggettoEnum.AMMESSO, graduatoriaBando);
                                        }
                                        if (Validator.isNotNull(soggettoGraduatoria)) {
                                            graduatoria.add(soggettoGraduatoria);
                                        }
                                    }

                                    break;
                                case NON_AMMESSO_CRITERIO:

                                    if (checkNonIdoneita && ammissibilita.equalsIgnoreCase(AmmissibilitaEnum.AMMISSIBILE.name()) && !domanda.getStato().equalsIgnoreCase(StatoDomandaBandoEnum.CHIUSA_NEGATIVAMENTE.name())) {
                                        GraduatoriaSoggettoDTO soggettoGraduatoria = getPunteggioTotaleDomandaBando(listaPunteggiDomanda, domanda, bandoId,  StatoGraduatoriaSoggettoEnum.NON_AMMESSO, graduatoriaBando);

                                        if (Validator.isNotNull(soggettoGraduatoria)) {
                                            graduatoria.add(soggettoGraduatoria);
                                        }
                                    }

                                    break;
                                case NON_AMMESSO:

                                    if (ammissibilita.equalsIgnoreCase(AmmissibilitaEnum.NON_AMMISSIBILE.name()) && !domanda.getStato().equalsIgnoreCase(StatoDomandaBandoEnum.CHIUSA_NEGATIVAMENTE.name())) {
                                        GraduatoriaSoggettoDTO soggettoGraduatoria = getPunteggioTotaleDomandaBando(listaPunteggiDomanda, domanda, bandoId,  StatoGraduatoriaSoggettoEnum.NON_AMMESSO, graduatoriaBando);

                                        if (Validator.isNotNull(soggettoGraduatoria)) {
                                            graduatoria.add(soggettoGraduatoria);
                                        }
                                    }

                                    break;
                                case ANNULLATE:

                                    if (domanda.getStato().equalsIgnoreCase(StatoDomandaBandoEnum.ANNULLATA.name())) {
                                        GraduatoriaSoggettoDTO soggettoGraduatoria = getPunteggioTotaleDomandaBando(listaPunteggiDomanda, domanda, bandoId,  StatoGraduatoriaSoggettoEnum.ANNULLATA, graduatoriaBando);

                                        if (Validator.isNotNull(soggettoGraduatoria)) {
                                            graduatoria.add(soggettoGraduatoria);
                                        }
                                    }

                                    break;
                                case ESITO_NEGATIVO:

                                    if (Validator.isNotNull(domanda.getStato()) && domanda.getStato().equalsIgnoreCase(StatoDomandaBandoEnum.CHIUSA_NEGATIVAMENTE.name()) && !ammissibilita.equalsIgnoreCase(AmmissibilitaEnum.AMMISSIBILE.name())) {
                                        GraduatoriaSoggettoDTO soggettoGraduatoria = getPunteggioTotaleDomandaBando(listaPunteggiDomanda, domanda, bandoId, StatoGraduatoriaSoggettoEnum.CHIUSA_CON_ESITO_NEGATIVO, graduatoriaBando);

                                        if (Validator.isNotNull(soggettoGraduatoria)) {
                                            graduatoria.add(soggettoGraduatoria);
                                        }
                                    }

                                    break;
                            }

                        }
                    }
                }

                if (graduatoria != null && !graduatoria.isEmpty()) {
                    ordinaGraduatoria(graduatoria, bando.getGestionePrioritaGraduatoria());
                }
            }
        }catch(Exception e) {
            log.error(e);
        }

        return graduatoria;
    }

    private void ripartizioneBudgetGraduatoria(List<GraduatoriaSoggettoDTO> graduatoriaIdonei) {
        try {
            if (graduatoriaIdonei != null && !graduatoriaIdonei.isEmpty()) {
                long bandoId = graduatoriaIdonei.get(0).getBandoId();

                if (bandoId > 0) {
                    Bando bando = bandoLocalService.getBando(bandoId);

                    if (Validator.isNotNull(bando)) {

                        BigDecimal budget = budgetBandoLocalService.getBudgetTotaleByBandoId(bandoId);
                        BigDecimal importoAssegnatoPreliminarmente = BigDecimal.ZERO;

                        if (budget != null && budget.signum() > 0) {
                            boolean importoAssegnabile = true;
                            for (GraduatoriaSoggettoDTO gradSogg: graduatoriaIdonei) {

                                if (Validator.isNotNull(gradSogg) && Validator.isNotNull(gradSogg.getEsito()) && !gradSogg.getEsito().equals(StatoGraduatoriaSoggettoEnum.CHIUSA_CON_ESITO_NEGATIVO)) {

                                    DomandaBando domanda = domandaBandoLocalService
                                            .getDomandaBando(gradSogg.getDomandaBandoId());

                                    if (Validator.isNotNull(domanda)) {

                                        if (Validator.isNotNull(domanda.getImportoAmmissibile())) {
                                            importoAssegnatoPreliminarmente = domanda
                                                    .getImportoAmmissibile();
                                        }
                                    }

                                    if (budget.compareTo(importoAssegnatoPreliminarmente) >= 0 && (importoAssegnabile)) {
                                        if(importoAssegnatoPreliminarmente.compareTo(BigDecimal.ZERO) >  0){
                                            gradSogg.setEsito(StatoGraduatoriaSoggettoEnum.PROGETTO_FINANZIABILE);
                                            gradSogg.setImportoAssegnato(importoAssegnatoPreliminarmente);
                                            budget = budget.subtract(importoAssegnatoPreliminarmente);
                                        }else{
                                            gradSogg.setEsito(StatoGraduatoriaSoggettoEnum.PROGETTO_NON_FINANZIABILE);
                                            gradSogg.setImportoAssegnato(BigDecimal.ZERO);
                                        }
                                    } else {

                                        if (budget.signum() > 0) {
                                            ModalitaAssegnazioneBudgetEnum modalitaAssegnazioneParziale = ModalitaAssegnazioneBudgetEnum.ASSEGNAZIONE_PARZIALE;
                                            ModalitaAssegnazioneBudgetEnum modalitaAssegnazioneTotale = ModalitaAssegnazioneBudgetEnum.ASSEGNAZIONE_TOTALE;
                                            String gestioneBudgetResiduo = bando.getGestioneBudgetResiduo();
                                            if(Validator.isNotNull(gestioneBudgetResiduo)){
                                                if(gestioneBudgetResiduo.equalsIgnoreCase(modalitaAssegnazioneParziale.name())){
                                                    gradSogg.setImportoAssegnato(budget);
                                                    budget = BigDecimal.ZERO; // budget -= budget;
                                                    gradSogg.setEsito(StatoGraduatoriaSoggettoEnum.PROGETTO_FINANZIABILE);
                                                }else if(gestioneBudgetResiduo.equalsIgnoreCase(modalitaAssegnazioneTotale.name())){
                                                    gradSogg.setImportoAssegnato(BigDecimal.ZERO);
                                                    gradSogg.setEsito(StatoGraduatoriaSoggettoEnum.PROGETTO_NON_FINANZIABILE);
                                                    importoAssegnabile = false;
                                                }
                                            }
                                        } else {
                                            gradSogg.setImportoAssegnato(BigDecimal.ZERO);
                                            gradSogg.setEsito(StatoGraduatoriaSoggettoEnum.PROGETTO_NON_FINANZIABILE);
                                        }
                                    }

                                    if (gradSogg.getImportoAssegnato() != null && gradSogg.getImportoAssegnato().compareTo(BigDecimal.ZERO) >= 0) {
                                        domanda.setImportoAssegnato(gradSogg.getImportoAssegnato());
                                        domandaBandoLocalService.updateDomandaBando(domanda);
                                    }
                                }
                            }

                            if (budget.signum() > 0) {
                                log.info("Budget dopo ripartizione avanzato per un totale di : " + budget
                                        + " per bando : " + bandoId);
                            }
                        } else {
                            log.warn("Budget per bando con id : " + bandoId + " non definito!");
                        }
                    }
                }
            }
        } catch (Exception e) {
            log.error(e.getMessage());
        }
    }

    private boolean checkNonIdoneitaPunteggi(List<Punteggio> listaPunteggi, List<CriterioValutazione> listaCriteri, Bando bando) {
        boolean nonIdoneo = false;

        if(Validator.isNotNull(bando)) {
            Iterator<CriterioValutazione> it = listaCriteri.iterator();
            BigDecimal punteggioVal = BigDecimal.ZERO;

            if(Validator.isNotNull(listaCriteri) && !listaCriteri.isEmpty()) {
                try {
                    while (nonIdoneo == false && it.hasNext()) {

                        CriterioValutazione criterio = it.next();

                        if (Validator.isNotNull(criterio)) {

                            if(Validator.isNotNull(criterio.getCodice()) && criterio.getCodice().equalsIgnoreCase(bando.getCodice() + "_" + GestioneBandiCommonConstants.CODICE_CRIT_PUNTEGGIO_TOT)) {
                                List<BigDecimal> punteggiVal = listaPunteggi.stream().map(x -> x.getValore()).collect(Collectors.toList());

                                if(Validator.isNotNull(punteggiVal) && !punteggiVal.isEmpty()) {
                                    punteggioVal = punteggiVal.stream().reduce(BigDecimal.ZERO, BigDecimal::add);
                                }

                            }else {
                                Optional<Punteggio> punteggioFilter = listaPunteggi.stream().filter(x -> x.getCriterioValutazioneId()==criterio.getCriterioValutazioneId()).findFirst();
                                if(punteggioFilter.isPresent()) {
                                    Punteggio punteggio = punteggioFilter.get();
                                    punteggioVal = punteggio.getValore();
                                }

                            }

                            if (punteggioVal.compareTo(criterio.getSogliaMinima()) < 0) {
                                nonIdoneo = true;
                            }

                        }
                    }
                }
                catch (Exception e) {
                    log.error(e.getMessage());
                }
            }

        }

        return nonIdoneo;
    }

    private List<GraduatoriaSoggetto> salvaGraduatoria(List<GraduatoriaSoggettoDTO> graduatoria, long graduatoriaBandoId, long groupId, long userId, long companyId, String userName) {
        List<GraduatoriaSoggetto> listaGraduatoriaSoggetto = new ArrayList<GraduatoriaSoggetto>();

        if (graduatoria != null && !graduatoria.isEmpty()) {

            for (int i = 0; i < graduatoria.size(); i++) {

                int y = i + 1;

                GraduatoriaSoggetto gradSogg = graduatoriaSoggettoLocalService.createGraduatoriaSoggetto(counterLocalService.increment());
                gradSogg.setGroupId(groupId);
                gradSogg.setUserId(userId);
                gradSogg.setCompanyId(companyId);
                gradSogg.setUserName(userName);
                gradSogg.setGraduatoriaBandoId(graduatoriaBandoId);
                gradSogg.setPosizione(y);

                GraduatoriaSoggettoDTO soggetto = graduatoria.get(i);

                if (Validator.isNotNull(soggetto)) {
                    gradSogg.setEsito(soggetto.getEsito().name());
                    gradSogg.setDomandaBandoId(soggetto.getDomandaBandoId());

                    if (Validator.isNotNull(soggetto.getNote())) {
