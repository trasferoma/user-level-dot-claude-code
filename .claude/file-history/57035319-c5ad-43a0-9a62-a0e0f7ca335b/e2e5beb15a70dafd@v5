    public List<Long> getUserSubOrganization(long groupId, long userId) throws PortalException {
        User user = userLocalService.getUser(userId);
        List<Long> ids = new ArrayList<Long>();
        if(Validator.isNotNull(user)) {
            if(Validator.isNotNull(user.getOrganizations())) {
                List<Organization> userOrganizations = user.getOrganizations();
                Group siteGroup = groupLocalService.getGroup(groupId);
                Optional<Organization> organizationUser = userOrganizations.stream().filter(x -> x.getOrganizationId() == siteGroup.getOrganizationId()).findAny();

                if(organizationUser.isPresent() && Validator.isNotNull(organizationUser.get())) {
                    Organization organization = organizationUser.get();

                    if(Validator.isNotNull(organization.getSuborganizations())) {
                        List<Organization> subOrganizationsPadre = organization.getSuborganizations();

                        for(Organization userOrganization : userOrganizations ) {
                            if(Validator.isNotNull(userOrganization)) {
                                if(userOrganization.getOrganizationId() != organization.getOrganizationId()) {
                                    Optional<Organization> organizationFound = subOrganizationsPadre.stream().filter(x -> x.getOrganizationId() == userOrganization.getOrganizationId()).findAny();

                                    if(organizationFound.isPresent() && Validator.isNotNull(organizationFound)) {
                                        ids.add(organizationFound.get().getOrganizationId());
                                    }
                                }
                            }
                        }
                    }

                }
            }
        }
        return ids;
    }

    private BigDecimal recuperaPunteggioTotale(List<Punteggio> listaPunteggi, List<CriterioValutazione> listaCriteri, Bando bando) {
        BigDecimal punteggioVal = BigDecimal.ZERO;

        if(Validator.isNotNull(bando)) {
            Iterator<CriterioValutazione> it = listaCriteri.iterator();

            if(Validator.isNotNull(listaCriteri) && !listaCriteri.isEmpty()) {
                try {
                    while (it.hasNext()) {

                        CriterioValutazione criterio = it.next();

                        if (Validator.isNotNull(criterio)) {

                            if (Validator.isNotNull(criterio.getCodice()) && criterio.getCodice().equalsIgnoreCase(bando.getCodice() + "_" + GestioneBandiCommonConstants.CODICE_CRIT_PUNTEGGIO_TOT)) {
                                List<BigDecimal> punteggiVal = listaPunteggi.stream().map(x -> x.getValore()).collect(Collectors.toList());

                                if(Validator.isNotNull(punteggiVal) && !punteggiVal.isEmpty()) {
                                    punteggioVal = punteggiVal.stream().reduce(BigDecimal.ZERO, BigDecimal::add);
                                }
                            }
                        }
                    }
                }catch (Exception e) {
                    log.error(e.getMessage());
                }
            }
        }

        return punteggioVal;
    }

