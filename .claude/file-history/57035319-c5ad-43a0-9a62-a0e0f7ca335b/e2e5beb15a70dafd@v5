    public AccountDto getEmailAccountByBando(Bando bando) {
        try {
            AccountDto emailAccount = null;
            if (bando.isMailEnabled()) {
                emailAccount = new AccountDto();
                KeystoreCryptoUtilProps keystoreUtil = new KeystoreCryptoUtilProps();
                String passwordDec = keystoreUtil.decrypt(bando.getMailPassword());

                emailAccount = new AccountDto();
                emailAccount.setHost(bando.getMailHost());
                emailAccount.setPort(bando.getMailPort());
                emailAccount.setProtocol(bando.getMailProtocol());
                emailAccount.setUsername(bando.getMailUsername());
                emailAccount.setPassword(passwordDec);
                emailAccount.setSocketPort(bando.getMailSocketFactoryPort());
                emailAccount.setAuth(String.valueOf(bando.getMailAuth()));
                emailAccount.setStarttls(bando.getMailStartTlsEnabled());
                emailAccount.setDebug(bando.getMailDebug());
                emailAccount.setStarttlsRequired(bando.getMailStartTlsRequired());
                emailAccount.setSocketFactoryFallback(bando.getMailSocketFactoryPortFallback());
                emailAccount.setFrom(bando.getMailFrom());
                emailAccount.setSslProtocols(bando.getMailProtocols());
            }
            return emailAccount;
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
    }

    /**
     * Retrieves protocol information for anticipazione forms (prima or seconda)
     * Returns a Map with keys: "testoAntipazione", "numeroProtocollo", "dataProtocollo"
     */
    public Map<String, String> getAnticipazioneProtocolInfo(long domandaBandoId, long bandoId, List<Long> integrazioni) {
        Map<String, String> result = new HashMap<>();
        result.put(TESTO_ANTICIPAZIONE, "");
        result.put("numeroProtocollo", "");
        result.put("dataProtocollo", "");

        try {
            String TIPO_FORM_INTEGRATIVA_PRIMA = "domanda-integrativa-prima-anticipazione-patrimonio-culturale";
            String TIPO_FORM_INTEGRATIVA_SECONDA = "domanda-integrativa-seconda-anticipazione-patrimonio-culturale";
            String TIPO_FORM_INTEGRATIVA_SALDO = "domanda-integrativa-di-saldo-patrimonio-culturale";


            String testoAntipazione = null;
            String[] codiciFormsToSearch = null;

            for (Long formId : integrazioni) {
                Form form = formLocalService.getForm(formId);

                if (form != null) {

                    if (TIPO_FORM_INTEGRATIVA_PRIMA.equals(form.getCodice())) {
                        testoAntipazione = "di prima anticipazione";
                        codiciFormsToSearch = new String[]{FormEsecuzione.DOMANDA_PRIMA_ANTICIPAZIONE_PATRIMONIO_CULTURALE_AC.name(), FormEsecuzione.DOMANDA_PRIMA_ANTICIPAZIONE_PATRIMONIO_CULTURALE.name()};
                        break;
                    } else if (TIPO_FORM_INTEGRATIVA_SECONDA.equals(form.getCodice())) {
                        testoAntipazione = "di seconda anticipazione";
                        codiciFormsToSearch = new String[]{FormEsecuzione.DOMANDA_SECONDA_ANTICIPAZIONE_PATRIMONIO_CULTURALE_AC.name(), FormEsecuzione.DOMANDA_SECONDA_ANTICIPAZIONE_PATRIMONIO_CULTURALE.name()};
                        break;
                    } else if (TIPO_FORM_INTEGRATIVA_SALDO.equals(form.getCodice())) {
                        testoAntipazione = "di saldo";
                        codiciFormsToSearch = new String[]{FormEsecuzione.DOMANDA_DI_SALDO_PATRIMONIO_CULTURALE_AC.name(), FormEsecuzione.DOMANDA_DI_SALDO_PATRIMONIO_CULTURALE.name()};
                        break;
                    }
                }
            }

            if (testoAntipazione != null && codiciFormsToSearch != null) {
                for (String codiceForm : codiciFormsToSearch) {
                    try {
                        Form form = formLocalService.getFormByCodice(codiceForm);

                        if (form != null) {
                            IstanzaDomandaBando istanza = istanzaDomandaBandoLocalService.getIstanzaDomandaBandoByDomandaBandoIdAndFormId(domandaBandoId, form.getFormId());

                            if (istanza != null) {
                                long istanzaDomandaBandoId = istanza.getIstanzaDomandaBandoId();

                                DomandaBandoIntegrazione integrazione = domandaBandoIntegrazioneLocalService.fetchDomandaBandoIntegrazione(istanzaDomandaBandoId);

                                if (integrazione != null) {
                                    String numeroProtocollo = integrazione.getNumeroProtocollo();
                                    Date dataProtocollo = integrazione.getDataProtocollo();

                                    if (Validator.isNotNull(numeroProtocollo)) {
                                        result.put("numeroProtocollo", numeroProtocollo);
                                    }

                                    if (dataProtocollo != null) {
                                        SimpleDateFormat sdf = new SimpleDateFormat("dd/MM/yyyy");
                                        result.put("dataProtocollo", sdf.format(dataProtocollo));
                                    }

                                    result.put(TESTO_ANTICIPAZIONE, testoAntipazione);
                                    return result;
                                }
                            }
                        }


                    } catch (Exception e) {
                        log.debug("Could not find istanza for form: " + codiceForm, e);
                    }
                }
            }
        } catch (Exception e) {
            log.error("Error retrieving anticipazione protocol info", e);
        }

        return result;
    }

