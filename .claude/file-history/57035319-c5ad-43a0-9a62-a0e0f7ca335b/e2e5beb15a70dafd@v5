     * Verifica generica sul valore di un flag booleano censito tra i {@link CodiceDatoBandoEnum} per il bando indicato.
     * I flag DISABILITA_* funzionano come attivatori: valore "true" => funzionalità attiva.
     */
    private boolean isDatoBandoFlagAttivo(long bandoId, CodiceDatoBandoEnum codice) {
        try {
            DatoBando datoBando = datoBandoLocalService.findByCodice(codice.name());
            if (datoBando != null) {
                List<ValoreDatoBando> valori = valoreDatoBandoLocalService.findByBandoIdAndDatoBandoId(bandoId, datoBando.getDatoBandoId());
                if (valori != null && !valori.isEmpty()) {
                    return "true".equals(valori.get(0).getValore());
                }
            }
        } catch (Exception e) {
            log.error("Errore nel recupero del flag " + codice.name() + " per bandoId=" + bandoId + ": " + e.getMessage(), e);
        }
        return false;
    }

