    public List<AllegatoDTO> getListaAllegati(long domandaBandoId, boolean interno, int start, int end) {
        List<AllegatoDomandaBando> listaAllegati = new ArrayList<AllegatoDomandaBando>();

        if (interno) {
            listaAllegati = allegatoDomandaBandoLocalService.getAllegatiByDomandaBandoIdAndInternoAndPrincipale(domandaBandoId, interno, false, start, end);
        } else {
            if (allegatiRichiedenteVisualizzabili(domandaBandoId)) {
                listaAllegati = allegatoDomandaBandoLocalService.getAllegatiByDomandaBandoIdAndFormCompilati(domandaBandoId, start, end);
            }
        }

        Set<Long> idsUsati = caricaIdsAllegatiUsati(domandaBandoId);
        return listaAllegati.stream()
                .map(allegato -> mapAllegato(allegato, idsUsati))
                .collect(Collectors.toList());
    }

    private Set<Long> caricaIdsAllegatiUsatiPerListaAllegati(List<AllegatoDomandaBando> allegati) {
        if (allegati == null || allegati.isEmpty()) {
            return Collections.emptySet();
        }
        long domandaBandoId = allegati.get(0).getDomandaBandoId();
        return caricaIdsAllegatiUsati(domandaBandoId);
    }

    private Set<Long> caricaIdsAllegatiUsati(long domandaBandoId) {
        List<Long> idsUsati = provvedimentoDomandaBandoAllegatoLocalService.getAllegatoDomandaBandoIdsUsati(domandaBandoId);
        if (idsUsati == null || idsUsati.isEmpty()) {
            return Collections.emptySet();
        }
        return new HashSet<>(idsUsati);
    }

