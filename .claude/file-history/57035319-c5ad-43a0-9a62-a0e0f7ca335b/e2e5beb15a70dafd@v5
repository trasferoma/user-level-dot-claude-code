    public List<CriterioValutazioneDTO> getListaCriteriValutazioneDomandaBando(long domandaBandoId, long graduatoriaBandoId) throws PortalException {
        List<CriterioValutazioneDTO> listaCriteri = new ArrayList<CriterioValutazioneDTO>();

        Valutazione val = valutazioneLocalService.getValutazioneByGraduatoriaBandoAndDomandaBando(graduatoriaBandoId, domandaBandoId);

        if (Validator.isNotNull(val)) {
            List<Punteggio> listaPunteggi = punteggioLocalService.getListaPunteggiByValutazioneId(val.getValutazioneId());

            DomandaBando domandaBando = domandaBandoLocalService.getDomandaBando(domandaBandoId);
            Bando bando = bandoLocalService.getBando(domandaBando.getBandoId());

            Map<Long, Punteggio> mapping = listaPunteggi.stream().collect(Collectors.toMap(Punteggio::getCriterioValutazioneId, Function.identity()));

            List<CriterioValutazione> listaCriteriModel = criterioValutazioneLocalService.getCriterioValutazioneByBandoIdAndNotCodice(domandaBando.getBandoId(),bando.getCodice() + "_" + GestioneBandiCommonConstants.CODICE_CRIT_PUNTEGGIO_TOT);

            List<DomandaBandoDatoAggiuntivo> domandaBandoDatoAggiuntivoList = domandaBandoDatoAggiuntivoLocalService.getDomandaBandoDatoAggiuntivoByDomandaBandoIdAndChiave(List.of(domandaBando.getDomandaBandoId()), List.of(DatoAggiuntivoChiave.PUNTEGGIO_AUTOVALUTAZIONE.name()));

            listaCriteriModel.forEach(criterioValutazione -> {
                Punteggio punteggio = mapping.get(criterioValutazione.getCriterioValutazioneId());

                CriterioValutazioneDTO criterio = new CriterioValutazioneDTO();
                criterio.setDescrizione(criterioValutazione.getDescrizione());
                criterio.setPunteggioMassimo(criterioValutazione.getPunteggioMassimo());
                criterio.setPunteggioMinimo(criterioValutazione.getPunteggioMinimo());
                criterio.setSogliaMinima(criterioValutazione.getSogliaMinima());
                criterio.setOrdine(criterioValutazione.getOrdine());
                criterio.setCriterioParentId(criterioValutazione.getCriterioParentId());
                criterio.setCriterioValutazioneId(criterioValutazione.getCriterioValutazioneId());
                if (domandaBandoDatoAggiuntivoList!=null && !domandaBandoDatoAggiuntivoList.isEmpty()) {
                    criterio.setPunteggioAutovalutazione(findPunteggioAutovalutazioneByOrdine(domandaBandoDatoAggiuntivoList, criterioValutazione.getOrdine()));
                }

                if (Validator.isNotNull(punteggio)) {
                    criterio.setPunteggioAttribuito(punteggio.getValore());
                    if (Validator.isNotNull(punteggio.getNote())) {
                        criterio.setNote(punteggio.getNote());
                    }
                }

                listaCriteri.add(criterio);
            });
        }

        return listaCriteri;
    }


