                                    graduatoriaSoggettoDTO.setEsito(esito);
                                }

                                if(Validator.isNotNull(valutazione)) {

                                    if(Validator.isNotNull(valutazione.getEsito())) {

                                        AmmissibilitaEnum ammissibilita = AmmissibilitaEnum.valueOf(valutazione.getEsito());
