                    .getIstanzaDomandaBandoByDomandaBandoIdAndFormId(domandaBando.getDomandaBandoId(), form.getFormId());

            String jsonForm = istanzaDomandaBando.getJson();

            String ragioneSociale = null, comune = null, codAteco = null, provincia = null, indirizzo = null, cap = null,
                    attivita = null, insegna = null, attoDirigenziale = null, settore = null, identificativo = null, codiceComune = null;
            int annoInizioAttivita = 0;

            if (Validator.isNotNull(jsonForm)) {
                Set<Option> jsonPathOptions = new HashSet<Option>();
                jsonPathOptions.add(Option.SUPPRESS_EXCEPTIONS);
                jsonPathOptions.add(Option.ALWAYS_RETURN_LIST);

                Configuration jsonPathConfiguration = Configuration.builder()
                        .jsonProvider(new JacksonJsonNodeJsonProvider()).mappingProvider(new JacksonMappingProvider())
                        .options(jsonPathOptions).build();

                JsonNode fieldValues = null;

                List<String> listaCampiRegistroImpresaConfigurabile = new ArrayList<String>();

                listaCampiRegistroImpresaConfigurabile = getNomeCampoByType(jsonForm, portalURL,
                        typesCustomRegistroImpreseConfigurabile, istanzaDomandaBando.getFormId());

                if (Validator.isNotNull(listaCampiRegistroImpresaConfigurabile)
                        && !listaCampiRegistroImpresaConfigurabile.isEmpty()) {
                    for (String campo : listaCampiRegistroImpresaConfigurabile) {
                        String pathCampo = "['" + campo + "']";
                        JsonNode fieldValuesOptions = JsonPath.using(jsonPathConfiguration).parse(jsonForm)
                                .read(ALPACA_ALPACA_FIELD + ALPACA_OPTIONS_FIELD + ALPACA_FIELDS_FIELD + pathCampo);

                        if (Validator.isNotNull(fieldValuesOptions) && !fieldValuesOptions.isEmpty()) {
                            JsonNode options = fieldValuesOptions.get(0);
                            if (options.has("fieldClass")) {
                                String fieldClass = options.get("fieldClass").asText();
                                if (Validator.isNotNull(fieldClass) && fieldClass.contains("soggettoDelegante")) {
                                    fieldValues = JsonPath.using(jsonPathConfiguration).parse(jsonForm)
                                            .read(ALPACA_ALPACA_FIELD + ALPACA_DATA_FIELD + pathCampo);
                                    break;
                                }
                            }
                        }
                    }
                }

                if (Validator.isNotNull(fieldValues)) {

                    JsonNode nodeInfo = fieldValues.get(0);

                    if (nodeInfo != null && !nodeInfo.isEmpty()) {

                        JsonNode nodeInterno = nodeInfo.get("privato");

                        if (Validator.isNotNull(nodeInterno)) {

                            if (nodeInterno.has("denominazioneSoggettoOrganizzatore")
                                    && !nodeInterno.get("denominazioneSoggettoOrganizzatore").isNull()) {
                                ragioneSociale = nodeInterno.get("denominazioneSoggettoOrganizzatore").asText();
                            }

                            if (nodeInterno.has("codiciAteco") && !nodeInterno.get("codiciAteco").isNull()) {
                                codAteco = nodeInterno.get("codiciAteco").asText();
                            }

                            List<String> listaCampiSedeOperativa= new ArrayList<String> ();
                            listaCampiSedeOperativa = getNomeCampoByType(jsonForm, portalURL, typesCustomSedeOperativa,
                                    istanzaDomandaBando.getFormId());
                            JsonNode fieldValuesSedeOperativa = null;
                            if (Validator.isNotNull(listaCampiSedeOperativa) && !listaCampiSedeOperativa.isEmpty()) {
                                for (String campo : listaCampiSedeOperativa) {
                                    String pathCampo = "['" + campo + "']";
                                    fieldValuesSedeOperativa = JsonPath.using(jsonPathConfiguration).parse(jsonForm)
                                            .read(ALPACA_ALPACA_FIELD + ALPACA_DATA_FIELD + pathCampo);
                                }
                            }

                            if (Validator.isNotNull(fieldValuesSedeOperativa) && !fieldValuesSedeOperativa.isEmpty()) {
                                JsonNode nodeInfoSO = fieldValuesSedeOperativa.get(0);
                                if (Validator.isNotNull(nodeInfoSO) && !nodeInfoSO.isEmpty()) {
                                    if (nodeInfoSO.has("capOperativa") && !nodeInfoSO.get("capOperativa").isNull()) {
                                        cap = nodeInfoSO.get("capOperativa").asText();
                                    }

                                    String viaSedeOperativa = "";
                                    String civicoSedeOperativa = "";
                                    if (nodeInfoSO.has("viaOperativa") && !nodeInfoSO.get("viaOperativa").isNull()) {
                                        viaSedeOperativa = nodeInfoSO.get("viaOperativa").asText();
                                    }

                                    if (nodeInfoSO.has("civicoOperativa") && !nodeInfoSO.get("civicoOperativa").isNull()) {
                                        civicoSedeOperativa = nodeInfoSO.get("civicoOperativa").asText();
                                    }
                                    indirizzo = viaSedeOperativa + " " + civicoSedeOperativa;

                                    if (nodeInfoSO.has("provinciaComuneSO") && !nodeInfo.has("provinciaComuneSO")) {
                                        JsonNode nodeInfoProvComSO = nodeInfoSO.get("provinciaComuneSO");
                                        if (nodeInfoProvComSO.has("comune") && !nodeInfoProvComSO.get("comune").isNull()) {
                                            codiceComune = nodeInfoProvComSO.get("comune").asText();
                                        }
                                        if (nodeInfoProvComSO.has("denominazioneComune") && !nodeInfoProvComSO.get("denominazioneComune").isNull()) {
                                            comune = nodeInfoProvComSO.get("denominazioneComune").asText();
                                        }

                                        if (nodeInfoProvComSO.has("provincia") && !nodeInfoProvComSO.get("provincia").isNull()) {
                                            provincia = nodeInfoProvComSO.get("provincia").asText();
                                        }
                                    }
                                }
                            } else {
                                if (nodeInterno.has("comune") && !nodeInterno.get("comune").isNull()) {
                                    comune = nodeInterno.get("comune").asText();
                                }


                                if (nodeInterno.has("provincia") && !nodeInterno.get("provincia").isNull()) {
                                    provincia = nodeInterno.get("provincia").asText();
                                }

                                if (nodeInterno.has("cap") && !nodeInterno.get("cap").isNull()) {
                                    cap = nodeInterno.get("cap").asText();
                                }
                                String viaSedeLegale = "";
                                String civicoSedeLegale = "";
                                if (nodeInterno.has("viaSedeLegale") && !nodeInterno.get("viaSedeLegale").isNull()) {
                                    viaSedeLegale = nodeInterno.get("viaSedeLegale").asText();
                                }

                                if (nodeInterno.has("civicoSedeLegale") && !nodeInterno.get("civicoSedeLegale").isNull()) {
                                    civicoSedeLegale = nodeInterno.get("civicoSedeLegale").asText();
                                }

                                indirizzo = viaSedeLegale + " " + civicoSedeLegale;

                                if (nodeInterno.has("codiceComune") && !nodeInterno.get("codiceComune").isNull()) {
                                    codiceComune = nodeInterno.get("codiceComune").asText();
                                }
                            }

                        }
                    }
                }


                List<String> listaCampiDatiAttivitaStorica = new ArrayList<String>();

                listaCampiDatiAttivitaStorica = getNomeCampoByType(jsonForm, portalURL,
                        typesCustomDatiAttivitaStorica, istanzaDomandaBando.getFormId());

                if (Validator.isNotNull(listaCampiDatiAttivitaStorica)
                        && !listaCampiDatiAttivitaStorica.isEmpty()) {
                    for (String campo : listaCampiDatiAttivitaStorica) {
                        String pathCampo = "['" + campo + "']";

                        fieldValues = JsonPath.using(jsonPathConfiguration).parse(jsonForm).read(ALPACA_ALPACA_FIELD + ALPACA_DATA_FIELD + pathCampo);

                    }
                }

                if (Validator.isNotNull(fieldValues)) {

                    JsonNode nodeInfo = fieldValues.get(0);

                    if (nodeInfo != null && !nodeInfo.isEmpty()) {

                        if (nodeInfo.has("nomeAttivita") && !nodeInfo.get("nomeAttivita").isNull()) {
                            attivita = nodeInfo.get("nomeAttivita").asText();
                        }

                        if (nodeInfo.has("denominazioneAttivita") && !nodeInfo.get("denominazioneAttivita").isNull()) {
                            insegna = nodeInfo.get("denominazioneAttivita").asText();
                        }

                        JsonNode nodeInterno = nodeInfo.get("daAnno");

                        if (Validator.isNotNull(nodeInterno)) {

                            if (nodeInterno.has("anni") && !nodeInterno.get("anni").isNull()) {
                                try {
                                    annoInizioAttivita = Integer.valueOf(nodeInterno.get("anni").asText());
                                } catch (NumberFormatException e) {
                                    log.info("Errore durante il cast del dato :annoInizioAttivita: con valore: " + annoInizioAttivita);
                                }
                            }
                        }
                    }
                }

                RiconoscimentoEnum riconoscimento = RiconoscimentoEnum.getByChiave(riconoscimentoAssegnato);

                if (Validator.isNotNull(riconoscimento)) {
                    switch (riconoscimento) {
                        case NEGOZIO_ATTIVITA:
                        case NEGOZIO_NEGOZIOSTORICO:
                        case NEGOZIO_NEGOZIOPATRIMONIO:
                            settore = SettoreEnum.COMMERCIO.name();
                            break;

                        case BOTTEGA_ATTIVITA:
                        case BOTTEGA_BOTTEGASTORICA:
                        case BOTTEGA_BOTTEGAPATRIMONIO:
                            settore = SettoreEnum.ARTIGIANATO.name();
                            break;
                        case LOCALE_ATTIVITA:
                        case LOCALE_LOCALESTORICO:
                        case LOCALE_LOCALEPATRIMONIO:
                            settore = SettoreEnum.SOMMINISTRAZIONE_RISTORAZIONE.name();
                            break;
                    }
                }

                //TODO campi mancanti
                attoDirigenziale = "";

                identificativo =  String.valueOf(LocalDate.now().getYear());

                log.debug("Campi estratti dal form: ");
                log.debug("ragioneSociale : " + ragioneSociale );
                log.debug("comune : " + comune );
                log.debug("codAteco : " + codAteco );
                log.debug("provincia : " + provincia );
                log.debug("indirizzo : " + indirizzo );
                log.debug("cap : " + cap );
                log.debug("attivita : " + attivita );
                log.debug("insegna : " + insegna );
                log.debug("attoDirigenziale : " + attoDirigenziale );
                log.debug("settore : " + settore );
                log.debug("riconoscimento : " + riconoscimentoAssegnato );
                log.debug("annoInizioAttivita: " + annoInizioAttivita);

                AttivitaStorica attivitaStorica = attivitaStoricaLocalService.createAttivitaStorica(counterLocalService.increment());

                attivitaStorica.setDomandaBandoId(domandaBando.getDomandaBandoId());
                attivitaStorica.setPartitaIva(domandaBando.getPartitaIva());

                if (Validator.isNotNull(identificativo)) {
                    attivitaStorica.setIdentificativo(domandaBando.getDomandaBandoId()+"/"+identificativo);
                }

                if (Validator.isNotNull(ragioneSociale)) {
                    attivitaStorica.setRagioneSociale(ragioneSociale);
                }

                // riferimenti a db
                if (Validator.isNotNull(codAteco)) {
                    //TODO ottimizzare il tutto agendo anche sulla custom alpaca aggiungendo un campo nascosto
                    String [] codiceAtecoElement = codAteco.split("-");
                    if (Validator.isNotNull(codiceAtecoElement) && codiceAtecoElement.length > 0) {
                        String codiceAteco = codiceAtecoElement[0].trim();
                        CodiceAteco codAtecoEntity = codiceAtecoLocalService.getByCodice(codiceAteco);
                        long atecoPrevalenteId = 0;

                        if (Validator.isNotNull(codAtecoEntity)) {
                            atecoPrevalenteId = codAtecoEntity.getCodiceAtecoId();
                            attivitaStorica.setCodiceAtecoPrevalente(codAtecoEntity.getCodice());
                        } else {
                            attivitaStorica.setCodiceAtecoPrevalente(codiceAteco);
                            //                            log.error("Impossibile recuperare codiceAteco con sigla: " + codAteco);
                        }

                        attivitaStorica.setAtecoPrevalenteId(atecoPrevalenteId);

                    }
                }

                // FIX: Associazione corretta provincia-comune
                // STEP 1: Prova lookup via codice ISTAT (provinciaId + codiceComune)
                // STEP 2: Se fallisce, cerca per denominazione (risolve bug BT con provincia errata nel form)
                // STEP 3: Deriva SEMPRE provinciaId dal comune trovato
                Comune comuneEntity = null;

                // STEP 1: Tentativo via codice ISTAT
                if (Validator.isNotNull(provincia) && Validator.isNotNull(codiceComune)) {
                    try {
                        Provincia provinciaFromForm = provinciaLocalService.getProvinciaBySigla(provincia);
                        if (Validator.isNotNull(provinciaFromForm)) {
                            String codiceISTAT = provinciaFromForm.getProvinciaId() + codiceComune;
                            comuneEntity = comuneLocalService.getComuneByCodiceISTAT(codiceISTAT);
                        }
                    } catch (Exception e) {
                        log.debug("Lookup ISTAT fallito per provincia " + provincia + " codiceComune " + codiceComune + ": " + e.getMessage());
                    }
                }

                // STEP 2: Fallback per denominazione (risolve bug BT con provincia errata)
                if (comuneEntity == null && Validator.isNotNull(comune)) {
                    try {
                        comuneEntity = comuneLocalService.getComuneByDenominazione(comune);
                        if (comuneEntity != null) {
                            log.info("Comune trovato per denominazione '" + comune + "' (ISTAT lookup fallito)");
                        }
                    } catch (Exception e) {
                        log.debug("Lookup per denominazione fallito per comune " + comune + ": " + e.getMessage());
                    }
                }

                // STEP 3: Se comune trovato, setta comuneId e SEMPRE deriva provinciaId dal comune
                if (Validator.isNotNull(comuneEntity)) {
                    attivitaStorica.setComuneId(comuneEntity.getComuneId());

                    // IMPORTANTE: Ricava provinciaId DAL COMUNE (non dal form!)
                    // Questo garantisce sempre la coerenza provincia-comune
                    long provinciaIdFromComune = comuneEntity.getIdProvincia();
                    if (provinciaIdFromComune > 0) {
                        attivitaStorica.setProvinciaId(provinciaIdFromComune);

                        // Log di warning se provincia del form è diversa da quella del comune
                        if (Validator.isNotNull(provincia)) {
                            try {
                                Provincia provinciaFromForm = provinciaLocalService.getProvinciaBySigla(provincia);
                                if (Validator.isNotNull(provinciaFromForm) &&
                                        provinciaFromForm.getProvinciaId() != provinciaIdFromComune) {
                                    log.warn("Provincia nel form (" + provincia + ", ID:" + provinciaFromForm.getProvinciaId() +
                                            ") diversa da provincia del comune (ID:" + provinciaIdFromComune + "). Usata provincia del comune.");
                                }
                            } catch (Exception e) {
                                log.debug("Provincia nel form non trovata: " + provincia);
                            }
                        }
                    } else {
                        log.warn("Provincia non trovata per comune: " + comuneEntity.getComuneId());
                    }
                } else {
                    // FALLBACK FINALE: Se comune non trovato, usa provincia del form
                    if (Validator.isNotNull(provincia)) {
                        try {
                            Provincia provinciaFromForm = provinciaLocalService.getProvinciaBySigla(provincia);
                            if (Validator.isNotNull(provinciaFromForm)) {
                                attivitaStorica.setProvinciaId(provinciaFromForm.getProvinciaId());
                                log.warn("Comune non trovato. Provincia settata da form: " + provincia);
                            }
                        } catch (Exception e) {
                            log.error("Errore nel recupero provincia fallback: " + e.getMessage(), e);
                        }
                    }
                }

                if (Validator.isNotNull(cap)) {
                    attivitaStorica.setCap(cap);
                }

                if (Validator.isNotNull(indirizzo)) {
                    attivitaStorica.setIndirizzo(indirizzo);
                }

                if (Validator.isNotNull(annoInizioAttivita)) {
                    attivitaStorica.setAnnoInizioAttivita(annoInizioAttivita);
                }

                if (Validator.isNotNull(attivita)) {
                    attivitaStorica.setAttivita(attivita);
                }

                if (Validator.isNotNull(insegna)) {
                    attivitaStorica.setInsegna(insegna);
                }

                if (Validator.isNotNull(attoDirigenziale)) {
                    attivitaStorica.setAttoDirigenziale(attoDirigenziale);
                }

                // da ENUM
                if (Validator.isNotNull(settore)) {
                    attivitaStorica.setSettore(settore);
                }

                if (Validator.isNotNull(riconoscimentoAssegnato)) {
                    attivitaStorica.setRiconoscimento(riconoscimentoAssegnato);
                }
                // fine ENUM
                attivitaStorica.setStato(StatoAttivitaStoricaEnum.ATTESA_APPROVAZIONE.name());
                attivitaStoricaLocalService.updateAttivitaStorica(attivitaStorica);
            }
        } else {
            log.error("Domanda bando o bando id null");
        }
    }

    private List<String> getNomeCampoByType(String jsonForm, String portalUrl, String[] types, long formId) {
        Gson gson = new Gson();
        List<String> listaCampi = new ArrayList<String>();
        FormData formData = null;

        try {
            if (Validator.isNotNull(jsonForm)) {
                String jsonData = gson.toJson(gson.fromJson(jsonForm, FormData.class));
                Form form = formLocalService.getForm(formId);

                if (Validator.isNotNull(form)) {
                    formData = AlpacaUtil.loadFormData(form, jsonData, true, portalUrl);
                    AlpacaJsonStructure alpacaStructure = formData.getAlpaca();
                    AlpacaJsonOptionsStructure optionStr = gson.fromJson(gson.toJson(alpacaStructure.getOptions()),
                            AlpacaJsonOptionsStructure.class);
                    listaCampi = AlpacaUtil.getAllFieldNameDataContainer(optionStr, types);
                }

            }
        } catch (Exception e) {
            log.error(e.getMessage());
        }
        return listaCampi;
    }

    public Boolean checkCalcoloAutomaticoImportoAmmissibile(Bando bando) {
        Boolean faseValutazione = false;
        Boolean calcoloAutoImportoAmmissibile = bando.getCalcoloAutoImportoAmmissibile();
        String fasi = bando.getFasiAssegnabilitaImporto();
        if (Validator.isNotNull(fasi) && !fasi.isEmpty()) {
            String[] split = fasi.split(",");
            for (String fase : split) {
                if (fase.equals(FasiAssegnabilitaImportoEnum.VALUTAZIONE.name())) {
                    faseValutazione = true;
                }
            }
        }
        return faseValutazione && calcoloAutoImportoAmmissibile;
    }


    public Boolean visualizzaImportoAmmissibile(ServiceContext serviceContext, long domandaBandoId, Bando bando) {
        FaseWorkflowBandoEnum faseCorrente = recuperaFaseWorkflow(serviceContext, domandaBandoId);
        String fasi = bando.getFasiAssegnabilitaImporto();
        if (Validator.isNotNull(fasi) && !fasi.isEmpty()) {
            String[] split = fasi.split(",");
            for (String fase : split) {
                if (fase.equals(FasiAssegnabilitaImportoEnum.ISTRUTTORIA.name()) && FaseWorkflowBandoEnum.ISTRUTTORIA.equals(faseCorrente)) {
                    return true;
                }
                if (fase.equals(FasiAssegnabilitaImportoEnum.VERIFICA_RESPONSABILE.name()) && FaseWorkflowBandoEnum.VERIFICA_RESPONSABILE.equals(faseCorrente)) {
                    return true;
                }
                if (fase.equals(FasiAssegnabilitaImportoEnum.VALUTAZIONE.name()) && FaseWorkflowBandoEnum.VALUTAZIONE.equals(faseCorrente)) {
                    return true;
                }
            }
        }
        return false;
    }

    public String getLabelRiconoscimentoRichiesto(DomandaBando domandaBando) {
