    public Boolean allegatiRichiedenteVisualizzabili(long domandaBandoId) {
        Date today = new Date();
        DomandaBando domandaBando = domandaBandoLocalService.fetchDomandaBando(domandaBandoId);
        Bando bando = bandoLocalService.fetchBando(domandaBando.getBandoId());
        if (bando.isAbilitazioneVisibilitaAllegati()) {
            //Visibilita' allegati dopo chiusura bando
            if (today.before(bando.getDataFine())) {
                return false;
            } else {
                return true;
            }
        } else return true;
    }

    private AllegatoDTO mapAllegato(AllegatoDomandaBando allegatoDomandaBando, Set<Long> idsAllegatiUsati) {
        AllegatoDTO dto = new AllegatoDTO();

        // ID documentale e nome file dal DB: sempre disponibili.
        // Garantisce che il bottone download sia sempre attivo se il file e' registrato in DB,
        // anche quando Alfresco e' temporaneamente lento al render.
        dto.setIdDocumentale(allegatoDomandaBando.getIdDocumentale());
        dto.setNomeFile(allegatoDomandaBando.getNome());

        try {
            FileService fileService = fileServiceFactory.getActiveFileService();
            File requestFile = fileService.getRequestFile(
                    allegatoDomandaBando.getIdDocumentale(),
                    allegatoDomandaBando.getGroupId());

            if (Validator.isNotNull(requestFile)) {
                // Lo stream e' aperto eagerly da AlfrescoFileServiceImpl.getFile().
                // Lo chiudiamo subito senza consumarlo: il binario non serve al render
                // (download avviene fresh in DownloadFileResourceCommand al click).
                InputStream is = requestFile.getInputStream();
                if (is != null) {
                    try (InputStream toClose = is) {
                        // intenzionalmente vuoto: il binario non viene consumato qui
                    } catch (IOException ioe) {
                        log.warn("mapAllegato: errore chiusura stream allegato "
                                + allegatoDomandaBando.getIdDocumentale(), ioe);
                    }
                }
                dto.setDimensione(fileUtility.getHumanReadableSize(requestFile.getSize()));
            }
        } catch (Exception e) {
            // Alfresco non risponde: il file resta scaricabile via DownloadFileResourceCommand
            // (fresh fetch al click). Solo la dimensione non sara' mostrata in UI.
            log.warn("mapAllegato: impossibile recuperare metadata Alfresco per "
                    + allegatoDomandaBando.getIdDocumentale(), e);
        }

        dto.setDescrizione(allegatoDomandaBando.getTitolo());
        dto.setTitolo(allegatoDomandaBando.getTitolo());
        dto.setVisibileAlCittadino(allegatoDomandaBando.getVisibile());
        dto.setNomeOperatore(allegatoDomandaBando.getUserName());
        dto.setAllegatoDomandaBandoId(allegatoDomandaBando.getAllegatoDomandaBandoId());
        dto.setDataScadenza(allegatoDomandaBando.getDataScadenza());
        dto.setUsato(idsAllegatiUsati != null && idsAllegatiUsati.contains(allegatoDomandaBando.getAllegatoDomandaBandoId()));

        return dto;
    }

