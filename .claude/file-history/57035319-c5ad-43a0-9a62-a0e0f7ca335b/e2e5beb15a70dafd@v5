                                        graduatoriaSoggettoDTO.setConvalidaAmmissibilita(valutazione.getConvalidata());
                                        Valutazione valutazioneMerito = valutazioneLocalService.getValutazioneByGraduatoriaBandoAndDomandaBando(graduatoriaBando.getGraduatoriaBandoId(), domandaBando.getDomandaBandoId());

                                        if(Validator.isNotNull(valutazioneMerito)) {
