        return false;
    }

    public String getFaseDomandaBando(ServiceContext serviceContext, long domandaBandoId) {

        String fase = "";

        try {
            String tenantId = String.valueOf(serviceContext.getScopeGroup().getOrganizationId());
            List<Task> tasksByBusinessKey = camundaClient.getTasksByBusinessKey(tenantId, String.valueOf(domandaBandoId));
            if (tasksByBusinessKey != null) {
                for (Task task : tasksByBusinessKey) {
                    List<VariableInstance> variablesByTaskId = camundaClient.getVariablesByExecutionId(tenantId, task.getExecutionId());
                    if (ListUtil.isNotNull(variablesByTaskId) && ListUtil.isNotEmpty(variablesByTaskId)) {
                        Iterator<VariableInstance> iterator = variablesByTaskId.iterator();
                        boolean variabileTrovata = false;

                        while(iterator.hasNext() && !variabileTrovata){
                            VariableInstance variableInstance = iterator.next();

                            if(Validator.isNotNull(variableInstance) && variableInstance.getName().equalsIgnoreCase(CustomProcessVariables.FASE)){
                                variabileTrovata = true;

                                if(Validator.isNotNull(variableInstance.getValue())){
                                    fase = (String) variableInstance.getValue();
                                }

                            }
                        }
                    }
                }
            }
        }
        catch (CamundaClientException | PortalException e) {
            log.error("getFaseDomandaBando :: " + e.getMessage(), e);
        }
        return fase;
    }

    private BigDecimal findPunteggioAutovalutazioneByOrdine(List<DomandaBandoDatoAggiuntivo> list, int ordine) {
        return list.stream()
                .filter(d -> d.getProgressivo()==ordine)
                .map(DomandaBandoDatoAggiuntivo::getValore)
                .map(this::safeToBigDecimal)
                .filter(Objects::nonNull)
                .findAny()
                .orElse(null);
    }

    private BigDecimal safeToBigDecimal(String value) {
        try {
            return value != null ? new BigDecimal(value.trim()) : null;
        } catch (NumberFormatException e) {
            return null;
        }
    }

