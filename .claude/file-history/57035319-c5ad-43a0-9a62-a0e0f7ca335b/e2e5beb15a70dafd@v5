                gradSogg = graduatoriaSoggettoLocalService.updateGraduatoriaSoggetto(gradSogg);
                listaGraduatoriaSoggetto.add(gradSogg);
            }
        }

        return listaGraduatoriaSoggetto;
    }

    private void ordinaGraduatoria(List<GraduatoriaSoggettoDTO> graduatoria, String gestionePrioritaGraduatoria) {
        TipoGestionePriorita tipoGestionePriorita;
        try {
            tipoGestionePriorita = TipoGestionePriorita.valueOf(gestionePrioritaGraduatoria);
        } catch (IllegalArgumentException e) {
            tipoGestionePriorita = TipoGestionePriorita.DEFAULT;
        }

        Map<TipoGestionePriorita, Comparator<GraduatoriaSoggettoDTO>> gestioniPriorita = Map.of(
                TipoGestionePriorita.DEFAULT, graduatoriaDefaultComparator,
                TipoGestionePriorita.ORDINE_ARRIVO, graduatoriaOrdineArrivoComparator
        );

        if (Validator.isNotNull(graduatoria)) {
            Collections.sort(graduatoria, gestioniPriorita.get(tipoGestionePriorita));
        }

    }

    private GraduatoriaSoggettoDTO getPunteggioTotaleDomandaBando(List<Punteggio> listaPunteggio, DomandaBando domandaBando, long bandoId, StatoGraduatoriaSoggettoEnum statoSoggetto, GraduatoriaBando graduatoriaBando) {

