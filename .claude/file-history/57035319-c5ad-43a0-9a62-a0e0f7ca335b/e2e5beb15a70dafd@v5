            if (selezionati != null && !selezionati.isEmpty()) {
                allegatoDomandaBandoLocalService.updateVisibilita(selezionati, true);
            }

            List<Task> tasksByBusinessKey = camundaClient.getTasksByBusinessKey(tenantId, String.valueOf(domandaBandoId));
