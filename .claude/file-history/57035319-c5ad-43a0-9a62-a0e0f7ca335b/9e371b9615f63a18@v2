@Component(immediate = true, property = { //
        "javax.portlet.name=" + PresentatoreFormsPortletKeys.PRESENTATOREFORMS, //
        "mvc.command.name=" + PresentatoreFormsPortletKeys.DOWNLOAD_FORM_INTEGRATIVO_OPERATORE_RENDER_COMMAND//
}, service = { MVCResourceCommand.class }//
) //
public class DownloadFileIntegrativoOperatoreResourceCommand extends BaseMVCResourceCommand {
    public static final Log log = LogFactoryUtil.getLog(DownloadFileIntegrativoOperatoreResourceCommand.class);

    private static final SimpleDateFormat formatter = new SimpleDateFormat("dd-MM-yyyy-HH-mm");

    @Reference
    private Portal portal;

    @Reference
    private PDFServiceFactory pdfServiceFactory;

    @Reference
    private DomandaBandoLocalService domandaBandoLocalService;

    @Reference
    private BandoLocalService bandoLocalService;

    @Reference
    private FormLocalService formLocalService;

    @Reference
    private AllegatoDomandaBandoLocalService allegatoDomandaBandoLocalService;

    @Reference
    private FileServiceFactory fileServiceFactory;

    @Reference
    private CounterLocalService counterLocalService;

    @Reference
    private AzioneOperatoreLocalService azioneOperatoreLocalService;
    
    @Reference
	private AuditService auditService;


    @Override
    protected void doServeResource(ResourceRequest resourceRequest, ResourceResponse resourceResponse) throws Exception {

        ThemeDisplay themeDisplay = (ThemeDisplay) resourceRequest.getAttribute(WebKeys.THEME_DISPLAY);
        User user = themeDisplay.getUser();

        String inputJson = ParamUtil.getString(resourceRequest, "json");

        long domandaBandoId = ParamUtil.getLong(resourceRequest, "domandaBandoId");
        long formId = ParamUtil.getLong(resourceRequest, "formId");
        String tipoModulo = ParamUtil.getString(resourceRequest, "tipoModulo");

        JsonObject payload;

        byte[] pdf = null;

        String screenName = themeDisplay.getUser().getScreenName();

        Gson gson = new Gson();

        try {

            DomandaBando domandaBando = domandaBandoLocalService.getDomandaBando(domandaBandoId);
            Bando bando = bandoLocalService.getBando(domandaBando.getBandoId());

            Form form = formLocalService.getForm(formId);
            form.setListaDefinizioneAllegato(new ArrayList<>());

            FormData formData = AlpacaUtil.loadFormData(form, null, true, themeDisplay.getPortalURL());

            Object dataObject = gson.fromJson(inputJson, Object.class);
            formData.getAlpaca().setData(dataObject);

            AlpacaJsonStructure alpacaStructure = formData.getAlpaca();

            JsonParser jsonParser = new JsonParser();
            alpacaStructure.setSchema(AlpacaUtil.addAttachmentsToSchema(gson.toJson(alpacaStructure.getSchema()), form.getListaDefinizioneAllegato()));
            alpacaStructure.setOptions(AlpacaUtil.loadOptions(gson.toJson(alpacaStructure.getOptions()), form.getListaDefinizioneAllegato(), true, themeDisplay.getPortalURL()));
            alpacaStructure.setData(jsonParser.parse(gson.toJson(alpacaStructure.getData())).getAsJsonObject());

            PDFService pdfService = pdfServiceFactory.getPDFService(TipoGenerazionePDF.NATIVA);


            byte[] content = null;
            String prefissoNomeFile = "disciplinare";
            if(tipoModulo.equalsIgnoreCase(PresentatoreFormsPortletKeys.REVOCA)){
                content = pdfService.generaPDFDisciplinareForm(domandaBando, alpacaStructure,
                        String.valueOf(CodiceTemplatePdf.REVOCA));
                prefissoNomeFile = "revoca";
            }else if(tipoModulo.equalsIgnoreCase(PresentatoreFormsPortletKeys.DISCIPLINARE_ESECUZIONE)){
                content = pdfService.generaPDFDisciplinareForm(domandaBando, alpacaStructure, CodiceTemplatePdf.DISCIPLINARE_ESECUZIONE.name());
                prefissoNomeFile = "disciplinare-esecuzione";
            }else if(tipoModulo.equalsIgnoreCase(PresentatoreFormsPortletKeys.DISCIPLINARE)){
                content = pdfService.generaPDFDisciplinareForm(domandaBando, alpacaStructure, CodiceTemplatePdf.DISCIPLINARE.name());
            }else{
                throw new IllegalArgumentException("Tipo modulo non valido: " + tipoModulo);
            }
            String titoloDocumento = prefissoNomeFile+" da sottoscrivere";

            InputStream stream = new ByteArrayInputStream(content);

            String nomeFile = prefissoNomeFile + "-" + domandaBandoId + "-" + formatter.format(new Date()) + ".pdf";
            String descrizione = "";

            String mimeType = MimeTypesUtil.getContentType(stream, nomeFile);

            // salvo il pdf generato
            ServiceContext serviceContext = ServiceContextFactory.getInstance(resourceRequest);
//            UploadPortletRequest uploadPortletRequest = portal.getUploadPortletRequest(resourceRequest);
//            String contentType = uploadPortletRequest.getContentType("allegato");
            List<AllegatoDomandaBando> allegati = allegatoDomandaBandoLocalService.getListaAllegatoDomandaBandoByDomandaBandoIdAndVisibile(domandaBandoId,true);

            AllegatoDomandaBando allegatoDomandaBando = null;
            if(allegati!= null && allegati.size()>0){
                long idAllegatoBando = 0;
//                String idDocumentale = null;
                for (AllegatoDomandaBando allegato : allegati){
                    if(allegato.getTitolo().equalsIgnoreCase(titoloDocumento)){
                        allegatoDomandaBando = allegato;
                        idAllegatoBando = allegato.getAllegatoDomandaBandoId();
//                        idDocumentale = allegato.getIdDocumentale();
                        break;
                    }
                }
//                if(idAllegatoBando>0) {
//                    allegatoDomandaBandoLocalService.deleteAllegatoDomandaBando(idAllegatoBando);
//                    DLFileEntryLocalServiceUtil.deleteDLFileEntry(Long.parseLong(idDocumentale));
//                }
            }

            FileService activeFileService = fileServiceFactory.getActiveFileService();

            String idDocumentale = addOrUpdatePdf(themeDisplay, user, domandaBando, bando, stream, nomeFile,titoloDocumento, descrizione, mimeType, activeFileService, allegatoDomandaBando);
            addOrUpdateAllegato(themeDisplay, user, domandaBando, nomeFile,titoloDocumento, descrizione, allegatoDomandaBando, idDocumentale);

//            allegatoDomandaBandoLocalService.addAllegato(
//                    serviceContext, domandaBandoId, titoloDocumento, true,
//                    stream, nomeFile, contentType);

            payload = new JsonObject();
            payload.addProperty("status", "OK");

            if(tipoModulo.equalsIgnoreCase(PresentatoreFormsPortletKeys.REVOCA)){
                azioneOperatoreLocalService.addAzioneOperatore(serviceContext, domandaBandoId, serviceContext.getUserId(), new Date(), PresentatoreFormsPortletKeys.COMPILA_REVOCA);
            } else if(tipoModulo.equalsIgnoreCase(PresentatoreFormsPortletKeys.DISCIPLINARE_ESECUZIONE)){
                azioneOperatoreLocalService.addAzioneOperatore(serviceContext, domandaBandoId, serviceContext.getUserId(), new Date(), PresentatoreFormsPortletKeys.COMPILA_DISCIPLINARE_ESECUZIONE);
            } else if(tipoModulo.equalsIgnoreCase(PresentatoreFormsPortletKeys.DISCIPLINARE)){
                azioneOperatoreLocalService.addAzioneOperatore(serviceContext, domandaBandoId, serviceContext.getUserId(), new Date(), PresentatoreFormsPortletKeys.COMPILA_DISCIPLINARE);
            } else{
                throw new IllegalArgumentException("Tipo modulo non valido: " + tipoModulo);
            }

        }
        catch (Exception e) {
        	auditService.saveErrorLog(resourceRequest, e.getMessage());
            log.error("downloadIstanzaPDFResourceCommand :: " + e.getMessage(), e);
            SessionErrors.add(resourceRequest, PresentatoreFormsPortletKeys.ERRORE_GENERICO);

            payload = new JsonObject();
            payload.addProperty("errore", "errore-generico");
            return;
        }
        String json = payload.toString();
        resourceResponse.getPortletOutputStream().write(json.getBytes());
    }

    private String addOrUpdatePdf(ThemeDisplay themeDisplay, User user, DomandaBando domandaBando, Bando bando, InputStream stream, String nomeFile,String titolo, String descrizione, String mimeType,
                                  FileService activeFileService, AllegatoDomandaBando allegatoRichiesta) {
        if (allegatoRichiesta != null) {
            activeFileService.deleteRequestFile(allegatoRichiesta.getIdDocumentale(), allegatoRichiesta.getGroupId());
        }

        it.servizidigitali.file.utility.model.File idDocumentale = activeFileService.saveRequestFile(nomeFile, titolo, descrizione, bando.getCodice(), domandaBando.getDomandaBandoId(), stream,
                mimeType, user.getUserId(), themeDisplay.getSiteGroupId());
        return idDocumentale.getId();
    }


    private void addOrUpdateAllegato(ThemeDisplay themeDisplay, User user, DomandaBando domandaBando, String nomeFile,String titolo, String descrizione, AllegatoDomandaBando allegatoDomandaBando,
                                     String idDocumentale) {
        if (allegatoDomandaBando != null) {
            allegatoDomandaBando.setIdDocumentale(idDocumentale);
        }
        else {
            long allegatoDomandaBandoId = counterLocalService.increment();
            allegatoDomandaBando = allegatoDomandaBandoLocalService.createAllegatoDomandaBando(allegatoDomandaBandoId);
            allegatoDomandaBando.setGroupId(themeDisplay.getSiteGroupId());
            allegatoDomandaBando.setCompanyId(themeDisplay.getCompanyId());
            allegatoDomandaBando.setUserId(user.getUserId());
            allegatoDomandaBando.setUserName(user.getFullName());
            allegatoDomandaBando.setDomandaBandoId(domandaBando.getDomandaBandoId());
            allegatoDomandaBando.setIdDocumentale(idDocumentale);
            allegatoDomandaBando.setDefinizioneAllegatoId(0);
            allegatoDomandaBando.setPrincipale(false);
            allegatoDomandaBando.setNome(nomeFile);
            allegatoDomandaBando.setTitolo(titolo);
            allegatoDomandaBando.setDescrizione(descrizione);
            allegatoDomandaBando.setInterno(true);
            allegatoDomandaBando.setVisibile(true);
        }

        allegatoDomandaBandoLocalService.updateAllegatoDomandaBando(allegatoDomandaBando);
    }

}