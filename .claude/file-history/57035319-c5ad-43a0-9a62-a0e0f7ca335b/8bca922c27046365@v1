    private List<AllegatoReportDTO> costruisciAllegatiReportDTO(List<AllegatoDomandaBando> allegatiEsterni) {
        if (allegatiEsterni == null || allegatiEsterni.isEmpty()) {
            return Collections.emptyList();
        }

        return allegatiEsterni.stream()
                .map(this::mappaAllegatoInReportDTO)
                .collect(Collectors.toList());
    }

    private AllegatoReportDTO mappaAllegatoInReportDTO(AllegatoDomandaBando allegato) {
        String denominazione = allegato.getTitolo() != null && !allegato.getTitolo().isEmpty()
                ? allegato.getTitolo()
                : (allegato.getDescrizione() != null ? allegato.getDescrizione() : "");
        String nomeFile = allegato.getNome() != null ? allegato.getNome() : "";

        String impronta;
        boolean firmato;
        if (EsitoVerificaFirma.ERRORE.name().equals(allegato.getEsitoVerificaFirma())) {
            impronta = "Non disponibile";
            firmato = false;
        } else {
            impronta = allegato.getImpronta() != null ? allegato.getImpronta() : "";
            firmato = allegato.isFirmatoDigitalmente();
        }

        String firmatario = allegato.getFirmatario() != null ? allegato.getFirmatario() : "";
        return new AllegatoReportDTO(denominazione, nomeFile, impronta, firmato, firmatario);
    }

    private AnnotazioneOperatore getCommentoText(long commentoDomandaBandoId) {
        AnnotazioneOperatore result = new AnnotazioneOperatore();
        if (commentoDomandaBandoId <= 0) {
            return result;
        }

        try {
            CommentoDomandaBando commento = commentoDomandaBandoLocalService.getCommentoDomandaBando(commentoDomandaBandoId);
            result.setOggetto(commento.getOggetto())
                  .setTesto(commento.getTesto());
        } catch (Exception e) {
            log.warn("Impossibile recuperare il commento con ID: " + commentoDomandaBandoId, e);
        }

        return result;
    }
