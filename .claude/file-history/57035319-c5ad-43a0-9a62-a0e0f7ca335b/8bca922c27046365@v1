    /**
     * Gets child templates from the list of templates
     * @param templatesPdf the list of templates to filter
     * @return list of child templates
     */
    private List<TemplatePdf> getTemplatesPdfFigli(List<TemplatePdf> templatesPdf) {
        if (templatesPdf == null) {
            return null;
        }

       return templatesPdf.stream()
               .filter(templatePdf -> templatePdf.getTemplatePdfParentId() != 0)
               .sorted(Comparator.comparing(TemplatePdf::getOrdine))
               .collect(Collectors.toList());
    }

    private TemplatePdf getTemplatePdfPrincipale(List<TemplatePdf> templatesPdf) {
        if (templatesPdf == null) {
            return null;
        }

        return templatesPdf.stream()
                .filter(templatePdf -> templatePdf.getTemplatePdfParentId() == 0)
                .findFirst()
                .orElse(null);
    }

