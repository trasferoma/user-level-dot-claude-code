    @Override
    public byte[] generaPDFAlpacaForm(String codiceFiscaleRichiedente, AlpacaJsonStructure alpacaStructure,
                                      DomandaBando domandaBando, boolean isDelega, String dettagliRichiesta) throws PDFServiceException {

        // Imposta headless mode per evitare errori Swing in ambiente server
        System.setProperty("java.awt.headless", "true");

        // Configura SSL per accettare tutti i certificati (necessario per caricare immagini da URL HTTPS)
        configureTrustAllCertificates();

        Gson gson = new Gson();

        try {
            long bandoId = domandaBando.getBandoId();
            Bando bando = bandoLocalService.getBando(bandoId);
            long groupId = bando.getGroupId();
            long organizationId = organizationUtility.getSiteOrganization(groupId).getOrganizationId();

            // Get templates list and optional override from configuration
            List<TemplatePdf> templatesPdf = templatePdfLocalService.getTemplatePdfByBandoIdAndTipoAndCodice(
                    bando.getBandoId(),
                    TipoTemplate.JASPER_REPORT.name(),
                    CodiceTemplatePdf.ISTANZA.name());

            jasperTemplateEnteConfiguration = configurationProvider.getGroupConfiguration(JasperTemplateEnteConfiguration.class, groupId);
            long overrideFileEntryId = 0L;
            if (jasperTemplateEnteConfiguration != null) {
                overrideFileEntryId = jasperTemplateEnteConfiguration.defaultAlpacaTemplate();
            }

            TemplatePdf templatePdfPrincipale = getTemplatePdfPrincipale(templatesPdf);
            List<TemplatePdf> templatesPdfFigli = getTemplatesPdfFigli(templatesPdf);

            if (overrideFileEntryId <= 0 && templatePdfPrincipale == null) {
                throw new PDFServiceException("Report JRXML principale non presente.");
            }

            Map<String, Object> param = new HashMap<>();
            Object data = alpacaStructure.getData();
            InputStream stream = new ByteArrayInputStream(gson.toJson(data).getBytes(StandardCharsets.UTF_8));
            Organization organization = organizationLocalService.getOrganization(organizationId);
            JRDataSource jsonDataSource = new JsonDataSource(stream);

            long fileEntryId = overrideFileEntryId > 0 ? overrideFileEntryId : templatePdfPrincipale.getFileEntryId();
            FileEntry documentoPrincipalefileEntry = dlAppService.getFileEntry(fileEntryId);
            InputStream reportPrincipaleInputStream = new ByteArrayInputStream(documentoPrincipalefileEntry.getContentStream().readAllBytes());
            JasperReport reportPrincipaleJasperReport = JasperCompileManager.compileReport(reportPrincipaleInputStream);

            // Sottoreport, se presenti
            if (templatesPdfFigli != null && !templatesPdfFigli.isEmpty()) {
                for (TemplatePdf templatePdfFiglio : templatesPdfFigli) {
                    FileEntry documentoFiglioEntry = dlAppService.getFileEntry(templatePdfFiglio.getFileEntryId());
                    InputStream subReportInputStream = new ByteArrayInputStream(documentoFiglioEntry.getContentStream().readAllBytes());
                    JasperReport subJasperReport = JasperCompileManager.compileReport(subReportInputStream);
                    String subreportKey = documentoFiglioEntry.getFileName();
                    param.put(subreportKey, subJasperReport);
                    log.debug("Compilato subreport con chiave: '" + subreportKey + "'");
                }
            } else {
                log.debug("Nessun subreport figlio trovato per questo bando");
            }

            addParametriAggiuntivi(param);

            LayoutSet layout = layoutSetLocalService.getLayoutSet(groupId, false);
            Image image = imageLocalService.getCompanyLogo(layout.getLogoId());

            if (Validator.isNotNull(image)) {
                ByteArrayInputStream logoComune = new ByteArrayInputStream(image.getTextObj());
                param.put(JR_PARAMETER_LOGO_COMUNE, logoComune);
            }

            param.put(JR_PARAMETER_COMUNE, organization.getName());
            param.put(JR_PARAMETER_NOME_BANDO, bando.getNome());

            // URL del portale per caricare risorse dalla Document Library
            try {
                Company company = companyLocalService.getCompany(organization.getCompanyId());
                String portalURL = company.getPortalURL(groupId);
                param.put(JR_PARAMETER_URL_PORTALE, portalURL);
            } catch (Exception e) {
                log.warn("Impossibile ottenere URL portale: " + e.getMessage());
            }

            // Nome e cognome dell'utente che genera il documento
            if (Validator.isNotNull(codiceFiscaleRichiedente)) {
                User user = userLocalService.fetchUserByScreenName(organization.getCompanyId(), codiceFiscaleRichiedente);
                if (user != null) {
                    String nomeCognome = user.getFirstName() + " " + user.getLastName();
                    param.put(JR_PARAMETER_NOME_COGNOME_UTENTE, nomeCognome);
                }
            }

            // Costruisce lista allegati DTO dagli allegati caricati nella domanda
            List<AllegatoReportDTO> listaAllegati = new ArrayList<>();

            List<AllegatoDomandaBando> allegatiDomanda = allegatoDomandaBandoLocalService
                    .getListaAllegatiByDomandaBandoId(domandaBando.getDomandaBandoId());

            for (AllegatoDomandaBando allegato : allegatiDomanda) {
                if (allegato.getDefinizioneAllegatoId() > 0) {
                    // Recupera denominazione dalla DefinizioneAllegato
                    String denominazione = allegato.getTitolo();

                    String nomeFile = allegato.getNome() != null ? allegato.getNome() : "";
                    String impronta;
                    boolean firmato;

                    if (EsitoVerificaFirma.ERRORE.name().equals(allegato.getEsitoVerificaFirma())) {
                        impronta = "Non disponibile";
                        firmato = false;
                    } else {
                        impronta = allegato.getImpronta() != null ? allegato.getImpronta() : "";
                        firmato = allegato.isFirmatoDigitalmente();
                    }

                    String firmatario = allegato.getFirmatario() != null ? allegato.getFirmatario() : "";
                    listaAllegati.add(new AllegatoReportDTO(denominazione, nomeFile, impronta, firmato, firmatario));
                }
            }

            param.put(JR_PARAMETER_LISTA_ALLEGATI, new JRBeanCollectionDataSource(listaAllegati));
            addDynamicArrayParameters(param, data, gson);
            addDynamicScalarParameters(param, data, gson);
            addDynamicObjectParameters(param, data, gson);
            addCostiUnificatoDataSource(param, data, gson);

            log.debug("generaPDFAlpacaForm :: Parametri disponibili per il report: " + param.keySet());

            JasperPrint jasperPrint = JasperFillManager.fillReport(reportPrincipaleJasperReport, param, jsonDataSource);

            ByteArrayOutputStream out = new ByteArrayOutputStream();
            JasperExportManager.exportReportToPdfStream(jasperPrint, out);
            return out.toByteArray();
        }
        catch (Exception e) {
            log.error("generaPDFAlpacaForm :: " + e.getMessage(), e);
            throw new PDFServiceException("Errore durante il processo di generazione del PDF :: " + e.getMessage(), e);
        }
    }

