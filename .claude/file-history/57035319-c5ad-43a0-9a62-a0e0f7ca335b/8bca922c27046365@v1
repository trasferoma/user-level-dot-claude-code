    /**
     * Estrae dinamicamente gli array dal JSON del form Alpaca e li aggiunge come parametri.
     * Usa il mapping definito in JSON_ARRAY_MAPPINGS per determinare quali array estrarre.
     *
     * @param param la mappa dei parametri a cui aggiungere gli array
     * @param data l'oggetto dati del form Alpaca
     * @param gson l'istanza Gson per la conversione
     */
    private void addDynamicArrayParameters(Map<String, Object> param, Object data, Gson gson) {
        if (data == null) {
            return;
        }

        try {
            // Converti l'oggetto data in JsonObject per la navigazione
            String jsonString = gson.toJson(data);
            JsonObject jsonData = gson.fromJson(jsonString, JsonObject.class);

            for (JasperArrayMappingEnum mapping : JasperArrayMappingEnum.values()) {
                String jsonPath = mapping.getJsonPath();
                String paramName = mapping.getJrParameterName();

                JsonArray jsonArray = extractJsonArray(jsonData, jsonPath);
                if (jsonArray != null && jsonArray.size() > 0) {
                    // Converti JsonArray in List<Map> per JRBeanCollectionDataSource
                    // (più affidabile di JsonDataSource per array estratti dal JSON)
                    List<Map> list = new ArrayList<>();
                    for (int i = 0; i < jsonArray.size(); i++) {
                        JsonElement element = jsonArray.get(i);
                        if (element.isJsonObject()) {
                            Map map = gson.fromJson(element, Map.class);
                            list.add(map);
                        }
                    }

                    if (!list.isEmpty()) {
                        JRBeanCollectionDataSource dataSource = new JRBeanCollectionDataSource(list);
                        param.put(paramName, dataSource);
                        log.debug("addDynamicArrayParameters :: Aggiunto parametro " + paramName + " con " + list.size() + " elementi");
                    }
                } else {
                    log.debug("addDynamicArrayParameters :: Array non trovato o vuoto per path '" + jsonPath + "'");
                }
            }
        } catch (Exception e) {
            log.warn("addDynamicArrayParameters :: Errore nell'estrazione degli array dinamici: " + e.getMessage(), e);
        }
    }

    /**
     * Estrae un array JSON da un path nested.
     *
     * @param jsonData l'oggetto JSON radice
     * @param path il path all'array (es. "parent.child.array")
     * @return il JsonArray se trovato, null altrimenti
     */
    private JsonArray extractJsonArray(JsonObject jsonData, String path) {
        if (jsonData == null || path == null || path.isEmpty()) {
            return null;
        }

        String[] parts = path.split("\\.");
        JsonElement current = jsonData;

        for (int i = 0; i < parts.length; i++) {
            if (current == null || !current.isJsonObject()) {
                return null;
            }

            JsonObject currentObj = current.getAsJsonObject();
            String part = parts[i];

            if (!currentObj.has(part)) {
                return null;
            }

            current = currentObj.get(part);

            // Se è l'ultima parte, deve essere un array
            if (i == parts.length - 1) {
                if (current.isJsonArray()) {
                    return current.getAsJsonArray();
                }
                return null;
            }
        }

        return null;
    }

    /**
     * Estrae dinamicamente valori scalari dal JSON del form Alpaca e li aggiunge come parametri String.
     * Usa il mapping definito in JasperScalarMappingEnum per determinare quali valori estrarre.
     *
     * @param param la mappa dei parametri a cui aggiungere i valori
     * @param data l'oggetto dati del form Alpaca
     * @param gson l'istanza Gson per la conversione
     */
    private void addDynamicScalarParameters(Map<String, Object> param, Object data, Gson gson) {
        if (data == null) {
            return;
        }

        try {
            String jsonString = gson.toJson(data);
            JsonObject jsonData = gson.fromJson(jsonString, JsonObject.class);

            for (JasperScalarMappingEnum mapping : JasperScalarMappingEnum.values()) {
                String jsonPath = mapping.getJsonPath();
                String paramName = mapping.getJrParameterName();

                String value = extractJsonScalar(jsonData, jsonPath);
                if (value != null) {
                    param.put(paramName, value);
                    log.debug("addDynamicScalarParameters :: Aggiunto parametro " + paramName + " = " + value);
                } else {
                    log.debug("addDynamicScalarParameters :: Valore non trovato per path '" + jsonPath + "'");
                }
            }
        } catch (Exception e) {
            log.warn("addDynamicScalarParameters :: Errore nell'estrazione dei valori scalari: " + e.getMessage(), e);
        }
    }

    /**
     * Processa oggetti flat dal JSON del form Alpaca e li aggiunge come parametri individuali.
     * Usa il mapping definito in JasperObjectMappingEnum per determinare quali oggetti estrarre.
     *
     * @param param la mappa dei parametri a cui aggiungere i valori
     * @param data l'oggetto dati del form Alpaca
     * @param gson l'istanza Gson per la conversione
     */
    private void addDynamicObjectParameters(Map<String, Object> param, Object data, Gson gson) {
        if (data == null) {
            return;
        }

        try {
            String jsonString = gson.toJson(data);
            JsonObject jsonData = gson.fromJson(jsonString, JsonObject.class);

            for (JasperObjectMappingEnum mapping : JasperObjectMappingEnum.values()) {
                String jsonPath = mapping.getJsonPath();
                JsonElement element = jsonData.get(jsonPath);

                if (element != null && element.isJsonObject()) {
                    JsonObject objectNode = element.getAsJsonObject();
                    for (Map.Entry<String, JsonElement> field : objectNode.entrySet()) {
                        String value = field.getValue().isJsonPrimitive() ? field.getValue().getAsString() : field.getValue().toString();
                        param.put(field.getKey(), value);
                        log.debug("addDynamicObjectParameters :: Aggiunto parametro " + field.getKey() + " = " + value);
                    }
                } else {
                    log.debug("addDynamicObjectParameters :: Oggetto non trovato per path '" + jsonPath + "'");
                }
            }
        } catch (Exception e) {
            log.warn("addDynamicObjectParameters :: Errore nell'estrazione degli oggetti: " + e.getMessage(), e);
        }
    }

    /**
     * Costruisce un JRBeanCollectionDataSource flat per il subreport unificato dei costi.
     * Viene invocato solo se il JSON contiene i dati del form agricoltura.
     * Delega la costruzione a {@link CostiUnificatoDataSourceBuilder}.
     */
    private void addCostiUnificatoDataSource(Map<String, Object> param, Object data, Gson gson) {
        if (data == null) {
            return;
        }

        try {
            String jsonString = gson.toJson(data);
            JsonObject jsonData = gson.fromJson(jsonString, JsonObject.class);

            if (!CostiUnificatoDataSourceBuilder.canHandle(jsonData)) {
                return;
            }

            CostiUnificatoDataSourceBuilder builder = new CostiUnificatoDataSourceBuilder(jsonData);
            param.put("elencoCostiUnificato", builder.build());
            log.debug("addCostiUnificatoDataSource :: Creato datasource unificato con " + builder.getRowCount() + " righe");

        } catch (Exception e) {
            log.warn("addCostiUnificatoDataSource :: Errore nella costruzione del datasource unificato: " + e.getMessage(), e);
        }
    }

    /**
     * Estrae un valore scalare (stringa) da un path nested nel JSON.
     *
     * @param jsonData l'oggetto JSON radice
     * @param path il path al valore (es. "contributoSpesa.contributoSpesaPersonaleAImponibile")
     * @return il valore come stringa se trovato, null altrimenti
     */
    private String extractJsonScalar(JsonObject jsonData, String path) {
        if (jsonData == null || path == null || path.isEmpty()) {
            return null;
        }

        String[] parts = path.split("\\.");
        JsonElement current = jsonData;

        for (int i = 0; i < parts.length; i++) {
            if (current == null || !current.isJsonObject()) {
                return null;
            }

            JsonObject currentObj = current.getAsJsonObject();
            String part = parts[i];

            if (!currentObj.has(part)) {
                return null;
            }

            current = currentObj.get(part);
        }

        if (current != null && current.isJsonPrimitive()) {
            return current.getAsString();
        }

        return null;
    }

    /**
     * Helper method to get operator role title
     * Returns the role title for specific roles that should sign documents
     */
    private String getOperatorRoleTitle(long userId, long organizationId) {
        if (userId > 0 && organizationId > 0) {
            try {

                // Approccio 1: tramite organizzazioni
                List<Organization> userOrganizations = organizationLocalService.getUserOrganizations(userId);
                List<Role> allOrganizationRoles = new ArrayList<>();
                for (Organization organization : userOrganizations) {
                    List<Role> organizationRoles = roleLocalService.getUserGroupRoles(
                            userId,
                            organization.getGroupId()
                    );
                    allOrganizationRoles.addAll(organizationRoles);
                }

                for (Role role : allOrganizationRoles) {

                    String roleName = role.getName();
                    OrganizationRoleEnum roleEnum = OrganizationRoleEnum.findByCode(roleName);

                    if (roleEnum != null) {
                        List<OrganizationRoleEnum> ruoliMostraFirma = List.of(
                                OrganizationRoleEnum.FUNZIONARIO_ISTRUTTORE,
                                OrganizationRoleEnum.FUNZIONARIO_TITOLARE_EQ,
                                OrganizationRoleEnum.DIRIGENTE_SERVIZIO_GESTIONE_OPERE_PUBBLICHE,
                                OrganizationRoleEnum.RESPONSABILE_PROCEDIMENTO,
                                OrganizationRoleEnum.RESPONSABILE_AZIONE_PR_PUGLIA,
                                OrganizationRoleEnum.ISTRUTTORE,
                                OrganizationRoleEnum.DIRIGENTE,
                                OrganizationRoleEnum.RESPONSABILE_PROCEDIMENTO_1,
                                OrganizationRoleEnum.RUP,
                                OrganizationRoleEnum.COMMISSIONE,
                                OrganizationRoleEnum.DELEGATO_DEL_RUP
                        );
                        if (ruoliMostraFirma.contains(roleEnum)) {
                            return roleEnum.getDescrizione();
                        }
                    }
                }
            } catch (Exception e) {
                log.warn("Impossibile recuperare i ruoli per l'utente con ID: " + userId, e);
            }
        }
        return "";
    }

