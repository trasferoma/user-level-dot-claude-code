    @Override
    public byte[] generaPDFEsitoDomanda(DomandaBando domandaBando, String codiceTipoTemplate, String portalURL, long commentoDomandaBandoId, long userId, StatoDomandaBandoEnum statoDomandaBando, List<AllegatoDomandaBando> allegatiEsterni) throws PDFServiceException {

        // Configura SSL per accettare tutti i certificati (necessario per caricare immagini da URL HTTPS)
        configureTrustAllCertificates();

        try {
            long bandoId = domandaBando.getBandoId();
            Bando bando = bandoLocalService.getBando(bandoId);
            long groupId = bando.getGroupId();
            long organizationId = organizationUtility.getSiteOrganization(groupId).getOrganizationId();

            // Get configuration for this group
            jasperTemplateEnteConfiguration = configurationProvider.getGroupConfiguration(JasperTemplateEnteConfiguration.class, groupId);

            List<TemplatePdf> templatesPdf = templatePdfLocalService.getTemplatePdfByBandoIdAndTipoAndCodice(
                    bando.getBandoId(),
                    TipoTemplate.JASPER_REPORT.name(),
                    CodiceTemplatePdf.ESITO_DOMANDA.name());

            long overrideFileEntryId = 0L;
            if (jasperTemplateEnteConfiguration != null) {
                overrideFileEntryId = jasperTemplateEnteConfiguration.esitoDomandaTemplate();
            }

            TemplatePdf templatePdfPrincipale = getTemplatePdfPrincipale(templatesPdf);
            List<TemplatePdf> templatesPdfFigli = getTemplatesPdfFigli(templatesPdf);

            if (overrideFileEntryId <= 0 && templatePdfPrincipale == null) {
                throw new PDFServiceException("Report JRXML esito domanda non presente.");
            }

            Map<String, Object> param = new HashMap<>();
            Organization organization = organizationLocalService.getOrganization(organizationId);

            long fileEntryId = overrideFileEntryId > 0 ? overrideFileEntryId : templatePdfPrincipale.getFileEntryId();
            FileEntry documentoPrincipalefileEntry = dlAppService.getFileEntry(fileEntryId);

            InputStream reportPrincipaleInputStream = new ByteArrayInputStream(documentoPrincipalefileEntry.getContentStream().readAllBytes());
            JasperReport reportPrincipaleJasperReport = JasperCompileManager.compileReport(reportPrincipaleInputStream);

            // Sottoreport, se presenti
            if (templatesPdfFigli != null && !templatesPdfFigli.isEmpty()) {
                for (TemplatePdf templatePdfFiglio : templatesPdfFigli) {
                    FileEntry documentoFiglioEntry = dlAppService.getFileEntry(templatePdfFiglio.getFileEntryId());
                    InputStream subReportInputStream = new ByteArrayInputStream(documentoFiglioEntry.getContentStream().readAllBytes());
                    JasperReport subJasperReport = JasperCompileManager.compileReport(subReportInputStream);
                    param.put(documentoFiglioEntry.getFileName(), subJasperReport);
                    registraSubreportAllegati(param, templatePdfFiglio, subJasperReport);
                }
            }

            param.put(JR_PARAMETER_LISTA_ALLEGATI, new JRBeanCollectionDataSource(costruisciAllegatiReportDTO(allegatiEsterni)));

            LayoutSet layout = layoutSetLocalService.getLayoutSet(groupId, false);
            Image image = imageLocalService.getCompanyLogo(layout.getLogoId());

            if (Validator.isNotNull(image)) {
                ByteArrayInputStream logoComune = new ByteArrayInputStream(image.getTextObj());
                param.put(JR_PARAMETER_LOGO_COMUNE, logoComune);
            }

            param.put(JR_PARAMETER_COMUNE, organization.getName());

            AnnotazioneOperatore notaOperatore = getCommentoText(commentoDomandaBandoId);

            String nomeCognomeOperatore = getOperatorName(userId);

            SimpleDateFormat dateFormat = new SimpleDateFormat("dd/MM/yyyy");
            SimpleDateFormat dateTimeFormat = new SimpleDateFormat("dd/MM/yyyy HH:mm");
            Date currentDate = new Date();
            String titoloRuoloOperatore = getOperatorRoleTitle(userId, organizationId);

            param.put("denominazioneBando", bando.getNome());
            param.put("descrizioneBreve", bando.getDescrizioneBreve());
            param.put("idPratica", String.valueOf(domandaBando.getDomandaBandoId()));
            param.put("dataArrivo", domandaBando.getCreateDate() != null ? dateFormat.format(domandaBando.getCreateDate()) : "");
            param.put("numeroProtocollo", domandaBando.getNumeroProtocollo() != null ? domandaBando.getNumeroProtocollo() : "N/A");
            param.put("oggettoNotaOperatore", notaOperatore.getOggetto());
            param.put("notaOperatore", notaOperatore.getTesto());
            param.put("dataOraRichiesta", dateTimeFormat.format(currentDate));
            param.put("nomeCognomeOperatore", nomeCognomeOperatore);
            param.put("stato_chiusura", statoDomandaBando.getName());

            String esitoChiusura = "";

            if(statoDomandaBando.equals(StatoDomandaBandoEnum.CHIUSA_NEGATIVAMENTE)){
                esitoChiusura = "negativo";
            }else{
                esitoChiusura = "positivo";
            }

            param.put("esito_chiusura", esitoChiusura);

            param.put("denominazioneRichiedente", domandaBando.getUserName());
            param.put("dataCorrente", dateFormat.format(currentDate));

            param.put("nomeCognomeOperatore", nomeCognomeOperatore);
            param.put("titoloRuoloOperatore", titoloRuoloOperatore);
            param.put("mostraFirma", titoloRuoloOperatore != null && !titoloRuoloOperatore.isEmpty());
            param.put("urlPortale", portalURL);

            JasperPrint jasperPrint = JasperFillManager.fillReport(reportPrincipaleJasperReport, param, new JREmptyDataSource());

            ByteArrayOutputStream out = new ByteArrayOutputStream();
            JasperExportManager.exportReportToPdfStream(jasperPrint, out);
            return out.toByteArray();
        }
        catch (Exception e) {
            log.error("generaPDFEsitoDomanda :: " + e.getMessage(), e);
            throw new PDFServiceException("Errore durante il processo di generazione del PDF esito domanda :: " + e.getMessage(), e);
        }
    }

