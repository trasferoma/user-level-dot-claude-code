    /**
     * Configura SSL per accettare tutti i certificati.
     * Necessario quando il server deve fare richieste HTTPS a se stesso.
     */
    private void configureTrustAllCertificates() {
        try {
            TrustManager[] trustAllCerts = new TrustManager[] {
                    new X509TrustManager() {
                        public X509Certificate[] getAcceptedIssuers() { return null; }
                        public void checkClientTrusted(X509Certificate[] certs, String authType) { }
                        public void checkServerTrusted(X509Certificate[] certs, String authType) { }
                    }
            };

            SSLContext sslContext = SSLContext.getInstance("TLS");
            sslContext.init(null, trustAllCerts, new java.security.SecureRandom());
            HttpsURLConnection.setDefaultSSLSocketFactory(sslContext.getSocketFactory());

            HostnameVerifier allHostsValid = (hostname, session) -> true;
            HttpsURLConnection.setDefaultHostnameVerifier(allHostsValid);

            log.debug("SSL TrustAll configurato correttamente");
        } catch (Exception e) {
            log.warn("Impossibile configurare SSL TrustAll: " + e.getMessage());
        }
    }

