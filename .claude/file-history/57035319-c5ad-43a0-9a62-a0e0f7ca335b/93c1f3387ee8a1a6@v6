    public void salvaImprontaIstanza(long domandaBandoId, long istanzaDomandaBandoId, byte[] pdf, long groupId, long companyId, long userId, String userName) {

        if (pdf == null) {
            return;
        }

        try {
            String hash = calcolaHashSHA256(pdf);
            String chiaveIstanza = String.valueOf(istanzaDomandaBandoId);

            List<DomandaBandoDatoAggiuntivo> existing = domandaBandoDatoAggiuntivoLocalService
                    .getDomandaBandoDatoAggiuntivoByDomandaBandoIdAndChiave(
                            Collections.singletonList(domandaBandoId),
                            Collections.singletonList(DatoAggiuntivoChiave.IMPRONTA_ISTANZA.name()));

            DomandaBandoDatoAggiuntivo dato;
            JsonObject jsonImpronte;

            if (existing != null && !existing.isEmpty()) {
                dato = existing.get(0);
                String valoreAttuale = dato.getValore();
                if (Validator.isNotNull(valoreAttuale)) {
                    jsonImpronte = new JsonParser().parse(valoreAttuale).getAsJsonObject();
                } else {
                    jsonImpronte = new JsonObject();
                }
            } else {
                dato = domandaBandoDatoAggiuntivoLocalService
                        .createDomandaBandoDatoAggiuntivo(counterLocalService.increment());
                dato.setDomandaBandoId(domandaBandoId);
                dato.setChiave(DatoAggiuntivoChiave.IMPRONTA_ISTANZA.name());
                dato.setGroupId(groupId);
                dato.setCompanyId(companyId);
                dato.setUserId(userId);
                dato.setUserName(userName);
                jsonImpronte = new JsonObject();
            }

            jsonImpronte.addProperty(chiaveIstanza, hash);
            dato.setValore(jsonImpronte.toString());
            domandaBandoDatoAggiuntivoLocalService.updateDomandaBandoDatoAggiuntivo(dato);

        } catch (Exception e) {
            log.error("Errore durante il salvataggio dell'impronta istanza per domandaBandoId " + domandaBandoId + " :: " + e.getMessage(), e);
        }
    }

    public String verificaImprontaIstanza(long domandaBandoId, long istanzaDomandaBandoId, byte[] allegatoBytes) {

        if (allegatoBytes == null) {
            return null;
        }

        try {
            List<DomandaBandoDatoAggiuntivo> existing = domandaBandoDatoAggiuntivoLocalService
                    .getDomandaBandoDatoAggiuntivoByDomandaBandoIdAndChiave(
                            Collections.singletonList(domandaBandoId),
                            Collections.singletonList(DatoAggiuntivoChiave.IMPRONTA_ISTANZA.name()));

            if (existing == null || existing.isEmpty()) {
                return "errore-download-documento-richiesto";
            }

            String valoreAttuale = existing.get(0).getValore();

            if (Validator.isNull(valoreAttuale)) {
                return "errore-download-documento-richiesto";
            }

            JsonObject jsonImpronte = new JsonParser().parse(valoreAttuale).getAsJsonObject();
            String chiaveIstanza = String.valueOf(istanzaDomandaBandoId);

            if (!jsonImpronte.has(chiaveIstanza)) {
                return "errore-download-documento-richiesto";
            }

            String hashIstanzaGenerata = jsonImpronte.get(chiaveIstanza).getAsString();

            if (Validator.isNull(hashIstanzaGenerata)) {
                return null;
            }

            String hashFileCaricato = calcolaHashSHA256(allegatoBytes);

            if (hashIstanzaGenerata.equals(hashFileCaricato)) {
                return "errore-file-identico-a-generato";
            }

        } catch (Exception e) {
            log.error("Errore durante la verifica dell'impronta istanza per domandaBandoId " + domandaBandoId + " :: " + e.getMessage(), e);
        }

        return null;
    }

    private String calcolaHashSHA256(byte[] data) throws Exception {
        MessageDigest digest = MessageDigest.getInstance("SHA-256");
        byte[] hashBytes = digest.digest(data);
        StringBuilder hexString = new StringBuilder();
        for (byte b : hashBytes) {
            String hex = Integer.toHexString(0xff & b);
            if (hex.length() == 1) {
                hexString.append('0');
            }
            hexString.append(hex);
        }
        return hexString.toString();
    }

