    public String getTipoIntegrazioneDomanda(String processInstanceId){
        String tipoIntegrazione = "";
        List<VariableInstance> vars = camundaClient.getVariablesByProcessInstanceId(processInstanceId);
        boolean variabileTrovata = false;

        if(ListUtil.isNotNull(vars) && ListUtil.isNotEmpty(vars)){
            Iterator<VariableInstance> it = vars.iterator();

            while(it.hasNext() && !variabileTrovata){
                VariableInstance variableInstance = it.next();

                if(Validator.isNotNull(variableInstance) && variableInstance.getName().equalsIgnoreCase(CustomProcessVariables.TIPO_INTEGRAZIONE)){
                    variabileTrovata = true;
                    tipoIntegrazione = (String) variableInstance.getValue();
                }
            }
        }

        return tipoIntegrazione;
    }

