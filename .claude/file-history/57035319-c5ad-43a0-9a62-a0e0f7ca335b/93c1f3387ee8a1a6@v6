    public Form getFormAndDefinizioneAllegati(long formId) {
        try {
            Form form = formLocalService.getForm(formId);
            List<DefinizioneAllegato> definizioneAllegati = definizioneAllegatoLocalService
                    .getListaDefinizioneAllegatoByFormId(form.getFormId());
