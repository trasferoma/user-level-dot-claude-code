     */
    private void applicaNormalizzazioneLocalitaAU(DettaglioImpresa dettaglioImpresa) {
        try {
            NormalizedLocalita nl = comuneLocalService.normalizzaLocalita(
                    dettaglioImpresa.getProvincia(), dettaglioImpresa.getComune(), dettaglioImpresa.getCodiceComune());
            if (nl != null && nl.isCorretto()) {
                log.info("Normalizzazione localita' AU applicata: provincia " + dettaglioImpresa.getProvincia() + " -> " + nl.getSiglaProvincia()
                        + " per comune " + dettaglioImpresa.getComune() + " c-comune=" + dettaglioImpresa.getCodiceComune());
                dettaglioImpresa.setProvincia(nl.getSiglaProvincia());
            }
