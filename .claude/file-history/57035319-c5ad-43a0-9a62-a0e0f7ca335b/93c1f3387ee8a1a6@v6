                }
            }
        }
    }

    public void addAziendeRaggruppamento(IstanzaDomandaBando istanzaDomandaBando, String portalURL, long groupId,
                                         long userId, String userName, long bandoId) {
        String jsonForm = istanzaDomandaBando.getJson();

        if (Validator.isNotNull(jsonForm)) {
            Set<Option> jsonPathOptions = new HashSet<Option>();
            jsonPathOptions.add(Option.SUPPRESS_EXCEPTIONS);
            jsonPathOptions.add(Option.ALWAYS_RETURN_LIST);

            Configuration jsonPathConfiguration = Configuration.builder()
                    .jsonProvider(new JacksonJsonNodeJsonProvider()).mappingProvider(new JacksonMappingProvider())
                    .options(jsonPathOptions).build();

            JsonNode fieldValues = null;

            List<String> listaCampiAziendaRaggruppamento = getNomeCampoByType(jsonForm, portalURL, typesSoggettiATIATS,
                    istanzaDomandaBando.getFormId());

            if (listaCampiAziendaRaggruppamento != null && !listaCampiAziendaRaggruppamento.isEmpty()) {
                for (String campo : listaCampiAziendaRaggruppamento) {
                    String pathCampo = "['" + campo + "']";
                    fieldValues = JsonPath.using(jsonPathConfiguration).parse(jsonForm)
                            .read(ALPACA_ALPACA_FIELD + ALPACA_DATA_FIELD + pathCampo);
                }

                estraiECreaAziendeAssociate(fieldValues, "partner", istanzaDomandaBando.getDomandaBandoId(),
                        groupId, userId, userName);

            }

            List<String> listaCampiMandanti = getNomeCampoByType(jsonForm, portalURL, typesCustomMandanti,
                    istanzaDomandaBando.getFormId());

            if (listaCampiMandanti != null && !listaCampiMandanti.isEmpty()) {
                for (String campo : listaCampiMandanti) {
                    String pathCampo = "['" + campo + "']";
                    fieldValues = JsonPath.using(jsonPathConfiguration).parse(jsonForm)
                            .read(ALPACA_ALPACA_FIELD + ALPACA_DATA_FIELD + pathCampo);
