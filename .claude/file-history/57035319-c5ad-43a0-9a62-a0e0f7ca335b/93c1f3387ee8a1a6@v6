            for (String field : datiEnteDataContainer) {
                JsonObject fieldDataContainer = alpacaJsonData.getAsJsonObject(field);
                JsonObject fieldDataContainerPrivato = fieldDataContainer.getAsJsonObject("privato");
                if (Validator.isNotNull(fieldDataContainerPrivato)) {
                    if (Validator.isNotNull(datiAnagraficaUnica) && Validator.isNotNull(datiAnagraficaUnica.getRestResponse()) && Validator.isNotNull(datiAnagraficaUnica.getRestResponse().getData())) {
                        Gson gson = new Gson();
                        if (ListUtil.isNotNull(datiAnagraficaUnica.getTipologie()) && ListUtil.isNotEmpty(datiAnagraficaUnica.getTipologie())) {
                            if (datiAnagraficaUnica.getTipologie().contains(TipologiaEnteBando.IMPRESA.name())) {
                                JsonObject data = gson.toJsonTree(datiAnagraficaUnica.getRestResponse().getData()).getAsJsonObject();
