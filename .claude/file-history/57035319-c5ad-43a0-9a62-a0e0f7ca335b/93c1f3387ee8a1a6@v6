                    domandaBandoDatoAggiuntivoLocalService
                            .updateDomandaBandoDatoAggiuntivo(domandaBandoDatoAggiuntivo);
                }
            }
        }

        // Recupero dinamico dati aggiuntivi dai campi con attributo "datoAggiuntivo" nelle options
        try {
            JsonObject jsonRoot = new JsonParser().parse(istanzaJson).getAsJsonObject();
            JsonObject alpacaObj = jsonRoot.getAsJsonObject("alpaca");

            if (alpacaObj != null && alpacaObj.has("options") && alpacaObj.has("data")) {
                JsonObject optionsObj = alpacaObj.getAsJsonObject("options");
                JsonObject dataObj = alpacaObj.getAsJsonObject("data");

                if (optionsObj.has("fields") && optionsObj.get("fields").isJsonObject()) {
                    JsonObject optionsFields = optionsObj.getAsJsonObject("fields");
                    Map<String, String> datiAggiuntiviDinamici = new LinkedHashMap<>();
                    Map<String, List<String>> datiAggiuntiviDinamiciArray = new LinkedHashMap<>();
                    _trovaDatiAggiuntiviDaOptions(optionsFields, dataObj, datiAggiuntiviDinamici, datiAggiuntiviDinamiciArray);

                    for (Map.Entry<String, String> entry : datiAggiuntiviDinamici.entrySet()) {
                        String chiaveDinamica = entry.getKey();
                        String valoreDinamico = entry.getValue();

                        if (Validator.isNotNull(chiaveDinamica) && Validator.isNotNull(valoreDinamico)) {
                            long count = domandaBandoDatoAggiuntivoLocalService
