    public DatiSoggettoDto getDatiAnagraficaUnica(String codFiscPiva, long groupId, Bando bando) throws AnagraficaUnicaException {
        DatiSoggettoDto datiSoggettoDto = new DatiSoggettoDto();
        RestResponse restResponse = null;
        List<String> tipologie = new ArrayList<>();
        Contesto contesto = Contesto.valueOf(bando.getContesto());
        List<BandoTipologiaEnte> bandoTipologiaEnteList = bandoTipologiaEnteLocalService.getBandoTipologiaEnteByBandoId(bando.getBandoId());
        if (ListUtil.isNotNull(bandoTipologiaEnteList) && ListUtil.isNotEmpty(bandoTipologiaEnteList)) {
            for (int i = 0; i < bandoTipologiaEnteList.size(); i++) {
            	BandoTipologiaEnte bandoTipologiaEnte = bandoTipologiaEnteList.get(i);
                try {
                    RestResponse response = anagraficaUnicaStakeholderClient.getAnagrafica(groupId, contesto, bandoTipologiaEnte.getCodiceTipologiaEnte(), codFiscPiva);
                    if (Validator.isNotNull(response) && Validator.isNotNull(response.getData()) && Validator.isNotNull(response.getStatus()) && response.getStatus().equalsIgnoreCase("200")) {
                        applicaNormalizzazioneLocalitaAUResponse(response);
                        restResponse = response;
                        tipologie.add(bandoTipologiaEnte.getCodiceTipologiaEnte());
                        log.info("Recuperati dati da anagrafica unica per tipo soggetto ::" + bandoTipologiaEnte.getCodiceTipologiaEnte() + " codFiscPiva=" + codFiscPiva);
                    } else {
                        log.warn("Response Anagrafica Unica non valida per tipo soggetto ::" + bandoTipologiaEnte.getCodiceTipologiaEnte()
                                + " codFiscPiva=" + codFiscPiva
                                + " status=" + (response != null ? response.getStatus() : "null")
                                + " data=" + (response != null && response.getData() != null ? "present" : "null"));
                    }
                } catch (Exception e) {
                    log.warn("Non é stato possibile recuperare i dati da anagrafica unica per tipo soggetto ::" + bandoTipologiaEnte.getCodiceTipologiaEnte() + " codFiscPiva=" + codFiscPiva, e);
                }
            }
            if (restResponse == null) {
                throw new AnagraficaUnicaException();
            }
        }
        datiSoggettoDto.setRestResponse(restResponse);
        datiSoggettoDto.setTipologie(tipologie);
        return datiSoggettoDto;
    }

    public DettaglioImpresa getDatiAnagraficaUnicaImpresa(String codFiscPiva, long bandoId, long groupId) throws Exception {
        Bando bando = bandoLocalService.getBando(bandoId);
        Contesto contesto = Contesto.valueOf(bando.getContesto());

        RestResponse restResponse = anagraficaUnicaStakeholderClient.getAnagrafica(
                groupId, contesto, "IMPRESA", codFiscPiva);

        if (Validator.isNotNull(restResponse) && Validator.isNotNull(restResponse.getData())
                && Validator.isNotNull(restResponse.getStatus()) && restResponse.getStatus().equalsIgnoreCase("200")) {
            Gson gson = new Gson();
            JsonObject data = gson.toJsonTree(restResponse.getData()).getAsJsonObject();
            DettaglioImpresa dettaglio = toDettaglioImpresaAnagraficaUnica(data);
            filtraCodiciAtecoDettaglioImpresa(dettaglio, bandoId);
            return dettaglio;
        }

        return null;
    }

    private void filtraCodiciAtecoDettaglioImpresa(DettaglioImpresa dettaglio, long bandoId) {
        if (!Validator.isNotNull(dettaglio)) {
            return;
        }

        List<CodiceAteco> listaCodiciBando = getListaCodiciAteco(bandoId);
        List<CodiceAteco> listaCodiciIstante = new ArrayList<>();
        RegistroImpresaService registroImpresaService = registroImpresaServiceFactory.getService();
        List<String> listaCodiciRilevanza = getListaRilevanzaCodiciAteco(bandoId, registroImpresaService);
        List<CodiceAteco> listaCodiciRegistro = dettaglio.getCodiciAteco();

        if (listaCodiciBando != null && !listaCodiciBando.isEmpty() && listaCodiciRilevanza != null
                && !listaCodiciRilevanza.isEmpty()) {
            if (listaCodiciRegistro != null && !listaCodiciRegistro.isEmpty()) {
                for (CodiceAteco codiceRegistroImpresa : listaCodiciRegistro) {
                    if (Validator.isNotNull(codiceRegistroImpresa)) {
                        Optional<CodiceAteco> codiceTrovato = listaCodiciBando.stream()
                                .filter(x -> x.getCodice().equalsIgnoreCase(codiceRegistroImpresa.getCodice()))
                                .findFirst();

                        if (codiceTrovato.isPresent()
                                && listaCodiciRilevanza.contains(codiceRegistroImpresa.getRilevanza())) {
                            CodiceAteco codicePresent = codiceTrovato.get();
                            CodiceAtecoRilevanzaEnum codiceEnum = CodiceAtecoRilevanzaEnum
                                    .findByCodice(codiceRegistroImpresa.getRilevanza());

                            if (codiceEnum != null) {
                                CodiceAteco codiceAtecoPresent = new CodiceAteco();
                                codiceAtecoPresent.setCodice(codicePresent.getCodice());
                                codiceAtecoPresent.setRilevanza(codiceEnum.getDescription());
                                listaCodiciIstante.add(codiceAtecoPresent);
                            }
                        }
                    }
                }

                dettaglio.setCodiciAteco(listaCodiciIstante);
            }
        } else {
            if (listaCodiciRegistro != null && !listaCodiciRegistro.isEmpty()) {
                for (CodiceAteco codice : listaCodiciRegistro) {
                    if (Validator.isNotNull(codice)) {
                        CodiceAtecoRilevanzaEnum codiceEnum = CodiceAtecoRilevanzaEnum
                                .findByCodice(codice.getRilevanza());

                        if (codiceEnum != null) {
                            codice.setRilevanza(codiceEnum.getDescription());
                        }
                    }
                }
            }
        }
    }

    private DettaglioImpresa toDettaglioImpresaAnagraficaUnica(JsonObject data) {
        DettaglioImpresa dettaglioImpresa = new DettaglioImpresa();

        if (data.has("dati-identificativi") && !data.get("dati-identificativi").isJsonNull()) {
            JsonObject datiIdentificativi = data.get("dati-identificativi").getAsJsonObject();

            if (datiIdentificativi.has("denominazione") && !datiIdentificativi.get("denominazione").isJsonNull()) {
                dettaglioImpresa.setDenominazione(datiIdentificativi.get("denominazione").getAsString());
            }

            if (datiIdentificativi.has("c-fiscale") && !datiIdentificativi.get("c-fiscale").isJsonNull()) {
                dettaglioImpresa.setCodiceFiscale(datiIdentificativi.get("c-fiscale").getAsString());
            }

            if (datiIdentificativi.has("partita-iva") && !datiIdentificativi.get("partita-iva").isJsonNull()) {
                dettaglioImpresa.setPartitaIva(datiIdentificativi.get("partita-iva").getAsString());
            }

            if (datiIdentificativi.has("indirizzo-posta-certificata") && !datiIdentificativi.get("indirizzo-posta-certificata").isJsonNull()) {
                dettaglioImpresa.setPec(datiIdentificativi.get("indirizzo-posta-certificata").getAsString());
            }

            if (datiIdentificativi.has("cciaa") && !datiIdentificativi.get("cciaa").isJsonNull()) {
                dettaglioImpresa.setCciaa(datiIdentificativi.get("cciaa").getAsString());
            }

            if (datiIdentificativi.has("forma-giuridica") && !datiIdentificativi.get("forma-giuridica").isJsonNull()) {
                JsonObject formaGiuridicaObj = datiIdentificativi.get("forma-giuridica").getAsJsonObject();

                if (formaGiuridicaObj.has("value") && !formaGiuridicaObj.get("value").isJsonNull()) {
                    dettaglioImpresa.setFormaGiuridica(formaGiuridicaObj.get("value").getAsString());
                }

                if (formaGiuridicaObj.has("C") && !formaGiuridicaObj.get("C").isJsonNull()) {
                    dettaglioImpresa.setCodiceFormaGiuridica(formaGiuridicaObj.get("C").getAsString());
                }
            }

            if (datiIdentificativi.has("n-rea") && !datiIdentificativi.get("n-rea").isJsonNull()) {
                dettaglioImpresa.setNumeroRea(datiIdentificativi.get("n-rea").getAsString());
            }

            if (datiIdentificativi.has("indirizzo-localizzazione") && !datiIdentificativi.get("indirizzo-localizzazione").isJsonNull()) {
                JsonObject indirizzo = datiIdentificativi.get("indirizzo-localizzazione").getAsJsonObject();

                String toponimo = "";
                String via = "";

                if (indirizzo.has("toponimo") && !indirizzo.get("toponimo").isJsonNull()) {
                    toponimo = indirizzo.get("toponimo").getAsString();
                }

                if (indirizzo.has("via") && !indirizzo.get("via").isJsonNull()) {
                    via = indirizzo.get("via").getAsString();
                }

                if (!toponimo.isEmpty()) {
                    dettaglioImpresa.setVia(toponimo + " " + via);
                } else {
                    dettaglioImpresa.setVia(via);
                }

                if (indirizzo.has("n-civico") && !indirizzo.get("n-civico").isJsonNull()) {
                    dettaglioImpresa.setCivico(indirizzo.get("n-civico").getAsString());
                }

                if (indirizzo.has("cap") && !indirizzo.get("cap").isJsonNull()) {
                    dettaglioImpresa.setCap(indirizzo.get("cap").getAsString());
                }

                if (indirizzo.has("comune") && !indirizzo.get("comune").isJsonNull()) {
                    dettaglioImpresa.setComune(indirizzo.get("comune").getAsString());
                }

                if (indirizzo.has("provincia") && !indirizzo.get("provincia").isJsonNull()) {
                    dettaglioImpresa.setProvincia(indirizzo.get("provincia").getAsString());
                }

                if (indirizzo.has("c-comune") && !indirizzo.get("c-comune").isJsonNull()) {
                    dettaglioImpresa.setCodiceComune(indirizzo.get("c-comune").getAsString());
                }
            }

            applicaNormalizzazioneLocalitaAU(dettaglioImpresa);
        }

        List<CodiceAteco> listaCodiciAteco = new ArrayList<>();

        if (data.has("info-attivita") && !data.get("info-attivita").isJsonNull()) {
            JsonObject infoAttivita = data.get("info-attivita").getAsJsonObject();

            if (infoAttivita.has("classificazioni-ateco") && !infoAttivita.get("classificazioni-ateco").isJsonNull()) {
                JsonObject classificazioniAteco = infoAttivita.get("classificazioni-ateco").getAsJsonObject();

                if (classificazioniAteco.has("classificazione-ateco") && !classificazioniAteco.get("classificazione-ateco").isJsonNull()) {
                    JsonArray classificazioniArray = classificazioniAteco.get("classificazione-ateco").getAsJsonArray();

                    for (JsonElement element : classificazioniArray) {
                        if (element != null && !element.isJsonNull()) {
                            JsonObject elementObject = element.getAsJsonObject();

                            String codice = null;
                            String importanza = null;

                            if (elementObject.has("c-attivita") && !elementObject.get("c-attivita").isJsonNull()) {
                                codice = elementObject.get("c-attivita").getAsString();
                            }

                            if (elementObject.has("c-importanza") && !elementObject.get("c-importanza").isJsonNull()) {
                                importanza = elementObject.get("c-importanza").getAsString();
                            }

                            if (Validator.isNotNull(codice) && Validator.isNotNull(importanza)) {
                                CodiceAteco codiceDto = new CodiceAteco();
                                codiceDto.setCodice(codice);
                                codiceDto.setRilevanza(importanza);

                                if (!listaCodiciAteco.contains(codiceDto)) {
                                    listaCodiciAteco.add(codiceDto);
                                }
                            }
                        }
                    }
                }
            }
        }

        // Fallback: se info-attivita non ha fornito codici ATECO, cerca il primo "principale" nelle localizzazioni
        if (listaCodiciAteco.isEmpty() && data.has("localizzazioni") && !data.get("localizzazioni").isJsonNull()) {
            JsonElement localizzazioniElement = data.get("localizzazioni");
            JsonArray localizzazioniArray = null;
            if (localizzazioniElement.isJsonArray()) {
                localizzazioniArray = localizzazioniElement.getAsJsonArray();
            } else if (localizzazioniElement.isJsonObject()) {
                JsonObject wrapper = localizzazioniElement.getAsJsonObject();
                if (wrapper.has("localizzazione") && !wrapper.get("localizzazione").isJsonNull()) {
                    localizzazioniArray = wrapper.get("localizzazione").getAsJsonArray();
                }
            }

            if (localizzazioniArray != null) {
                Set<String> codiciImportanzaPrincipali = new HashSet<>();
                try {
                    RegistroImpresaConfiguration registroImpresaConfiguration = configurationProvider
                            .getSystemConfiguration(RegistroImpresaConfiguration.class);
                    String csv = registroImpresaConfiguration.codiciImportanzaAtecoPrincipali();
                    if (Validator.isNotNull(csv)) {
                        for (String s : csv.split(",")) {
                            String trimmed = s.trim().toUpperCase();
                            if (!trimmed.isEmpty()) {
                                codiciImportanzaPrincipali.add(trimmed);
                            }
                        }
                    }
                } catch (Exception e) {
                    _log.warn("Lettura RegistroImpresaConfiguration.codiciImportanzaAtecoPrincipali fallita, fallback ATECO disabilitato: " + e.getMessage());
                }

                if (!codiciImportanzaPrincipali.isEmpty()) {
                    boolean trovato = false;
                    for (int i = 0; i < localizzazioniArray.size() && !trovato; i++) {
                        JsonElement locEl = localizzazioniArray.get(i);
                        if (locEl == null || !locEl.isJsonObject()) {
                            continue;
                        }
                        JsonObject loc = locEl.getAsJsonObject();
                        if (!loc.has("classificazione-ateco") || loc.get("classificazione-ateco").isJsonNull()) {
                            continue;
                        }
                        JsonObject classObj = loc.get("classificazione-ateco").getAsJsonObject();
                        if (!classObj.has("classificazione-ateco")
                                || classObj.get("classificazione-ateco").isJsonNull()) {
                            continue;
                        }
                        JsonArray atecoArr = classObj.get("classificazione-ateco").getAsJsonArray();
                        for (JsonElement el : atecoArr) {
                            if (el == null || el.isJsonNull()) {
                                continue;
                            }
                            JsonObject elObj = el.getAsJsonObject();
                            String codice = elObj.has("c-attivita") && !elObj.get("c-attivita").isJsonNull()
                                    ? elObj.get("c-attivita").getAsString() : null;
                            String importanza = elObj.has("c-importanza") && !elObj.get("c-importanza").isJsonNull()
                                    ? elObj.get("c-importanza").getAsString() : null;
                            if (Validator.isNotNull(codice) && Validator.isNotNull(importanza)
                                    && codiciImportanzaPrincipali.contains(importanza.toUpperCase())) {
                                CodiceAteco codiceDto = new CodiceAteco();
                                codiceDto.setCodice(codice);
                                codiceDto.setRilevanza(importanza);
                                listaCodiciAteco.add(codiceDto);
                                trovato = true;
                                break;
                            }
                        }
                    }
                }
            }
        }

        dettaglioImpresa.setCodiciAteco(listaCodiciAteco);

        if (data.has("persone-sede") && !data.get("persone-sede").isJsonNull()) {
            JsonObject personaSede = data.get("persone-sede").getAsJsonObject();

            if (personaSede.has("persona") && !personaSede.get("persona").isJsonNull()) {
                JsonArray personaArray = personaSede.get("persona").getAsJsonArray();

                for (int i = 0; i < personaArray.size(); i++) {
                    JsonObject personaObj = personaArray.get(i).getAsJsonObject();

                    if (personaObj.has("persona-fisica") && !personaObj.get("persona-fisica").isJsonNull()) {
                        JsonObject personaFisica = personaObj.get("persona-fisica").getAsJsonObject();

                        if (personaFisica.has("c-fiscale") && !personaFisica.get("c-fiscale").isJsonNull()) {
                            dettaglioImpresa.getListaCfTitolari().add(personaFisica.get("c-fiscale").getAsString());
                        }
                    }
                }
            }
        }

        if (data.has("elenco-soci") && !data.get("elenco-soci").isJsonNull()) {
            JsonObject elencoSoci = data.get("elenco-soci").getAsJsonObject();

            if (elencoSoci.has("riquadri") && !elencoSoci.get("riquadri").isJsonNull()) {
                JsonObject riquadri = elencoSoci.get("riquadri").getAsJsonObject();

                if (riquadri.has("riquadro") && !riquadri.get("riquadro").isJsonNull()) {
                    JsonArray riquadroArray = riquadri.get("riquadro").getAsJsonArray();

                    for (int i = 0; i < riquadroArray.size(); i++) {
                        JsonObject riquadroObj = riquadroArray.get(i).getAsJsonObject();

                        if (riquadroObj.has("titolari") && !riquadroObj.get("titolari").isJsonNull()) {
                            JsonObject titolari = riquadroObj.get("titolari").getAsJsonObject();

                            if (titolari.has("titolare") && !titolari.get("titolare").isJsonNull()) {
                                JsonArray titolareArray = titolari.get("titolare").getAsJsonArray();

                                for (int j = 0; j < titolareArray.size(); j++) {
                                    JsonObject titolareObj = titolareArray.get(j).getAsJsonObject();

                                    if (titolareObj.has("anagrafica-titolare") && !titolareObj.get("anagrafica-titolare").isJsonNull()) {
                                        JsonObject anagraficaTitolare = titolareObj.get("anagrafica-titolare").getAsJsonObject();

                                        if (anagraficaTitolare.has("c-fiscale") && !anagraficaTitolare.get("c-fiscale").isJsonNull()) {
                                            dettaglioImpresa.getListaCfTitolari().add(anagraficaTitolare.get("c-fiscale").getAsString());
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        return dettaglioImpresa;
    }

    /**
     * Applica la normalizzazione di provincia/comune sul DettaglioImpresa appena
     * popolato dalla risposta di Anagrafica Unica, per correggere il
     * disallineamento della provincia BAT (e simili). In caso di match positivo
     * sovrascrive sigla provincia e codiceComune con i valori locali corretti;
