    public boolean checkPermissionIntegrazioneVolontaria(DomandaBando domandaBando) {

        List<BandoForm> listaBandoFormBando = bandoFormLocalService.getListaBandoFormBando(domandaBando.getBandoId());
        boolean isBandoFormIntegrazioneFrontend = listaBandoFormBando.stream()
                .anyMatch(o -> o.getTipoForm().equals(TipoFormEnum.INTEGRAZIONE_FRONTEND.name()));
        boolean isInRange = false;

        try {
            List<DomandaBandoDatoAggiuntivo> domandaBandoDatoAggiuntivoByDomandaBandoIdAndChiave = domandaBandoDatoAggiuntivoLocalService
                    .getDomandaBandoDatoAggiuntivoByDomandaBandoIdAndChiave(List.of(domandaBando.getDomandaBandoId()),
                            List.of(DatoAggiuntivoChiave.DATA_INIZIO_UPLOAD_DOCUMENTI.name(),
                                    DatoAggiuntivoChiave.DATA_FINE_UPLOAD_DOCUMENTI.name()));
            if (ListUtil.isNotEmpty(domandaBandoDatoAggiuntivoByDomandaBandoIdAndChiave)) {
                DomandaBandoDatoAggiuntivo domandaBandoDatoAggiuntivoDataInizioUploadDocumenti = domandaBandoDatoAggiuntivoByDomandaBandoIdAndChiave
                        .stream()
                        .filter(db -> db.getChiave().equals(DatoAggiuntivoChiave.DATA_INIZIO_UPLOAD_DOCUMENTI.name()))
                        .findAny().orElse(null);
                DomandaBandoDatoAggiuntivo domandaBandoDatoAggiuntivoDataFineUploadDocumenti = domandaBandoDatoAggiuntivoByDomandaBandoIdAndChiave
                        .stream()
                        .filter(db -> db.getChiave().equals(DatoAggiuntivoChiave.DATA_FINE_UPLOAD_DOCUMENTI.name()))
                        .findAny().orElse(null);
                if (domandaBandoDatoAggiuntivoDataInizioUploadDocumenti != null
                        && domandaBandoDatoAggiuntivoDataFineUploadDocumenti != null) {
                    String domandaBandoDatoAggiuntivoDataInizioUploadDocumentiValore = domandaBandoDatoAggiuntivoDataInizioUploadDocumenti
                            .getValore();
                    String domandaBandoDatoAggiuntivoDataFineUploadDocumentiValore = domandaBandoDatoAggiuntivoDataFineUploadDocumenti
                            .getValore();

                    LocalDateTime domandaBandoDatoAggiuntivoDataInizioUploadDocumentiValoreDateTime = LocalDateTime
                            .parse(domandaBandoDatoAggiuntivoDataInizioUploadDocumentiValore);
                    LocalDateTime domandaBandoDatoAggiuntivoDataFineUploadDocumentiValoreDateTime = LocalDateTime
                            .parse(domandaBandoDatoAggiuntivoDataFineUploadDocumentiValore);
                    LocalDateTime now = LocalDateTime.now();
                    if ((now.isAfter(domandaBandoDatoAggiuntivoDataInizioUploadDocumentiValoreDateTime)
                            || now.equals(domandaBandoDatoAggiuntivoDataInizioUploadDocumentiValoreDateTime))
                            && (now.isBefore(domandaBandoDatoAggiuntivoDataFineUploadDocumentiValoreDateTime)
                            || now.equals(domandaBandoDatoAggiuntivoDataFineUploadDocumentiValoreDateTime))) {
                        isInRange = true;
                    }
                }
            }
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
        return isBandoFormIntegrazioneFrontend && isInRange;
    }

