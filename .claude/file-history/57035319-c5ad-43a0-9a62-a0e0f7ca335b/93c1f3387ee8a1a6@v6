            String pathCampo = null;
            String pathTotalePunti = null;

            if (Validator.isNotNull(listaCampiCriteriAutovalutazione) && !listaCampiCriteriAutovalutazione.isEmpty()) {
                for (String campo : listaCampiCriteriAutovalutazione) {
                    pathCampo = "['" + campo + "']";
                    fieldValuesCriteriAutovalutazione = JsonPath.using(jsonPathConfiguration)
                            .parse(jsonForm)
                            .read(ALPACA_ALPACA_FIELD + ALPACA_DATA_FIELD + pathCampo);

                    JsonNode optionsCriteriAutovalutazione = JsonPath.using(jsonPathConfiguration)
                            .parse(jsonForm)
                            .read(ALPACA_ALPACA_FIELD + ALPACA_OPTIONS_FIELD + ALPACA_FIELDS_FIELD + pathCampo + ALPACA_FIELDS_FIELD);

                    if (optionsCriteriAutovalutazione != null) {
                        JsonNode optionsCriteriAutovalutaioneObj = optionsCriteriAutovalutazione.get(0);
                        for (Iterator<Map.Entry<String, JsonNode>> it = optionsCriteriAutovalutaioneObj.fields(); it.hasNext(); ) {
                            Map.Entry<String, JsonNode> entry = it.next();
                            JsonNode optionField = entry.getValue();
                            if (optionField.isObject() && optionField.has("requisitoChiusuraAutomatica")
                                    && optionField.get("requisitoChiusuraAutomatica").asBoolean(false)) {
                                pathTotalePunti = "$." + pathCampo + "['" + entry.getKey() + "']";
                                break;
                            }
                        }
                    }
                }
            }

            if (Validator.isNotNull(fieldValuesCriteriAutovalutazione)) {
                JsonNode nodeInfoAutovalutazione = fieldValuesCriteriAutovalutazione.get(0);

                if (nodeInfoAutovalutazione != null && !nodeInfoAutovalutazione.isEmpty()) {
                    DomandaBando domandaBandoAutovalutazione = domandaBandoLocalService
                            .fetchDomandaBando(istanzaDomandaBando.getDomandaBandoId());

