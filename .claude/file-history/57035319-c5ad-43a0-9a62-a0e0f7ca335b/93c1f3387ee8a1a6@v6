    public List<IstanzaDomandaBando> getFormEsecuzione(List<IstanzaDomandaBando> formIntegrativi, long bandoId) {
        List<BandoForm> bandoForms = bandoFormLocalService.getListaBandoFormBando(bandoId);

        List<Long> listaBandoFormId = new ArrayList<>();

        for (BandoForm bando : bandoForms) {
            if (bando.getTipoForm().equals(TipoFormEnum.ESECUZIONE.name())
                    || bando.getTipoForm().equals(TipoFormEnum.ESECUZIONE_CRONOPROGRAMMA.name())) {
                listaBandoFormId.add(bando.getFormId());
            }
        }

        List<IstanzaDomandaBando> formsEsecuzione = new ArrayList<>();

        for (IstanzaDomandaBando istanzaDomandaBando : formIntegrativi) {
            if (listaBandoFormId.contains(istanzaDomandaBando.getFormId())) {
                formsEsecuzione.add(istanzaDomandaBando);
            }
        }

        return formsEsecuzione;
    }

