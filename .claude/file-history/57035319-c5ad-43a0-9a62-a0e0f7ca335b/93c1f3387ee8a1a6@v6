    private List<JsonObject> getMockDataContainers(JsonObject alpacaJsonData, AlpacaJsonOptionsStructure optionsStr, String[] types) {
        List<JsonObject> containers = new ArrayList<>();
        List<String> fieldNames = AlpacaUtil.getAllFieldNameDataContainer(optionsStr, types);
        if (fieldNames == null) {
            return containers;
        }
        for (String fieldName : fieldNames) {
            JsonObject container = alpacaJsonData.getAsJsonObject(fieldName);
            if (container != null) {
                containers.add(container);
            }
        }
        return containers;
    }

    public Utente getUtente(User user) {
        Utente utente = new Utente();
        utente.setUtenteId(user.getUserId());
        utente.setCodiceFiscale(user.getScreenName().toUpperCase());
        utente.setNome(user.getFirstName());
        utente.setCognome(user.getLastName());

        String emailAddress = user.getEmailAddress();
        Serializable emailAggiuntiva = user.getExpandoBridge()
                .getAttribute(UserCustomAttributes.EMAIL_AGGIUNTIVA.getNomeAttributo());
        if (emailAggiuntiva != null && !emailAggiuntiva.toString().isEmpty()) {
            emailAddress = emailAggiuntiva.toString();
        }
        utente.setEmail(emailAddress);

        Serializable pec = user.getExpandoBridge().getAttribute(UserCustomAttributes.PEC.getNomeAttributo());
        if (pec != null) {
            utente.setPec(pec.toString());
        }
        return utente;
    }

