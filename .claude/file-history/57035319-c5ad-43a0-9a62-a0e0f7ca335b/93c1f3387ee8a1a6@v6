    public Map<String, String> calcolaPunteggioAutovalutazione(Map<String, String> dati) {
        BigDecimal puntiDimensioneInternazionale = _calcolaPuntiDimensioneInternazionale(dati);
        BigDecimal puntiNumeroDipendenti = _calcolaPuntiNumeroDipendenti(dati);
        BigDecimal puntiArticolazioneProgetto = _calcolaPuntiArticolazioneProgetto(dati);
        BigDecimal puntiSitoWeb = _calcolaPuntiSitoWeb(dati);
        BigDecimal puntiImpresaFemminile = _calcolaPuntiImpresaFemminile(dati);
        BigDecimal puntiImpresaGiovanile = _calcolaPuntiImpresaGiovanile(dati);
        BigDecimal puntiImpresaSostenibile = _calcolaPuntiImpresaSostenibile(dati);
        BigDecimal puntiCoerenza = _calcolaPuntiCoerenza(dati);

        BigDecimal totale = puntiDimensioneInternazionale.add(puntiNumeroDipendenti)
                .add(puntiArticolazioneProgetto).add(puntiSitoWeb)
                .add(puntiImpresaFemminile).add(puntiImpresaGiovanile)
                .add(puntiImpresaSostenibile).add(puntiCoerenza);

        Map<String, String> punteggi = new HashMap<>();
        punteggi.put("dimensioneInternazionale", _formattaPunteggio(puntiDimensioneInternazionale));
        punteggi.put("numeroDipendenti", _formattaPunteggio(puntiNumeroDipendenti));
        punteggi.put("articolazioneProgetto", _formattaPunteggio(puntiArticolazioneProgetto));
        punteggi.put("sitoWeb", _formattaPunteggio(puntiSitoWeb));
        punteggi.put("impresaFemminile", _formattaPunteggio(puntiImpresaFemminile));
        punteggi.put("impresaGiovanile", _formattaPunteggio(puntiImpresaGiovanile));
        punteggi.put("impresaSostenibile", _formattaPunteggio(puntiImpresaSostenibile));
        punteggi.put("coerenza", _formattaPunteggio(puntiCoerenza));
        punteggi.put("totale", _formattaPunteggio(totale));

        return punteggi;
    }

    /**
     * Calcola il punteggio per Dimensione Internazionalizzazione (max 35).
     *
     * Rapporto percentuale = (VE30 + VE34) / VE50 * 100
     *
     * Interpolazione lineare a tratti:
     *   - percentuale 0%   -> 30 punti
     *   - percentuale 10%  -> 35 punti (massimo)
     *   - percentuale 100% ->  0 punti
     *
     * Segmento 0%-10%:   punti = 30 + (percentuale / 10) * 5
     * Segmento 10%-100%: punti = 35 - ((percentuale - 10) / 90) * 35
     */
    private BigDecimal _calcolaPuntiDimensioneInternazionale(Map<String, String> dati) {
        BigDecimal ve30 = _parseImporto(dati.get("valoreCampoVE30Importo"));
        BigDecimal ve34 = _parseImporto(dati.get("valoreCampoVE34Importo"));
        BigDecimal ve50 = _parseImporto(dati.get("valoreCampoVE50Importo"));

        if (ve50.compareTo(BigDecimal.ZERO) <= 0) {
            return BigDecimal.valueOf(30);
        }

        BigDecimal sommaExport = ve30.add(ve34);
        BigDecimal percentuale = sommaExport
                .multiply(BigDecimal.valueOf(100))
                .divide(ve50, 4, RoundingMode.HALF_UP);

        if (percentuale.compareTo(BigDecimal.ZERO) < 0) {
            percentuale = BigDecimal.ZERO;
        }

        if (percentuale.compareTo(BigDecimal.valueOf(100)) > 0) {
            percentuale = BigDecimal.valueOf(100);
        }

        BigDecimal punti;

        if (percentuale.compareTo(BigDecimal.TEN) <= 0) {
            punti = BigDecimal.valueOf(30).add(
                    percentuale.divide(BigDecimal.TEN, 4, RoundingMode.HALF_UP)
                            .multiply(BigDecimal.valueOf(5))
            );
        }
        else {
            punti = BigDecimal.valueOf(35).subtract(
                    percentuale.subtract(BigDecimal.TEN)
                            .divide(BigDecimal.valueOf(90), 4, RoundingMode.HALF_UP)
                            .multiply(BigDecimal.valueOf(35))
            );
        }

        punti = punti.setScale(2, RoundingMode.HALF_UP);

        return punti.compareTo(BigDecimal.ZERO) < 0 ? BigDecimal.ZERO
                : punti.compareTo(BigDecimal.valueOf(MAX_PUNTI_DIMENSIONE_INTERNAZIONALE)) > 0
                        ? BigDecimal.valueOf(MAX_PUNTI_DIMENSIONE_INTERNAZIONALE) : punti;
    }

    /**
     * Calcola il punteggio per Numero Dipendenti (max 25).
     *
     * Start up innovativa: 25 punti indipendentemente dal numero di dipendenti.
     *
     * Altrimenti interpolazione lineare a tratti:
     *   - 0 dipendenti  ->  0 punti
     *   - 10 dipendenti -> 25 punti (inizio plateau)
     *   - 25 dipendenti -> 25 punti (fine plateau)
     *   - >= 50 dipendenti ->  0 punti
     *
     * Segmento 0-10:  punti = (n / 10) * 25
     * Segmento 10-25: punti = 25
     * Segmento 25-50: punti = 25 - ((n - 25) / 25) * 25
     */
    private BigDecimal _calcolaPuntiNumeroDipendenti(Map<String, String> dati) {
        String startUp = dati.get("startUpInput");

        if (SI.equalsIgnoreCase(startUp)) {
            return BigDecimal.valueOf(MAX_PUNTI_NUMERO_DIPENDENTI);
        }

        String numDipStr = dati.get("numeroDipendentiInput");
        int numDipendenti = _parseIntero(numDipStr);

        if (numDipendenti <= 0) {
            return BigDecimal.ZERO;
        }

        if (numDipendenti >= 50) {
            return BigDecimal.ZERO;
        }

        BigDecimal punti;

        if (numDipendenti <= 10) {
            punti = BigDecimal.valueOf(numDipendenti)
                    .divide(BigDecimal.TEN, 4, RoundingMode.HALF_UP)
                    .multiply(BigDecimal.valueOf(MAX_PUNTI_NUMERO_DIPENDENTI));
        }
        else if (numDipendenti <= 25) {
            punti = BigDecimal.valueOf(MAX_PUNTI_NUMERO_DIPENDENTI);
        }
        else {
            punti = BigDecimal.valueOf(MAX_PUNTI_NUMERO_DIPENDENTI).subtract(
                    BigDecimal.valueOf(numDipendenti - 25)
                            .divide(BigDecimal.valueOf(25), 4, RoundingMode.HALF_UP)
                            .multiply(BigDecimal.valueOf(MAX_PUNTI_NUMERO_DIPENDENTI))
            );
        }

        punti = punti.setScale(2, RoundingMode.HALF_UP);

        return punti.compareTo(BigDecimal.ZERO) < 0 ? BigDecimal.ZERO
                : punti.compareTo(BigDecimal.valueOf(MAX_PUNTI_NUMERO_DIPENDENTI)) > 0
                        ? BigDecimal.valueOf(MAX_PUNTI_NUMERO_DIPENDENTI) : punti;
    }

    /**
     * Calcola il punteggio per Articolazione Progetto (max 15).
     *
     * Basato sul numero di fiere internazionali all'estero:
     *   - 0 fiere internazionali (solo nazionali) ->  0 punti
     *   - 1 fiera internazionale all'estero       ->  5 punti
     *   - 2 fiere internazionali all'estero       -> 10 punti
     *   - 3 fiere internazionali all'estero       -> 15 punti (10 + 5 aggiuntivi)
     */
    private BigDecimal _calcolaPuntiArticolazioneProgetto(Map<String, String> dati) {
        String partecipazioneFiere = dati.get("articolazioneProgettoInput");

        if (!SI.equalsIgnoreCase(partecipazioneFiere)) {
            return BigDecimal.ZERO;
        }

        int numeroFiereInternazionali = _parseIntero(dati.get("numeroFiereInternazionali"));

        if (numeroFiereInternazionali <= 0) {
            return BigDecimal.ZERO;
        }

        BigDecimal punti;

        if (numeroFiereInternazionali == 1) {
            punti = BigDecimal.valueOf(5);
        }
        else if (numeroFiereInternazionali == 2) {
            punti = BigDecimal.valueOf(10);
        }
        else {
            punti = BigDecimal.valueOf(15);
        }

        return punti.compareTo(BigDecimal.valueOf(MAX_PUNTI_ARTICOLAZIONE_PROGETTO)) > 0
                ? BigDecimal.valueOf(MAX_PUNTI_ARTICOLAZIONE_PROGETTO) : punti;
    }

    /**
     * Calcola il punteggio per Sito Web (max 10).
     * 2,5 punti per ogni lingua straniera, max 4 lingue rilevanti.
     * Oltre 4 lingue il punteggio resta 10.
     */
    private BigDecimal _calcolaPuntiSitoWeb(Map<String, String> dati) {
        String numLingueStr = dati.get("sitoWebNumLingueInput");
        int numLingue = _parseIntero(numLingueStr);

        if (numLingue <= 0) {
            return BigDecimal.ZERO;
        }

        int lingueRilevanti = Math.min(numLingue, 4);

        BigDecimal punti = BigDecimal.valueOf(lingueRilevanti)
                .multiply(new BigDecimal("2.5"));

        return punti.compareTo(BigDecimal.valueOf(MAX_PUNTI_SITO_WEB)) > 0
                ? BigDecimal.valueOf(MAX_PUNTI_SITO_WEB) : punti;
    }

