                            if (Validator.isNotNull(partitaIva)) {
                                listaPartiteIva.add(partitaIva);
                            }
                        }
                    }
                }
            }
        }
    }

    private List<String> getPartiteIva(IstanzaDomandaBando istanzaDomandaBando, String portalURL, long bandoId)
            throws PortalException {
        List<String> listaPartiteIva = new ArrayList<String>();
        String jsonForm = istanzaDomandaBando.getJson();

        if (Validator.isNotNull(jsonForm)) {
            Set<Option> jsonPathOptions = new HashSet<Option>();
            jsonPathOptions.add(Option.SUPPRESS_EXCEPTIONS);
            jsonPathOptions.add(Option.ALWAYS_RETURN_LIST);

            Configuration jsonPathConfiguration = Configuration.builder()
                    .jsonProvider(new JacksonJsonNodeJsonProvider()).mappingProvider(new JacksonMappingProvider())
                    .options(jsonPathOptions).build();

            JsonNode fieldValues = null;
            JsonNode soggettiAti = null;

            List<String> listaCampiRegistroImpresa = getNomeCampoByType(jsonForm, portalURL, typesRegistroImpresa,
                    istanzaDomandaBando.getFormId());

            if (ListUtil.isNotNull(listaCampiRegistroImpresa) && ListUtil.isNotEmpty(listaCampiRegistroImpresa)) {
                for (String campo : listaCampiRegistroImpresa) {
                    String pathCampo = "['" + campo + "']";
                    fieldValues = JsonPath.using(jsonPathConfiguration).parse(jsonForm)
                            .read(ALPACA_ALPACA_FIELD + ALPACA_DATA_FIELD + pathCampo);
                }

                if (fieldValues != null) {
                    JsonNode nodeInfo = fieldValues.get(0);

                    if (nodeInfo != null && !nodeInfo.isEmpty()) {

                        JsonNode nodeInterno = null;

                        if (nodeInfo.has("tipoSoggetto")) {
                            String tipoSoggetto = nodeInfo.get("tipoSoggetto").asText();

                            if (Validator.isNotNull(tipoSoggetto)) {

                                if (tipoSoggetto.equalsIgnoreCase(TipoSoggettoEnum.LR.name())) {
                                    nodeInterno = nodeInfo.get("privato");
                                }

                                if (tipoSoggetto.equalsIgnoreCase(TipoSoggettoEnum.SD.name())) {
                                    nodeInterno = nodeInfo.get("privatoDelegato");
                                }
                            }
                        }

                        if (nodeInterno != null) {

                            if (nodeInterno.has("pIva") && !nodeInterno.get("pIva").isNull()) {
                                String pIva = nodeInterno.get("pIva").asText();

                                if (Validator.isNotNull(pIva)) {
                                    listaPartiteIva.add(pIva);
                                }
                            }

                        }
                    }
                }
            } else {
                List<String> listaCampiRegistroImpresaConfigurabile = getNomeCampoByType(jsonForm, portalURL, typesCustomRegistroImpreseConfigurabile,
                        istanzaDomandaBando.getFormId());

                if (ListUtil.isNotNull(listaCampiRegistroImpresaConfigurabile) && ListUtil.isNotEmpty(listaCampiRegistroImpresaConfigurabile)) {
                    for (String campo : listaCampiRegistroImpresaConfigurabile) {
                        String pathCampo = "['" + campo + "']";
                        JsonNode fieldValuesOptions = JsonPath.using(jsonPathConfiguration).parse(jsonForm)
                                .read(ALPACA_ALPACA_FIELD + ALPACA_OPTIONS_FIELD + ALPACA_FIELDS_FIELD + pathCampo);

                        if (Validator.isNotNull(fieldValuesOptions) && !fieldValuesOptions.isEmpty()) {
                            JsonNode options = fieldValuesOptions.get(0);
                            if (options.has("fieldClass")) {
                                String fieldClass = options.get("fieldClass").asText();
                                if (Validator.isNotNull(fieldClass) && fieldClass.contains("soggettoDelegante")) {
                                    fieldValues = JsonPath.using(jsonPathConfiguration).parse(jsonForm)
                                            .read(ALPACA_ALPACA_FIELD + ALPACA_DATA_FIELD + pathCampo);
                                    break;
                                }
                            }
                        }

                    }

                    if (Validator.isNotNull(fieldValues)) {
                        JsonNode nodeInfo = fieldValues.get(0);

                        if (nodeInfo != null && !nodeInfo.isEmpty()) {

                            JsonNode nodeInterno = nodeInfo.get("privato");

                            if (Validator.isNotNull(nodeInterno)) {

                                if (nodeInterno.has("pIva") && !nodeInterno.get("pIva").isNull()) {
                                    String pIva = nodeInterno.get("pIva").asText();

                                    if (Validator.isNotNull(pIva)) {
                                        listaPartiteIva.add(pIva);
                                    }
                                }

                            }
                        }
                    }
                }
                Bando bando = bandoLocalService.getBando(bandoId);
                if (bando.isObbligoAccreditamentoEnte()) {
                    List<String> listaCampiAccreditamento = getNomeCampoByType(jsonForm, portalURL,
                            datiEnteRecuperoTypes, istanzaDomandaBando.getFormId());

                    if (Validator.isNotNull(listaCampiAccreditamento) && !listaCampiAccreditamento.isEmpty()) {
                        for (String campo : listaCampiAccreditamento) {
                            String pathCampo = "['" + campo + "']";
                            fieldValues = JsonPath.using(jsonPathConfiguration).parse(jsonForm)
                                    .read(ALPACA_ALPACA_FIELD + ALPACA_DATA_FIELD + pathCampo);
                        }

                        if (Validator.isNotNull(fieldValues)) {
                            JsonNode nodeInfo = fieldValues.get(0);

                            if (nodeInfo != null && !nodeInfo.isEmpty()) {

                                JsonNode nodeInterno = nodeInfo.get("privato");

                                if (Validator.isNotNull(nodeInterno)) {

                                    if (nodeInterno.has("pIva") && !nodeInterno.get("pIva").isNull()) {
                                        String pIva = nodeInterno.get("pIva").asText();

                                        if (Validator.isNotNull(pIva)) {
                                            listaPartiteIva.add(pIva);
                                        }
                                    }

                                }
                            }
                        }
                    }
                }

                List<String> listaCampiSoggettiATIATS = getNomeCampoByType(jsonForm, portalURL, typesSoggettiATIATS,
                        istanzaDomandaBando.getFormId());

                for (String campo : listaCampiSoggettiATIATS) {
                    String pathCampo = "['" + campo + "']";
                    fieldValues = JsonPath.using(jsonPathConfiguration).parse(jsonForm)
                            .read(ALPACA_ALPACA_FIELD + ALPACA_DATA_FIELD + pathCampo);
                }

                estraiPartiteIva(fieldValues,"partner", listaPartiteIva);

            }

            List<String> listaCampiCustomMandanti = getNomeCampoByType(jsonForm, portalURL, typesCustomMandanti,
                    istanzaDomandaBando.getFormId());

            for (String campo : listaCampiCustomMandanti) {
                String pathCampo = "['" + campo + "']";
                fieldValues = JsonPath.using(jsonPathConfiguration).parse(jsonForm)
                        .read(ALPACA_ALPACA_FIELD + ALPACA_DATA_FIELD + pathCampo);
            }
            estraiPartiteIva(fieldValues, "mandanti", listaPartiteIva);

            List<String> listaCampiPartnerAgricoltura = getNomeCampoByType(jsonForm, portalURL, typesPartnerAgricoltura,
                    istanzaDomandaBando.getFormId());

            if (listaCampiPartnerAgricoltura != null && !listaCampiPartnerAgricoltura.isEmpty()) {
                for (String campo : listaCampiPartnerAgricoltura) {
                    String pathCampo = "['" + campo + "']";
                    fieldValues = JsonPath.using(jsonPathConfiguration).parse(jsonForm)
                            .read(ALPACA_ALPACA_FIELD + ALPACA_DATA_FIELD + pathCampo);
                }

                if (fieldValues != null) {
                    JsonNode root = fieldValues.get(0);
                    if (root != null) {
                        JsonNode partnerArray = root.get("partner");
                        if (partnerArray != null && partnerArray.size() > 0) {
                            for (JsonNode elemPartner : partnerArray) {
                                if (Validator.isNotNull(elemPartner) && Validator.isNotNull(elemPartner.get("datiPartner"))) {
                                    JsonNode datiPartner = elemPartner.get("datiPartner");
                                    if (datiPartner.has("codiceFiscale") && !datiPartner.get("codiceFiscale").isNull()) {
                                        String codiceFiscale = datiPartner.get("codiceFiscale").asText();
                                        if (Validator.isNotNull(codiceFiscale)) {
                                            listaPartiteIva.add(codiceFiscale);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Form form = getFormBando(bandoId);
            List<FormField> listaField = new ArrayList<FormField>();

            if (Validator.isNotNull(form)) {
                for (String type : typesCustomSoggettiATIATS) {
                    JsonPathUtil.processPropertiesCustomFields(listaField, form.getJson(), "", "", type);

                    if (Validator.isNotNull(listaField) && !listaField.isEmpty()) {
                        JsonNode partner = null;

                        if (Validator.isNotNull(listaField.get(0))
                                && Validator.isNotNull(listaField.get(0).getPath())) {
                            String field = listaField.get(0).getPath()
                                    .substring(listaField.get(0).getPath().indexOf(".") + 1);

                            String arrayField = field.substring(field.indexOf("["), field.indexOf("]") + 1);

                            if (Validator.isNotNull(arrayField)) {
                                String jsonPathInterno = ALPACA_ALPACA_FIELD + ALPACA_DATA_FIELD + arrayField;
                                partner = JsonPath.using(jsonPathConfiguration).parse(jsonForm).read(jsonPathInterno);

                                if (Validator.isNotNull(partner) && Validator.isNotNull(partner.get(0))) {

                                    JsonNode arrayPartner = partner.get(0);

                                    for (JsonNode elemPartner : arrayPartner) {
                                        if (Validator.isNotNull(elemPartner)) {

                                            if (Validator.isNotNull(elemPartner.get("datiPartner"))) {
                                                JsonNode datiPartner = elemPartner.get("datiPartner");

                                                if (Validator.isNotNull(datiPartner.get("partitaIva"))) {
                                                    String partitaIva = datiPartner.get("partitaIva").asText();

                                                    if (Validator.isNotNull(partitaIva)) {
                                                        listaPartiteIva.add(partitaIva);
                                                    }
                                                } else if (Validator.isNotNull(datiPartner.get("codiceFiscale"))
                                                        && Validator.isNull(datiPartner.get("partitaIva"))) {
                                                    String codiceFiscale = datiPartner.get("codiceFiscale").asText();

                                                    if (Validator.isNotNull(codiceFiscale)) {
                                                        listaPartiteIva.add(codiceFiscale);
                                                    }
                                                }

                                            }
                                        }
                                    }

                                }
                            }
                        }

                    }
                }

            }

        }

        return listaPartiteIva;
    }

    public List<ErroreValidazionePartitaIvaDTO> validaPartiteIvaDomanda(Bando bando,
                                                                        IstanzaDomandaBando istanzaDomandaBando, Locale locale, String portalURL) throws PortalException {
        List<ErroreValidazionePartitaIvaDTO> listaErrori = new ArrayList<ErroreValidazionePartitaIvaDTO>();
        List<String> listaPartiteIva = getPartiteIva(istanzaDomandaBando, portalURL, bando.getBandoId());
        ResourceBundleLoader resourceBundleLoader = ResourceBundleLoaderUtil
                .getResourceBundleLoaderByBundleSymbolicName(PresentatoreFormsPortletKeys.BUNDLE_SYMBOLIC_NAME);

        if (listaPartiteIva != null && !listaPartiteIva.isEmpty()) {
            for (String partitaIva : listaPartiteIva) {
                if (!bando.getDomandaMultiplaIndividuale()) {
                    long countByPartitaIvaAndBandoId = domandaBandoLocalService
                            .countAziendeNonAssociateByPartitaIvaAndBandoId(partitaIva, bando.getBandoId());

                    if (countByPartitaIvaAndBandoId > 0) {

                        ErroreValidazionePartitaIvaDTO erroreDto = new ErroreValidazionePartitaIvaDTO();

                        String messaggioErrore = resourceBundleLoader.loadResourceBundle(locale)
                                .getString("errore-domanda-multipla-individuale");

                        if (Validator.isNotNull(messaggioErrore)) {
                            erroreDto.setErrore(messaggioErrore);
                        }

                        erroreDto.setPartitaIva(partitaIva);
                        listaErrori.add(erroreDto);
                    }

                }

                if (!bando.getDomandaMultiplaRti()) {
                    long countAziendeAssociateByPartitaIvaAndBandoId = domandaBandoLocalService
                            .countAziendeAssociateByPartitaIvaAndBandoId(partitaIva, bando.getBandoId());

                    if (countAziendeAssociateByPartitaIvaAndBandoId > 0) {

                        ErroreValidazionePartitaIvaDTO erroreDto = new ErroreValidazionePartitaIvaDTO();

                        String messaggioErrore = resourceBundleLoader.loadResourceBundle(locale)
                                .getString("errore-domanda-multipla-rti");

                        if (Validator.isNotNull(messaggioErrore)) {
                            erroreDto.setErrore(messaggioErrore);
                        }

                        erroreDto.setPartitaIva(partitaIva);
                        listaErrori.add(erroreDto);
                    }

                }
            }
        }

        return listaErrori;
    }

