            return BigDecimal.valueOf(MAX_PUNTI_COERENZA);
        }

        return BigDecimal.ZERO;
    }

    /**
     * Formatta un punteggio BigDecimal come stringa.
     * Se il valore è intero restituisce senza decimali (es. "25"),
     * altrimenti con i decimali significativi (es. "2.5", "7.5").
     */
    private String _formattaPunteggio(BigDecimal punteggio) {
        if (punteggio.stripTrailingZeros().scale() <= 0) {
            return punteggio.setScale(0, RoundingMode.HALF_UP).toPlainString();
        }

        return punteggio.stripTrailingZeros().toPlainString();
    }

    /**
     * Converte una stringa importo (formato italiano 1.234,56) in BigDecimal.
     */
    private BigDecimal _parseImporto(String importo) {
        if (Validator.isNull(importo)) {
            return BigDecimal.ZERO;
        }

        String normalizzato = importo.trim()
                .replace("€", "")
                .replace(" ", "")
                .trim();

        if (Validator.isNull(normalizzato)) {
            return BigDecimal.ZERO;
        }

        if (normalizzato.contains(",")) {
            normalizzato = normalizzato.replace(".", "").replace(",", ".");
        }

        try {
            return new BigDecimal(normalizzato);
        }
        catch (NumberFormatException e) {
            log.warn("Importo non valido: " + importo);
            return BigDecimal.ZERO;
        }
    }

    /**
     * Converte una stringa in intero, ritorna 0 se non valida.
     */
    private int _parseIntero(String valore) {
        if (Validator.isNull(valore)) {
            return 0;
        }

        try {
            return Integer.parseInt(valore.trim());
        }
        catch (NumberFormatException e) {
            log.warn("Valore intero non valido: " + valore);
            return 0;
        }
    }

    public List<ErroreValidazioneDTO> validaImportoPostiLetto(String dataForm, String jsonPathCampo) {
        List<ErroreValidazioneDTO> errori = new ArrayList<>();

        if (Validator.isNull(dataForm) || Validator.isNull(jsonPathCampo)) {
            return errori;
        }

        JsonObject formJson = new JsonParser().parse(dataForm).getAsJsonObject();
        JsonObject alpacaData = formJson.getAsJsonObject("alpaca").getAsJsonObject("data");

        // Naviga al parent object usando il jsonPathCampo
        List<String> keys = _parseJsonPathKeys(jsonPathCampo);

        JsonObject parent = alpacaData;
        for (int i = 0; i < keys.size() - 1; i++) {
            if (parent == null || !parent.has(keys.get(i))) {
                return errori;
            }
            parent = parent.getAsJsonObject(keys.get(i));
        }

        String valoreNumericoStr = parent.has("valoreNumerico") && !parent.get("valoreNumerico").isJsonNull()
                ? parent.get("valoreNumerico").getAsString() : null;
        String importoStr = parent.has("importo") && !parent.get("importo").isJsonNull()
                ? parent.get("importo").getAsString() : null;

        if (Validator.isNull(valoreNumericoStr) || Validator.isNull(importoStr)) {
            return errori;
        }

        int postiLetto = _parseIntero(valoreNumericoStr);
        BigDecimal importo = ImportoUtils.parseImporto(importoStr);

        BigDecimal importoMinimo40 = new BigDecimal("250000");
        BigDecimal importoMassimo40 = new BigDecimal("1500000");
        BigDecimal importoMassimoOltre40 = new BigDecimal("3000000");
        int sogliaPostiLetto = 40;

        if (postiLetto == sogliaPostiLetto) {
            if (importo.compareTo(importoMinimo40) < 0) {
                ErroreValidazioneDTO errore = new ErroreValidazioneDTO();
                errore.setDescrizione("Per " + sogliaPostiLetto + " posti letto, l'importo minimo deve essere di \u20AC 250.000,00");
                errore.setObbligatorio(true);
                errori.add(errore);
            }

            if (importo.compareTo(importoMassimo40) > 0) {
                ErroreValidazioneDTO errore = new ErroreValidazioneDTO();
                errore.setDescrizione("Per " + sogliaPostiLetto + " posti letto, l'importo massimo non deve superare \u20AC 1.500.000,00");
                errore.setObbligatorio(true);
                errori.add(errore);
            }
        }
        else if (postiLetto > sogliaPostiLetto) {
            if (importo.compareTo(importoMinimo40) < 0) {
                ErroreValidazioneDTO errore = new ErroreValidazioneDTO();
                errore.setDescrizione("Per un numero di posti letto superiore a " + sogliaPostiLetto + ", l'importo minimo deve essere di \u20AC 250.000,00");
                errore.setObbligatorio(true);
                errori.add(errore);
            }

            if (importo.compareTo(importoMassimoOltre40) > 0) {
                ErroreValidazioneDTO errore = new ErroreValidazioneDTO();
                errore.setDescrizione("Per un numero di posti letto superiore a " + sogliaPostiLetto + ", l'importo massimo non deve superare \u20AC 3.000.000,00");
                errore.setObbligatorio(true);
                errori.add(errore);
            }
        }

        return errori;
    }

    /**
     * Estrae le chiavi dal jsonPath nel formato $.['key1']['key2']['key3']
     */
    private List<String> _parseJsonPathKeys(String jsonPath) {
        List<String> keys = new ArrayList<>();
        java.util.regex.Pattern pattern = java.util.regex.Pattern.compile("\\['([^']+)'\\]");
        java.util.regex.Matcher matcher = pattern.matcher(jsonPath);

        while (matcher.find()) {
            keys.add(matcher.group(1));
        }

        return keys;
    }

    public JsonObject calcolaGiorniAttivita(String dataForm, String jsonPathCampo) {
        JsonObject result = new JsonObject();
        DateTimeFormatter formatter = DateTimeFormatter.ofPattern("dd/MM/yyyy");

        try {
            if (Validator.isNull(dataForm) || Validator.isNull(jsonPathCampo)) {
                return _buildErroreCalcoloGiorni(result, "Compilare entrambe le date", true);
            }

            JsonObject formJson = new JsonParser().parse(dataForm).getAsJsonObject();
            JsonObject alpacaData = formJson.getAsJsonObject("alpaca").getAsJsonObject("data");

            List<String> keys = _parseJsonPathKeys(jsonPathCampo);

            JsonObject parent = alpacaData;
            for (int i = 0; i < keys.size() - 1; i++) {
                if (parent == null || !parent.has(keys.get(i))) {
                    return _buildErroreCalcoloGiorni(result, "Compilare entrambe le date", true);
                }
                parent = parent.getAsJsonObject(keys.get(i));
            }

            String dataInizioStr = parent.has("dataInizio") && !parent.get("dataInizio").isJsonNull()
                    ? parent.get("dataInizio").getAsString() : null;
            String dataFineStr = parent.has("dataFine") && !parent.get("dataFine").isJsonNull()
                    ? parent.get("dataFine").getAsString() : null;

            if (Validator.isNull(dataInizioStr) || Validator.isNull(dataFineStr)) {
                return _buildErroreCalcoloGiorni(result, "Compilare entrambe le date", true);
            }

            LocalDate dataInizio = LocalDate.parse(dataInizioStr, formatter);
            LocalDate dataFine = LocalDate.parse(dataFineStr, formatter);

            if (dataFine.isBefore(dataInizio)) {
                return _buildErroreCalcoloGiorni(result, "La data fine attività deve essere successiva o uguale alla data inizio attività", true);
            }

            long giorni = ChronoUnit.DAYS.between(dataInizio, dataFine) + 1;

            result.addProperty("status", "OK");
            result.addProperty("risultato", giorni);
        }
        catch (DateTimeParseException e) {
            _log.error("Errore nel parsing delle date: " + e.getMessage(), e);
            _buildErroreCalcoloGiorni(result, "Formato data non valido, utilizzare dd/MM/yyyy", true);
        }
        catch (Exception e) {
            _log.error("Errore nel calcolo giorni attività: " + e.getMessage(), e);
            _buildErroreCalcoloGiorni(result, "Errore durante il calcolo dei giorni", true);
        }

        return result;
    }

    private JsonObject _buildErroreCalcoloGiorni(JsonObject result, String messaggio, boolean obbligatorio) {
        JsonObject errore = new JsonObject();
        errore.addProperty("messaggio", messaggio);
        errore.addProperty("obbligatorio", obbligatorio);
        JsonArray errori = new JsonArray();
        errori.add(errore);
        result.addProperty("status", "KO");
        result.add("errori", errori);
        return result;
    }

    public JsonObject calcolaPercentuale(String dataForm, String jsonPathIniziale, String jsonPathRiferimento) {
        JsonObject result = new JsonObject();

        try {
            if (Validator.isNull(dataForm) || Validator.isNull(jsonPathIniziale) || Validator.isNull(jsonPathRiferimento)) {
                result.addProperty("status", "KO");
                return result;
            }

            JsonObject formJson = new JsonParser().parse(dataForm).getAsJsonObject();

            String valoreInizialeStr = _risolviValoreDaJsonPath(formJson, jsonPathIniziale);
            String valoreRiferimentoStr = _risolviValoreDaJsonPath(formJson, jsonPathRiferimento);

            if (Validator.isNull(valoreInizialeStr) || Validator.isNull(valoreRiferimentoStr)) {
                result.addProperty("status", "KO");
                return result;
            }

            BigDecimal valoreIniziale = _parseImporto(valoreInizialeStr);
            BigDecimal valoreRiferimento = _parseImporto(valoreRiferimentoStr);
            BigDecimal risultato = BigDecimal.ZERO;
            if (valoreRiferimento.compareTo(BigDecimal.ZERO) == 0) {
                result.addProperty("status", "KO");
                result.addProperty("messaggio", "Il campo '${valoreRiferimento}' non può essere pari a zero");
                return result;
            }

            if (valoreRiferimento.compareTo(valoreIniziale) < 0) {
                result.addProperty("status", "KO");
                result.addProperty("messaggio", "Il campo '${valoreRiferimento}' deve essere maggiore o uguale al campo '${valoreIniziale}'");
                return result;
            }

            risultato = valoreRiferimento.subtract(valoreIniziale);

            BigDecimal percentuale = risultato.multiply(new BigDecimal(100)).divide(valoreRiferimento, 2, RoundingMode.HALF_UP);

            result.addProperty("status", "OK");
            result.addProperty("percentuale", percentuale.toPlainString());
            result.addProperty("importo", risultato.toPlainString());
        }
        catch (Exception e) {
            log.error("Errore nel calcolo percentuale: " + e.getMessage(), e);
            result.addProperty("status", "KO");
        }

        return result;
    }

    private String _risolviValoreDaJsonPath(JsonObject formData, String jsonPath) {
        List<String> keys = _parseJsonPathKeys(jsonPath);
        if (keys.isEmpty()) {
            return null;
        }

        JsonElement current = formData;
        for (String key : keys) {
            if (current == null || !current.isJsonObject() || !current.getAsJsonObject().has(key)) {
                return null;
            }
            current = current.getAsJsonObject().get(key);
        }

        if (current == null || current.isJsonNull() || !current.isJsonPrimitive()) {
            return null;
        }

        return current.getAsString();
    }
