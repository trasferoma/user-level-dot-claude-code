    private Map<String, String> retrievePartivaIvaRagioneSociale(long formId, String portalURL, long bandoId,
                                                                 String jsonForm) {
        String partitaIva = null;
        String ragioneSociale = null;
        Map<String, String> response = new HashMap<String, String>();
        if (Validator.isNotNull(jsonForm)) {
            Set<Option> jsonPathOptions = new HashSet<Option>();
            jsonPathOptions.add(Option.SUPPRESS_EXCEPTIONS);
            jsonPathOptions.add(Option.ALWAYS_RETURN_LIST);

            Configuration jsonPathConfiguration = Configuration.builder()
                    .jsonProvider(new JacksonJsonNodeJsonProvider()).mappingProvider(new JacksonMappingProvider())
                    .options(jsonPathOptions).build();

            JsonNode fieldValues = null;

            List<String> listaCampiRegistroImpresa = getNomeCampoByType(jsonForm, portalURL, typesRegistroImpresa,
                    formId);
            List<String> listaCampiRegistroImpresaConfigurabile = getNomeCampoByType(jsonForm, portalURL,
                    typesCustomRegistroImpreseConfigurabile, formId);

            List<String> listaCampiSedeLegale = new ArrayList<String>();

            if (Validator.isNotNull(listaCampiRegistroImpresa) && !listaCampiRegistroImpresa.isEmpty()) {
                for (String campo : listaCampiRegistroImpresa) {
                    String pathCampo = "['" + campo + "']";
                    fieldValues = JsonPath.using(jsonPathConfiguration).parse(jsonForm)
                            .read(ALPACA_ALPACA_FIELD + ALPACA_DATA_FIELD + pathCampo);
                }
            } else {
                listaCampiSedeLegale = getNomeCampoByType(jsonForm, portalURL, typesSedeLegale, formId);

                if (Validator.isNotNull(listaCampiSedeLegale) && !listaCampiSedeLegale.isEmpty()) {
                    for (String campo : listaCampiSedeLegale) {
                        String pathCampo = "['" + campo + "']";
                        fieldValues = JsonPath.using(jsonPathConfiguration).parse(jsonForm)
                                .read(ALPACA_ALPACA_FIELD + ALPACA_DATA_FIELD + pathCampo);
                    }
                }
            }

            if (Validator.isNotNull(listaCampiRegistroImpresa) && !listaCampiRegistroImpresa.isEmpty()) {
                for (String campo : listaCampiRegistroImpresa) {
                    String pathCampo = "['" + campo + "']";
                    fieldValues = JsonPath.using(jsonPathConfiguration).parse(jsonForm)
                            .read(ALPACA_ALPACA_FIELD + ALPACA_DATA_FIELD + pathCampo);
                }

                if (fieldValues != null) {
                    JsonNode nodeInfo = fieldValues.get(0);

                    if (nodeInfo != null && !nodeInfo.isEmpty()) {

                        JsonNode nodeInterno = null;

                        if (nodeInfo.has("tipoSoggetto")) {
                            String tipoSoggetto = nodeInfo.get("tipoSoggetto").asText();

                            if (Validator.isNotNull(tipoSoggetto)) {

                                if (tipoSoggetto.equalsIgnoreCase(TipoSoggettoEnum.LR.name())) {
                                    nodeInterno = nodeInfo.get("privato");
                                }

                                if (tipoSoggetto.equalsIgnoreCase(TipoSoggettoEnum.SD.name())) {
                                    nodeInterno = nodeInfo.get("privatoDelegato");
                                }
                            }
                        }

                        if (nodeInterno != null) {

                            if (nodeInterno.has("pIva") && !nodeInterno.get("pIva").isNull()) {
                                String pIva = nodeInterno.get("pIva").asText();
                                if (Validator.isNotNull(pIva)) {
                                    partitaIva = pIva;
                                }
                            }

                            if (nodeInterno.has("denominazioneSoggettoOrganizzatore")
                                    && !nodeInterno.get("denominazioneSoggettoOrganizzatore").isNull()) {
                                ragioneSociale = nodeInterno.get("denominazioneSoggettoOrganizzatore").asText();
                            }

                        }
                    }
                }
            } else if (Validator.isNotNull(listaCampiRegistroImpresaConfigurabile) && !listaCampiRegistroImpresaConfigurabile.isEmpty()) {

                for (String campo : listaCampiRegistroImpresaConfigurabile) {
                    String pathCampo = "['" + campo + "']";
                    JsonNode fieldValuesOptions = JsonPath.using(jsonPathConfiguration).parse(jsonForm)
                            .read(ALPACA_ALPACA_FIELD + ALPACA_OPTIONS_FIELD + ALPACA_FIELDS_FIELD + pathCampo);
                    boolean isInsegnestoriche = true;
                    try{
                        Bando bando = bandoLocalService.getBando(bandoId);
                        String codiBandiInsegneStoriche = null;
                        exportInserimentoElencoConfiguration = configurationProvider
                                .getGroupConfiguration(BandiInserimentoElencoConfiguration.class, bando.getGroupId());
                        codiBandiInsegneStoriche = exportInserimentoElencoConfiguration.codiciBandiInsegneStoriche();
                        List<String> listaCodiBandiInsegneStoriche = Arrays.asList(codiBandiInsegneStoriche.split(","));
                        if (Validator.isNotNull(bando.getCodice())) {
                            if (listaCodiBandiInsegneStoriche.contains(bando.getCodice())) {
                                isInsegnestoriche=true;
                            }
                        }
                    }catch (Exception e){
                        _log.error("Errore durante il recupero delle informazioni del bando con ID: " + bandoId, e);
                    }

                    if (Validator.isNotNull(fieldValuesOptions) && !fieldValuesOptions.isEmpty()) {
                        JsonNode options = fieldValuesOptions.get(0);
                        if (options.has("fieldClass")) {
                            String fieldClass = options.get("fieldClass").asText();
                            if (Validator.isNotNull(fieldClass)){
                                if (!isInsegnestoriche || (isInsegnestoriche && fieldClass.contains("soggettoDelegante"))) {
                                    fieldValues = JsonPath.using(jsonPathConfiguration).parse(jsonForm)
                                            .read(ALPACA_ALPACA_FIELD + ALPACA_DATA_FIELD + pathCampo);
                                    break;
                                }
                            }
                        }
                    }

                }

                if (Validator.isNotNull(fieldValues)) {
                    JsonNode nodeInfo = fieldValues.get(0);

                    if (nodeInfo != null && !nodeInfo.isEmpty()) {

                        JsonNode nodeInterno = nodeInfo.get("privato");

                        if (Validator.isNotNull(nodeInterno)) {

                            if (nodeInterno.has("pIva") && !nodeInterno.get("pIva").isNull()) {
                                String pIva = nodeInterno.get("pIva").asText();

                                if (Validator.isNotNull(pIva)) {
                                    partitaIva = pIva;
                                }
                            }

                            if (nodeInterno.has("denominazioneSoggettoOrganizzatore")
                                    && !nodeInterno.get("denominazioneSoggettoOrganizzatore").isNull()) {
                                ragioneSociale = nodeInterno.get("denominazioneSoggettoOrganizzatore").asText();
                            }

                        }
                    }
                }
            } else {
                if (Validator.isNotNull(listaCampiSedeLegale) && !listaCampiSedeLegale.isEmpty()) {
                    JsonNode nodeInfo = fieldValues.get(0);

                    if (nodeInfo.has("ragioneSociale")) {
                        if (Validator.isNotNull(nodeInfo.get("ragioneSociale").asText())) {
                            ragioneSociale = nodeInfo.get("ragioneSociale").asText();
                        }
                    } else {
                        JsonNode fieldValuesNome = JsonPath.using(jsonPathConfiguration).parse(jsonForm)
                                .read(ALPACA_ALPACA_FIELD + ALPACA_DATA_FIELD + "['NomeEnte']");
                        if (Validator.isNotNull(fieldValuesNome) && !fieldValuesNome.isEmpty()) {
                            if (Validator.isNotNull(fieldValuesNome.get(0).asText())) {
                                ragioneSociale = fieldValuesNome.get(0).asText();
                            }
                        }
                    }

                    if (nodeInfo.has("partitaIva") && Validator.isNotNull(nodeInfo.get("partitaIva").asText())) {
                        partitaIva = nodeInfo.get("partitaIva").asText();
                    } else if (nodeInfo.has("cf") && Validator.isNotNull(nodeInfo.get("cf").asText())) {
                        partitaIva = nodeInfo.get("cf").asText();
                    }

                }
            }

        }

        if (Validator.isNotNull(partitaIva) && Validator.isNotNull(ragioneSociale)) {
            response.put("PARTITA_IVA", partitaIva);
            response.put("RAGIONE_SOCIALE", ragioneSociale);
        }

        return response;
    }

