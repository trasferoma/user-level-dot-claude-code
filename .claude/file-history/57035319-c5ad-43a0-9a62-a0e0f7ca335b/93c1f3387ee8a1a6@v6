                        "sitoWebPunti", "impresaFemminilePunti", "impresaGiovanilePunti",
                        "impresaSostenibilePunti", "coerenzaPunti"
                    };

                    for (String campoTotale : campiTotale) {
                        if (nodeInfoAutovalutazione.has(campoTotale) && !nodeInfoAutovalutazione.get(campoTotale).isNull()) {
                            String valore = nodeInfoAutovalutazione.get(campoTotale).asText();
                            if (Validator.isNotNull(valore)) {
                                DomandaBandoDatoAggiuntivo dato = domandaBandoDatoAggiuntivoLocalService
                                        .createDomandaBandoDatoAggiuntivo(counterLocalService.increment());
                                dato.setChiave(DatoAggiuntivoChiave.PUNTEGGIO_AUTOVALUTAZIONE.name());
                                dato.setValore(valore);
                                dato.setDomandaBandoId(domandaBandoAutovalutazione.getDomandaBandoId());
                                dato.setCompanyId(domandaBandoAutovalutazione.getCompanyId());
                                dato.setUserId(domandaBandoAutovalutazione.getUserId());
                                dato.setUserName(domandaBandoAutovalutazione.getUserName());
                                dato.setGroupId(domandaBandoAutovalutazione.getGroupId());
                                domandaBandoDatoAggiuntivoLocalService.addDomandaBandoDatoAggiuntivo(dato);

                            }
                        }
                    }

                    if(Validator.isNotNull(pathTotalePunti)){
                        RequisitoDomandaBando requisitoDomandaBando = requisitoDomandaBandoLocalService.getRequisitoDomandaBandoByBandoIdAndCodice(domandaBandoAutovalutazione.getBandoId(), pathTotalePunti);
                        if(Validator.isNotNull(requisitoDomandaBando)){
                            List<RequisitoDomandaBando> requisitoDomandaBandos = new ArrayList<>();
                            requisitoDomandaBandos.add(requisitoDomandaBando);
                            List<ErroreValidazioneDTO> erroreValidazioneDTOList = validaDomandaBandoService.validaForm(jsonForm, domandaBandoAutovalutazione.getBandoId(), Locale.ITALIAN, requisitoDomandaBandos);

                            if(ListUtil.isNotNull(erroreValidazioneDTOList) && ListUtil.isNotEmpty(erroreValidazioneDTOList)){
                                DomandaBandoDatoAggiuntivo dato = domandaBandoDatoAggiuntivoLocalService
                                        .createDomandaBandoDatoAggiuntivo(counterLocalService.increment());
                                dato.setChiave(DatoAggiuntivoChiave.CHIUSURA_NEGATIVA_AUTOMATICA.name());
                                dato.setValore(Boolean.TRUE.toString());
                                dato.setDomandaBandoId(domandaBandoAutovalutazione.getDomandaBandoId());
                                dato.setCompanyId(domandaBandoAutovalutazione.getCompanyId());
                                dato.setUserId(domandaBandoAutovalutazione.getUserId());
                                dato.setUserName(domandaBandoAutovalutazione.getUserName());
                                dato.setGroupId(domandaBandoAutovalutazione.getGroupId());
                                domandaBandoDatoAggiuntivoLocalService.addDomandaBandoDatoAggiuntivo(dato);

                                Bando bandoChiusura = null;
                                try {
                                    bandoChiusura = bandoLocalService.getBando(domandaBandoAutovalutazione.getBandoId());
