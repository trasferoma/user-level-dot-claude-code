                "CF_LEGALE_RAPPRESENTANTE",
                "DATA_NASCITA_LEGALE_RAPPRESENTANTE",
                "LUOGO_NASCITA_LEGALE_RAPPRESENTANTE",
                "CIVICO_SEDE_LEGALE_ENTE",
                "INDIRIZZO_SEDE_LEGALE_ENTE",
                "CITTA_SEDE_LEGALE",
                "PROVINCIA_SEDE_LEGALE_ENTE",
                "CAP_SEDE_LEGALE",
                "PEC_RICHIEDENTE",
                "DENOMINAZIONE_ENTE_CAPOFILA",
                "CODICE_FISCALE_ENTE",
                "NOME_RICHIEDENTE",
                "COGNOME_RICHIEDENTE",
                "CF_RICHIEDENTE",
                "DATA_NASCITA_RICHIEDENTE",
                "LUOGO_NASCITA_RICHIEDENTE"
        );

        List<DomandaBandoDatoAggiuntivo> datiAggiuntiviDomandaBando = domandaBandoDatoAggiuntivoLocalService
                .getDomandaBandoDatoAggiuntivoByDomandaBandoIdAndChiave(
                        Collections.singletonList(domandaBando.getDomandaBandoId()),
                        chiaviEnum
                );

        Map<String, String> datiAggiuntiviMap = new HashMap<>();
        for (DomandaBandoDatoAggiuntivo datoAggiuntivo : datiAggiuntiviDomandaBando) {
            if (Validator.isNotNull(datoAggiuntivo.getChiave()) &&
                    Validator.isNotNull(datoAggiuntivo.getValore())) {
                datiAggiuntiviMap.put(datoAggiuntivo.getChiave(), datoAggiuntivo.getValore());
            }
        }

        boolean isSoggettoDelegato = datiAggiuntiviMap.containsKey("NOME_LEGALE_RAPPRESENTANTE") ||
                datiAggiuntiviMap.containsKey("COGNOME_LEGALE_RAPPRESENTANTE") ||
                datiAggiuntiviMap.containsKey("CF_LEGALE_RAPPRESENTANTE");

        Map<String, String> mappaChiaviFieldArtistiNeiTerritori = Map.ofEntries(
                Map.entry("DENOMINAZIONE_ENTE_CAPOFILA", "denominazioneEnte"),
                Map.entry("CITTA_SEDE_LEGALE", "comuneSedeLegaleEnte"),
                Map.entry("PROVINCIA_SEDE_LEGALE_ENTE", "provinciaSedeLegaleEnte"),
                Map.entry("INDIRIZZO_SEDE_LEGALE_ENTE", "viaSedeLegaleEnte"),
                Map.entry("CIVICO_SEDE_LEGALE_ENTE", "numeroCivicoSedeLegaleEnte"),
                Map.entry("CAP_SEDE_LEGALE", "capSedeLegaleEnte"),
                Map.entry("CODICE_FISCALE_ENTE", "codiceFiscaleEnte"),
                Map.entry("PEC_RICHIEDENTE", "pecEnte")
        );

        List<String> fieldNamesDataContainer = AlpacaUtil.getAllFieldNameDataContainer(
                optionsStr,
                typesDatiArtistiNeiTerritori
        );

        if (fieldNamesDataContainer != null) {
            for (String fieldNameDataContainer : fieldNamesDataContainer) {
                JsonObject fieldDataContainer = alpacaJsonData.getAsJsonObject(fieldNameDataContainer);

                if (fieldDataContainer != null) {

                    for (Map.Entry<String, String> entry : mappaChiaviFieldArtistiNeiTerritori.entrySet()) {
                        String chiave = entry.getKey();
                        String campo = entry.getValue();
                        if (datiAggiuntiviMap.containsKey(chiave)) {
                            fieldDataContainer.addProperty(campo, datiAggiuntiviMap.get(chiave));
                        }
                    }

                    if (isSoggettoDelegato) {
                        String nome = datiAggiuntiviMap.getOrDefault("NOME_LEGALE_RAPPRESENTANTE", "");
                        String cognome = datiAggiuntiviMap.getOrDefault("COGNOME_LEGALE_RAPPRESENTANTE", "");
                        fieldDataContainer.addProperty("nomeCognomeRichiedente", (nome + " " + cognome).trim());

                        if (datiAggiuntiviMap.containsKey("CF_LEGALE_RAPPRESENTANTE")) {
                            fieldDataContainer.addProperty("codiceFiscaleRichiedente", datiAggiuntiviMap.get("CF_LEGALE_RAPPRESENTANTE"));
                        }
                        if (datiAggiuntiviMap.containsKey("DATA_NASCITA_LEGALE_RAPPRESENTANTE")) {
                            fieldDataContainer.addProperty("dataDiNascitaRichiedente", datiAggiuntiviMap.get("DATA_NASCITA_LEGALE_RAPPRESENTANTE"));
                        }
                        if (datiAggiuntiviMap.containsKey("LUOGO_NASCITA_LEGALE_RAPPRESENTANTE")) {
                            fieldDataContainer.addProperty("luogoDiNascitaRichiedente", datiAggiuntiviMap.get("LUOGO_NASCITA_LEGALE_RAPPRESENTANTE"));
                        }
                    } else {
                        String nome = datiAggiuntiviMap.getOrDefault("NOME_RICHIEDENTE", "");
                        String cognome = datiAggiuntiviMap.getOrDefault("COGNOME_RICHIEDENTE", "");
                        fieldDataContainer.addProperty("nomeCognomeRichiedente", (nome + " " + cognome).trim());

                        if (datiAggiuntiviMap.containsKey("CF_RICHIEDENTE")) {
                            fieldDataContainer.addProperty("codiceFiscaleRichiedente", datiAggiuntiviMap.get("CF_RICHIEDENTE"));
                        }
                        if (datiAggiuntiviMap.containsKey("DATA_NASCITA_RICHIEDENTE")) {
                            fieldDataContainer.addProperty("dataDiNascitaRichiedente", datiAggiuntiviMap.get("DATA_NASCITA_RICHIEDENTE"));
                        }
                        if (datiAggiuntiviMap.containsKey("LUOGO_NASCITA_RICHIEDENTE")) {
                            fieldDataContainer.addProperty("luogoDiNascitaRichiedente", datiAggiuntiviMap.get("LUOGO_NASCITA_RICHIEDENTE"));
                        }
                    }

                    if (Validator.isNotNull(domandaBando.getTitoloProgetto())) {
                        fieldDataContainer.addProperty("titoloProgettoTriennale", domandaBando.getTitoloProgetto());
                    }

                    if (datiAggiuntiviMap.containsKey("PROVINCIA_SEDE_LEGALE_ENTE")) {
                        String codiceProvincia = datiAggiuntiviMap.get("PROVINCIA_SEDE_LEGALE_ENTE");
                        try {
                            Provincia provincia = provinciaLocalService.getProvinciaBySigla(codiceProvincia);
                            if (provincia != null) {
                                fieldDataContainer.addProperty("provinciaSedeLegaleEnte", provincia.getDenominazioneProvincia());
                            }
                        } catch (Exception e) {
                            _log.error("Errore nel recupero della provincia con codice: " + codiceProvincia, e);
                            fieldDataContainer.addProperty("provinciaSedeLegaleEnte", codiceProvincia);
                        }
                    }

                    alpacaJsonData.add(fieldNameDataContainer, fieldDataContainer);
                }
            }
        }

        return alpacaJsonData;
    }

    public JsonObject enrichCompilaDisciplinare(JsonObject alpacaJsonData, AlpacaJsonOptionsStructure optionsStr,
                                                DomandaBando domandaBando, JsonObject dataFormPrincipale, String tipoModulo) {

        JsonObject datiAnagrafici = dataFormPrincipale.getAsJsonObject("datiAnagrafici");

        String rappresentantwLegale = "";

        if (datiAnagrafici != null) {
            if (datiAnagrafici.has("nome")) {
                rappresentantwLegale = datiAnagrafici.get("nome").getAsString();
            }
            if (datiAnagrafici.has("cognome")) {
                if (rappresentantwLegale.equals("")) {
                    rappresentantwLegale = datiAnagrafici.get("cognome").getAsString();
                } else {
                    rappresentantwLegale += " " + datiAnagrafici.get("cognome").getAsString();
                }
            }
        }

        JsonObject registroImprese = dataFormPrincipale.getAsJsonObject("registroImprese");
        JsonObject privato = null;
        if (registroImprese != null) {
            String tipoSoggetto = "";
            if (registroImprese.has("tipoSoggetto")) {
                tipoSoggetto = registroImprese.get("tipoSoggetto").getAsString();
            }
            if (tipoSoggetto.equalsIgnoreCase("SD")) {
                privato = registroImprese.getAsJsonObject("privatoDelegato");
            } else if (tipoSoggetto.equalsIgnoreCase("LR")) {
                privato = registroImprese.getAsJsonObject("privato");
            }
        }

        String citta = "";
        String via = "";
        String cap = "";

        if (privato != null) {
            if (privato.has("comune")) {
                citta = privato.get("comune").getAsString();
            }
            if (privato.has("viaSedeLegale")) {
                via = privato.get("viaSedeLegale").getAsString();
            }
            if (privato.has("civicoSedeLegale")) {
                if (via != "") {
                    via += ", " + privato.get("civicoSedeLegale").getAsString();
                } else {
                    via = privato.get("civicoSedeLegale").getAsString();
                }
            }
            if (privato.has("cap")) {
                cap = privato.get("cap").getAsString();
            }
        }

        String[] tipiDisciplinare = typesCompilaDisciplinareBandi;

        List<String> fieldNamesDataContainer = AlpacaUtil.getAllFieldNameDataContainer(optionsStr,
                tipiDisciplinare);
        if (fieldNamesDataContainer != null) {
            for (String fieldNameDataContainer : fieldNamesDataContainer) {
                JsonObject fieldDataContainer = alpacaJsonData.getAsJsonObject(fieldNameDataContainer);
                if (fieldDataContainer != null) {
                    String soggettoBeneficiario = domandaBando.getRagioneSociale();
                    fieldDataContainer.addProperty("soggettoBeneficiario", soggettoBeneficiario);

                    fieldDataContainer.addProperty("via", via);

                    fieldDataContainer.addProperty("cap", cap);

                    fieldDataContainer.addProperty("citta", citta);

                    String codiceFiscale = domandaBando.getCodiceFiscale();
                    fieldDataContainer.addProperty("codiceFiscale", codiceFiscale);

                    String partitaIva = domandaBando.getPartitaIva();
                    fieldDataContainer.addProperty("partitaIva", partitaIva);

                    fieldDataContainer.addProperty("rappresentanteLegale", rappresentantwLegale);

                    String titoloProgetto = domandaBando.getTitoloProgetto();
                    fieldDataContainer.addProperty("titoloProgetto", titoloProgetto);

                    alpacaJsonData.add(fieldNameDataContainer, fieldDataContainer);
                }
            }
        }

        List<String> chiaviEnum = Arrays.stream(DatoAggiuntivoChiave.values()).map(Enum::name)
                .collect(Collectors.toList());
        List<DomandaBandoDatoAggiuntivo> datiAggiuntiviDomandaBando = domandaBandoDatoAggiuntivoLocalService
                .getDomandaBandoDatoAggiuntivoByDomandaBandoIdAndChiave(
                        Collections.singletonList(domandaBando.getDomandaBandoId()), chiaviEnum);
        List<String> fieldNamesDatiDomandaBandoDataContainer = AlpacaUtil.getAllFieldNameDataContainer(optionsStr,
                typesCompilaDatiDomandaBando);
        if (fieldNamesDatiDomandaBandoDataContainer != null) {
            for (String fieldNameDataContainer : fieldNamesDatiDomandaBandoDataContainer) {
                JsonObject fieldDataContainer = alpacaJsonData.getAsJsonObject(fieldNameDataContainer);
                if (fieldDataContainer != null) {

                    SimpleDateFormat simpleDateFormat = new SimpleDateFormat("dd/MM/yyyy");

                    fieldDataContainer.addProperty("idRichiesta", String.valueOf(domandaBando.getDomandaBandoId()));

                    fieldDataContainer.addProperty("dataInvioDomanda",
                            simpleDateFormat.format(domandaBando.getDataArrivo()));

                    fieldDataContainer.addProperty("numeroProtocolloDomanda",
                            String.valueOf(domandaBando.getNumeroProtocolloEsteso()));

                    fieldDataContainer.addProperty("dataProtocolloDomanda",
                            simpleDateFormat.format(domandaBando.getDataProtocollo()));

                    fieldDataContainer.addProperty("denominazioneEnte", domandaBando.getRagioneSociale());

                    fieldDataContainer.addProperty("partitaIva", domandaBando.getPartitaIva());

                    fieldDataContainer.addProperty("titoloProgetto", domandaBando.getTitoloProgetto());

                    fieldDataContainer.addProperty("importoAssegnato", domandaBando.getImportoAssegnato());

                    fieldDataContainer.addProperty("nomeCognomeRichiedente", domandaBando.getUserName());

                    Map<String, String> mappaChiaviField = Map.ofEntries(
                            Map.entry(DatoAggiuntivoChiave.CF_ENTE.name(), "codiceFiscale"),
                            Map.entry(DatoAggiuntivoChiave.TITOLO_PROGRAMMA_TRIENNALE.name(),
                                    "titoloProgrammazioneTriennale"),
                            Map.entry(DatoAggiuntivoChiave.INDIRIZZO_SEDE_LEGALE_ENTE.name(),
                                    "indirizzoSedeLegaleEnte"),
                            Map.entry(DatoAggiuntivoChiave.CITTA_SEDE_LEGALE.name(), "cittaSedeLegale"),
                            Map.entry(DatoAggiuntivoChiave.CIVICO_SEDE_LEGALE_ENTE.name(), "civicoSedeLegale"),
                            Map.entry(DatoAggiuntivoChiave.PROVINCIA_SEDE_LEGALE_ENTE.name(),
                                    "provinciaSedeLegaleEnte"),
                            Map.entry(DatoAggiuntivoChiave.CAP_SEDE_LEGALE.name(), "capSedeLegale"));
                    String civico = "";
                    for (DomandaBandoDatoAggiuntivo datoAggiuntivo : datiAggiuntiviDomandaBando) {
                        String chiave = datoAggiuntivo.getChiave();
                        if (Validator.isNotNull(chiave)) {
                            String campo = mappaChiaviField.get(chiave);
                            if (Validator.isNotNull(campo)) {
                                if (chiave.equalsIgnoreCase(DatoAggiuntivoChiave.INDIRIZZO_SEDE_LEGALE_ENTE.name())
                                        && Validator.isNotNull(civico)) {
                                    fieldDataContainer.addProperty(campo, datoAggiuntivo.getValore() + " " + civico);
                                } else if (chiave
                                        .equalsIgnoreCase(DatoAggiuntivoChiave.CIVICO_SEDE_LEGALE_ENTE.name())) {
                                    civico = datoAggiuntivo.getValore();
                                } else {
                                    fieldDataContainer.addProperty(campo, datoAggiuntivo.getValore());
                                }
                            }
                        }
                    }

                    alpacaJsonData.add(fieldNameDataContainer, fieldDataContainer);
                }
            }
        }
        alpacaJsonData = enrichCompilaDisciplinareAntimafia(alpacaJsonData, optionsStr, domandaBando, tipoModulo);

        alpacaJsonData = enrichCompilaDisciplinareCentroDiResidenza(alpacaJsonData, optionsStr, domandaBando, tipoModulo);

        alpacaJsonData = enrichCompilaDisciplinareArtistiNeiTerritori(alpacaJsonData, optionsStr, domandaBando, tipoModulo);

        // TODO MOCK TEMPORANEO - dati concessione non disponibili in locale. Jester
        // Sovrascrive i dati domanda con valori finti, indipendentemente da cosa e' stato recuperato.
        // Rimuovere questa chiamata e il metodo applyMockDatiConcessione per ripristinare i dati reali.
        applyMockDatiConcessione(alpacaJsonData, optionsStr);

        return alpacaJsonData;
    }

