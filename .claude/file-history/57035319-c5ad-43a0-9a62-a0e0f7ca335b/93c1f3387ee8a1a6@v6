    public JsonObject enrichFormBandi(User profiloUtenteCittadino, JsonObject alpacaJsonData,
                                      AlpacaJsonOptionsStructure optionsStr, UserPreferences userPreferences, String partitaIvaCodiceFiscale,
                                      Bando bando) throws AnagraficaUnicaException {
        String codiceFiscaleServizio = userPreferences.getCodiceFiscaleRichiedente();
        List<String> fieldNamesDataContainer = AlpacaUtil.getAllFieldNameDataContainer(optionsStr, types);
        if (fieldNamesDataContainer != null && codiceFiscaleServizio.equals(profiloUtenteCittadino.getScreenName())) {
            for (String fieldNameDataContainer : fieldNamesDataContainer) {
                JsonObject fieldDataContainer = alpacaJsonData.getAsJsonObject(fieldNameDataContainer);
                Set<Option> jsonPathOptions = new HashSet<Option>();
                jsonPathOptions.add(Option.SUPPRESS_EXCEPTIONS);
                jsonPathOptions.add(Option.ALWAYS_RETURN_LIST);

                Configuration jsonPathConfiguration = Configuration.builder()
                        .jsonProvider(new JacksonJsonNodeJsonProvider()).mappingProvider(new JacksonMappingProvider())
                        .options(jsonPathOptions).build();

                JsonObject fieldValuesOptions = optionsStr.getFields().get(fieldNameDataContainer).getAsJsonObject();
                boolean datiReadOnly = false;
                String customType = null;
                if (fieldValuesOptions.has("type")) {
                    customType = fieldValuesOptions.get("type").getAsString();
                }
                if (Validator.isNotNull(fieldValuesOptions)) {
                    if (Validator.isNotNull(fieldValuesOptions.has("fields"))) {
                        JsonObject options = fieldValuesOptions.get("fields").getAsJsonObject();
                        if (options.has("configurazione")) {
                            JsonObject configurazione = options.get("configurazione").getAsJsonObject();
                            if (Validator.isNotNull(configurazione) && configurazione.has("datiReadOnly")) {
                                datiReadOnly = configurazione.get("datiReadOnly").getAsBoolean();
                            }
                        }
                    }
                }

                if (Validator.isNotNull(customType)) {
                    if (!customType.equalsIgnoreCase("datiAnagraficiConfigurabile")) {
                        datiReadOnly = true;
                    }
                } else {
                    datiReadOnly = true;
                }

                if (Validator.isNotNull(fieldDataContainer) && datiReadOnly) {

                    // Delegato
                    fieldDataContainer.addProperty("isDelegato", false);
                    // Nome
                    String nome = profiloUtenteCittadino.getFirstName();
                    fieldDataContainer.addProperty("nome", nome);
                    // Cognome
                    String cognome = profiloUtenteCittadino.getLastName();
                    fieldDataContainer.addProperty("cognome", cognome);
                    // Codice Fiscale
                    String codiceFiscale = profiloUtenteCittadino.getScreenName().toUpperCase();
                    fieldDataContainer.addProperty("codiceFiscale", codiceFiscale);
                    fieldDataContainer.addProperty("codicefiscale", codiceFiscale);

                    // Sesso
                    SPIDAttributes spidAttributes = utenteUtility.getSPIDAttributes(
                            profiloUtenteCittadino.getCompanyId(), profiloUtenteCittadino.getScreenName());
                    String sesso = spidAttributes.getGender();

                    if (Validator.isNull(sesso) && codiceFiscale != null) {
                        // Calcolo da CF
                        int giornoNascita = Integer.parseInt(codiceFiscale.substring(9, 10));
                        if (giornoNascita > 40) {
                            sesso = "F";
                        } else {
                            sesso = "M";
                        }
                    }

                    if (sesso != null) {
                        fieldDataContainer.addProperty("sesso", sesso);
                    }

                    // Data nascita
                    SimpleDateFormat simpleDateFormat = new SimpleDateFormat("dd/MM/yyyy");
                    try {
                        Date dataNascita = spidAttributes.getDateOfBirth();
                        if (dataNascita != null) {
                            fieldDataContainer.addProperty("dataNascita", simpleDateFormat.format(dataNascita));
                            fieldDataContainer.addProperty("datanascita", simpleDateFormat.format(dataNascita));
                        }
                    } catch (SystemException e) {
                        log.error("enrich :: " + e.getMessage(), e);
                    }

                    // Comune nascita
                    String luogoNascita = "";
                    if (spidAttributes != null) {
                        luogoNascita = spidAttributes.getPlaceOfBirth();
                    }

                    if (!Validator.isNull(luogoNascita)) {
                        Comune comuneNascita = comuneLocalService.getComuneByDenominazione(luogoNascita);
                        if (comuneNascita == null) {
                            // Da SPID potrebbe ritornare il codice catastale...
                            comuneNascita = comuneLocalService.getComuneByCodiceCatastale(luogoNascita);
                        }
                        if (comuneNascita != null) {
                            fieldDataContainer.addProperty("codiceIstatComuneNascitaHidden",
                                    comuneNascita.getCodiceIstatAN());
                            luogoNascita = comuneNascita.getDenominazione();
                            Provincia provincia = comuneNascita.getProvincia();
                            if (provincia != null) {
                                fieldDataContainer.addProperty("siglaProvinciaNascitaHidden", provincia.getSigla());
                                luogoNascita = luogoNascita + " (" + provincia.getSigla() + ")";
                            }
                        }
                        // Comune estero di nasciata (codice catastale)
                        else {
                            StatoEstero statoEsteroByCodiceAT = statoEsteroLocalService
                                    .getStatoEsteroByCodiceAT(luogoNascita);
                            if (statoEsteroByCodiceAT != null) {
                                luogoNascita = statoEsteroByCodiceAT.getDenominazioneIt();
                            }
                        }
                    }

                    fieldDataContainer.addProperty("luogoNascita", luogoNascita);

                    String indirizzoResidenza = (String) profiloUtenteCittadino.getExpandoBridge()
                            .getAttribute(UserCustomAttributes.SPID_ADDRESS.getNomeAttributo());
                    if (Validator.isNotNull(indirizzoResidenza)) {
                        fieldDataContainer.addProperty("indirizzoResidenza", indirizzoResidenza);
                    }

                    alpacaJsonData.add(fieldNameDataContainer, fieldDataContainer);
                }
            }
            // Salvo

        }

        if (Validator.isNotNull(bando)) {
            if (Validator.isNotNull(bando.getNome())) {
                List<String> titoloFormDataContainer = AlpacaUtil.getAllFieldNameDataContainer(optionsStr, titoloFormTypes);
                if (Validator.isNotNull(titoloFormDataContainer) && !titoloFormDataContainer.isEmpty()) {
                    for (String field : titoloFormDataContainer) {
                        JsonObject fieldDataContainer = alpacaJsonData.getAsJsonObject(field);
                        if (Validator.isNotNull(fieldDataContainer)) {
                            fieldDataContainer.addProperty("titolo", bando.getNome());
                        }
                    }
                }
            }


            if (Validator.isNotNull(partitaIvaCodiceFiscale) && bando.isObbligoAccreditamentoEnte()) {
                List<String> province = new ArrayList<>();
                province.add("FG");
                province.add("BA");
                province.add("TA");
                province.add("BR");
                province.add("LE");
                province.add("BT");
                EnteDto enteDto = getDatiAccreditamentoEnte(partitaIvaCodiceFiscale, profiloUtenteCittadino.getScreenName(),
                        province);
                if (Validator.isNotNull(enteDto)) {
                    // DATI ENTE
                    datiEnteEnrich(optionsStr, enteDto, alpacaJsonData);
                    datiEnteMarketingEnrich(optionsStr, enteDto, alpacaJsonData);
                    datiIdentificativiEnteAccreditamentoEnrich(optionsStr, enteDto, alpacaJsonData);
                    // COMPANY PROFILE
                    companyProfileEnrich(optionsStr, enteDto, alpacaJsonData);

                    // COMPANY PROFILE
                    configurazioneAccreditamentoEnrich(optionsStr, enteDto, alpacaJsonData, profiloUtenteCittadino);

                    sedeEnteEnrich(optionsStr, partitaIvaCodiceFiscale, alpacaJsonData);

                    datiBrochureEnrich(optionsStr, enteDto, alpacaJsonData, partitaIvaCodiceFiscale);
                }
            }

            //Enrich per anagrafeUnica
            if (Validator.isNotNull(partitaIvaCodiceFiscale) && bando.isAbilitaAnagraficaUnica()) {
                DatiSoggettoDto datiAnagraficaUnica = getDatiAnagraficaUnica(partitaIvaCodiceFiscale, bando.getGroupId(), bando);
                tipologiaEnteEnrich(optionsStr, alpacaJsonData, datiAnagraficaUnica.getTipologie());
                datiEnteAnagraficaEnrich(optionsStr, datiAnagraficaUnica, alpacaJsonData);
                datiEnteSedeLegaleAnagraficaEnrich(optionsStr, datiAnagraficaUnica, alpacaJsonData);
            	
            }
        }


        return alpacaJsonData;
    }

    private void datiEnteSedeLegaleAnagraficaEnrich(AlpacaJsonOptionsStructure optionsStr, DatiSoggettoDto datiAnagraficaUnica, JsonObject alpacaJsonData) {
        List<String> datiEnteDataContainer = AlpacaUtil.getAllFieldNameDataContainer(optionsStr, customRegistroImpreseSedeLegaleAnagraficaUnica);
        if (Validator.isNotNull(datiEnteDataContainer)) {
            for (String field : datiEnteDataContainer) {
                JsonObject fieldDataContainer = alpacaJsonData.getAsJsonObject(field);
                JsonObject fieldDataContainerPrivato = fieldDataContainer.getAsJsonObject("privato");
                if (Validator.isNotNull(fieldDataContainerPrivato)) {
                    if (Validator.isNotNull(datiAnagraficaUnica) && Validator.isNotNull(datiAnagraficaUnica.getRestResponse()) && Validator.isNotNull(datiAnagraficaUnica.getRestResponse().getData())) {
                        Gson gson = new Gson();
                        if (ListUtil.isNotNull(datiAnagraficaUnica.getTipologie()) && ListUtil.isNotEmpty(datiAnagraficaUnica.getTipologie())) {
                            if (datiAnagraficaUnica.getTipologie().contains(TipologiaEnteBando.IMPRESA.name())) {
                                JsonObject data = gson.toJsonTree(datiAnagraficaUnica.getRestResponse().getData()).getAsJsonObject();
                                if (Validator.isNotNull(data)) {

                                    if (data.has("dati-identificativi")) {
                                        JsonObject datiIdentificativi = data.get("dati-identificativi").getAsJsonObject();
                                        if (datiIdentificativi.has("denominazione")) {
                                            fieldDataContainerPrivato.addProperty("denominazioneSoggettoOrganizzatore", datiIdentificativi.get("denominazione").getAsString());
                                        }
                                        if (datiIdentificativi.has("indirizzo-posta-certificata")) {
                                            fieldDataContainerPrivato.addProperty("pec", datiIdentificativi.get("indirizzo-posta-certificata").getAsString());
                                        }
                                        if (datiIdentificativi.has("c-fiscale")) {
                                            fieldDataContainerPrivato.addProperty("cfAzienda", datiIdentificativi.get("c-fiscale").getAsString());
                                        }

                                        if (datiIdentificativi.has("indirizzo-localizzazione")) {
                                            JsonObject indirizzoLocalizzazione = datiIdentificativi.get("indirizzo-localizzazione").getAsJsonObject();
                                            if(indirizzoLocalizzazione.has("provincia")) {
                                                fieldDataContainerPrivato.addProperty("provincia", indirizzoLocalizzazione.get("provincia").getAsString());
                                            }
                                            if(indirizzoLocalizzazione.has("comune")) {
                                                fieldDataContainerPrivato.addProperty("comune", indirizzoLocalizzazione.get("comune").getAsString());
                                            }
                                            if(indirizzoLocalizzazione.has("via")) {
                                                fieldDataContainerPrivato.addProperty("viaSedeLegale", indirizzoLocalizzazione.get("via").getAsString());
                                            }
                                            if(indirizzoLocalizzazione.has("n-civico")) {
                                                fieldDataContainerPrivato.addProperty("civicoSedeLegale", indirizzoLocalizzazione.get("n-civico").getAsString());
                                            }
                                            if(indirizzoLocalizzazione.has("cap")) {
                                                fieldDataContainerPrivato.addProperty("cap", indirizzoLocalizzazione.get("cap").getAsString());
                                            }
                                        }
                                    }
                                    alpacaJsonData.add(field, fieldDataContainer);
                                }
                            }
                        }
                    }
                }
            }
        }
    }

