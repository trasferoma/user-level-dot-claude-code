                        String partitaIva = "";
                        String codiceFiscale = "";

                        if (elementoAzienda.has("nomePartner") && !elementoAzienda.get("nomePartner").isNull()) {
                            ragioneSociale = elementoAzienda.get("nomePartner").asText();

                            if (Validator.isNotNull(ragioneSociale)) {
                                azienda.setRagioneSociale(ragioneSociale);
                            }
