    /**
     * Applica la normalizzazione di provincia/comune sul payload JSON raw (response.data)
     * di Anagrafica Unica per i tipi soggetto non-impresa (ente, comune, ente ecclesiastico, ecc.).
     * Legge provincia/comune dal JSON (dati-identificativi.indirizzo-localizzazione), invoca
     * il normalizer e, in caso di correzione, riscrive sigla provincia e c-comune nel JSON
     * prima che il consumer lo utilizzi.
     */
    private void applicaNormalizzazioneLocalitaAUResponse(RestResponse response) {
        if (response == null || response.getData() == null) {
            return;
        }
        try {
            Gson gson = new Gson();
            JsonObject data = gson.toJsonTree(response.getData()).getAsJsonObject();

            if (!data.has("dati-identificativi") || data.get("dati-identificativi").isJsonNull()) {
                return;
            }
            JsonObject datiIdentificativi = data.get("dati-identificativi").getAsJsonObject();
            if (!datiIdentificativi.has("indirizzo-localizzazione") || datiIdentificativi.get("indirizzo-localizzazione").isJsonNull()) {
                return;
            }
            JsonObject indirizzo = datiIdentificativi.get("indirizzo-localizzazione").getAsJsonObject();

            String provincia = indirizzo.has("provincia") && !indirizzo.get("provincia").isJsonNull() ? indirizzo.get("provincia").getAsString() : null;
            String comune = indirizzo.has("comune") && !indirizzo.get("comune").isJsonNull() ? indirizzo.get("comune").getAsString() : null;
            String cComune = indirizzo.has("c-comune") && !indirizzo.get("c-comune").isJsonNull() ? indirizzo.get("c-comune").getAsString() : null;

            if (provincia == null || comune == null || cComune == null) {
                return;
            }

            NormalizedLocalita nl = comuneLocalService.normalizzaLocalita(provincia, comune, cComune);
            if (nl != null && nl.isCorretto()) {
                log.info("Normalizzazione localita' AU (response) applicata: provincia " + provincia + " -> " + nl.getSiglaProvincia() + " per comune " + comune + " c-comune=" + cComune);
                indirizzo.addProperty("provincia", nl.getSiglaProvincia());
                response.setData(data);
            }
        }
        catch (Exception e) {
            log.warn("Errore durante la normalizzazione localita' AU (response), dati originali preservati", e);
        }
    }

