    public void addExtraValidationErrors(List<ErroreValidazioneDTO> listaErroriValidazione, long groupId,
                                         String portalURL, long formId, String alpacaFormData, long bandoId, Locale locale) throws PortalException {

        if (Validator.isNotNull(alpacaFormData)) {
            Set<Option> jsonPathOptions = new HashSet<Option>();
            jsonPathOptions.add(Option.SUPPRESS_EXCEPTIONS);
            jsonPathOptions.add(Option.ALWAYS_RETURN_LIST);

            Configuration jsonPathConfiguration = Configuration.builder()
                    .jsonProvider(new JacksonJsonNodeJsonProvider()).mappingProvider(new JacksonMappingProvider())
                    .options(jsonPathOptions).build();
            String cap = "";
            String pIva = "";
            String cfAzienda = "";
            String stepTitle = "";
            String stepDescription = "";

            List<String> listaCampiRegistroImpresaConfigurabile = getNomeCampoByType(alpacaFormData, portalURL,
                    typesCustomRegistroImpreseConfigurabile, formId);
            JsonNode fieldValues = null;
            if (Validator.isNotNull(listaCampiRegistroImpresaConfigurabile)
                    && !listaCampiRegistroImpresaConfigurabile.isEmpty()) {
                for (String campo : listaCampiRegistroImpresaConfigurabile) {
                    String pathCampo = "['" + campo + "']";
                    JsonNode fieldValuesOptions = JsonPath.using(jsonPathConfiguration).parse(alpacaFormData)
                            .read(ALPACA_ALPACA_FIELD + ALPACA_OPTIONS_FIELD + ALPACA_FIELDS_FIELD + pathCampo);

                    JsonNode fieldValuesBindings = JsonPath.using(jsonPathConfiguration).parse(alpacaFormData)
                            .read(ALPACA_ALPACA_FIELD + ALPACA_VIEW_FIELD + ALPACA_WIZARD_FIELD + ALPACA_BINDINGS_FIELD
                                    + pathCampo);

                    JsonNode fieldValuesSteps = JsonPath.using(jsonPathConfiguration).parse(alpacaFormData)
                            .read(ALPACA_ALPACA_FIELD + ALPACA_VIEW_FIELD + ALPACA_WIZARD_FIELD + ALPACA_STEPS_FIELD);

                    if (Validator.isNotNull(fieldValuesOptions) && !fieldValuesOptions.isEmpty()) {
                        JsonNode options = fieldValuesOptions.get(0);
                        if (options.has("fieldClass")) {
                            String fieldClass = options.get("fieldClass").asText();
                            if (Validator.isNotNull(fieldClass) && fieldClass.contains("soggettoDelegante")) {
                                if (Validator.isNotNull(fieldValuesBindings) && !fieldValuesBindings.isEmpty()) {
                                    int stepNumber = fieldValuesBindings.get(0).asInt();
                                    if (Validator.isNotNull(stepNumber)) {
                                        if (Validator.isNotNull(fieldValuesSteps) && !fieldValuesSteps.isEmpty()) {
                                            int actualStepNumber = stepNumber - 1;
                                            for (int i = 0; i < fieldValuesSteps.get(0).size(); i++) {
                                                if (actualStepNumber == i) {
                                                    stepTitle = fieldValuesSteps.get(0).get(i).get("title").asText();
                                                    stepDescription = fieldValuesSteps.get(0).get(i).get("description")
                                                            .asText();
                                                }
                                            }
                                        }
                                    }
                                }
                                fieldValues = JsonPath.using(jsonPathConfiguration).parse(alpacaFormData)
                                        .read(ALPACA_ALPACA_FIELD + ALPACA_DATA_FIELD + pathCampo);
                                break;
                            }
                        }
                    }

                }
            }

            if (Validator.isNotNull(fieldValues) && !fieldValues.isEmpty()) {
                JsonNode nodeInfo = fieldValues.get(0);

                if (nodeInfo != null && !nodeInfo.isEmpty()) {

                    JsonNode nodeInterno = nodeInfo.get("privato");

                    if (Validator.isNotNull(nodeInterno)) {

                        if (nodeInterno.has("cap") && !nodeInterno.get("cap").isNull()) {
                            cap = nodeInterno.get("cap").asText();
                        }

                        if (nodeInterno.has("pIva") && !nodeInterno.get("pIva").isNull()) {
                            pIva = nodeInterno.get("pIva").asText();
                        }

                        if (nodeInterno.has("cfAzienda") && !nodeInterno.get("cfAzienda").isNull()) {
                            cfAzienda = nodeInterno.get("cfAzienda").asText();
                        }

                        JsonNode fieldValuesBindings = null;
                        JsonNode fieldValuesSteps = null;

                        if (Validator.isNotNull(cap)) {
                            List<String> listaCampiSedeOperativa = new ArrayList<String>();
                            listaCampiSedeOperativa = getNomeCampoByType(alpacaFormData, portalURL,
                                    typesCustomSedeOperativa, formId);
                            JsonNode fieldValuesSedeOperativa = null;
                            if (Validator.isNotNull(listaCampiSedeOperativa) && !listaCampiSedeOperativa.isEmpty()) {
                                for (String campo : listaCampiSedeOperativa) {
                                    String pathCampo = "['" + campo + "']";
                                    fieldValuesSedeOperativa = JsonPath.using(jsonPathConfiguration)
                                            .parse(alpacaFormData)
                                            .read(ALPACA_ALPACA_FIELD + ALPACA_DATA_FIELD + pathCampo);
                                    fieldValuesBindings = JsonPath.using(jsonPathConfiguration).parse(alpacaFormData)
                                            .read(ALPACA_ALPACA_FIELD + ALPACA_VIEW_FIELD + ALPACA_WIZARD_FIELD
                                                    + ALPACA_BINDINGS_FIELD + pathCampo);

                                    fieldValuesSteps = JsonPath.using(jsonPathConfiguration).parse(alpacaFormData)
                                            .read(ALPACA_ALPACA_FIELD + ALPACA_VIEW_FIELD + ALPACA_WIZARD_FIELD
                                                    + ALPACA_STEPS_FIELD);
                                }
                            }

                            if (Validator.isNotNull(fieldValuesSedeOperativa) && !fieldValuesSedeOperativa.isEmpty()) {
                                JsonNode nodeInfoSO = fieldValuesSedeOperativa.get(0);
                                if (Validator.isNotNull(nodeInfoSO) && !nodeInfoSO.isEmpty()) {
                                    if (nodeInfoSO.has("capOperativa") && !nodeInfoSO.get("capOperativa").isNull()) {
                                        if (Validator.isNotNull(fieldValuesBindings)
                                                && !fieldValuesBindings.isEmpty()) {
                                            int stepNumber = fieldValuesBindings.get(0).asInt();
                                            if (Validator.isNotNull(stepNumber)) {
                                                if (Validator.isNotNull(fieldValuesSteps)
                                                        && !fieldValuesSteps.isEmpty()) {
                                                    int actualStepNumber = stepNumber - 1;
                                                    for (int i = 0; i < fieldValuesSteps.get(0).size(); i++) {
                                                        if (actualStepNumber == i) {
                                                            stepTitle = fieldValuesSteps.get(0).get(i).get("title")
                                                                    .asText();
                                                            stepDescription = fieldValuesSteps.get(0).get(i)
                                                                    .get("description").asText();
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        cap = nodeInfoSO.get("capOperativa").asText();
                                    }
                                }
                            }
                        }
                    }
                }

                if (Validator.isNotNull(cap) && Validator.isNotNull(pIva)) {
                    List<String> statiToExclude = new ArrayList<String>();
                    statiToExclude.add(StatoDomandaBandoEnum.BOZZA.name());
                    statiToExclude.add(StatoDomandaBandoEnum.ANNULLATA.name());
                    statiToExclude.add(StatoDomandaBandoEnum.CHIUSA_NEGATIVAMENTE.name());
                    statiToExclude.add(StatoDomandaBandoEnum.CHIUSA_POSITIVAMENTE.name());
                    long countByCapAndBandoId = domandaBandoLocalService
                            .countAziendeNonAssociateByCapAndPIvaAndBandoIdAndNotStato(cap, bandoId, pIva,
                                    statiToExclude);
                    if (countByCapAndBandoId > 0) {
                        ResourceBundleLoader resourceBundleLoader = ResourceBundleLoaderUtil
                                .getResourceBundleLoaderByBundleSymbolicName(
                                        GestioneBandiCommonConstants.PRESENTATORE_FORM_BUNDLE_SYMBOLIC_NAME);
                        ResourceBundle resourceBundle = resourceBundleLoader.loadResourceBundle(locale);

                        ErroreValidazioneDTO erroreValidazioneDTO = new ErroreValidazioneDTO();
                        erroreValidazioneDTO.setCampo("P.IVA - C.A.P.");
                        erroreValidazioneDTO.setObbligatorio(true);
                        erroreValidazioneDTO.setDescrizione(
                                ResourceBundleUtil.getString(resourceBundle, "errore.validazione.form.cap.piva"));
                        erroreValidazioneDTO.setStepTitle(stepTitle);
                        erroreValidazioneDTO.setStepDescription(stepDescription);
                        listaErroriValidazione.add(erroreValidazioneDTO);
                    }
                }

                if (Validator.isNotNull(cap) && Validator.isNotNull(pIva)) {
                    String riconoscimentoRichiesto = getRiconoscimentoRichiesto(alpacaFormData);

                    long count = attivitaStoricaLocalService.countByAttivitaStoricheByAndCapAndPIvaAndRiconoscimento(cap, pIva, riconoscimentoRichiesto);
                    boolean valid = count == 0;

                    if (!valid) {
                        ResourceBundleLoader resourceBundleLoader = ResourceBundleLoaderUtil
                                .getResourceBundleLoaderByBundleSymbolicName(
                                        GestioneBandiCommonConstants.PRESENTATORE_FORM_BUNDLE_SYMBOLIC_NAME);
                        ResourceBundle resourceBundle = resourceBundleLoader.loadResourceBundle(locale);

                        ErroreValidazioneDTO erroreValidazioneDTO = new ErroreValidazioneDTO();
                        erroreValidazioneDTO.setCampo("P.IVA - C.A.P.");
                        erroreValidazioneDTO.setObbligatorio(true);
                        erroreValidazioneDTO.setDescrizione(
                                ResourceBundleUtil.getString(resourceBundle, "errore.validazione.form.cap.piva.insegna"));
                        erroreValidazioneDTO.setStepTitle(stepTitle);
                        erroreValidazioneDTO.setStepDescription(stepDescription);
                        listaErroriValidazione.add(erroreValidazioneDTO);
                    }
                }

                // Controllo CF & P.Iva

                if (Validator.isNotNull(pIva)) {
                    String cfRichiedente = "";
                    JsonNode fieldValuesNome = JsonPath.using(jsonPathConfiguration).parse(alpacaFormData)
                            .read(PATH_CF_RAPPRESENTANTE_LEGALE);
                    if (Validator.isNotNull(fieldValuesNome) && !fieldValuesNome.isEmpty()) {
                        if (Validator.isNotNull(fieldValuesNome.get(0).asText())) {
                            cfRichiedente = fieldValuesNome.get(0).asText();
                        }
                    } else {
                        log.error(
                                "Non e' stato possibile recuperare il CF del rappresentante legale associato alla P.IVA :: "
                                        + pIva);
                    }
                    boolean isCfTitolare = false;
                    if (Validator.isNotNull(cfRichiedente)) {
                        DettaglioImpresa dettaglioImpresa = null;

                        try {
                            if (Validator.isNotNull(cfAzienda) && !pIva.equalsIgnoreCase(cfAzienda)) {
                                dettaglioImpresa = this.getDettaglioImpresa(cfAzienda, bandoId, groupId);
                            } else {
                                dettaglioImpresa = this.getDettaglioImpresa(pIva, bandoId, groupId);
                            }
                        } catch (Exception e) {
                            log.error("Errore recupero dati da registro imprese :: ", e);
                            throw new PortalException("Errore durante il recupero dei dati da Registro Imprese");
                        }
                        if (Validator.isNotNull(dettaglioImpresa)) {
                            if (Validator.isNotNull(dettaglioImpresa.getListaCfTitolari())) {
                                List<String> titolari = dettaglioImpresa.getListaCfTitolari();
                                for (String titolare : titolari) {
                                    if (titolare.equalsIgnoreCase(cfRichiedente)) {
                                        isCfTitolare = true;
                                    }
                                }
                            }
                        }
                    }

                    if (!isCfTitolare) {
                        ResourceBundleLoader resourceBundleLoader = ResourceBundleLoaderUtil
                                .getResourceBundleLoaderByBundleSymbolicName(
                                        GestioneBandiCommonConstants.PRESENTATORE_FORM_BUNDLE_SYMBOLIC_NAME);
                        ResourceBundle resourceBundle = resourceBundleLoader.loadResourceBundle(locale);

                        ErroreValidazioneDTO erroreValidazioneDTO = new ErroreValidazioneDTO();
                        erroreValidazioneDTO.setCampo("Cod.Fiscale - P.IVA");
                        erroreValidazioneDTO.setObbligatorio(true);
                        erroreValidazioneDTO.setDescrizione(
                                ResourceBundleUtil.getString(resourceBundle, "errore.validazione.form.cf.piva"));
                        erroreValidazioneDTO.setStepTitle(stepTitle);
                        erroreValidazioneDTO.setStepDescription(stepDescription);
                        listaErroriValidazione.add(erroreValidazioneDTO);
                    }
                }
            }
        }
    }

    private String getRiconoscimentoRichiesto(String alpacaFormData) {
        String riconoscimento = "";

        Set<Option> jsonPathOptions = new HashSet<Option>();
        jsonPathOptions.add(Option.SUPPRESS_EXCEPTIONS);
        jsonPathOptions.add(Option.ALWAYS_RETURN_LIST);

        Configuration jsonPathConfiguration = Configuration.builder()
                .jsonProvider(new JacksonJsonNodeJsonProvider()).mappingProvider(new JacksonMappingProvider())
                .options(jsonPathOptions).build();

        JsonNode fieldValues = null;

        // tipoInsegna possibili valori: NEGOZIO BOTTEGA LOCALE
        String jsonPath = ALPACA_ALPACA_FIELD + ALPACA_DATA_FIELD + "['tipoInsegna']";
        fieldValues = JsonPath.using(jsonPathConfiguration).parse(alpacaFormData).read(jsonPath);
        if (Validator.isNotNull(fieldValues) && Validator.isNotNull(fieldValues.get(0))) {
            String tipoInsegna = fieldValues.get(0).asText();
            if (Validator.isNotNull(tipoInsegna)) {
                switch (tipoInsegna) {
                    case "NEGOZIO": {
                        // "selezioneTipoNegozio" possibili valori: "ATTIVITA", "NEGOZIOSTORICO", "NEGOZIOPATRIMONIO"
                        jsonPath = ALPACA_ALPACA_FIELD + ALPACA_DATA_FIELD + "['selezioneTipoNegozio']";
                        fieldValues = JsonPath.using(jsonPathConfiguration).parse(alpacaFormData).read(jsonPath);
                        if (Validator.isNotNull(fieldValues) && Validator.isNotNull(fieldValues.get(0))) {
                            String selezioneTipoNegozio = fieldValues.get(0).asText();
                            if (Validator.isNotNull(selezioneTipoNegozio)) {
                                // possibili chiavi:
                                // ATTIVITA_ATTIVITA
                                // ATTIVITA_NEGOZIOSTORICO
                                // ATTIVITA_NEGOZIOPATRIMONIO
                                riconoscimento = tipoInsegna + "_" + selezioneTipoNegozio;
                            }
                        }
                    }
                    break;
                    case "BOTTEGA": {
                        // "selezioneTipoBottega" possibili valori: "ATTIVITA", "BOTTEGASTORICA", "BOTTEGAPATRIMONIO"
                        jsonPath = ALPACA_ALPACA_FIELD + ALPACA_DATA_FIELD + "['selezioneTipoBottega']";
                        fieldValues = JsonPath.using(jsonPathConfiguration).parse(alpacaFormData).read(jsonPath);
                        if (Validator.isNotNull(fieldValues) && Validator.isNotNull(fieldValues.get(0))) {
                            String selezioneTipoNegozio = fieldValues.get(0).asText();
                            if (Validator.isNotNull(selezioneTipoNegozio)) {
                                // possibili chiavi:
                                // BOTTEGA_ATTIVITA
                                // BOTTEGA_BOTTEGASTORICA
                                // BOTTEGA_BOTTEGAPATRIMONIO
                                riconoscimento = tipoInsegna + "_" + selezioneTipoNegozio;
                            }
                        }
                    }
                    break;
                    case "LOCALE": {
                        // "selezioneTipoLocale" possibili valori: "ATTIVITA", "LOCALESTORICO", "LOCALEPATRIMONIO"
                        jsonPath = ALPACA_ALPACA_FIELD + ALPACA_DATA_FIELD + "['selezioneTipoLocale']";
                        fieldValues = JsonPath.using(jsonPathConfiguration).parse(alpacaFormData).read(jsonPath);
                        if (Validator.isNotNull(fieldValues) && Validator.isNotNull(fieldValues.get(0))) {
                            String selezioneTipoNegozio = fieldValues.get(0).asText();
                            if (Validator.isNotNull(selezioneTipoNegozio)) {
                                // possibili chiavi:
                                // LOCALE_ATTIVITA
                                // LOCALE_LOCALESTORICO
                                // LOCALE_LOCALEPATRIMONIO
                                riconoscimento = tipoInsegna + "_" + selezioneTipoNegozio;
                            }
                        }
                    }
                    break;
                }
            }
        }
        return riconoscimento;
    }

    public List<DomandaBandoDTO> getDomandeBandoByUserAndStatoInterno(String codiceFiscale, Long bandoId, String stato,
                                                                      int start, int end) {
        List<DomandaBando> domandeBando = domandaBandoLocalService
                .getDomandeBandoByUserAndStatoInterno(codiceFiscale.toUpperCase(), bandoId, stato, start, end);
        List<DomandaBandoDTO> response = new ArrayList<DomandaBandoDTO>();

        if (Validator.isNotNull(domandeBando) && !domandeBando.isEmpty()) {
            response = domandeBando.stream().map(domandaBando -> mapDomandaBando(domandaBando))
                    .collect(Collectors.toList());
        }

        Collections.sort(response, new Comparator<DomandaBandoDTO>() {
            public int compare(DomandaBandoDTO o1, DomandaBandoDTO o2) {
                return o2.getCreateDate().compareTo(o1.getCreateDate());
            }
        });
        return response;
    }

