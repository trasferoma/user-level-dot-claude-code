    public JsonObject enrichNoteFormIntegrativoBandi(JsonObject alpacaJsonData, AlpacaJsonOptionsStructure optionsStr,
                                                     IstanzaDomandaBando istanzaDomandaBando) {
        List<String> fieldNames = AlpacaUtil.getAllFieldNameDataContainer(optionsStr, typesNoteIntegrative);
        List<String> fieldNamesDataContainerOggettoCommento = AlpacaUtil.getAllFieldNameDataContainer(optionsStr, typesNoteIntegrativeOggettoCommento);

        if (istanzaDomandaBando.getCommentoDomandaBandoId() <= 0) {
            return alpacaJsonData;
        }

        if (fieldNames != null && !fieldNames.isEmpty()) {
            alpacaJsonDataCommentoField(alpacaJsonData, istanzaDomandaBando, fieldNames, PresentatoreFormFrontendService::popolaNota);
        } else if (fieldNamesDataContainerOggettoCommento != null && !fieldNamesDataContainerOggettoCommento.isEmpty() ) {
            alpacaJsonDataCommentoField(alpacaJsonData, istanzaDomandaBando, fieldNamesDataContainerOggettoCommento, PresentatoreFormFrontendService::popolaOggettoPiuNota);
        }

        return alpacaJsonData;
    }

    private void alpacaJsonDataCommentoField(JsonObject alpacaJsonData, IstanzaDomandaBando istanzaDomandaBando, List<String> fieldNames, BiConsumer<CommentoDomandaBando, JsonObject> popolatoreNota) {
        CommentoDomandaBando commentoDomandaBando = null;

        try {
            commentoDomandaBando = commentoDomandaBandoLocalService.getCommentoByCommentoDomandaBandoId(istanzaDomandaBando.getCommentoDomandaBandoId());
        } catch (NoSuchCommentoDomandaBandoException e) {
            log.error("Nessun commento trovato per questa istanza domanda bando :: ", e);
            return;
        }

        for (String fieldNameDataContainer : fieldNames) {
            JsonObject fieldDataContainer = alpacaJsonData.getAsJsonObject(fieldNameDataContainer);

            if (fieldDataContainer == null) {
                continue;
            }

            if (Validator.isNotNull(commentoDomandaBando)) {
                popolatoreNota.accept(commentoDomandaBando, fieldDataContainer);
            }

            alpacaJsonData.add(fieldNameDataContainer, fieldDataContainer);
        }
    }

    private static void popolaNota(CommentoDomandaBando commentoDomandaBando, JsonObject fieldDataContainer) {
        String value = commentoDomandaBando.getTesto();
        fieldDataContainer.addProperty("note", value);
    }

    private static void popolaOggettoPiuNota(CommentoDomandaBando commentoDomandaBando, JsonObject fieldDataContainer) {
        String oggetto = commentoDomandaBando.getOggetto();
        String note = commentoDomandaBando.getTesto();
        fieldDataContainer.addProperty("note", note);
        fieldDataContainer.addProperty("oggetto", oggetto);
    }

    private void alpacaJsonDataCommentoField(JsonObject alpacaJsonData, IstanzaDomandaBando istanzaDomandaBando, List<String> fieldNames, String fieldKey, Function<CommentoDomandaBando, String> fieldExtractor) {
        for (String fieldNameDataContainer : fieldNames) {
            JsonObject fieldDataContainer = alpacaJsonData.getAsJsonObject(fieldNameDataContainer);

            if (fieldDataContainer == null) {
                return;
            }

            CommentoDomandaBando commentoDomandaBando = null;
            try {
                commentoDomandaBando = commentoDomandaBandoLocalService.getCommentoByCommentoDomandaBandoId(istanzaDomandaBando.getCommentoDomandaBandoId());
            } catch (NoSuchCommentoDomandaBandoException e) {
                log.error("Nessun commento trovato per questa istanza domanda bando :: ", e);
            }

            if (Validator.isNotNull(commentoDomandaBando)) {
                String value = fieldExtractor.apply(commentoDomandaBando);
                fieldDataContainer.addProperty(fieldKey, value);
            }

            alpacaJsonData.add(fieldNameDataContainer, fieldDataContainer);
        }
    }

    private String getTaskId(DomandaBando domandaBando) {
        List<Task> tasks = camundaClient.searchTasks(domandaBando.getProcessInstanceId());
        if (tasks.isEmpty()) {
            throw new RuntimeException("No task");
        }

        if (tasks.size() > 1) {
            log.warn("Piu task per processo " + domandaBando.getProcessInstanceId());
        }

        return tasks.get(0).getId();
    }

    public void annullaDomandaBando(ServiceContext serviceContext, long domandaBandoId, long allegatoAnnullamentoId) {

        try {
            DomandaBando domandaBando = domandaBandoLocalService.getDomandaBando(domandaBandoId);

            String taskId = getTaskId(domandaBando);

            String tenantId = String.valueOf(serviceContext.getScopeGroup().getOrganizationId());
            List<Task> tasksByBusinessKey = camundaClient.getTasksByBusinessKey(tenantId,
                    String.valueOf(domandaBandoId));

            if (tasksByBusinessKey != null) {

                for (Task task : tasksByBusinessKey) {
                    if (taskId.equalsIgnoreCase(task.getId())) {
                        List<Map.Entry<String, Object>> variables = new ArrayList<>();

                        // TODO: Capire se questi valori devono rimanere hard coded

                        variables.add(new AbstractMap.SimpleEntry<>("ESITO_PROCEDIMENTO", "ANNULLAMENTO"));
                        variables.add(new AbstractMap.SimpleEntry<>("COMUNICAZIONE_ESITO", "SI"));
                        variables.add(new AbstractMap.SimpleEntry<>("ID_ALLEGATO_ANNULLAMENTO",
                                String.valueOf(allegatoAnnullamentoId)));

                        camundaClient.completeTaskMultiType(taskId, variables);
                    }
                }
            }

        } catch (Exception e) {
            throw new RuntimeException(e);
        }
    }

