    private List<String> getNomeCampoByType(String jsonForm, String portalUrl, String[] types, long formId) {
        Gson gson = new Gson();
        List<String> listaCampi = new ArrayList<String>();
        FormData formData = null;

        try {
            if (Validator.isNotNull(jsonForm)) {
                String jsonData = gson.toJson(gson.fromJson(jsonForm, FormData.class));
                Form form = formLocalService.getForm(formId);

                if (Validator.isNotNull(form)) {
                    formData = AlpacaUtil.loadFormData(form, jsonData, true, portalUrl);
                    AlpacaJsonStructure alpacaStructure = formData.getAlpaca();
                    AlpacaJsonOptionsStructure optionStr = gson.fromJson(gson.toJson(alpacaStructure.getOptions()),
                            AlpacaJsonOptionsStructure.class);
                    listaCampi = AlpacaUtil.getAllFieldNameDataContainer(optionStr, types);
                }

            }
        } catch (Exception e) {
            log.error(e.getMessage());
        }

        return listaCampi;
    }

    public InfoRegistroImpresa getInfoRegistroImpresa(String codiceFiscale, String portalUrl) {
        JsonNode fieldValues = null;
        InfoRegistroImpresa info = null;
        List<DomandaBando> listaDomandeRecenti = domandaBandoLocalService
                .getListaDomandeBandoUtenteOrdinate(codiceFiscale);
        boolean infoTrovate = false;
        Iterator<DomandaBando> iteratorDomande = listaDomandeRecenti.iterator();

        if (listaDomandeRecenti != null && !listaDomandeRecenti.isEmpty()) {
            while (infoTrovate == false && iteratorDomande.hasNext()) {
                DomandaBando domandaBando = iteratorDomande.next();

                if (Validator.isNotNull(domandaBando)) {
                    IstanzaDomandaBando istanzaDomandaBando = getIstanzaDomandaBandoPrincipaleByDomandaBandoId(
                            domandaBando.getDomandaBandoId());

                    if (Validator.isNotNull(istanzaDomandaBando)) {
                        String jsonForm = istanzaDomandaBando.getJson();

                        if (Validator.isNotNull(jsonForm)) {
                            Set<Option> jsonPathOptions = new HashSet<Option>();
                            jsonPathOptions.add(Option.SUPPRESS_EXCEPTIONS);
                            jsonPathOptions.add(Option.ALWAYS_RETURN_LIST);

                            Configuration jsonPathConfiguration = Configuration.builder()
                                    .jsonProvider(new JacksonJsonNodeJsonProvider())
                                    .mappingProvider(new JacksonMappingProvider()).options(jsonPathOptions).build();

                            List<String> listaCampi = getNomeCampoByType(jsonForm, portalUrl, typesRegistroImpresa,
                                    istanzaDomandaBando.getFormId());

                            for (String campo : listaCampi) {
                                String pathCampo = "['" + campo + "']";
                                fieldValues = JsonPath.using(jsonPathConfiguration).parse(jsonForm)
                                        .read(ALPACA_ALPACA_FIELD + ALPACA_DATA_FIELD + pathCampo);
                            }

                            if (fieldValues != null && !fieldValues.isEmpty()) {

                                if (fieldValues != null && !fieldValues.isEmpty()) {
                                    JsonNode nodeInterno = fieldValues.get(0);

                                    if (nodeInterno != null && !nodeInterno.isEmpty()) {
                                        info = populateInfoRegistroImpresa(nodeInterno);

                                        if (nodeInterno.has("tipoSoggetto")) {
                                            String tipoSoggetto = nodeInterno.get("tipoSoggetto").asText();
                                            info.setTipoSoggetto(tipoSoggetto);
                                        }

                                        if (info != null) {
                                            infoTrovate = true;
                                        }

                                    }
                                }

                            }
                        }

                    }
                }
            }
        }

        return info;
    }

