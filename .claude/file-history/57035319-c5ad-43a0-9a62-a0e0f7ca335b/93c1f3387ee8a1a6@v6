    public DomandaBando createOrUpdateDomandaBando(User user, long bandoId, String dataForm, String stato,
                                                   long groupId) {
        DomandaBando domandaBando = null;
        IstanzaDomandaBando istanzaDomandaBando = null;
        Bando bando = null;
        Form form = null;
        BandoForm bandoForm = null;
        Gson gson = new Gson();
        AlpacaJsonStructure alpacaStructure = gson.fromJson(dataForm, AlpacaJsonStructure.class);

        try {
            if (Validator.isNotNull(alpacaStructure)) {
                FormData formData = new FormData();
                formData.setAlpaca(alpacaStructure);
                String jsonToSave = gson.toJson(formData);

                // recupero richiesta se esiste altrimenti ne creo una nuova
                domandaBando = getDomandaBandoBozza(user.getScreenName(), bandoId);
                form = getFormBando(bandoId);
                bandoForm = getBandoForm(bandoId);
                bando = bandoLocalService.getBando(bandoId);
                if (Validator.isNotNull(form)) {

                    if (Validator.isNotNull(StatoDomandaBandoEnum.valueOf(stato))) {
                        // recupero richiesta esistente
                        if (Validator.isNotNull(domandaBando)) {
                            log.debug("Recuperata domanda bando in stato BOZZA con id: " + domandaBando.getBandoId());

                            if (Validator.isNotNull(bandoForm)) {
                                istanzaDomandaBando = getIstanzaDomandaBando(domandaBando.getDomandaBandoId(),
                                        form.getFormId());
                            }

                        } else {
                            // creazione nuova richiesta
                            domandaBando = domandaBandoLocalService.createDomandaBando(counterLocalService.increment());
                            domandaBando.setCodiceFiscale(user.getScreenName().toUpperCase());
                            domandaBando.setUserId(user.getUserId());
                            domandaBando.setUserName(user.getFullName());
                            domandaBando.setBandoId(bandoId);
                            domandaBando.setOggetto(bando.getNome());
                            domandaBando.setStato(StatoDomandaBandoEnum.BOZZA.name());
                            domandaBando.setGroupId(groupId);
                            domandaBando = domandaBandoLocalService.updateDomandaBando(domandaBando);

                            istanzaDomandaBando = istanzaDomandaBandoLocalService
                                    .createIstanzaDomandaBando(counterLocalService.increment());
                            istanzaDomandaBando.setGroupId(groupId);
                            istanzaDomandaBando.setUserId(user.getUserId());
                            istanzaDomandaBando.setUserName(user.getFullName());
                            istanzaDomandaBando.setDomandaBandoId(domandaBando.getDomandaBandoId());
                        }
                        // aggiorno stato richiesta
                        domandaBando.setStato(stato);
                        domandaBandoLocalService.updateDomandaBando(domandaBando);
                        // aggiorno json in istanza form
                        istanzaDomandaBando.setJson(jsonToSave);
                        istanzaDomandaBando.setVersioneForm(form.getVersione());
                        istanzaDomandaBando.setFormId(form.getFormId());
                        istanzaDomandaBando.setStato(StatoIntegrazioneDomandaBandoEnum.NON_VALIDATA.name());
                        istanzaDomandaBandoLocalService.updateIstanzaDomandaBando(istanzaDomandaBando);
                    } else {
                        log.error("Valore non valido per lo stato della richiesta: " + stato);
                    }
                } else {
                    log.error("Nessun form principale associato alla procedura con id: " + 0);
                }
            }
        } catch (Exception e) {
            log.error(e.getMessage());
        }

        return domandaBando;

    }

    private void estraiPartiteIva(JsonNode fieldValues, String nomeCampo, List<String> listaPartiteIva) {
        if (fieldValues != null) {
            JsonNode soggettiAti = fieldValues.get(0);

            if (soggettiAti != null) {
                JsonNode campoGenerico = soggettiAti.get(nomeCampo);

                if (campoGenerico != null && campoGenerico.size() > 0) {
                    for (JsonNode elemento : campoGenerico) {
                        String partitaIva = "";

                        if (elemento.has("partitaIva") && !elemento.get("partitaIva").isNull()) {
