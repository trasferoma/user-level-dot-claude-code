                                dato.setDomandaBandoId(domandaBando.getDomandaBandoId());
                                dato.setCompanyId(companyId);
                                dato.setUserId(userId);
                                dato.setUserName(username);
                                dato.setGroupId(groupId);
                                domandaBandoDatoAggiuntivoLocalService.updateDomandaBandoDatoAggiuntivo(dato);
                            }
                        }
                    }

                    // Gestione dati aggiuntivi di tipo array
                    for (Map.Entry<String, List<String>> entry : datiAggiuntiviDinamiciArray.entrySet()) {
                        String chiaveDinamica = entry.getKey();
                        List<String> valoriDinamici = entry.getValue();

                        if (Validator.isNotNull(chiaveDinamica) && valoriDinamici != null && !valoriDinamici.isEmpty()) {
                            long count = domandaBandoDatoAggiuntivoLocalService
                                    .countDomandaBandoDatoAggiuntivoByDomandaBandoIdAndChiave(
                                            domandaBando.getDomandaBandoId(), Collections.singletonList(chiaveDinamica));

                            if (count == 0) {
                                for (String valoreDinamico : valoriDinamici) {
                                    if (Validator.isNotNull(valoreDinamico)) {
                                        DomandaBandoDatoAggiuntivo dato = domandaBandoDatoAggiuntivoLocalService
                                                .createDomandaBandoDatoAggiuntivo(counterLocalService.increment());
                                        dato.setChiave(chiaveDinamica);
                                        dato.setValore(valoreDinamico);
                                        dato.setDomandaBandoId(domandaBando.getDomandaBandoId());
                                        dato.setCompanyId(companyId);
                                        dato.setUserId(userId);
                                        dato.setUserName(username);
                                        dato.setGroupId(groupId);
                                        domandaBandoDatoAggiuntivoLocalService.addDomandaBandoDatoAggiuntivo(dato);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        catch (Exception e) {
            log.error("Errore nel recupero dati aggiuntivi da attributo datoAggiuntivo nelle options: " + e.getMessage(), e);
        }
    }

    private List<DatoAggiuntivoChiave> getDatiAggiuntiviChiaviDaForm(long bandoId) throws Exception {
        List<BandoForm> bandoForms = bandoFormLocalService.getListaBandoFormBando(bandoId);
        BandoForm bandoForm = bandoForms.stream().filter(bf -> Validator.isNull(bf.getTipoForm())).findFirst()
                .orElseThrow();
        Form form = formLocalService.getForm(bandoForm.getFormId());
        String formJson = form.getJson();

        Configuration configuration = Configuration.defaultConfiguration().addOptions(Option.SUPPRESS_EXCEPTIONS);
        DocumentContext document = JsonPath.using(configuration).parse(formJson);

        List<DatoAggiuntivoChiave> chiaviPresenti = new ArrayList<>();
        for (DatoAggiuntivoChiave chiave : DatoAggiuntivoChiave.values()) {

            if (Validator.isNotNull(chiave.getSchemaJsonPath())) {
                Object value = document.read(chiave.getSchemaJsonPath());
                boolean found = Validator.isNotNull(value);

                if (found) {
                    chiaviPresenti.add(chiave);
                }
            }

        }
        chiaviPresenti.sort(NUMERO_ORDINE_COMP);
        return chiaviPresenti;
    }

    /**
     * Attraversa ricorsivamente la struttura options.fields del form Alpaca
     * per trovare tutti i campi con attributo "datoAggiuntivo" e recuperare
     * il corrispondente valore dai data.
     *
     * @param optionsFields nodo options.fields corrente
     * @param dataObj       nodo data corrente (parallelo alla struttura options)
     * @param risultato     mappa chiave datoAggiuntivo -> valore dal data
     */
    private void _trovaDatiAggiuntiviDaOptions(JsonObject optionsFields, JsonObject dataObj,
                                                Map<String, String> risultato,
                                                Map<String, List<String>> risultatoArray) {
        if (optionsFields == null || dataObj == null) {
            return;
        }

        for (Map.Entry<String, com.google.gson.JsonElement> entry : optionsFields.entrySet()) {
            String fieldName = entry.getKey();
            com.google.gson.JsonElement fieldElement = entry.getValue();

            if (fieldElement == null || !fieldElement.isJsonObject()) {
                continue;
            }

            JsonObject fieldObj = fieldElement.getAsJsonObject();

            // Verifica se questo campo ha l'attributo datoAggiuntivo
            if (fieldObj.has("datoAggiuntivo") && !fieldObj.get("datoAggiuntivo").isJsonNull()) {
                String chiave = fieldObj.get("datoAggiuntivo").getAsString();

                if (Validator.isNotNull(chiave) && dataObj.has(fieldName) && !dataObj.get(fieldName).isJsonNull()) {
                    com.google.gson.JsonElement dataElement = dataObj.get(fieldName);

                    if (dataElement.isJsonPrimitive()) {
                        risultato.put(chiave, dataElement.getAsString());
                    } else if (dataElement.isJsonArray()) {
                        com.google.gson.JsonArray jsonArray = dataElement.getAsJsonArray();
                        List<String> elementi = new ArrayList<>();
                        for (int i = 0; i < jsonArray.size(); i++) {
                            com.google.gson.JsonElement arrayElement = jsonArray.get(i);
                            if (arrayElement != null && !arrayElement.isJsonNull()) {
                                elementi.add(arrayElement.toString());
                            }
                        }
                        if (!elementi.isEmpty()) {
                            risultatoArray.put(chiave, elementi);
                        }
                    }
                }
            }

            // Ricorsione nei sotto-campi (fields annidati)
            if (fieldObj.has("fields") && fieldObj.get("fields").isJsonObject()) {
                JsonObject nestedOptionsFields = fieldObj.getAsJsonObject("fields");

                if (dataObj.has(fieldName) && dataObj.get(fieldName).isJsonObject()) {
                    JsonObject nestedDataObj = dataObj.getAsJsonObject(fieldName);
                    _trovaDatiAggiuntiviDaOptions(nestedOptionsFields, nestedDataObj, risultato, risultatoArray);
                }
            }
        }
    }

