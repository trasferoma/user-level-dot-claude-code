    public void deleteDomandaBozzaUtente(String screenName, long domandaBandoId, long formId) {
        DomandaBando domandaBando = null;
        try {
            domandaBando = domandaBandoLocalService.getDomandaBando(domandaBandoId);
        } catch (PortalException e) {
            log.error(e);
        }

        if (Validator.isNotNull(domandaBando)) {

            try {
                domandaBandoLocalService.deleteDomandaBando(domandaBando.getDomandaBandoId());
            } catch (PortalException e) {
                log.error("deleteRichiesteBozzaUtente :: " + e.getMessage(), e);
            }

            IstanzaDomandaBando istanzaDomandaBando = getIstanzaDomandaBando(domandaBando.getDomandaBandoId(), formId);

            if (Validator.isNotNull(istanzaDomandaBando)) {
                try {
                    istanzaDomandaBandoLocalService
                            .deleteIstanzaDomandaBando(istanzaDomandaBando.getIstanzaDomandaBandoId());
                } catch (PortalException e) {
                    log.error("deleteRichiesteBozzaUtente :: " + e.getMessage(), e);
                }
                allegatoDomandaBandoService.deleteAllAllegati(istanzaDomandaBando.getIstanzaDomandaBandoId());
            }
        }
    }

