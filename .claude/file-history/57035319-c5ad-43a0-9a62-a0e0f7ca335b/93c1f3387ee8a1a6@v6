        AlpacaJsonStructure alpacaStructure = gson.fromJson(dataForm, AlpacaJsonStructure.class);
        String view = gson.toJson(alpacaStructure.getView());
        JsonObject jsonView = gson.fromJson(view, JsonObject.class);
        if (Validator.isNotNull(jsonView) && jsonView.has("wizard")) {
            JsonObject wizard = jsonView.getAsJsonObject("wizard");
            if (Validator.isNotNull(wizard) && wizard.has("steps")) {
                JsonArray steps = wizard.get(AlpacaKey.STEPS.getName()).getAsJsonArray();
