    private List<CodiceAteco> getListaCodiciAteco(long bandoId) {
        List<CodiceAteco> listaCodiciBando = new ArrayList<CodiceAteco>();
        List<String> codiciRilevanza = null;

        if (bandoId > 0) {
            DatoBando datoBandoCodiciRilevanza = datoBandoLocalService
                    .findByCodice(CodiceDatoBandoEnum.CODICE_ATECO_RILEVANZA.name());
            DatoBando datoBandoCodiceAteco = datoBandoLocalService
                    .findByCodice(CodiceDatoBandoEnum.CODICI_ATECO.name());

            if (Validator.isNotNull(datoBandoCodiciRilevanza) && Validator.isNotNull(datoBandoCodiceAteco)) {
                List<ValoreDatoBando> listaRilevanzaCodiciAteco = valoreDatoBandoLocalService
                        .findByBandoIdAndDatoBandoId(bandoId, datoBandoCodiciRilevanza.getDatoBandoId());
                List<ValoreDatoBando> listaCodiciAteco = valoreDatoBandoLocalService
                        .findByBandoIdAndDatoBandoId(bandoId, datoBandoCodiceAteco.getDatoBandoId());

                String rilevanze = null;

                if (listaRilevanzaCodiciAteco != null && !listaRilevanzaCodiciAteco.isEmpty()) {
                    codiciRilevanza = listaRilevanzaCodiciAteco.stream().map(ValoreDatoBando::getValore)
                            .collect(Collectors.toList());

                    if (codiciRilevanza != null && !codiciRilevanza.isEmpty()) {
                        rilevanze = String.join(",", codiciRilevanza);
                    }
                }

                if (listaCodiciAteco != null && !listaCodiciAteco.isEmpty()) {
                    for (ValoreDatoBando codiceAteco : listaCodiciAteco) {
                        if (Validator.isNotNull(codiceAteco)) {
                            CodiceAteco codice = new CodiceAteco();
                            codice.setCodice(codiceAteco.getValore());

                            if (Validator.isNotNull(rilevanze)) {
                                codice.setRilevanza(rilevanze);
                            }

                            listaCodiciBando.add(codice);
                        }
                    }
                }
            }
        }

        return listaCodiciBando;
    }

