                Map.entry("CF_LEGALE_RAPPRESENTANTE", "codiceFiscaleSoggettoDelegato"),
                Map.entry("DATA_NASCITA_LEGALE_RAPPRESENTANTE", "dataNascitaSoggettoDelegato"),
                Map.entry("LUOGO_NASCITA_LEGALE_RAPPRESENTANTE", "luogoNascitaSoggettoDelegato")
        );

        Map<String, String> mappaChiaviFieldSoggettoProponente = Map.ofEntries(
                Map.entry("RAGIONE_SOCIALE_SOGGETTO_PROPONENTE", "ragioneSocialeSoggettoProponente"),
                Map.entry("CF_SOGGETTO_PROPONENTE", "cfSoggettoProponente"),
                Map.entry("VIA_SOGGETTO_PROPONENTE", "viaSoggettoProponente"),
                Map.entry("CIVICO_SOGGETTO_PROPONENTE", "civicoSoggettoProponente"),
                Map.entry("CAP_SOGGETTO_PROPONENTE", "capSoggettoProponente"),
                Map.entry("EMAIL_SOGGETTO_PROPONENTE", "emailSoggettoProponente"),
                Map.entry("PEC_SOGGETTO_PROPONENTE", "pecSoggettoProponente"),
                Map.entry("TEL_SOGGETTO_PROPONENTE", "telSoggettoProponente")
        );

        List<String> fieldNamesDataContainer = AlpacaUtil.getAllFieldNameDataContainer(
                optionsStr,
                typesCompilaDisciplinareAntimafia
        );

        if (fieldNamesDataContainer != null) {
            for (String fieldNameDataContainer : fieldNamesDataContainer) {
                JsonObject fieldDataContainer = alpacaJsonData.getAsJsonObject(fieldNameDataContainer);

                if (fieldDataContainer != null) {

                    for (Map.Entry<String, String> entry : mappaChiaviFieldRichiedente.entrySet()) {
                        String chiave = entry.getKey();
                        String campo = entry.getValue();
                        if (datiAggiuntiviMap.containsKey(chiave)) {
                            fieldDataContainer.addProperty(campo, datiAggiuntiviMap.get(chiave));
                        }
                    }

                    if (isSoggettoDelegato) {
                        for (Map.Entry<String, String> entry : mappaChiaviFieldDelegato.entrySet()) {
                            String chiave = entry.getKey();
                            String campo = entry.getValue();
                            if (datiAggiuntiviMap.containsKey(chiave)) {
                                fieldDataContainer.addProperty(campo, datiAggiuntiviMap.get(chiave));
                            }
                        }
                    } else {
                        if (datiAggiuntiviMap.containsKey("NOME_RICHIEDENTE")) {
                            fieldDataContainer.addProperty("nomeSoggettoDelegato", datiAggiuntiviMap.get("NOME_RICHIEDENTE"));
                        }
                        if (datiAggiuntiviMap.containsKey("COGNOME_RICHIEDENTE")) {
                            fieldDataContainer.addProperty("cognomeSoggettoDelegato", datiAggiuntiviMap.get("COGNOME_RICHIEDENTE"));
                        }
                        if (datiAggiuntiviMap.containsKey("CF_RICHIEDENTE")) {
                            fieldDataContainer.addProperty("codiceFiscaleSoggettoDelegato", datiAggiuntiviMap.get("CF_RICHIEDENTE"));
                        }
                        if (datiAggiuntiviMap.containsKey("DATA_NASCITA_RICHIEDENTE")) {
                            fieldDataContainer.addProperty("dataNascitaSoggettoDelegato", datiAggiuntiviMap.get("DATA_NASCITA_RICHIEDENTE"));
                        }
                        if (datiAggiuntiviMap.containsKey("LUOGO_NASCITA_RICHIEDENTE")) {
                            fieldDataContainer.addProperty("luogoNascitaSoggettoDelegato", datiAggiuntiviMap.get("LUOGO_NASCITA_RICHIEDENTE"));
                        }
                    }

                    for (Map.Entry<String, String> entry : mappaChiaviFieldSoggettoProponente.entrySet()) {
                        String chiave = entry.getKey();
                        String campo = entry.getValue();
                        if (datiAggiuntiviMap.containsKey(chiave)) {
                            fieldDataContainer.addProperty(campo, datiAggiuntiviMap.get(chiave));
                        }
                    }
                    if (Validator.isNotNull(domandaBando.getTitoloProgetto())) {
                        fieldDataContainer.addProperty("titoloProgetto", domandaBando.getTitoloProgetto());
                    }

                    if (Validator.isNotNull(domandaBando.getImportoRichiesto())) {
                        fieldDataContainer.addProperty("importoRichiesto", domandaBando.getImportoRichiesto().toPlainString());

                    }

                    if (datiAggiuntiviMap.containsKey("IMPORTO_COFINANZIATO")) {
                        fieldDataContainer.addProperty("importoCofinanziato", datiAggiuntiviMap.get("IMPORTO_COFINANZIATO"));
                    }

                    if (datiAggiuntiviMap.containsKey("IMPORTO_COMPLESSIVO_PROGETTUALE")) {
                        fieldDataContainer.addProperty("importoComplessivo", datiAggiuntiviMap.get("IMPORTO_COMPLESSIVO_PROGETTUALE"));
                    }

                    if (Validator.isNotNull(domandaBando.getImportoAssegnato())) {
                        fieldDataContainer.addProperty("importoAssegnato", domandaBando.getImportoAssegnato().toPlainString());

                    }

                    if (datiAggiuntiviMap.containsKey("PROVINCIA_SOGGETTO_PROPONENTE")) {
                        String codiceProvincia = datiAggiuntiviMap.get("PROVINCIA_SOGGETTO_PROPONENTE");
                        try {
                            Provincia provincia = provinciaLocalService.getProvinciaBySigla(codiceProvincia);
                            if (provincia != null) {
                                fieldDataContainer.addProperty("provinciaSoggettoProponente", provincia.getDenominazioneProvincia());
                            }
                        } catch (Exception e) {
                            _log.error("Errore nel recupero della provincia con codice: " + codiceProvincia, e);
                            // In caso di errore, uso il codice
                            fieldDataContainer.addProperty("provinciaSoggettoProponente", codiceProvincia);
                        }
                    }

                    if (datiAggiuntiviMap.containsKey("COMUNE_SOGGETTO_PROPONENTE")) {
                        String codiceComune = datiAggiuntiviMap.get("COMUNE_SOGGETTO_PROPONENTE");
                        try {
                            Comune comune = comuneLocalService.getComune(Long.parseLong(codiceComune));
                            if (comune != null) {
                                fieldDataContainer.addProperty("comuneSoggettoProponente", comune.getDenominazione());
                            }
                        } catch (NumberFormatException e) {
                            _log.error("Errore nel parsing del codice comune: " + codiceComune, e);
                            fieldDataContainer.addProperty("comuneSoggettoProponente", codiceComune);
                        } catch (Exception e) {
                            _log.error("Errore nel recupero del comune con codice: " + codiceComune, e);
                            fieldDataContainer.addProperty("comuneSoggettoProponente", codiceComune);
                        }
                    }

                    if (datiAggiuntiviMap.containsKey("MANDANTI_ARRAY")) {
                        String mandantiJson = datiAggiuntiviMap.get("MANDANTI_ARRAY");
                        try {
                            Gson gson = new Gson();
                            JsonArray mandantiArray = gson.fromJson(mandantiJson, JsonArray.class);

                            for (int i = 0; i < mandantiArray.size(); i++) {
                                JsonObject mandante = mandantiArray.get(i).getAsJsonObject();

                                if (mandante.has("sedeLegale") && mandante.get("sedeLegale").isJsonObject()) {
                                    JsonObject sedeLegale = mandante.getAsJsonObject("sedeLegale");

                                    if (sedeLegale.has("provincia") && !sedeLegale.get("provincia").isJsonNull()) {
                                        String codiceProvincia = sedeLegale.get("provincia").getAsString();
                                        try {
                                            Provincia provincia = provinciaLocalService.getProvinciaBySigla(codiceProvincia);
                                            if (provincia != null) {
                                                sedeLegale.addProperty("provincia", provincia.getDenominazioneProvincia());
                                            }
                                        } catch (Exception e) {
                                            _log.error("Errore nel recupero della provincia per mandante: " + codiceProvincia, e);
                                        }
                                    }

                                    if (sedeLegale.has("comune") && !sedeLegale.get("comune").isJsonNull()) {
                                        String codiceComune = sedeLegale.get("comune").getAsString();
                                        try {
                                            Comune comune = comuneLocalService.getComune(Long.parseLong(codiceComune));
                                            if (comune != null) {
                                                sedeLegale.addProperty("comune", comune.getDenominazione());
                                                sedeLegale.addProperty("denominazioneComune", comune.getDenominazione());
                                            }
                                        } catch (NumberFormatException e) {
                                            _log.error("Errore nel parsing del codice comune per mandante: " + codiceComune, e);
                                        } catch (Exception e) {
                                            _log.error("Errore nel recupero del comune per mandante: " + codiceComune, e);
                                        }
                                    }
                                }
                            }

                            fieldDataContainer.add("mandantiArray", mandantiArray);
                        } catch (Exception e) {
                            _log.error("Errore nel parsing del JSON dei mandanti", e);
                        }
                    }

                    if (datiAggiuntiviMap.containsKey("PARTNER_ARRAY")) {
                        String partnerJson = datiAggiuntiviMap.get("PARTNER_ARRAY");
                        try {
                            Gson gson = new Gson();
                            JsonArray partnerArray = gson.fromJson(partnerJson, JsonArray.class);

                            for (int i = 0; i < partnerArray.size(); i++) {
                                JsonObject partner = partnerArray.get(i).getAsJsonObject();

                                if (partner.has("datiPartner") && partner.get("datiPartner").isJsonObject()) {
                                    JsonObject datiPartner = partner.getAsJsonObject("datiPartner");

                                    if (datiPartner.has("nomePartner") && !datiPartner.get("nomePartner").isJsonNull()) {
                                        partner.addProperty("nomePartner", datiPartner.get("nomePartner").getAsString());
                                    }

                                    if (datiPartner.has("legaleRappresentante") && !datiPartner.get("legaleRappresentante").isJsonNull()) {
                                        partner.addProperty("legaleRappresentante", datiPartner.get("legaleRappresentante").getAsString());
                                    }

                                    if (datiPartner.has("codiceFiscale") && !datiPartner.get("codiceFiscale").isJsonNull()) {
                                        partner.addProperty("codiceFiscale", datiPartner.get("codiceFiscale").getAsString());
                                    }

                                    if (datiPartner.has("tipologiaAttivita") && !datiPartner.get("tipologiaAttivita").isJsonNull()) {
                                        partner.addProperty("tipologiaAttivita", datiPartner.get("tipologiaAttivita").getAsString());
                                    }
                                }

                                if (partner.has("sedeLegale") && partner.get("sedeLegale").isJsonObject()) {
                                    JsonObject sedeLegale = partner.getAsJsonObject("sedeLegale");

                                    if (sedeLegale.has("provincia") && !sedeLegale.get("provincia").isJsonNull()) {
                                        String codiceProvincia = sedeLegale.get("provincia").getAsString();
                                        try {
                                            Provincia provincia = provinciaLocalService.getProvinciaBySigla(codiceProvincia);
                                            if (provincia != null) {
                                                sedeLegale.addProperty("provincia", provincia.getDenominazioneProvincia());
                                            }
                                        } catch (Exception e) {
                                            _log.error("Errore nel recupero della provincia per partner: " + codiceProvincia, e);
                                        }
                                    }

                                    if (sedeLegale.has("comune") && !sedeLegale.get("comune").isJsonNull()) {
                                        String codiceComune = sedeLegale.get("comune").getAsString();
                                        try {
                                            Comune comune = comuneLocalService.getComune(Long.parseLong(codiceComune));
                                            if (comune != null) {
                                                sedeLegale.addProperty("comune", comune.getDenominazione());
                                                sedeLegale.addProperty("denominazioneComune", comune.getDenominazione());
                                            }
                                        } catch (NumberFormatException e) {
                                            _log.error("Errore nel parsing del codice comune per partner: " + codiceComune, e);
                                        } catch (Exception e) {
                                            _log.error("Errore nel recupero del comune per partner: " + codiceComune, e);
                                        }
                                    }
                                }
                            }

                            fieldDataContainer.add("partnerArray", partnerArray);
                        } catch (Exception e) {
                            _log.error("Errore nel parsing del JSON dei partner", e);
                        }
                    }

                    alpacaJsonData.add(fieldNameDataContainer, fieldDataContainer);
                }
            }
        }

        return alpacaJsonData;
    }

