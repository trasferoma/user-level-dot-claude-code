    public String getErroreBozzaDettaglioKey(String codiceBando, java.util.Locale locale) {
        String baseKey = "errore.bozza.dettaglio";
        if (Validator.isNull(codiceBando)) {
            return baseKey;
        }
        String customKey = baseKey + "_" + codiceBando;
        ResourceBundleLoader resourceBundleLoader = ResourceBundleLoaderUtil
                .getResourceBundleLoaderByBundleSymbolicName(PresentatoreFormsPortletKeys.BUNDLE_SYMBOLIC_NAME);
        ResourceBundle resourceBundle = resourceBundleLoader.loadResourceBundle(locale);
        String customMessage = ResourceBundleUtil.getString(resourceBundle, customKey);
        if (Validator.isNotNull(customMessage) && !customMessage.equals(customKey)) {
            return customKey;
        }
        return baseKey;
    }

    public Form getFormBando(long bandoId) {
        try {
            List<BandoForm> listaBandoForm = bandoFormLocalService.getListaBandoFormBando(bandoId);
            boolean isPrincipale = false;
            int i = 0;
            Form form = null;
            if (Validator.isNotNull(listaBandoForm) && !listaBandoForm.isEmpty()) {
                while (isPrincipale == false && i < listaBandoForm.size()) {
                    BandoForm bandoForm = listaBandoForm.get(i);

                    if (Validator.isNotNull(bandoForm)) {
                        form = formLocalService.getForm(bandoForm.getFormId());

                        if (Validator.isNotNull(form)) {
                            if (form.isPrincipale()) {
                                form.setListaDefinizioneAllegato(definizioneAllegatoLocalService
                                        .getListaDefinizioneAllegatoByFormId(form.getFormId()));
                                isPrincipale = true;
                            }
                        }
                    }
                    i++;
                }
            }
            return form;

        } catch (PortalException e) {
            log.warn("getFormPrincipaleProcedura :: " + e.getMessage());
        }
        return null;
    }

    public BandoForm getBandoForm(long bandoId) {

