    @Override
    public String render(RenderRequest renderRequest, RenderResponse renderResponse) throws PortletException {
        long domandaBandoId = ParamUtil.getLong(renderRequest, "domandaBandoId");
        String queryTabParent = ParamUtil.getString(renderRequest, "queryTabParent", DomandaBandoTabEnum.IN_LAVORAZIONE.getKey());
        String queryTab = ParamUtil.getString(renderRequest, "queryTab", DettaglioDomandaBandoTabEnum.DATI_IDENTIFICATIVI.getKey());
        boolean focusAllegatiOperatore = ParamUtil.getBoolean(renderRequest, "focusAllegatiOperatore", false);
        boolean prendiInCaricoAbilitato = scrivaniaOperatoreBandiFrontendService.prendiInCaricaAbilitato(domandaBandoId);
        renderRequest.setAttribute("focusAllegatiOperatore", focusAllegatiOperatore);
        renderRequest.setAttribute("prendiInCaricoAbilitato", prendiInCaricoAbilitato);
        boolean erroreRichiestaIntegrazione = ParamUtil.getBoolean(renderRequest, "erroreRichiestaIntegrazione");
        renderRequest.setAttribute("erroreRichiestaIntegrazione", erroreRichiestaIntegrazione);

        try {
            ServiceContext serviceContext = ServiceContextFactory.getInstance(renderRequest);
            ThemeDisplay themeDisplay = serviceContext.getThemeDisplay();
            List<ErroreValidazioneDTO> erroreValidazioneDTOS = new ArrayList<ErroreValidazioneDTO>();
            DomandaBando domandaBando = domandaBandoLocalService.getDomandaBando(domandaBandoId);

            GraduatoriaBando graduatoriaProvvisoria = graduatoriaBandoLocalService.getGraduatoriaBandoByBandoIdAndDefinitiva(domandaBando.getBandoId(), false);
            GraduatoriaBando graduatoriaDefinitiva = graduatoriaBandoLocalService.getGraduatoriaBandoByBandoIdAndDefinitiva(domandaBando.getBandoId(), true);
            long graduatoriaBandoId = 0;

            if (Validator.isNotNull(graduatoriaProvvisoria)) {
                graduatoriaBandoId = graduatoriaProvvisoria.getGraduatoriaBandoId();
            }

            if (Validator.isNotNull(graduatoriaDefinitiva)) {
                graduatoriaBandoId = graduatoriaDefinitiva.getGraduatoriaBandoId();
            }

            Bando bando = bandoLocalService.getBando(domandaBando.getBandoId());
            IstanzaDomandaBando istanzaDomandaBando =
                    scrivaniaOperatoreBandiFrontendService.getIstanzaDomandaBandoPrincipaleByDomandaBandoId(domandaBando.getDomandaBandoId());

            List<CriterioValutazioneDTO> listaCriteriValutazione = getListaCriteriValutazione(domandaBandoId, graduatoriaBandoId, renderRequest);
            List<AzioneUtenteDTO> azioni = scrivaniaOperatoreBandiFrontendService.getAzioni(serviceContext,
                    domandaBandoId,
                    scrivaniaOperatoreBandiFrontendService.verificaFaseCamunda(serviceContext, domandaBando.getDomandaBandoId(), "ATTIVITA_BENEFICIARIO"),
                    bando.getAbilitaEsecuzioneIntegrazione());

            // TODO MOCK TEMPORANEO - BPMN non modificabile: in fase esecuzione forziamo l'azione COMPILA_DISCIPLINARE_ESECUZIONE. // Jester
            // Rimuovere quando il workflow Camunda emettera' la variabile COMPILA_DISCIPLINARE_ESECUZIONE.
            boolean isFaseEsecuzione = scrivaniaOperatoreBandiFrontendService.verificaFaseCamunda(serviceContext, domandaBando.getDomandaBandoId(), "ATTIVITA_BENEFICIARIO");
            if (isFaseEsecuzione) {
                AzioneUtenteDTO azioneDisciplinareEsecuzione = new AzioneUtenteDTO();
                azioneDisciplinareEsecuzione.setCodiceAzioneUtente("COMPILA_DISCIPLINARE_ESECUZIONE");
                azioneDisciplinareEsecuzione.setDescrizione("Richiedi Modifiche\\Compila disciplinare esecuzione");
                azioni.add(azioneDisciplinareEsecuzione);
            }

            String fase = scrivaniaOperatoreBandiFrontendService.getFaseDomandaBando(serviceContext, domandaBandoId);

            if (Validator.isNotNull(istanzaDomandaBando)) {
                List<RequisitoDomandaBando> requisitoDomandaBandoLst = requisitoDomandaBandoLocalService.getRequisitoDomandaBandoByBandoId(bando.getBandoId());
                erroreValidazioneDTOS = validaDomandaBandoService
                        .validaForm(istanzaDomandaBando.getJson(), bando.getBandoId(), themeDisplay.getLocale(), requisitoDomandaBandoLst);
                renderRequest.setAttribute("listaErroriValidazione", erroreValidazioneDTOS);
                renderRequest.setAttribute("checkCriteriNonSoddisfattiObbligatori", checkCriteriNonSoddisfattiObbligatori(erroreValidazioneDTOS));
            }


            ValutazioneAmmissibilita valutazioneAmmissibilita = valutazioneAmmissibilitaLocalService
                    .getValutazioneAmmissibilitaByDomandaBandoAndGraduatoriaBando(domandaBando.getDomandaBandoId(), graduatoriaBandoId);

            if (Validator.isNotNull(valutazioneAmmissibilita) && Validator.isNotNull(valutazioneAmmissibilita.getEsito())) {
                AmmissibilitaEnum ammissibiltiaEnum = AmmissibilitaEnum.valueOf(valutazioneAmmissibilita.getEsito());
                renderRequest.setAttribute("ammissibilitaDomandaOperatore", ammissibiltiaEnum.name());
            }

            TipologiaBando tipologia = tipologiaBandoLocalService.getTipologiaBando(bando.getTipologiaBandoId());

            if (Validator.isNotNull(tipologia)) {
                renderRequest.setAttribute("tipologiaBando", tipologia.getCodice());
            }

            renderRequest.setAttribute("alpacaStructureSchema", null);
            renderRequest.setAttribute("alpacaStructureOptions", null);
            renderRequest.setAttribute("alpacaStructureData", null);
            renderRequest.setAttribute("alpacaStructureView", null);

            renderRequest.setAttribute(ScrivaniaOperatoreBandiPortletKeys.BANDO_ABILITAZIONE_DELEGA, bando.getAbilitazioneDelega());
            boolean hasCommentiNonLetti = scrivaniaOperatoreBandiFrontendService.hasCommentiNonLetti(domandaBandoId, serviceContext.getUserId());
            renderRequest.setAttribute("commentiNonLetti", hasCommentiNonLetti);
            handleTab(renderRequest, serviceContext, queryTab, domandaBando, bando);

            handleAzioni(renderRequest, serviceContext, domandaBando, queryTabParent, azioni);

            if (Validator.isNotNull(domandaBando.getImportoRichiesto())) {
                BigDecimal importoRichiesto = domandaBando.getImportoRichiesto().setScale(2, RoundingMode.HALF_UP);
                renderRequest.setAttribute("importoRichiesto", importoRichiesto);
            }

            renderRequest.setAttribute("abilitaVisualizzazioneImportoRichiesto", bando.getAbilitaImportoRichiesto());

            Boolean visualizzaImportoAmmissibile = scrivaniaOperatoreBandiFrontendService.visualizzaImportoAmmissibile(serviceContext, domandaBandoId, bando);
            renderRequest.setAttribute("visualizzaImportoAmmissibile", visualizzaImportoAmmissibile);

            boolean disabilitaControlloImportoAmmissibile = false;
            try {
                DatoBando datoBandoDisabilita = datoBandoLocalService.findByCodice(CodiceDatoBandoEnum.DISABILITA_CONTROLLO_IMPORTO_AMMISSIBILE.name());
                if (datoBandoDisabilita != null) {
                    List<ValoreDatoBando> valoriDisabilita =
                            valoreDatoBandoLocalService.findByBandoIdAndDatoBandoId(bando.getBandoId(), datoBandoDisabilita.getDatoBandoId());
                    if (valoriDisabilita != null && !valoriDisabilita.isEmpty()) {
                        disabilitaControlloImportoAmmissibile = "true".equals(valoriDisabilita.get(0).getValore());
                    }
                }
            } catch (Exception e) {
                _log.error("Errore nel recupero del flag disabilitaControlloImportoAmmissibile: " + e.getMessage(), e);
            }
            renderRequest.setAttribute("disabilitaControlloImportoAmmissibile", disabilitaControlloImportoAmmissibile);

            boolean disabilitaCampoOggetto = false;
            try {
                DatoBando datoBandoDisabilitaOggetto = datoBandoLocalService.findByCodice(CodiceDatoBandoEnum.DISABILITA_CAMPO_OGGETTO.name());
                if (datoBandoDisabilitaOggetto != null) {
                    List<ValoreDatoBando> valoriDisabilitaOggetto =
                            valoreDatoBandoLocalService.findByBandoIdAndDatoBandoId(bando.getBandoId(), datoBandoDisabilitaOggetto.getDatoBandoId());
                    if (valoriDisabilitaOggetto != null && !valoriDisabilitaOggetto.isEmpty()) {
                        disabilitaCampoOggetto = "true".equals(valoriDisabilitaOggetto.get(0).getValore());
                    }
                }
            } catch (Exception e) {
                _log.error("Errore nel recupero del flag disabilitaCampoOggetto: " + e.getMessage(), e);
            }
            renderRequest.setAttribute("disabilitaCampoOggetto", disabilitaCampoOggetto);

            Boolean calcoloAutomaticoImportoAmmissibile = scrivaniaOperatoreBandiFrontendService.checkCalcoloAutomaticoImportoAmmissibile(bando);

            List<RangeImportiValutazione> listaRangeImportiValutazione = null;
            if (calcoloAutomaticoImportoAmmissibile) {
                listaRangeImportiValutazione = rangeImportiValutazioneLocalService.getRangeImportiValutazioneByBandoId(bando.getBandoId());
            }

            String[] titleArgs = new String[0];

            if (Validator.isNotNull(fase)) {
                try {
                    FaseWorkflowBandoEnum faseEnum = FaseWorkflowBandoEnum.valueOf(fase);
                    if (Validator.isNotNull(faseEnum)) {
                        fase = faseEnum.getLabel();
                    }
                    titleArgs = new String[] {String.valueOf(domandaBando.getDomandaBandoId()), domandaBando.getRagioneSociale(), bando.getNome(), fase};
                    renderRequest.setAttribute(ScrivaniaOperatoreBandiPortletKeys.FASE, fase);
                } catch (RuntimeException e) {
                    titleArgs = new String[] {String.valueOf(domandaBando.getDomandaBandoId()), domandaBando.getRagioneSociale(), bando.getNome(), fase};
                    renderRequest.setAttribute(ScrivaniaOperatoreBandiPortletKeys.FASE, fase);
                }

            } else {
                titleArgs = new String[] {String.valueOf(domandaBando.getDomandaBandoId()), domandaBando.getRagioneSociale(), bando.getNome()};
            }

            renderRequest.setAttribute("listaRangeImportiValutazione", listaRangeImportiValutazione);
            renderRequest.setAttribute("importoAmmissibile", domandaBando.getImportoAmmissibile());
            renderRequest.setAttribute("calcoloAutomaticoImportoAmmissibile", calcoloAutomaticoImportoAmmissibile);
            renderRequest.setAttribute("listaCriteriValutazione", listaCriteriValutazione);
            boolean mostraPunteggioAutovalutazione = domandaBandoDatoAggiuntivoLocalService
                    .countDomandaBandoDatoAggiuntivoByDomandaBandoIdAndChiave(
                            domandaBandoId,
                            List.of(DatoAggiuntivoChiave.PUNTEGGIO_AUTOVALUTAZIONE.name())) > 0;
            renderRequest.setAttribute("mostraPunteggioAutovalutazione", mostraPunteggioAutovalutazione);

            BigDecimal punteggioTotaleAutovalutazione = BigDecimal.ZERO;
            if (listaCriteriValutazione != null) {
                for (CriterioValutazioneDTO criterio : listaCriteriValutazione) {
                    if (criterio.getPunteggioAutovalutazione() != null) {
                        punteggioTotaleAutovalutazione = punteggioTotaleAutovalutazione.add(criterio.getPunteggioAutovalutazione());
                    }
                }
            }
            renderRequest.setAttribute("punteggioTotaleAutovalutazione", punteggioTotaleAutovalutazione);
            renderRequest.setAttribute("checkPresenzaValutazione", checkPresenzaValutazione(domandaBando.getDomandaBandoId(), graduatoriaBandoId));
            renderRequest.setAttribute("checkPresenzaValutazioneAmmissibilita",
                    checkPresenzaValutazioneAmmissibilita(domandaBando.getDomandaBandoId(), graduatoriaBandoId, tipologia.getCodice()));
            renderRequest.setAttribute("esitoValutazioneAmmissibilita", getEsitoValutazioneAmmissibilita(domandaBando.getDomandaBandoId(), graduatoriaBandoId));
