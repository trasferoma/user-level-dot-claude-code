    private void handleDomandaInserita(RenderRequest renderRequest, ServiceContext serviceContext, DomandaBando domandaBando, Bando bando) throws Exception {
        ThemeDisplay themeDisplay = serviceContext.getThemeDisplay();
        Gson gson = new Gson();
        Form form = scrivaniaOperatoreBandiFrontendService.getFormBando(bando.getBandoId());
        IstanzaDomandaBando istanzaDomandaBando =
                istanzaDomandaBandoLocalService.getIstanzaDomandaBandoByDomandaBandoIdAndFormId(domandaBando.getDomandaBandoId(), form.getFormId());

        AlpacaJsonStructure alpacaStructure = null;
        FormData formData = null;

        String jsonForm = gson.toJson(gson.fromJson(istanzaDomandaBando.getJson(), FormData.class));
        formData = AlpacaUtil.loadFormData(form, jsonForm, true, themeDisplay.getPortalURL());
        alpacaStructure = formData.getAlpaca();

        // Sostituzione valore di data
        String data = gson.toJson(alpacaStructure.getData());
        JsonObject jsonData = gson.fromJson(data, JsonObject.class);
        alpacaStructure.setData(gson.toJsonTree(jsonData).getAsJsonObject());

        AlpacaUtil.convertiComponentiAlpacaStructure(alpacaStructure);
        // Carica la view se presente
        AlpacaUtil.loadView(alpacaStructure);

        //        renderRequest.setAttribute("alpacaStructure", alpacaStructure);

        renderRequest.setAttribute("alpacaStructureSchema", alpacaStructure.getSchema());
        renderRequest.setAttribute("alpacaStructureOptions", alpacaStructure.getOptions());
        renderRequest.setAttribute("alpacaStructureData", alpacaStructure.getData());
        renderRequest.setAttribute("alpacaStructureView", alpacaStructure.getView());
        renderRequest.setAttribute("apiAlpacaPath", themeDisplay.getPortalURL() + "/o/api/alpaca");
        renderRequest.setAttribute("obbligoAccreditamentoEnte", bando.isObbligoAccreditamentoEnte());

    }

