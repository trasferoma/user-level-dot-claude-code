                                DomandaBandoIntegrazione domandaBandoIntegrazione =
                                        domandaBandoIntegrazioneLocalService.fetchDomandaBandoIntegrazione(istanzaDomandaBandoId);
                                if (Validator.isNotNull(domandaBandoIntegrazione) && Validator.isNotNull(domandaBandoIntegrazione.getNumeroProtocollo())
                                        && Validator.isNotNull(domandaBandoIntegrazione.getDataProtocollo())) {
                                    azioneAbilitata = valoriPresenti.containsAll(nomiFormAnticipo) && !valoriPresenti
                                            .contains(ScrivaniaOperatoreBandiPortletKeys.DOCUMENTAZIONE_INTEGRATIVA_SECONDA_DOMANDA_DI_ANTICIPO.toUpperCase());
                                }
                            }
                        }

                    }
                }
            }

            return azioneAbilitata;
        }

        return false;
    }

