    private void handleTabDettagliPec(RenderRequest renderRequest, DomandaBando domandaBando, Bando bando) {
        String queryTabParent = ParamUtil.getString(renderRequest, "queryTabDettaglioPec", DettaglioPecTabEnum.DETTAGLIO_PEC_INGRESSO.getKey());
        DettaglioPecTabEnum dettaglioPecTabEnum = DettaglioPecTabEnum.parse(queryTabParent);
        renderRequest.setAttribute("queryTabDettaglioPec", queryTabParent);

        switch (dettaglioPecTabEnum) {
            case DETTAGLIO_PEC_INGRESSO:
                handleTabDettagliPecIngresso(renderRequest, domandaBando, bando);
                break;
            case DETTAGLIO_PEC_USCITA:
                handleTabDettagliPecUscita(renderRequest, domandaBando, bando);
                break;
            default:
                throw new RuntimeException("No tab val");
        }
    }

