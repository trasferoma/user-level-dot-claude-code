                        List.of(DatoAggiuntivoChiave.FORM_ESECUZIONE_NON_ABILITATO.name()));

        if (ListUtil.isNotEmpty(datiAggiuntivi)) {
            Set<String> valoriPresenti = datiAggiuntivi.stream()
                    .filter(Validator::isNotNull)
                    .map(dato -> dato.getValore().toUpperCase())
                    .collect(Collectors.toSet());

