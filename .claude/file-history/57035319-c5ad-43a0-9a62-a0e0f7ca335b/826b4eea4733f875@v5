    private boolean checkPresenzaRevoca(long domandaBandoId) {
        boolean checkPresenzaRevoca = false;

        if (domandaBandoId > 0) {
            List<AllegatoDomandaBando> listaAllegatiDomandaBando =
                    allegatoDomandaBandoLocalService.getListaAllegatoDomandaBandoByDomandaBandoIdAndVisibile(domandaBandoId, true);

            Optional<AllegatoDomandaBando> allegatoRevoca = listaAllegatiDomandaBando.stream()
                    .filter(o -> o.getTitolo().equalsIgnoreCase("revoca"))
                    .findFirst();
            if (allegatoRevoca.isPresent()) {
                checkPresenzaRevoca = true;
            }

        }
        return checkPresenzaRevoca;
    }

    private void handleTab(RenderRequest renderRequest, ServiceContext serviceContext, String queryTab, DomandaBando domandaBando, Bando bando)
            throws Exception {
        DettaglioDomandaBandoTabEnum tabEnum = DettaglioDomandaBandoTabEnum.parse(queryTab);

        // per il controllo delle scadenze allegati, sposto il caricamento indipendentemente dal tab cliccato
        handleTabAllegati(renderRequest, domandaBando);
        //il caricamento del form viene gestito in maniera indipendente dal tab cliccato
        //handleDomandaInserita(renderRequest, serviceContext, domandaBando, bando);
        switch (tabEnum) {
            case DATI_IDENTIFICATIVI:
                handleDatiIdentificativi(renderRequest, serviceContext, domandaBando, bando);
                break;
            case DOMANDA_INSERITA:
                handleDomandaInserita(renderRequest, serviceContext, domandaBando, bando);
                break;
            case ALLEGATI:
                //                handleTabAllegati(renderRequest, domandaBando);
                break;
            case COMMENTI:
                User user = userLocalService.getUserById(serviceContext.getUserId());
                scrivaniaOperatoreBandiFrontendService.setCommentiLetti(
                        domandaBando.getDomandaBandoId(),
                        user.getUserId(),
                        user.getFullName(),
                        serviceContext.getCompanyId(),
                        serviceContext.getScopeGroupId());
                handleTabCommenti(renderRequest, domandaBando);
                break;
            case ATTIVITA:
                handleTabAttivita(renderRequest, domandaBando);
                break;
            case INTEGRAZIONI:
                handleTabIntegrazioni(renderRequest, domandaBando);
                break;
            case VALUTAZIONI:
                handleTabValutazioni(renderRequest, domandaBando);
                break;
            case ANTICIPO:
                handleTabBando(renderRequest, domandaBando);
                break;
            case SALDO:
                handleTabBando(renderRequest, domandaBando);
                break;
            case RINUNCIA:
                handleTabBando(renderRequest, domandaBando);
                break;
            case DETTAGLIO_PEC:
                handleTabDettagliPec(renderRequest, domandaBando, bando);
                break;
            case SERVIZI_ESECUZIONE:
                handleTabServiziEsecuzione(renderRequest, domandaBando);
                break;
            default:
                throw new RuntimeException("No tab val");
        }
    }

