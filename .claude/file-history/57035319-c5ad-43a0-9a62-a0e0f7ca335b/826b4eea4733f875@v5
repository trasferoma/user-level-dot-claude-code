    private void handleTabDettagliPecIngresso(RenderRequest renderRequest, DomandaBando domandaBando, Bando bando) {
        try {
            if (Validator.isNotNull(domandaBando)) {
                Contesto contesto = Contesto.valueOf(bando.getContesto());
                VerificaMailRequest request = new VerificaMailRequest();
                request.setContesto(contesto);
                request.setTipoProtocolloClient(bando.getTipoProtocolloClient());

                if (Validator.isNotNull(domandaBando.getDataProtocollo()) && Validator.isNotNull(domandaBando.getNumeroProtocollo())) {
                    LocalDate localDate = domandaBando.getDataProtocollo()
                            .toInstant()
                            .atZone(ZoneId.systemDefault())
                            .toLocalDate();
                    int anno = localDate.getYear();
                    request.setNumeroProtocollo(domandaBando.getNumeroProtocollo());
                    request.setAnnoProtocollo(anno);
                } else {
                    renderRequest.setAttribute("datiPecDisponibiliIngresso", false);
                    return;
                }
                VerificaMailResponse response = protocolloService.verificaInvioMail(request, bando.getGroupId());

                if (Validator.isNotNull(response)) {

                    if (ListUtil.isNotNull(response.getAccettazioneOutList()) && ListUtil.isNotEmpty(response.getAccettazioneOutList())) {
                        renderRequest.setAttribute("listaAccettazioni", response.getAccettazioneOutList());
                        renderRequest.setAttribute("accettazioniCount", response.getAccettazioneOutList().size());
                    }

                    if (ListUtil.isNotNull(response.getConsegnaOutList()) && ListUtil.isNotEmpty(response.getConsegnaOutList())) {
                        renderRequest.setAttribute("listaConsegne", response.getConsegnaOutList());
                        renderRequest.setAttribute("consegneCount", response.getConsegnaOutList().size());
                    }

                    renderRequest.setAttribute("numMancateConsegne", response.getNumMancateConsegne());

                    if (ListUtil.isNotNull(response.getMancataConsegnaOutList()) && ListUtil.isNotEmpty(response.getMancataConsegnaOutList())) {
                        renderRequest.setAttribute("listaMancateConsegne", response.getMancataConsegnaOutList());
                        renderRequest.setAttribute("mancateConsegneCount", response.getMancataConsegnaOutList().size());
                    }
                    renderRequest.setAttribute("datiPecDisponibiliIngresso", true);
                }

            } else {
                renderRequest.setAttribute("datiPecDisponibiliIngresso", false);
            }
        } catch (Exception e) {
            _log.error("Errore durante il recupero dei dettagli PEC " + e.getMessage());
        }
    }

