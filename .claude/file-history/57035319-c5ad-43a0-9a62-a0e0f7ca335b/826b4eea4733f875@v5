    private boolean checkCompilazioneDomandaAnticipo(long domandaBandoId) {
        List<DomandaBandoDatoAggiuntivo> datiAggiuntivi =
                domandaBandoDatoAggiuntivoLocalService.getDomandaBandoDatoAggiuntivoByDomandaBandoIdAndChiave(
                        List.of(domandaBandoId),
                        List.of(DatoAggiuntivoChiave.FORM_ESECUZIONE_NON_ABILITATO.name()));

        if (ListUtil.isNotEmpty(datiAggiuntivi)) {

            //Inserisco in un set tutti i form di anticipo
            Set<String> nomiFormAnticipo = FormEsecuzione.getFormAnticipo()
                    .stream()
                    .filter(form -> !form.isAzioneIntermedia())
                    .map(Enum::name)
                    .collect(Collectors.toSet());

            //Filtro la lista dei valoriPresenti in domandaBandoAggiuntiva, se tutti i form sono presenti nella lista dei datiAggiuntivi vul dire che i form della fase di anticipo
            //sono stati tutti compilati
            Set<String> valoriPresenti = datiAggiuntivi.stream()
                    .filter(Validator::isNotNull)
                    .map(dato -> dato.getValore().toUpperCase())
                    .collect(Collectors.toSet());
            return valoriPresenti.containsAll(nomiFormAnticipo)
                    && !valoriPresenti.contains(ScrivaniaOperatoreBandiPortletKeys.DOCUMENTAZIONE_INTEGRATIVA_DOMANDA_DI_ANTICIPO.toUpperCase());
        }

        return false;
    }

