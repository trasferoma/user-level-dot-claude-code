    private void handleTabBando(RenderRequest renderRequest, DomandaBando domandaBando) throws PortalException {

        final String ANTICIPO = "anticipo";
        final String SALDO = "saldo";
        final String RINUNCIA = "rinuncia";

        int cur = ParamUtil.getInteger(renderRequest, "curIntegrazione", 1);
        int delta = ParamUtil.getInteger(renderRequest, "deltaIntegrazione", 10);
        long domandaBandoId = ParamUtil.getLong(renderRequest, "domandaBandoId");
        long bandoId = domandaBando.getBandoId();
        String tab = ParamUtil.getString(renderRequest, "queryTab");

        List<String> tipiForm = new ArrayList<>();
        List<IstanzaDomandaBando> listIstanzaDomandaBando = new ArrayList<>();

        if (tab.equalsIgnoreCase(ANTICIPO)) {
            tipiForm = Arrays.asList(TipoFormEnum.ESECUZIONE_PRIMO_ANTICIPO.name(),
                    TipoFormEnum.ESECUZIONE_SECONDO_ANTICIPO.name(),
                    TipoFormEnum.ESECUZIONE_ANTICIPO_INTEGRAZIONE.name(),
                    TipoFormEnum.ESECUZIONE_ANTICIPO.name());
            listIstanzaDomandaBando = scrivaniaOperatoreBandiFrontendService.getIstanzeEsecuzione(bandoId, domandaBandoId, tipiForm);
        } else if (tab.equalsIgnoreCase(SALDO)) {
            tipiForm = Arrays.asList(TipoFormEnum.ESECUZIONE_SALDO.name(), TipoFormEnum.ESECUZIONE_SALDO_INTEGRAZIONE.name());
            listIstanzaDomandaBando = scrivaniaOperatoreBandiFrontendService.getIstanzeEsecuzione(bandoId, domandaBandoId, tipiForm);
        } else if (tab.equalsIgnoreCase(RINUNCIA)) {
            tipiForm = Arrays.asList(TipoFormEnum.ESECUZIONE_RINUNCIA.name());
            listIstanzaDomandaBando = scrivaniaOperatoreBandiFrontendService.getIstanzeEsecuzione(bandoId, domandaBandoId, tipiForm);
        }

        List<EsecuzioneDTO> esecuzioneDTOList = listIstanzaDomandaBando.stream()
                .map(this::mapEsecuzione)
                .collect(Collectors.toList());

        int total = esecuzioneDTOList.size();
        int[] limits = PaginationUtil.calculateStartAndEnd(cur, delta, total);
        int start = limits[0];
        int end = limits[1];
        cur = limits[2];

        List<EsecuzioneDTO> paginated = esecuzioneDTOList.subList(
                Math.min(start, total),
                Math.min(end, total));

        renderRequest.setAttribute("istanzeEsecuzioneList", paginated);
        renderRequest.setAttribute("istanzeEsecuzioneCount", total);
        renderRequest.setAttribute("curIntegrazione", cur);
        renderRequest.setAttribute("deltaIntegrazione", delta);
    }

    private EsecuzioneDTO mapEsecuzione(IstanzaDomandaBando istanza) {
        Form form = formLocalService.fetchForm(istanza.getFormId());
        EsecuzioneDTO dto = new EsecuzioneDTO();
        DomandaBandoIntegrazione domandaIntegrazione = domandaBandoIntegrazioneLocalService.fetchDomandaBandoIntegrazione(istanza.getIstanzaDomandaBandoId());

        if (Validator.isNotNull(domandaIntegrazione)) {
            dto.setDataProtocollo(domandaIntegrazione.getDataProtocollo());
            dto.setNumeroProtocollo(domandaIntegrazione.getNumeroProtocollo());

            if (Validator.isNotNull(domandaIntegrazione.getDataProtocolloUscita())) {
                dto.setDataProtocolloUscita(domandaIntegrazione.getDataProtocolloUscita());
            }

            if (Validator.isNotNull(domandaIntegrazione.getNumeroProtocolloUscita())) {
                dto.setNumeroProtocolloUscita(domandaIntegrazione.getNumeroProtocolloUscita());
            }
        }

        dto.setIstanzaDomandaBandoId(istanza.getIstanzaDomandaBandoId());
        dto.setFormId(istanza.getFormId());
        dto.setCreateDate(istanza.getCreateDate());
        dto.setModifiedDate(istanza.getModifiedDate());
        dto.setUserName(istanza.getUserName());
        StatoIntegrazioneDomandaBandoEnum stato = StatoIntegrazioneDomandaBandoEnum.valueOf(istanza.getStato());
        dto.setStato(Validator.isNotNull(stato) ? stato.name() : " ");
        boolean validata = stato.equals(StatoIntegrazioneDomandaBandoEnum.CONFERMATA) || stato.equals(StatoIntegrazioneDomandaBandoEnum.VALIDATA);
        dto.setStatoCheck(validata);
        dto.setDescrizione(form.getNome());
        DomandaBando domandaBando = domandaBandoLocalService.fetchDomandaBando(istanza.getDomandaBandoId());
        Bando bando = bandoLocalService.fetchBando(domandaBando.getBandoId());
        List<BandoForm> bandoFormList = bandoFormLocalService.getBandoFormBandoAndForm(bando.getBandoId(), form.getFormId());
        if (ListUtil.isNotNull(bandoFormList) && ListUtil.isNotEmpty(bandoFormList) && bandoFormList.size() == 1) {
            BandoForm bandoForm = bandoFormList.get(0);
            TipoFormEnum tipoFormEnum = TipoFormEnum.valueOf(bandoForm.getTipoForm());
            dto.setIntegrazione(false);
            if (Validator.isNotNull(tipoFormEnum)) {
                dto.setIntegrazione(tipoFormEnum.isIntegrazione());
            }
        }

        if (Validator.isNotNull(istanza.getDataInvio())) {
            dto.setDataInvio(istanza.getDataInvio());
