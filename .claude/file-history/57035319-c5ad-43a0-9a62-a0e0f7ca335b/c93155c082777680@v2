package it.servizidigitali.presentatoreforms.bandi.frontend.portlet.render;

import com.google.gson.Gson;
import com.google.gson.JsonObject;
import com.liferay.portal.kernel.log.Log;
import com.liferay.portal.kernel.log.LogFactoryUtil;
import com.liferay.portal.kernel.portlet.bridges.mvc.MVCRenderCommand;
import com.liferay.portal.kernel.servlet.SessionErrors;
import com.liferay.portal.kernel.theme.ThemeDisplay;
import com.liferay.portal.kernel.util.ParamUtil;
import com.liferay.portal.kernel.util.WebKeys;

import java.util.List;

import javax.portlet.PortletException;
import javax.portlet.RenderRequest;
import javax.portlet.RenderResponse;

import org.osgi.service.component.annotations.Component;
import org.osgi.service.component.annotations.Reference;

import it.servizidigitali.audit.common.service.AuditService;
import it.servizidigitali.gestionebandi.common.model.AlpacaJsonStructure;
import it.servizidigitali.gestionebandi.common.model.FormData;
import it.servizidigitali.gestionebandi.model.Bando;
import it.servizidigitali.gestionebandi.model.DomandaBando;
import it.servizidigitali.gestionebandi.model.IstanzaDomandaBando;
import it.servizidigitali.gestionebandi.service.BandoLocalService;
import it.servizidigitali.gestionebandi.service.DomandaBandoLocalService;
import it.servizidigitali.gestionebandi.service.IstanzaDomandaBandoLocalService;
import it.servizidigitali.gestioneforms.model.DefinizioneAllegato;
import it.servizidigitali.gestioneforms.model.Form;
import it.servizidigitali.gestioneforms.service.DefinizioneAllegatoLocalService;
import it.servizidigitali.gestioneforms.service.FormLocalService;
import it.servizidigitali.presentatoreforms.bandi.common.model.AlpacaJsonOptionsStructure;
import it.servizidigitali.presentatoreforms.bandi.common.util.AlpacaUtil;
import it.servizidigitali.presentatoreforms.bandi.frontend.constants.PresentatoreFormsPortletKeys;
import it.servizidigitali.presentatoreforms.bandi.frontend.service.PresentatoreFormFrontendService;

@Component(//
        immediate = true, //
        property = { //
                "com.liferay.portlet.instanceable=true", //
                "javax.portlet.display-name=PresentatoreForms", //
                "javax.portlet.init-param.template-path=/", //
                "javax.portlet.init-param.view-template=/view.jsp", //
                "javax.portlet.name=" + PresentatoreFormsPortletKeys.PRESENTATOREFORMS, //
                "mvc.command.name=" + PresentatoreFormsPortletKeys.FORM_INTEGRATIVO_OPERATORE_RENDER_COMMAND//
        }, //
        service = MVCRenderCommand.class//
) //
public class CompilaFormIntegrativoOperatoreRenderCommand implements MVCRenderCommand {
        private static final Log log = LogFactoryUtil.getLog(CompilaFormIntegrativoOperatoreRenderCommand.class.getName());

        private static final Gson gson = new Gson();

        @Reference
        private PresentatoreFormFrontendService presentatoreFormFrontendService;

        @Reference
        private FormLocalService formLocalService;

        @Reference
        private DomandaBandoLocalService domandaBandoLocalService;

        @Reference
        private DefinizioneAllegatoLocalService definizioneAllegatoLocalService;

        @Reference
        private BandoLocalService bandoLocalService;

        @Reference
        private IstanzaDomandaBandoLocalService istanzaDomandaBandoLocalService;
        
        @Reference
    	private AuditService auditService;


        @Override
        public String render(RenderRequest request, RenderResponse response) throws PortletException {

                try {
                        ThemeDisplay themeDisplay = (ThemeDisplay) request.getAttribute(WebKeys.THEME_DISPLAY);

                        long domandaBandoId = ParamUtil.getLong(request, PresentatoreFormsPortletKeys.DOMANDABANDO_ID);
                        long formOperatoreId = ParamUtil.getLong(request, PresentatoreFormsPortletKeys.FORM_OPERATORE_ID);
                        String iPId = ParamUtil.getString(request,"iPId");
                        String frUrl = ParamUtil.getString(request,"frUrl");
                        String tipoModulo = ParamUtil.getString(request,"tipoModulo");

                        DomandaBando domandaBando = domandaBandoLocalService.getDomandaBando(domandaBandoId);
                        Bando bando = bandoLocalService.getBando(domandaBando.getBandoId());

                        Form form = formLocalService.getForm(formOperatoreId);
                        List<DefinizioneAllegato> defAllegati = definizioneAllegatoLocalService.getListaDefinizioneAllegatoByFormIdAndNotIstanzaAggiuntiva(form.getFormId());
                        form.setListaDefinizioneAllegato(defAllegati);

                        FormData formData = AlpacaUtil.loadFormData(form, null, true, themeDisplay.getPortalURL());

                        AlpacaJsonStructure alpacaStructure = convert(formData.getAlpaca());

                        if(tipoModulo.equalsIgnoreCase(PresentatoreFormsPortletKeys.DISCIPLINARE)
                                || tipoModulo.equalsIgnoreCase(PresentatoreFormsPortletKeys.DISCIPLINARE_ESECUZIONE)){
                                // Recupero il form principale
                                IstanzaDomandaBando istanzaFormPrincipale = presentatoreFormFrontendService.getIstanzaDomandaBandoPrincipaleByDomandaBandoId(domandaBando.getDomandaBandoId());
                                String jsonFormPrincipale = gson.toJson(gson.fromJson(istanzaFormPrincipale.getJson(), FormData.class));
                                FormData formDataPrincipale = AlpacaUtil.loadFormData(form, jsonFormPrincipale, true, themeDisplay.getPortalURL());
                                AlpacaJsonStructure alpacaStructurePrincipale = formDataPrincipale.getAlpaca();
                                String dataFormPrincipale = gson.toJson(alpacaStructurePrincipale.getData());
                                JsonObject jsonDataPrincipale = gson.fromJson(dataFormPrincipale, JsonObject.class);

                                JsonObject data = gson.fromJson(gson.toJson(alpacaStructure.getData()), JsonObject.class);
                                AlpacaJsonOptionsStructure optionStr = gson.fromJson(gson.toJson(alpacaStructure.getOptions()), AlpacaJsonOptionsStructure.class);

                                JsonObject dataEnrichCompilaDisciplinare = presentatoreFormFrontendService.enrichCompilaDisciplinare(data, optionStr, domandaBando, jsonDataPrincipale, tipoModulo);
                                alpacaStructure.setData(dataEnrichCompilaDisciplinare);
                        }

                        request.setAttribute(PresentatoreFormsPortletKeys.DISABLED, false);
                        request.setAttribute(PresentatoreFormsPortletKeys.DOMANDABANDO_ID, domandaBandoId);
                        request.setAttribute(PresentatoreFormsPortletKeys.ALPACA_STRUCTURE, alpacaStructure);
                        request.setAttribute(PresentatoreFormsPortletKeys.FORM_OPERATORE_ID, form.getFormId());
                        request.setAttribute(PresentatoreFormsPortletKeys.DENOMINAZIONE, form.getNome());
                        request.setAttribute("tipoModulo", tipoModulo);
                        request.setAttribute("titleArgs", new String[]{String.valueOf(domandaBando.getDomandaBandoId()), bando.getNome()});
                        request.setAttribute("dettaglioBandoURL", presentatoreFormFrontendService.getScrivaniaOperatorePathDomandaBando(domandaBandoId, iPId, frUrl));
                        request.setAttribute(PresentatoreFormsPortletKeys.API_ALPACA_PATH, themeDisplay.getPortalURL() + PresentatoreFormsPortletKeys.SERVIZI_DIGITALI_REST_CUSTOM_API_ALPACA_PATH);

                        return PresentatoreFormsPortletKeys.JSP_FORM_INTEGRATIVO_OPERATORE;

                } catch (Exception e) {
                		auditService.saveErrorLog(request, e.getMessage());
                        log.error(e);
                        SessionErrors.add(request, PresentatoreFormsPortletKeys.GENERIC_ERROR_MESSAGE_KEY, e.getMessage());
                        return PresentatoreFormsPortletKeys.JSP_ERROR;
                }

        }

        private AlpacaJsonStructure convert(AlpacaJsonStructure alpaca) {
                AlpacaJsonStructure converted = new AlpacaJsonStructure();
                converted.setData(asJsonObject(alpaca.getData()));
                converted.setOptions(asJsonObject(alpaca.getOptions()));
                converted.setSchema(asJsonObject(alpaca.getSchema()));
                converted.setView(asJsonObject(alpaca.getView()));
                return converted;
        }

        private JsonObject asJsonObject(Object data) {
                String json = gson.toJson(data);
                return gson.fromJson(json, JsonObject.class);
        }


}
