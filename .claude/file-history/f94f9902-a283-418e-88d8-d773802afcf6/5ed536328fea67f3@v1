	public AllegatoDomandaBando creaAllegatoDomanda(String idDocumentale, String nomeFile, String impronta, String titolo, String descrizione, String nomeServizio, long domandaBandoId, long istanzaDomandaBandoId,
													String firmatario, boolean firmatoDigitalmente, long definizioneAllegatoId, boolean principale, boolean visibile, long userId, String userName, long groupId, long companyId, EsitoVerificaFirma esitoVerificaFirma, String identificativo) {
		AllegatoDomandaBando allegatoDomandaBando = allegatoDomandaBandoLocalService.createAllegatoDomandaBando(counterLocalService.increment());

		if (Validator.isNotNull(idDocumentale)) {
			allegatoDomandaBando.setGroupId(groupId);
			allegatoDomandaBando.setCompanyId(companyId);
			allegatoDomandaBando.setUserId(userId);
			allegatoDomandaBando.setUserName(userName);
			allegatoDomandaBando.setDomandaBandoId(domandaBandoId);
			allegatoDomandaBando.setIdDocumentale(idDocumentale);
			allegatoDomandaBando.setPrincipale(principale);
			allegatoDomandaBando.setNome(nomeFile);
			allegatoDomandaBando.setImpronta(impronta);
			allegatoDomandaBando.setTitolo(titolo);
			allegatoDomandaBando.setDescrizione(descrizione);
			allegatoDomandaBando.setVisibile(visibile);
			allegatoDomandaBando.setDefinizioneAllegatoId(definizioneAllegatoId);
			allegatoDomandaBando.setIstanzaDomandaBandoId(istanzaDomandaBandoId);
			allegatoDomandaBando.setFirmatoDigitalmente(firmatoDigitalmente);
			allegatoDomandaBando.setFirmatario(firmatario);
			if (Validator.isNotNull(esitoVerificaFirma)) {
				allegatoDomandaBando.setEsitoVerificaFirma(esitoVerificaFirma.name());
			}
            if (Validator.isNotNull(identificativo)) {
                allegatoDomandaBando.setIdentificativo(identificativo);
            }

			allegatoDomandaBandoLocalService.updateAllegatoDomandaBando(allegatoDomandaBando);
		}
		
		return allegatoDomandaBando;
	}
	
	public void salvaDocumentoPrincipaleRichiesta(byte[] allegato, String impronta, String mimeType, Bando bando, long domandaBandoId, long istanzaDomandaBandoId, String firmatario, boolean firmatoDigitalmente, String userName, long userId, long groupId, long companyId, EsitoVerificaFirma esitoVerificaFirma)
			throws Exception {
		
		String estensione = "";
		
		if(Validator.isNotNull(mimeType) && (mimeType.equalsIgnoreCase(MimeTypesFirmaDigitale.P7S.getMimeType()) || mimeType.equalsIgnoreCase(MimeTypesFirmaDigitale.P7M.getMimeType()))) {
			estensione = ".p7m";
		}else {
			estensione = ".pdf";
		}

		String nomeFile = "Allegato ID " + domandaBandoId + estensione;
		String descrizione = "Domanda '" + bando.getNome() + "' - ID: " + domandaBandoId;
		String idDocumentale = null;
		try {
			if (Validator.isNotNull(allegato)) {
				InputStream stream = new ByteArrayInputStream(allegato);
				if (Validator.isNotNull(allegato)) {
					File savedFile = fileServiceFactory.getActiveFileService().saveRequestFile(nomeFile, nomeFile, descrizione, bando.getCodice(), domandaBandoId, stream, mimeType, userId, groupId);
					
					if (Validator.isNotNull(savedFile != null && savedFile.getId() != null)) {
						idDocumentale = savedFile.getId();
						creaAllegatoDomanda(savedFile.getId(), savedFile.getNome(), impronta, nomeFile, descrizione, bando.getNome(), domandaBandoId, istanzaDomandaBandoId, firmatario, firmatoDigitalmente, 0,true, true, userId, userName,
								groupId, companyId, esitoVerificaFirma, null);
					}
				}
			}
		}
		catch (Exception e) {
			log.error("Errore durante il caricamento del file firmato : " + e.getMessage(), e);
			//Se qualcosa e andato storto durante la creazione del file, elimino il file dal documentale
			if (Validator.isNotNull(idDocumentale)) {
				fileServiceFactory.getActiveFileService().deleteRequestFile(idDocumentale, groupId);
				throw new SalvataggioAllegatoBandoException("Caricamento del documento principale non eseguito correttamente", e);
			}
			throw new SalvataggioAllegatoBandoException("Caricamento del documento principale sul sistema documentale non eseguito correttamente", e);
		}
	}

	public VerificaResponse checkFirmaDigitaleDocumento(byte[] byteArray, String descrizione, String cfLoggato, List<TipoFirmaDigitale> tipiAmmessi, boolean sigilloQualificato, boolean verificaFirmaCf, long groupId, Contesto contesto, boolean verificaFirmaSoloDataOggi) throws PDFSignatureException {
		VerificaFirmaOptions options = new VerificaFirmaOptions();
		VerificaResponse response = null;
		options.setDescrizione(descrizione);
		options.setTipiFirmaAmmessi(tipiAmmessi.stream().map(Enum::name).collect(Collectors.toList()));
		options.setCfLoggato(cfLoggato);
		options.setVerificaSigilloQualificato(sigilloQualificato);
		options.setVerificaFirmaCf(verificaFirmaCf);

		try {
			response = firmaRemotaService.verificaFirma(groupId, contesto, byteArray, options);

			boolean verificaFirmaSuDataFineValidita = !verificaFirmaSoloDataOggi;
			boolean firmatoNonValido = response.isFirmatoNonValido();
			boolean presenzaDataFineValidita = response.getDataFineValidita() != null;

			if (verificaFirmaSuDataFineValidita && firmatoNonValido && presenzaDataFineValidita) {
				options.setDataFineValidita(response.getDataFineValidita());
				response = firmaRemotaService.verificaFirma(groupId, contesto, byteArray, options);
			}
		} catch (VerificaFirmaException e) {
			throw new PDFSignatureException(e.getMessage(), e);
		} catch (ServizioNonDisponibileException e) {
			log.error(e);
			throw new PDFSignatureException("Il servizio non è disponibile. Riprovare più tardi");
		}

		return response;
	}

	public VerificaResponse recuperaDettagliAllegato(long groupId, byte[] file, Contesto contesto){
