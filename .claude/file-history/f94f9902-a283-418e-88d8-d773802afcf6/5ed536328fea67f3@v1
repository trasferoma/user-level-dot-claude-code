	public AllegatoDomandaBando salvaAllegatoRichiesta(byte[] allegato, String impronta, String nomeFile, String titolo, Bando bando, long domandaBandoId, Long definizioneAllegatoId, long istanzaDomandaBandoId, String firmatario,
													   boolean firmatoDigitalmente, String userName,
													   long userId, long groupId, long companyId, EsitoVerificaFirma esitoVerificaFirma, String identificativo) throws Exception {
		
		AllegatoDomandaBando allegatoCreato = null;
		String idDocumentale = null;
		try {
			if (Validator.isNotNull(allegato)) {
				InputStream stream = new ByteArrayInputStream(allegato);
				if (Validator.isNotNull(allegato)) {
					String descrizione = null;
					if (definizioneAllegatoId != null && !definizioneAllegatoId.equals(0L)) {
						try {
							DefinizioneAllegato definizioneAllegato = definizioneAllegatoLocalService.getDefinizioneAllegato(definizioneAllegatoId);
							descrizione = "Allegato '" + definizioneAllegato.getDenominazione() + "'";
						}
						catch (PortalException e) {
							log.error("salvaAllegatiRichiesta :: " + e.getMessage(), e);
						}
					}

					String mimeType = MimeTypesUtil.getContentType(stream, nomeFile);
					File savedFile = fileServiceFactory.getActiveFileService().saveRequestFile(nomeFile, titolo, descrizione, bando.getCodice(), domandaBandoId, stream, mimeType, userId, groupId);
					if(Validator.isNotNull(savedFile) && Validator.isNotNull(savedFile.getId())) {
						idDocumentale = savedFile.getId();
						allegatoCreato = creaAllegatoDomanda(savedFile.getId(), nomeFile, impronta, titolo, descrizione, bando.getNome(), domandaBandoId, istanzaDomandaBandoId, firmatario, firmatoDigitalmente, definizioneAllegatoId, false, true, userId,
								userName, groupId, companyId, esitoVerificaFirma, identificativo);
					}
				}
			}
		}
		catch (Exception e) {
			log.error("Errore durante il caricamento del file : " + e.getMessage(), e);
			//Se qualcosa e andato storto durante la creazione del file, elimino il file dal documentale
			if (Validator.isNotNull(idDocumentale)) {
				fileServiceFactory.getActiveFileService().deleteRequestFile(idDocumentale, groupId);
				throw new SalvataggioAllegatoBandoException("Caricamento dell'allegato " + titolo + " non eseguito correttamente", e);
			}
			throw new SalvataggioAllegatoBandoException("Caricamento dell'allegato " + titolo + " non eseguito correttamente sul sistema documentale", e);
		}
		
		return allegatoCreato;

	}
	
	public DatiFileAllegato getModelloAllegato(long definizioneAllegatoId) {
		DatiFileAllegato modello = null;
		DefinizioneAllegato allegato = null;

		try {
			if (definizioneAllegatoId > 0) {
				allegato = definizioneAllegatoLocalService.getDefinizioneAllegato(definizioneAllegatoId);

				if (allegato.getFileEntryId() > 0) {
					FileEntry templateFileEntry = dlAppService.getFileEntry(allegato.getFileEntryId());

					if (Validator.isNotNull(templateFileEntry)) {
						modello = new DatiFileAllegato();
						modello.setFileName(templateFileEntry.getFileName());

						modello.setMimeType(templateFileEntry.getMimeType());
						InputStream isTemplate = templateFileEntry.getContentStream();

						if (Validator.isNotNull(isTemplate)) {
							modello.setContenuto(isTemplate.readAllBytes());
						}
						else {
							log.error("AllegatoRichiestaService :: getModelloAllegato :: Input stream modello NULL!");
						}
					}
					else {
						log.error("AllegatoRichiestaService :: getModelloAllegato :: fileEntry dell'allegato con ID : " + definizioneAllegatoId + " NULL");
					}
				}
			}

		}
		catch (Exception e) {
			log.error("Errore durante il recupero dell'allegato con id definizione : " + definizioneAllegatoId + e.getMessage(), e);
		}

		return modello;
	}
	
	public void deleteAllAllegati(long istanzaDomandaBandoId) {
		List<AllegatoDomandaBando> allegati = allegatoDomandaBandoLocalService.getListaAllegatiByIstanzaDomandaBandoId(istanzaDomandaBandoId).stream().filter(x -> x.getDefinizioneAllegatoId() != 0).collect(Collectors.toList());

		FileService activeFileService = fileServiceFactory.getActiveFileService();

		if(Validator.isNotNull(allegati) && !allegati.isEmpty()) {
			for (AllegatoDomandaBando ar : allegati) {
				activeFileService.deleteRequestFile(ar.getIdDocumentale(), ar.getGroupId());
				allegatoDomandaBandoLocalService.deleteAllegatoDomandaBando(ar);
			}
		}
	}
	
	public void deleteAllegato(long allegatoDomandaBandoId) {
		AllegatoDomandaBando allegato = null;
		try {
			allegato = allegatoDomandaBandoLocalService.getAllegatoDomandaBando(allegatoDomandaBandoId);
		} catch (PortalException e) {
			log.error("Allegato da eliminare non trovato :: " + e.getMessage(), e);
		}
		FileService activeFileService = fileServiceFactory.getActiveFileService();
		
		if (Validator.isNotNull(allegato)) {
			activeFileService.deleteRequestFile(allegato.getIdDocumentale(), allegato.getGroupId());
			allegatoDomandaBandoLocalService.deleteAllegatoDomandaBando(allegato);
		}
	}
