package it.servizidigitali.common.fdr.service.impl;

import com.liferay.portal.kernel.module.configuration.ConfigurationProvider;
import it.servizidigitali.common.fdr.client.FirmaRemotaClient;
import it.servizidigitali.common.fdr.configuration.FirmaRemotaCommonEnteConfiguration;
import it.servizidigitali.common.fdr.dto.VerificaFirmaOptions;
import it.servizidigitali.common.fdr.dto.VerificaResponse;
import it.servizidigitali.common.fdr.exception.VerificaFirmaException;
import it.servizidigitali.common.fdr.service.FirmaRemotaService;
import it.servizidigitali.common.utility.enumeration.Contesto;
import it.servizidigitali.common.utility.exception.FirmaDigitaleRemotaException;
import org.osgi.service.component.annotations.Component;
import org.osgi.service.component.annotations.Reference;
import org.osgi.service.component.annotations.ReferenceCardinality;

import java.util.List;
import java.util.Set;

/**
 * Implementazione del servizio di firma digitale remota.
 * Gestisce la selezione del client appropriato in base alla configurazione dell'ente
 * e delega le operazioni di firma e verifica al provider configurato.
 *
 * <p>Il servizio supporta piu provider di firma remota e seleziona quello corretto
 * in base alla configurazione {@link FirmaRemotaCommonEnteConfiguration}.</p>
 *
 * @author Servizi Digitali
 * @see FirmaRemotaService
 * @see FirmaRemotaClient
 */
@Component(service = FirmaRemotaService.class)
public class FirmaRemotaServiceImpl implements FirmaRemotaService {
    @Reference(cardinality = ReferenceCardinality.MULTIPLE)
    private volatile List<FirmaRemotaClient> firmaRemotaClient;
    @Reference
    private ConfigurationProvider configurationProvider;

    @Override
    public byte[] applicaSigillo(long groupId, long userId, Contesto contesto, byte[] pdf, String codiceOtpFirma, String password) {
        return getClient(groupId).signWithPades(groupId, userId, contesto, pdf, codiceOtpFirma, password);
    }

    @Override
    public VerificaResponse verificaFirma(long groupId, Contesto contesto, byte[] file, VerificaFirmaOptions options) {
        FirmaRemotaClient client = getClient(groupId);
        VerificaResponse response = client.verificaDocumentoFirmato(groupId, contesto, file, options.getDataFineValidita());

        boolean firmatoNonValido = response.isFirmatoNonValido();
        boolean presenzaDataFineValidita = response.getDataFineValidita() != null;
        boolean verificaFirmaSuDataFineValidita = options.isVerificaFirmaSuDataFineValidita();

        if (firmatoNonValido && verificaFirmaSuDataFineValidita && presenzaDataFineValidita) {
            response = client.verificaDocumentoFirmato(groupId, contesto, file, response.getDataFineValidita());
        }

        Set<String> cfFirme = response.getFirme();

        if (cfFirme.isEmpty()) {
            throw new VerificaFirmaException(String.format("%s non risulta firmato digitalmente o non ha una firma valida", options.getDescrizione()));
        }

        if (!options.getTipiFirmaAmmessi().contains(response.getTipoFirma())) {
            throw new VerificaFirmaException(String.format("%s ha un tipo di firma non accettato", options.getDescrizione()));
        }
//jester
        /*
        if (options.isVerificaSigilloQualificato()) {
            if(!response.isSigilloQualificato()) {
                throw new VerificaFirmaException(String.format("%s non presenta un sigillo qualificato", options.getDescrizione()));
            }
        }
         */

        if (options.isVerificaFirmaCf()) {
            String cfLoggato = options.getCfLoggato().toUpperCase();
            if (!cfFirme.contains(cfLoggato)) {
                throw new VerificaFirmaException(String.format("%s non risulta firmato dall'utente loggato", options.getDescrizione()));
            }
        }

        return response;
    }

    @Override
    public VerificaResponse recuperaImpronta(long groupId, Contesto contesto, byte[] file) {
        return getClient(groupId).verificaDocumentoFirmato(groupId, contesto, file, 0);
    }

    private FirmaRemotaClient getClient(long groupId) {
        try {
            final List<FirmaRemotaClient> clients = firmaRemotaClient;

            FirmaRemotaCommonEnteConfiguration configuration = configurationProvider.getGroupConfiguration(FirmaRemotaCommonEnteConfiguration.class, groupId);

            if (configuration.provider() == null) {
                throw new FirmaDigitaleRemotaException("Provider non configurato");
            }

            return clients.stream()
                    .filter(o -> o.getProviderName().equals(configuration.provider()))
                    .findFirst()
                    .orElseThrow();
        } catch (Exception e) {
            throw new FirmaDigitaleRemotaException(e.getMessage(), e);
        }
    }
}