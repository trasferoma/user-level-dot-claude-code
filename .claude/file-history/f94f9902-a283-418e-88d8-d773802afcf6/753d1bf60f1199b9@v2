/**
 * Implementazione REST del client di firma digitale remota.
 * Gestisce l'integrazione con il servizio di firma remota esposto tramite API REST
 * attraverso la piattaforma API Puglia.
 *
 * <p>Il client supporta:</p>
 * <ul>
 *   <li>Firma digitale PAdES di documenti PDF con autenticazione OTP</li>
 *   <li>Verifica di documenti firmati digitalmente con estrazione dei certificati</li>
 *   <li>Configurazione flessibile per firme visibili con posizionamento personalizzato</li>
 * </ul>
 *
 * <p>L'autenticazione al servizio avviene tramite token OAuth2 ottenuto da API Puglia.
 * Le credenziali di firma possono essere configurate a livello di ente o recuperate
 * dagli attributi custom (expando) dell'utente Liferay.</p>
 *
 * @author Servizi Digitali
 * @see FirmaRemotaClient
 * @see FirmaRemotaRestEnteConfiguration
 */
@Component(service = FirmaRemotaClient.class)
public class FirmaRemotaRestClient implements FirmaRemotaClient {
    private static final String FLAG_YES = "1";
    private static final String CF_FIRMA_PREFIX = "TINIT-";
    private static final int MAX_RETRIES = 2;
    private static final Duration CONNECT_TIMEOUT = Duration.ofSeconds(30);
    private static final Duration REQUEST_TIMEOUT = Duration.ofSeconds(120);
    public static final String PARAMETRI_REST_VERIFICA_DOCUMENTO_FIRMATO = "?ts_date_validity=%d&codice_sigillo=ANY";

    @Reference
    private ApiPugliaService apiPugliaService;
    @Reference
    private ConfigurationProvider configurationProvider;
    @Reference
    private UserLocalService userLocalService;

    private static final Log _log = LogFactoryUtil.getLog(FirmaRemotaRestClient.class);

    @Override
    public String getProviderName() {
        return "REST";
    }

    @Override
    public byte[] signWithPades(long groupId, long userId, Contesto contesto, byte[] pdf, String codiceOtpFirma, String password) {
        try {
            FirmaRemotaRestEnteConfiguration configuration = configurationProvider.getGroupConfiguration(FirmaRemotaRestEnteConfiguration.class, groupId);

            AmbienteRiferimento ambiente = AmbienteRiferimento.valueOf(configuration.ambienteRiferimento());
            String accessToken = apiPugliaService.getToken(groupId, ambiente, contesto);
            Auth auth = createAuth(configuration, userId, codiceOtpFirma, password);
            PadesParam padesParam = createPadesParam(configuration, userId);

            ObjectMapper objectMapper = new ObjectMapper();
            String authJson = objectMapper.writeValueAsString(auth);
            String padesParamJson = objectMapper.writeValueAsString(padesParam);

            List<MultiPartRecord> records = List.of(
                    new MultiPartRecord("file", ContentTypes.APPLICATION_PDF, new ByteArrayInputStream(pdf), null),
                    new MultiPartRecord("auth", ContentTypes.APPLICATION_JSON, new ByteArrayInputStream(authJson.getBytes(StandardCharsets.UTF_8)), null),
                    new MultiPartRecord("padesParam", ContentTypes.APPLICATION_JSON, new ByteArrayInputStream(padesParamJson.getBytes(StandardCharsets.UTF_8)), null)
            );

            MultiPartBody body = MultiPartBodyBuilder.build(records);

            String url = configuration.getServiceBaseURL().concat(configuration.getServiceApposizioneFirmaPath());
            HttpRequest httpRequest = HttpRequest.newBuilder()
                    .uri(new URI(url))
                    .method("POST", HttpRequest.BodyPublishers.ofByteArray(body.getData()))
                    .header("Accept", ContentTypes.APPLICATION_PDF)
                    .header("Authorization", "Bearer " + accessToken)
                    .header("Content-Type", "multipart/form-data; boundary=" + body.getBoundary())
                    .timeout(REQUEST_TIMEOUT)
                    .build();

            HttpClient httpClient = HttpClient.newBuilder()
                    .version(HttpClient.Version.HTTP_1_1)
                    .connectTimeout(CONNECT_TIMEOUT)
                    .build();

            _log.info("Chiamata al servizio di firma. Endpoint : "+url);

            HttpResponse<byte[]> httpResponse = sendWithRetry(httpClient, httpRequest, HttpResponse.BodyHandlers.ofByteArray());

            if (httpResponse.statusCode() != 200) {
                String errorBody = new String(httpResponse.body(), StandardCharsets.UTF_8);
                _log.error("Errore durante la firma digitale - Status: " + httpResponse.statusCode() + " - Response: " + errorBody);
                throw new FirmaDigitaleRemotaException();
            }

            return httpResponse.body();
        } catch (FirmaDigitaleRemotaException e) {
            throw e;
        } catch (Exception e) {
            _log.error("Errore durante la firma digitale", e);
            throw new FirmaDigitaleRemotaException();
        }
    }

    @Override
    public VerificaResponse verificaDocumentoFirmato(long groupId, Contesto contesto, byte[] fileBytes, long dataConfronto) {
        try {
            FirmaRemotaRestEnteConfiguration configuration = configurationProvider.getGroupConfiguration(FirmaRemotaRestEnteConfiguration.class, groupId);
            AmbienteRiferimento ambiente = AmbienteRiferimento.valueOf(configuration.ambienteRiferimento());

            String parametri = String.format(PARAMETRI_REST_VERIFICA_DOCUMENTO_FIRMATO, dataConfronto);

            String url = configuration.getServiceBaseURL()
                    .concat(configuration.getServiceVerificaFirmaPath())
                    .concat(parametri);

            _log.info("verificaDocumentoFirmato - URL: " + url + " groupId: " + groupId
                    + " ambiente: " + ambiente + " contesto: " + contesto);

            HttpResponse<String> httpResponse = executeVerifica(groupId, ambiente, contesto, fileBytes, url);

            // Retry su 401: invalida cache token e riprova con token fresco
            if (httpResponse.statusCode() == 401) {
                _log.warn("verificaDocumentoFirmato - 401 ricevuto, invalido cache e riprovo. Response: " + httpResponse.body());
                apiPugliaService.invalidateToken(groupId, ambiente, contesto);
                httpResponse = executeVerifica(groupId, ambiente, contesto, fileBytes, url);
            }

            if (httpResponse.statusCode() != 200) {
                String errorBody = httpResponse.body();
                _log.error("Errore durante la verifica della firma - Status: " + httpResponse.statusCode() + " - Response: " + errorBody);
                throw new RuntimeException("Si è verificato un errore durante la verifica della firma digitale.");
            }

            ObjectMapper objectMapper = new ObjectMapper();
            VerificationResponse response = objectMapper.readValue(httpResponse.body(), VerificationResponse.class);
            return mapResponse(response);
        } catch (Exception e) {
            _log.error("Errore durante la verifica della firma digitale", e);
            throw new RuntimeException("Si è verificato un errore durante la verifica della firma digitale.", e);
        }
    }

    private HttpResponse<String> executeVerifica(long groupId, AmbienteRiferimento ambiente, Contesto contesto,
                                                  byte[] fileBytes, String url) throws Exception {
        String accessToken = apiPugliaService.getToken(groupId, ambiente, contesto);

        _log.info("executeVerifica - tokenNull: " + (accessToken == null)
                + " tokenEmpty: " + (accessToken != null && accessToken.isEmpty()));

        String mimeType = MimeTypesUtil.getContentType(new ByteArrayInputStream(fileBytes), null);

        List<MultiPartRecord> records = List.of(
                new MultiPartRecord("file", mimeType, new ByteArrayInputStream(fileBytes), null)
        );

        MultiPartBody body = MultiPartBodyBuilder.build(records);

        HttpRequest httpRequest = HttpRequest.newBuilder()
                .uri(new URI(url))
                .method("POST", HttpRequest.BodyPublishers.ofByteArray(body.getData()))
                .header("Accept", ContentTypes.APPLICATION_JSON)
                .header("Authorization", "Bearer " + accessToken)
                .header("Content-Type", "multipart/form-data; boundary=" + body.getBoundary())
                .timeout(REQUEST_TIMEOUT)
                .build();

        HttpClient httpClient = HttpClient.newBuilder()
                .version(HttpClient.Version.HTTP_1_1)
                .connectTimeout(CONNECT_TIMEOUT)
                .build();

        return sendWithRetry(httpClient, httpRequest, HttpResponse.BodyHandlers.ofString());
    }

    private static VerificaResponse mapResponse(VerificationResponse verificationResponse) {
        Set<String> cfFirme = Optional.ofNullable(verificationResponse.getCertificati())
                .orElse(Collections.emptyList())
                .stream()
                .filter(Certificato::getValido)
                .map(Certificato::getCffirmatario)
                .filter(Objects::nonNull)
                .map(s -> s.replace(CF_FIRMA_PREFIX, StringPool.BLANK))
                .collect(Collectors.toSet());
        Set<String> firmatari = Optional.ofNullable(verificationResponse.getCertificati())
                .orElse(Collections.emptyList())
                .stream()
                .filter(Certificato::getValido)
                .map(Certificato::getFirmatario)
                .filter(Objects::nonNull)
                .collect(Collectors.toSet());

        VerificaResponse response = new VerificaResponse();
        response.setFirmato(verificationResponse.getFirmato());
        response.setFirmaValida(verificationResponse.getFirmaValida());
        response.setImpronta(verificationResponse.getImpronta());
        response.setTipoFirma(verificationResponse.getTipoFirma());
        response.setSigilloQualificato(verificationResponse.getSigilloQualificato());
        response.setFirme(cfFirme);
        response.setFirmatari(firmatari);
        response.setDataFineValidita(extractDataFineValidita(verificationResponse.getCertificati()));
        return response;
    }

    private static Long extractDataFineValidita(List<Certificato> certificati) {
        if (certificati == null || certificati.isEmpty()) {
            return null;
        }

        Long dataFineValiditaPiuLontana = null;
        for (Certificato certificato : certificati) {
            String dataFineValidita = certificato.getDataFineValidita();
            if (dataFineValidita == null || dataFineValidita.isEmpty()) {
                continue;
            }

            long epoch = dateToEpoch(dataFineValidita);
            if (dataFineValiditaPiuLontana == null || epoch > dataFineValiditaPiuLontana) {
                dataFineValiditaPiuLontana = epoch;
            }
        }

        return dataFineValiditaPiuLontana;
    }

    private static long dateToEpoch(String dataFineValidita) {
        try {
            SimpleDateFormat sdf = new SimpleDateFormat("EEE MMM dd HH:mm:ss zzz yyyy", Locale.ENGLISH);
            Date dataFine = sdf.parse(dataFineValidita);
            return dataFine.getTime();
        } catch (ParseException e) {
            throw new RuntimeException(e);
        }
    }

    private <T> HttpResponse<T> sendWithRetry(HttpClient httpClient, HttpRequest httpRequest, HttpResponse.BodyHandler<T> bodyHandler) throws IOException, InterruptedException {
        IOException lastException = null;
        for (int attempt = 0; attempt <= MAX_RETRIES; attempt++) {
            try {
                return httpClient.send(httpRequest, bodyHandler);
            } catch (IOException e) {
                lastException = e;
                if (attempt < MAX_RETRIES) {
                    long waitMs = (long) Math.pow(2, attempt) * 1000;
                    _log.warn("Errore I/O durante la chiamata al servizio di firma, tentativo " + (attempt + 1) + "/" + (MAX_RETRIES + 1) + ". Retry tra " + waitMs + "ms", e);
                    Thread.sleep(waitMs);
                }
            }
        }
        throw lastException;
    }

    private Auth createAuth(FirmaRemotaRestEnteConfiguration configuration, long userId, String codiceOtpFirma, String password) throws Exception{
        String codiceCertificato = configuration.getSignCodiceCertificato();
        String codiceFiscale = configuration.getSignCodiceFiscale();
        String passwordSign = configuration.getSignPassword();
        String otpPassword = configuration.getSignOtp();

        if(userId > 0){
            User user = userLocalService.fetchUser(userId);
            String codiceCertificatoAttr = "codiceCertificato";
            String codiceFiscaleAttr = "codiceFiscale";
            if(Validator.isNotNull(user) && Validator.isNotNull(codiceOtpFirma) && Validator.isNotNull(password)){
                ExpandoBridge expandoBridge = user.getExpandoBridge();
                String codiceCertificatoExpando = (String) expandoBridge.getAttribute(codiceCertificatoAttr);
                String codiceFiscaleExpando = (String) expandoBridge.getAttribute(codiceFiscaleAttr);

                if(Validator.isNotNull(codiceCertificatoExpando)){
                    codiceCertificato = codiceCertificatoExpando;
                }

                if(Validator.isNotNull(codiceFiscaleExpando)){
                    codiceFiscale = codiceFiscaleExpando;
                }

                if(Validator.isNotNull(password)){
                    passwordSign = password;
                }

                if(Validator.isNotNull(codiceOtpFirma) && !codiceOtpFirma.isEmpty()){
                    otpPassword = codiceOtpFirma;
                }

                if(Validator.isNull(codiceCertificato) || Validator.isNull(codiceFiscale) || Validator.isNull(password) || Validator.isNull(otpPassword)){
                    throw new Exception("Credenziali FDR operatore mancanti! Controllare configurazione utenza");
                }
            }
        }

        Auth signatureAuth = new Auth();
        signatureAuth.setCodiceCertificato(codiceCertificato);
        signatureAuth.setCodiceFiscale(codiceFiscale);
        signatureAuth.setPassword(passwordSign);
        if (Validator.isNotNull(otpPassword) && !otpPassword.isEmpty()) {
            signatureAuth.setOtp(otpPassword);
        }
        return signatureAuth;
    }

    private PadesParam createPadesParam(FirmaRemotaRestEnteConfiguration configuration, long userId) {
        PadesParam padesParam = new PadesParam();
        padesParam.setFlagVisibile(FLAG_YES.equals(configuration.isSignVisible()));

        if(userId > 0){
            padesParam.setPage(Integer.parseInt(configuration.getSignPageOperatore()));
            padesParam.setLeftx(Integer.parseInt(configuration.getSignLeftXOperatore()));
            padesParam.setLefty(Integer.parseInt(configuration.getSignLeftYOperatore()));
            padesParam.setRightx(Integer.parseInt(configuration.getSignRightXOperatore()));
            padesParam.setRighty(Integer.parseInt(configuration.getSignRightYOperatore()));
        }else{
            padesParam.setPage(Integer.parseInt(configuration.getSignPage()));
            padesParam.setLeftx(Integer.parseInt(configuration.getSignLeftX()));
            padesParam.setLefty(Integer.parseInt(configuration.getSignLeftY()));
            padesParam.setRightx(Integer.parseInt(configuration.getSignRightX()));
            padesParam.setRighty(Integer.parseInt(configuration.getSignRightY()));
        }


        padesParam.setPadesProfile(PadesProfile.PADESBES);
        return padesParam;
    }
}
