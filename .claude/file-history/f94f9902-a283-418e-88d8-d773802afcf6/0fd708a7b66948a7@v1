    /**
     * Verifica lo stesso documento firmato da noi due volte: prima con ts_date_validity=0 (validita
     * controllata a oggi), poi con ts_date_validity = epoch della data di fine validita del certificato
     * (validita controllata a quella data). Serve a osservare come cambia l'esito al variare del parametro.
     */
    @Test
    public void verificaDocumentoFirmatoOggi_verificaModalitaOggiPiuDataFineValidita_nonValido() throws Exception {
        HttpClient httpClient = HttpClient.newBuilder()
                .version(HttpClient.Version.HTTP_1_1)
                .connectTimeout(CONNECT_TIMEOUT)
                .build();

        String accessToken = ottieniToken(httpClient);
        assertThat(accessToken).as("access_token").isNotBlank();

        byte[] pdfFirmato = firmaDocumento(httpClient, accessToken);

        HttpResponse<String> verificaOggi = verificaDocumento(httpClient, accessToken, pdfFirmato, 0L);
        System.out.println("=== VERIFICA ts=0 (oggi) - Status: " + verificaOggi.statusCode() + " ===");
        System.out.println(verificaOggi.body());

        assertThat(verificaOggi.body()).as("firma considerata non valida perchè firmato prima di oggi")
                .contains("\"firmaValida\":false");

        String dataFineValidita = estraiDataFineValidita(verificaOggi.body());
        assertThat(dataFineValidita).as("dataFineValidita dal certificato").isNotBlank();
        long tsDateValidity = dateToEpochTest(dataFineValidita);

        HttpResponse<String> verificaAllaScadenza = verificaDocumento(httpClient, accessToken, pdfFirmato, tsDateValidity);
        System.out.println("=== VERIFICA ts=" + tsDateValidity + " (" + dataFineValidita + ") - Status: " + verificaAllaScadenza.statusCode() + " ===");
        System.out.println(verificaAllaScadenza.body());

        assertThat(verificaAllaScadenza.statusCode()).as("HTTP status verifica con ts").isEqualTo(200);
        assertThat(verificaAllaScadenza.body()).as("firma considerata non valida perchè firmato oltre la scadenza")
                .contains("\"firmaValida\":false");
    }

