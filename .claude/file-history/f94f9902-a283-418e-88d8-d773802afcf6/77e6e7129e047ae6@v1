import it.servizidigitali.gestionebandi.service.DomandaBandoLocalService;
import it.servizidigitali.gestionebandi.service.IstanzaDomandaBandoLocalService;
import it.servizidigitali.gestioneforms.model.Form;
import it.servizidigitali.gestioneforms.service.FormLocalService;
import it.servizidigitali.presentatoreforms.bandi.common.service.AllegatoDomandaBandoService;
import it.servizidigitali.presentatoreforms.bandi.common.service.integration.input.jsonenrich.model.UserPreferences;
