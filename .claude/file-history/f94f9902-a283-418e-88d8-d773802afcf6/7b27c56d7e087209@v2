    @Override
    public boolean existsRichiesta(long richiestaId) {
        try {
            DomandaBando domandaBando = getDomandaBandoLocalService().fetchDomandaBando(richiestaId);
            if (Validator.isNotNull(domandaBando)) {
                Bando bando = getBandoLocalService().getBando(domandaBando.getBandoId());
                TipologiaBando tipologiaBando = getTipologiaBandoLocalService().getTipologiaBando(bando.getTipologiaBandoId());
                return getDominio().name().equals(tipologiaBando.getDominio());
            }
            return false;
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
    }

    @Override
    public boolean istanzePresenti(long bandoId, String partitaIva) {
        return getDomandaBandoLocalService().countIstanzePresenti(bandoId, partitaIva, false) > 0;
    }

    @Override
    public Contesto getContestoByProcedimento(long idProcedimento, long groupId) {
        try {
            Bando bando = getBandoLocalService().getBando(idProcedimento);
            return Contesto.valueOf(bando.getContesto());
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
    }

    @Override
    public boolean isVerificaFirmaSoloDataOggi(RichiestaReferenteIstanza richiestaReferenteIstanza) {
        long bandoId = richiestaReferenteIstanza.getServizioId();
        return getDatoBandoService().isVerificaFirmaSoloDataOggiByBandoId(bandoId);
    }

    @Override
    public RichiestaDTO getRichiesta(long richiestaId) {
        try {
            DomandaBando domandaBando = getDomandaBandoLocalService().getDomandaBando(richiestaId);
            return getDomandaBandoToRichiestaDTOTransformer().transform(domandaBando);
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
    }

    @Override
    public ServizioDTO getServizio(long richiestaId) {
        try {
            DomandaBando domandaBando = getDomandaBandoLocalService().getDomandaBando(richiestaId);
            return getServizioByProcedimento(domandaBando.getBandoId());
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
    }

    @Override
    public ServizioDTO getServizioByProcedimento(long idProcedimento) {
        try {
            Bando bando = getBandoLocalService().getBando(idProcedimento);

            ServizioDTO servizioDTO = new ServizioDTO();
            servizioDTO.setCodiceServizio(bando.getCodice());
            servizioDTO.setServizioId(bando.getBandoId());
            servizioDTO.setNome(bando.getNome());
            return servizioDTO;
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
    }

    @Override
    public ProtocolloRequest createProtocolloRequest(RichiestaReferenteIstanza richiestaReferenteIstanza) {
        try {
            ProtocolloRequest protocolloRequest = new ProtocolloRequest();

            DomandaBando domandaBando = risolviDomandaBando(richiestaReferenteIstanza);
            Bando bando = getBandoLocalService().getBando(domandaBando.getBandoId());

            if (Validator.isNotNull(bando.getTipoDocumento())) {
                protocolloRequest.setTipoDocumento(bando.getTipoDocumento());
            }

            if (Validator.isNotNull(bando.getMittenteInterno())) {
                protocolloRequest.setMittenteInterno(bando.getMittenteInterno());
            }

            if (Validator.isNotNull(bando.getInCaricoA())) {
                protocolloRequest.setInCaricoA(bando.getInCaricoA());
            }

            if (Validator.isNotNull(bando.getClassifica())) {
                protocolloRequest.setClassifica(bando.getClassifica());
            }

            if (Validator.isNotNull(bando.getTipoProtocolloClient())) {
                protocolloRequest.setTipoProtocolloClient(bando.getTipoProtocolloClient());
            }

            String oggetto = bando.getNome();
            protocolloRequest.setOggetto(oggetto);

            if (bando.isAbilitaSottoFascicolazione()) {
                SottoFascicoloRequest sottoFascicoloRequest = new SottoFascicoloRequest();
                sottoFascicoloRequest.setContesto(Contesto.valueOf(bando.getContesto()));
                sottoFascicoloRequest.setGroupId(domandaBando.getGroupId());
                sottoFascicoloRequest.setCodiceAoo(bando.getCodiceAOO());
                sottoFascicoloRequest.setFascicoloId(bando.getIdPratica());
                sottoFascicoloRequest.setClassifica(bando.getClassifica());
                sottoFascicoloRequest.setUfficioResp(bando.getMittenteInterno());
                sottoFascicoloRequest.setiFA(bando.isIFA());
                sottoFascicoloRequest.setTipoProtocolloClient(bando.getTipoProtocolloClient());
                sottoFascicoloRequest.setOggetto("Cambio referente " + richiestaReferenteIstanza.getRichiestaReferenteIstanzaId());
                String idSottoFascicolo = getProtocolloService().creaSottoFascicolo(sottoFascicoloRequest);

                if (Validator.isNotNull(idSottoFascicolo)) {
                    protocolloRequest.setIdPratica(idSottoFascicolo);

                    RichiestaReferenteIstanza richiestaReferenteIstanzaModel = getRichiestaReferenteIstanzaLocalService()
                            .getRichiestaReferenteIstanza(richiestaReferenteIstanza.getRichiestaReferenteIstanzaId());
                    richiestaReferenteIstanzaModel.setIdSottoFascicolo(idSottoFascicolo);
                    getRichiestaReferenteIstanzaLocalService().updateRichiestaReferenteIstanza(richiestaReferenteIstanzaModel);
                } else if (Validator.isNotNull(bando.getIdPratica())) {
                    protocolloRequest.setIdPratica(bando.getIdPratica());
                }
            } else {
                if (Validator.isNotNull(bando.getIdPratica())) {
                    protocolloRequest.setIdPratica(bando.getIdPratica());
                }
            }

            List<AllegatoReferenteIstanza> allegatiPrincipale = getAllegatoReferenteIstanzaLocalService().getByRichiestaReferenteIdAndPrincipale(richiestaReferenteIstanza.getRichiestaReferenteIstanzaId(), true);
            if (allegatiPrincipale != null && !allegatiPrincipale.isEmpty()) {
                protocolloRequest.setDocumento(getDocumentoProtocollo(allegatiPrincipale.get(0)));
            }

            List<AllegatoReferenteIstanza> allegatiDomandaBando = getAllegatoReferenteIstanzaLocalService().getByRichiestaReferenteIdAndPrincipale(richiestaReferenteIstanza.getRichiestaReferenteIstanzaId(), true);
            if (allegatiDomandaBando != null && !allegatiDomandaBando.isEmpty()) {
                List<Documento> allegati = new ArrayList<Documento>();
                for (AllegatoReferenteIstanza allegatoDomandaBando : allegatiDomandaBando) {
                    allegati.add(getDocumentoProtocollo(allegatoDomandaBando));
                }
                protocolloRequest.setAllegati(allegati);
            }

            Origine origine = new Origine();

            IndirizzoTelematico indirizzoTelematico = new IndirizzoTelematico();
            indirizzoTelematico.setValore(domandaBando.getEmail());
            origine.setIndirizzoTelematico(indirizzoTelematico);

            Persona persona = new Persona();
            TipoPersona tipoPersona = TipoPersona.FISICA;
            if (Validator.isNotNull(domandaBando.getPartitaIva())) {
                tipoPersona = TipoPersona.GIURIDICA;
                persona.setPartitaIva(domandaBando.getPartitaIva());
            }

            persona.setTipoPersona(tipoPersona);

            persona.setCodiceFiscale(domandaBando.getCodiceFiscale());
            persona.setDenominazione(domandaBando.getUserName());

            Mittente mittente = new Mittente();
            mittente.setPersona(persona);
            origine.setMittente(mittente);
            protocolloRequest.setOrigine(origine);

            protocolloRequest.setCanaleProtocollo(null);
            String codiceIstanzaPortale = bando.getCodice() + "/" + richiestaReferenteIstanza.getRichiestaReferenteIstanzaId();
            String tipoIstanzaPortale;
            if (getDominio().equals(DominioIstanza.BANDI)) {
                tipoIstanzaPortale = "BANDI_CAMBIO_REFERENTE";
            } else {
                tipoIstanzaPortale = "EVENTI_CAMBIO_REFERENTE";
            }

            protocolloRequest.setCodiceIstanzaPortale(codiceIstanzaPortale);
            protocolloRequest.setTipoIstanzaPortale(tipoIstanzaPortale);

            if (Validator.isNotNull(bando.getCodiceAOO())) {
                protocolloRequest.setCodiceAOO(bando.getCodiceAOO());
            }

            if (Validator.isNotNull(bando.getCodiceUO())) {
                protocolloRequest.setCodiceUO(bando.getCodiceUO());
            }
            protocolloRequest.setContesto(Contesto.valueOf(bando.getContesto()));

            return protocolloRequest;
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
    }

    @Override
    public List<String> getGruppiReferenti(RichiestaDTO richiestaDTO) {
        try {
            DomandaBando domandaBando = getDomandaBandoLocalService().getDomandaBando(richiestaDTO.getRichiestaId());
            Bando bando = getBandoLocalService().getBando(domandaBando.getBandoId());
            List<SottoOrganizzazione> sottoOrganizzazioneList = getSottoOrganizzazioneLocalService().getListSottoOrganizzazioneByBandoId(bando.getBandoId());
            return sottoOrganizzazioneList.stream()
                    .map(SottoOrganizzazioneModel::getSubOrganizationId)
                    .map(String::valueOf)
                    .collect(Collectors.toList());
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
    }

    @Override
    public void aggiornaPratica(RichiestaReferenteIstanza richiestaReferenteIstanza) {
        try {
            User user = getUserLocalService().getUser(richiestaReferenteIstanza.getUserId());

            List<DomandaBando> domandeDaAggiornare = risolviDomandeDaAggiornare(richiestaReferenteIstanza);

            for (DomandaBando domandaBando : domandeDaAggiornare) {
                aggiornaSingolaDomanda(domandaBando, user, richiestaReferenteIstanza);
            }
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
    }

    private void aggiornaSingolaDomanda(DomandaBando domandaBando, User user, RichiestaReferenteIstanza richiestaReferenteIstanza) {
        // Catturo il referente uscente e la data invio domanda PRIMA di sovrascrivere la domanda
        long vecchioUserId = domandaBando.getUserId();
        String vecchioUserName = domandaBando.getUserName();
        Date dataInvioDomanda = domandaBando.getDataArrivo();

        domandaBando.setUserId(user.getUserId());
        domandaBando.setUserName(user.getFullName());
        domandaBando.setCodiceFiscale(user.getScreenName().toUpperCase());

        getDomandaBandoLocalService().updateDomandaBando(domandaBando);

        if (Validator.isNotNull(domandaBando.getProcessInstanceId())
                && getCamundaClient().existProcess(domandaBando.getProcessInstanceId())) {
            getCamundaClient().updateProcessInstanceVariableByBusinessKey(domandaBando.getProcessInstanceId(), List.of(
                    new Variable(CustomProcessVariables.DENOMINAZIONE_RICHIEDENTE, CustomProcessVariables.TYPE_STRING, user.getFullName())
            ));
        }

        getReferenteIstanzaHistoryService().registraNuovoReferente(domandaBando.getDomandaBandoId(), richiestaReferenteIstanza, vecchioUserId, vecchioUserName, dataInvioDomanda);
    }

    private List<DomandaBando> risolviDomandeDaAggiornare(RichiestaReferenteIstanza richiestaReferenteIstanza) {
        if (richiestaReferenteIstanza.getRichiestaId() > 0) {
            try {
                return Collections.singletonList(
                        getDomandaBandoLocalService().getDomandaBando(richiestaReferenteIstanza.getRichiestaId()));
            } catch (Exception e) {
                throw new RuntimeException(e);
            }
        }

        boolean eventi = DominioIstanza.EVENTI.equals(getDominio());
        List<DomandaBando> domandeBando = getDomandaBandoLocalService().getIstanzePresenti(
                richiestaReferenteIstanza.getServizioId(),
                richiestaReferenteIstanza.getPartitaIva(),
                eventi);

        if (domandeBando == null || domandeBando.isEmpty()) {
            throw new RuntimeException("Nessuna DomandaBando trovata per RichiestaReferenteIstanza id="
                    + richiestaReferenteIstanza.getRichiestaReferenteIstanzaId()
                    + ", servizioId=" + richiestaReferenteIstanza.getServizioId()
                    + ", partitaIva=" + richiestaReferenteIstanza.getPartitaIva());
        }

        return domandeBando;
    }

    private Documento getDocumentoProtocollo(AllegatoReferenteIstanza allegatoReferenteIstanza) throws Exception {
        FileService fileService = getFileServiceFactory().getActiveFileService();
        File file = fileService.getRequestFile(allegatoReferenteIstanza.getIdDocumentale(), allegatoReferenteIstanza.getGroupId());

        Documento documento = new Documento();
        documento.setContenuto(file.getInputStream().readAllBytes());
        documento.setNome(allegatoReferenteIstanza.getNome());
        documento.setOggetto(allegatoReferenteIstanza.getDescrizione());
        documento.setTipo(null);
        documento.setTipoMIME(null);
        documento.setTitolo(allegatoReferenteIstanza.getTitolo());

        return documento;
    }

    @Override
    public List<RichiestaDTO> getIstanzePresenti(long bandoId, String partitaIva) {
        List<DomandaBando> domandeBando = getDomandaBandoLocalService().getIstanzePresenti(bandoId, partitaIva, false);
        return getDomandaBandoToRichiestaDTOTransformer().transform(domandeBando);
    }

    protected DomandaBando risolviDomandaBando(RichiestaReferenteIstanza richiestaReferenteIstanza) {
        if (richiestaReferenteIstanza.getRichiestaId() > 0) {
            try {
                return getDomandaBandoLocalService().getDomandaBando(richiestaReferenteIstanza.getRichiestaId());
            } catch (Exception e) {
                throw new RuntimeException(e);
            }
        }
        boolean eventi = DominioIstanza.EVENTI.equals(getDominio());
        List<DomandaBando> domandeBando = getDomandaBandoLocalService().getIstanzePresenti(
                richiestaReferenteIstanza.getServizioId(),
                richiestaReferenteIstanza.getPartitaIva(),
                eventi);
        if (domandeBando == null || domandeBando.isEmpty()) {
            throw new RuntimeException("DomandaBando non trovata per RichiestaReferenteIstanza id=" + richiestaReferenteIstanza.getRichiestaReferenteIstanzaId()
                    + ", servizioId=" + richiestaReferenteIstanza.getServizioId()
                    + ", partitaIva=" + richiestaReferenteIstanza.getPartitaIva());
        }
        return domandeBando.get(0);
    }

    @Override
    public DatiPraticaDTO buildDatiPraticaDTO(RichiestaReferenteIstanza richiestaReferenteIstanza) {
        try {
            long richiestaIstanzaId = richiestaReferenteIstanza.getRichiestaReferenteIstanzaId();
            long bandoId = richiestaReferenteIstanza.getServizioId();

            DomandaBando domandaBando = risolviDomandaBando(richiestaReferenteIstanza);
            long domandaBandoId = domandaBando.getDomandaBandoId();

            Bando bando = getBandoLocalService().getBando(bandoId);
            User domandaUser = getUserLocalService().fetchUser(domandaBando.getUserId());

            TipoPersona tipoPersona = Validator.isNotNull(domandaBando.getPartitaIva())
                    ? TipoPersona.GIURIDICA
                    : TipoPersona.FISICA;

            String fascicoloId = findParentFascicoloId(domandaBandoId);
            String idPratica = Validator.isNotNull(fascicoloId)
                    ? fascicoloId
                    : bando.getIdPratica();

            String codiceIstanzaPortale = bando.getCodice()
                    + "/"
                    + domandaBandoId
                    + "/"
                    + richiestaIstanzaId
                    + "/cr/i";

            return new DatiPraticaDTO()
                    .setIndirizzoTelematico(domandaBando.getEmail())
                    .setTipoPersona(tipoPersona)
                    .setPartitaIva(domandaBando.getPartitaIva())
                    .setCodiceFiscale(domandaBando.getCodiceFiscale())
                    .setUserName(domandaBando.getUserName())
                    .setNome(domandaUser != null ? domandaUser.getFirstName() : null)
                    .setCognome(domandaUser != null ? domandaUser.getLastName() : null)
                    .setCodice(bando.getCodice())
                    .setContesto(Contesto.valueOf(bando.getContesto()))
                    .setCodiceIstanzaPortale(codiceIstanzaPortale)
                    .setTipoIstanza(TipoIstanzaPortale.BANDI_CAMBIO_REFERENTE.name())
                    .setMittenteInterno(bando.getMittenteInterno())
                    .setCodiceAOO(bando.getCodiceAOO())
                    .setCodiceUO(bando.getCodiceUO())
                    .setTipoProtocolloClient(bando.getTipoProtocolloClient())
                    .setClassifica(bando.getClassifica())
                    .setTipoDocumento(bando.getTipoDocumento())
                    .setIdPratica(idPratica)
                    .setInCaricoA(bando.getInCaricoA())
                    .setFascicoloId(fascicoloId)
                    .setTitolarioId(null);
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
    }

    private String findParentFascicoloId(long domandaBandoId) {
        return getDomandaBandoDatoAggiuntivoLocalService()
                .getDomandaBandoDatoAggiuntivoByDomandaBandoIdAndChiave(
                        List.of(domandaBandoId),
                        List.of(IdentificativoFascicoloEnum.ID_FASCICOLO_ISTANZA.name()))
                .stream()
                .findFirst()
                .map(DomandaBandoDatoAggiuntivo::getValore)
                .orElse(null);
    }
