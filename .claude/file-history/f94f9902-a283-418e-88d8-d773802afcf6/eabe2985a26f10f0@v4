    public SearchResultDTO searchRichiesteOperatore(OperatoreSearchFiltersDTO filters) {
        try {
            List<Task> allTasks = new ArrayList<>();
            List<RichiestaReferenteIstanza> richieste = new ArrayList<>();
            List<SearchRichiestaReferenteDTO> items = new ArrayList<>();
            Filters filter = new Filters();
            aggiornaFiltri(filter, filters);
            filter.setStatiEsclusi(List.of(StatoRichiesta.IN_COMPILAZIONE.name()));
            long total = 0;
            if (Validator.isNotNull(filters.getTabCorrente())) {
                switch (filters.getTabCorrente()) {
                    case IN_ARRIVO:
                        filters.setOperatoreUserId(null);
                        allTasks = searchPraticheCamunda(filters);
                        if (ListUtil.isNotNull(allTasks) && ListUtil.isNotEmpty(allTasks)) {
                            List<String> processInstanceIds = allTasks.stream().map(Task::getProcessInstanceId).collect(Collectors.toList());
                            if (ListUtil.isNotNull(processInstanceIds) && ListUtil.isNotEmpty(processInstanceIds)) {
                                filter.setProcessInstanceIds(processInstanceIds);
                                richieste = richiestaReferenteIstanzaLocalService.searchRichiestaReferente(filter);
                                items = richieste.stream()
                                        .map(this::mapRichiesta)
                                        .collect(Collectors.toList());
                                total = richiestaReferenteIstanzaLocalService.countRichiestaReferente(filter);
                            }
                        }
                        break;
                    case IN_LAVORAZIONE:
                        allTasks = searchPraticheCamunda(filters);
                        if (ListUtil.isNotNull(allTasks) && ListUtil.isNotEmpty(allTasks)) {
                            List<String> processInstanceIds = allTasks.stream().map(Task::getProcessInstanceId).collect(Collectors.toList());
                            if (ListUtil.isNotNull(processInstanceIds) && ListUtil.isNotEmpty(processInstanceIds)) {
                                filter.setProcessInstanceIds(processInstanceIds);
                                richieste = richiestaReferenteIstanzaLocalService.searchRichiestaReferente(filter);
                                items = richieste.stream()
                                        .map(this::mapRichiesta)
                                        .collect(Collectors.toList());
                                total = richiestaReferenteIstanzaLocalService.countRichiestaReferente(filter);
                            }
                        }
                        break;
                    case IN_ITINERE_CHIUSI:
                        richieste = richiestaReferenteIstanzaLocalService.searchRichiestaReferente(filter);
                        items = richieste.stream()
                                .map(this::mapRichiesta)
                                .collect(Collectors.toList());
                        total = richiestaReferenteIstanzaLocalService.countRichiestaReferente(filter);
                        break;
                }
            } else {
                throw new RuntimeException("Errore nel recupero del tab corrente");
            }

            SearchResultDTO result = new SearchResultDTO();
            result.setItems(items);
            result.setTotal(total);
            return result;
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
    }

