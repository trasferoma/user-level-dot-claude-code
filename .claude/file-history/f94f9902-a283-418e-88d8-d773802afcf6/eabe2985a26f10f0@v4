    public List<Map<String, Object>> getItemsByDominio(long userId, String dominio) {
        try {
            Filters filter = new Filters();
            filter.setUserId(userId);
            filter.setDominio(dominio);
            filter.setStart(QueryUtil.ALL_POS);
            filter.setEnd(QueryUtil.ALL_POS);
            filter.setStatiEsclusi(List.of(StatoRichiesta.IN_COMPILAZIONE.name()));

            List<RichiestaReferenteIstanza> richieste = richiestaReferenteIstanzaLocalService.searchRichiestaReferente(filter);

            Map<Long, Map<String, Object>> itemsByServizioId = new LinkedHashMap<>();

            for (RichiestaReferenteIstanza richiesta : richieste) {
                try {
                    ServizioDTO servizio = risolviServizio(richiesta);
                    itemsByServizioId.computeIfAbsent(servizio.getServizioId(), k -> {
                        Map<String, Object> item = new HashMap<>();
                        item.put("id", servizio.getServizioId());
                        item.put("nome", servizio.getNome());
                        return item;
                    });
                } catch (Exception e) {
                    _log.error("Error getting servizio for richiestaId: " + richiesta.getRichiestaId(), e);
                }
            }

            return new ArrayList<>(itemsByServizioId.values());
        } catch (Exception e) {
            _log.error("Error in getItemsByDominio for userId: " + userId + ", dominio: " + dominio, e);
            return new ArrayList<>();
        }
    }

