    public void setStatoRichiesta(long richiestaReferenteIstanzaId, long groupId, long userId,  String stato, long companyId) {
        RichiestaReferenteIstanza richiestaReferenteIstanza = richiestaReferenteIstanzaLocalService.fetchRichiestaReferenteIstanza(richiestaReferenteIstanzaId);
        String statoAttuale = richiestaReferenteIstanza != null ? richiestaReferenteIstanza.getStato() : null;

        if (richiestaReferenteIstanza != null && !stato.equals(statoAttuale)) {
            richiestaReferenteIstanza.setStato(stato);
            richiestaReferenteIstanzaLocalService.updateRichiestaReferenteIstanza(richiestaReferenteIstanza);
        }



        if (!stato.equals(statoAttuale)) {
            AttivitaRichiestaReferente attivitaRichiestaReferente = attivitaRichiestaReferenteLocalService.createAttivitaRichiestaReferente(counterLocalService.increment());
            attivitaRichiestaReferente.setRichiestaReferenteIstanzaId(richiestaReferenteIstanzaId);
            attivitaRichiestaReferente.setStato(stato);
            attivitaRichiestaReferenteLocalService.updateAttivitaRichiestaReferente(attivitaRichiestaReferente);
            try {
                StatoRichiesta statoRichiesta = StatoRichiesta.findByName(stato);
                String labelStato = statoRichiesta != null ? statoRichiesta.getName() : stato;

                boolean nuovaRichiesta = stato.equalsIgnoreCase(StatoRichiesta.NUOVA.name());
