                richiestaReferenteIstanzaLocalService.fetchRichiestaReferenteIstanza(richiestaReferenteId);
        List<AllegatoReferenteIstanza> docPrincipale = allegatoReferenteIstanzaLocalService.getByRichiestaReferenteIdAndPrincipale(richiestaReferenteId, true);

        DettaglioRichiestaReferenteDTO dto = new DettaglioRichiestaReferenteDTO();
        dto.setRichiestaReferenteId(richiesta.getRichiestaReferenteIstanzaId());
        dto.setRichiestaId(richiesta.getRichiestaId());
        dto.setNumeroProtocollo(richiesta.getNumeroProtocollo());
        dto.setNumeroProtocolloEsteso(richiesta.getNumeroProtocolloEsteso());
        dto.setDataProtocollo(richiesta.getDataProtocollo());
        dto.setDominio(DominioIstanza.valueOf(richiesta.getDominio()));
        dto.setStatoRichiesta(StatoRichiesta.valueOf(richiesta.getStato()));
        dto.setNumeroProtocolloUscita(richiesta.getNumeroProtocolloUscita());
        dto.setNumeroProtocolloEstesoUscita(richiesta.getNumeroProtocolloEstesoUscita());
        dto.setDataProtocolloUscita(richiesta.getDataProtocolloUscita());
        dto.setDataEsito(richiesta.getDataEsito());
        dto.setQualifica(richiesta.getQualifica());
        dto.setQualificaInfocamere(richiesta.getQualificaInfocamere());

        // Map the main document
        if (!docPrincipale.isEmpty()) {
            AllegatoReferenteIstanza principale = docPrincipale.get(0);
            AllegatoReferenteDTO principaleDTO = new AllegatoReferenteDTO();
            principaleDTO.setAllegatoReferenteId(principale.getAllegatoReferenteIstanzaId());
            principaleDTO.setNomeFile(principale.getNome());
            dto.setDocumentoPrincipale(principaleDTO);
        }

        // Map other allegati if needed
        List<AllegatoReferenteIstanza> allegati =
                allegatoReferenteIstanzaLocalService.getByRichiestaReferenteIdAndPrincipale(richiestaReferenteId, false);

        List<AllegatoReferenteDTO> allegatiDTO = allegati.stream().map(a -> {
            AllegatoReferenteDTO aDTO = new AllegatoReferenteDTO();
            aDTO.setAllegatoReferenteId(a.getAllegatoReferenteIstanzaId());
            aDTO.setNomeFile(a.getNome());
            aDTO.setDescrizione(a.getDescrizione());
            aDTO.setInterno(a.getInterno());
            aDTO.setDimensione(risolviDimensioneAllegato(a.getIdDocumentale(), a.getGroupId()));
            return aDTO;
        }).collect(Collectors.toList());

        dto.setAllegati(allegatiDTO);

        String taskId = camundaClient.searchTasks(richiesta.getProcessInstanceId())
                .stream()
                .findFirst()
                .map(Task::getId)
                .orElse(null);
        dto.setTaskId(taskId);

        List<AttivitaRichiestaReferente> attivitaRichiestaReferenteList = attivitaRichiestaReferenteLocalService.getAttivitaRichiestaReferenteByAttivitaRichiestaReferenteId(richiestaReferenteId);
        if (ListUtil.isNotNull(attivitaRichiestaReferenteList) && ListUtil.isNotEmpty(attivitaRichiestaReferenteList)) {
            List<StatoRichiestaReferenteDTO> stati = attivitaRichiestaReferenteList.stream().map(a -> {
                StatoRichiestaReferenteDTO sDTO = new StatoRichiestaReferenteDTO();
                sDTO.setStato(a.getStato());
                sDTO.setDataStato(a.getCreateDate());
                sDTO.setNote(a.getNote());
                return sDTO;
            }).collect(Collectors.toList());
            dto.setStati(stati);
        }

        return dto;
    }

    public List<ReferenteRegistroDTO> getRegistroReferenti(DominioIstanza dominio, long richiestaId) {
        List<ReferenteIstanza> referenti = referenteIstanzaLocalService.findByRichiestaId(richiestaId);
        if (ListUtil.isNull(referenti) || ListUtil.isEmpty(referenti)) {
            return new ArrayList<>();
        }

        List<ReferenteIstanza> ordinati = referenti.stream()
                .filter(r -> Validator.isNull(dominio) || dominio.name().equals(r.getDominio()))
                .filter(r -> Validator.isNotNull(r.getDataInizio()))
                .sorted(Comparator.comparing(ReferenteIstanza::getDataInizio))
                .collect(Collectors.toList());

        List<ReferenteRegistroDTO> registro = new ArrayList<>(ordinati.size());
        for (ReferenteIstanza referente : ordinati) {
            ReferenteRegistroDTO dto = new ReferenteRegistroDTO();
            dto.setDataDal(referente.getDataInizio());
            dto.setDataAl(referente.getDataFine());
            try {
                User user = userLocalService.getUser(referente.getUserId());
                dto.setNomeCompleto(Validator.isNotNull(user.getFullName()) ? user.getFullName().toUpperCase() : null);
                dto.setCodiceFiscale(Validator.isNotNull(user.getScreenName()) ? user.getScreenName().toUpperCase() : null);
            } catch (PortalException e) {
