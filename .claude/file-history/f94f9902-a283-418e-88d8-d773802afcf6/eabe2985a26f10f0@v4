    public ProtocolloDTO protocolla(long richiestaReferenteIstanzaId) throws Exception {
        RichiestaReferenteIstanza richiestaReferenteIstanza = richiestaReferenteIstanzaLocalService.getRichiestaReferenteIstanza(richiestaReferenteIstanzaId);
        DominioIstanza dominio = DominioIstanza.valueOf(richiestaReferenteIstanza.getDominio());

        boolean protocolloEnabled = protocolloService.isProtocolloEnabled(richiestaReferenteIstanza.getGroupId());
        if (!protocolloEnabled) {
            throw new Exception("Errore protocollazione richiesta " + richiestaReferenteIstanzaId + ", protocollo non abilitato per group " + richiestaReferenteIstanza.getGroupId());
        }

        if (Validator.isNotNull(richiestaReferenteIstanza.getNumeroProtocollo()) || Validator.isNotNull(richiestaReferenteIstanza.getDataProtocollo())) {
            throw new Exception("Errore protocollazione richiesta  " + richiestaReferenteIstanzaId + ", gia protocollata");
        }

        ProtocolloRequest protocolloRequest = strategies.get(dominio).createProtocolloRequest(richiestaReferenteIstanza);

        ProtocolloResponse response = protocolloService.protocolla(protocolloRequest, richiestaReferenteIstanza.getGroupId());

        if (response.getCodiceErrore() != null) {
            throw new RuntimeException();
        }
        richiestaReferenteIstanza.setNumeroProtocollo(response.getNumeroProtocollo());
        richiestaReferenteIstanza.setNumeroProtocolloEsteso(response.getNumeroProtocolloEsteso());
        richiestaReferenteIstanza.setDataProtocollo(response.getDataProtocollo());
        richiestaReferenteIstanzaLocalService.updateRichiestaReferenteIstanza(richiestaReferenteIstanza);

        setStatoRichiesta(richiestaReferenteIstanzaId, richiestaReferenteIstanza.getGroupId(), richiestaReferenteIstanza.getUserId(), StatoRichiesta.PROTOCOLLATA.name(), richiestaReferenteIstanza.getCompanyId());

        ProtocolloDTO protocolloDTO = new ProtocolloDTO();
        protocolloDTO.setNumeroProtocollo(response.getNumeroProtocollo());
        protocolloDTO.setDataProtocollo(response.getDataProtocollo());
        protocolloDTO.setNumeroProtocolloEsteso(response.getNumeroProtocolloEsteso());
        return protocolloDTO;
    }

