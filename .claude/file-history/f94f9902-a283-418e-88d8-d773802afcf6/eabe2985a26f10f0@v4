    public byte[] generaPdfRichiesta(GeneraPdfDTO config) throws Exception {
        GestioneReferenteGroupConfiguration configuration = configurationProvider.getGroupConfiguration(GestioneReferenteGroupConfiguration.class, config.getGroupId());

        FileEntry fileEntry = dlAppLocalService.getFileEntry(configuration.templateFileEntryId());
        InputStream templateStream = fileEntry.getContentStream();

        LocalDateTime now = LocalDateTime.now();

        JRDataSource datasource = new JREmptyDataSource(1);

        DominioStrategy strategy = strategies.get(config.getDominio());
        RichiestaDTO richiestaDTO = config.getRichiesta();

        Map<String, Object> params = new HashMap<>();

        // Sottoscritto (utente loggato)
        params.put("nomeRichiedente", config.getNomeRichiedente());
        params.put("cognomeRichiedente", config.getCognomeRichiedente());
        params.put("codiceFiscaleRichiedente", config.getCodiceFiscaleRichiedente());
        params.put("dataNascitaRichiedente", config.getDataNascitaRichiedente());

        // Selezione richiesta
        params.put("dominio", config.getDominio() != null ? config.getDominio().name() : null);
        params.put("qualifica", config.getQualifica());
        params.put("disponeIdentificativo", config.isDisponeIdentificativo());

        // Caso "dispone identificativo"
        if (config.isDisponeIdentificativo() && richiestaDTO != null) {
            params.put("idPratica", String.valueOf(config.getRichiestaId()));
            params.put("dataArrivo", richiestaDTO.getDataArrivo() != null ? DATE_FORMATTER.format(richiestaDTO.getDataArrivo()) : null);
            params.put("numeroProtocollo", richiestaDTO.getNumeroProtocollo());
        }

        // Caso "non dispone identificativo"
        if (!config.isDisponeIdentificativo()) {
            params.put("partitaIva", config.getPartitaIva());
            try {
                ServizioDTO servizio = strategy.getServizioByProcedimento(config.getProcedimentoId());
                params.put("procedimentoNome", servizio != null ? servizio.getNome() : null);
            } catch (Exception e) {
                _log.warn("Impossibile risolvere il nome del procedimento " + config.getProcedimentoId(), e);
            }
        }

        // Firma (data + nome completo)
        params.put("dataOraRichiesta", DATE_TIME_FORMATTER.format(now));
        params.put("richiedente", config.getLoggedUserFullName());
        params.put("nomeCognomeUtente", config.getLoggedUserFullName());

        // Riepilogo allegati caricati in bozza
        params.put("listaAllegati", buildListaAllegatiDataSource(config.getRichiestaReferenteIstanzaId()));

        long organizationId = organizationUtility.getSiteOrganization(config.getGroupId()).getOrganizationId();
        Organization organization = organizationLocalService.getOrganization(organizationId);
        Company company = companyLocalService.getCompany(organization.getCompanyId());
        String portalURL = company.getPortalURL(config.getGroupId());
        params.put("urlPortale", portalURL);

        JasperReport report = JasperCompileManager.compileReport(templateStream);
        JasperPrint print = JasperFillManager.fillReport(report, params, datasource);
        ByteArrayOutputStream out = new ByteArrayOutputStream();
        JasperExportManager.exportReportToPdfStream(print, out);
        byte[] pdfData = out.toByteArray();

        Contesto contesto;
        if (config.isDisponeIdentificativo() && richiestaDTO != null) {
            contesto = richiestaDTO.getContesto();
        } else {
            contesto = strategy.getContestoByProcedimento(config.getProcedimentoId(), config.getGroupId());
        }

        return firmaRemotaService.applicaSigillo(config.getGroupId(), 0L, contesto, pdfData, null, null);
    }

