    public long creaBozzaRichiesta(RichiestaReferenteDTO richiesta) throws Exception {
        DominioIstanza dominio = richiesta.getDominio();
        User user = userLocalService.getUser(richiesta.getUserId());
        ServizioDTO servizio = getServizioDto(richiesta, dominio);

        long richiestaReferenteId = counterLocalService.increment(RichiestaReferenteIstanza.class.getName());

        RichiestaReferenteIstanza richiestaModel = richiestaReferenteIstanzaLocalService.createRichiestaReferenteIstanza(richiestaReferenteId);
        richiestaModel.setGroupId(richiesta.getGroupId());
        richiestaModel.setCompanyId(richiesta.getCompanyId());
        richiestaModel.setUserId(user.getUserId());
        richiestaModel.setUserName(user.getFullName());
        richiestaModel.setDominio(dominio.name());
        richiestaModel.setCodiceFiscale(user.getScreenName().toUpperCase());
        richiestaModel.setRichiestaId(richiesta.getRichiestaId());
        richiestaModel.setServizioId(servizio.getServizioId());
        richiestaModel.setPartitaIva(richiesta.getPartitaIva());
        richiestaModel.setProcedimentoId(richiesta.getProcedimentoId() == null ? 0 : richiesta.getProcedimentoId());
        richiestaModel.setStato(StatoRichiesta.IN_COMPILAZIONE.name());
        richiestaReferenteIstanzaLocalService.updateRichiestaReferenteIstanza(richiestaModel);

        return richiestaReferenteId;
    }

    public void salvaAllegatoBozza(long richiestaReferenteIstanzaId, AllegatoReferenteDTO allegato, boolean principale, String descrizioneDefault) throws Exception {
        RichiestaReferenteIstanza bozza = richiestaReferenteIstanzaLocalService.getRichiestaReferenteIstanza(richiestaReferenteIstanzaId);
        if (!StatoRichiesta.IN_COMPILAZIONE.name().equals(bozza.getStato())) {
            throw new IllegalStateException("La richiesta " + richiestaReferenteIstanzaId + " non e' in compilazione");
        }
        validaEstensioneAllegato(allegato);

        User user = userLocalService.getUser(bozza.getUserId());
        DominioIstanza dominio = DominioIstanza.valueOf(bozza.getDominio());
        DominioStrategy strategy = strategies.get(dominio);
        ServizioDTO servizio = strategy.getServizioByProcedimento(bozza.getServizioId());
        Contesto contesto = strategy.getContestoByProcedimento(bozza.getServizioId(), bozza.getGroupId());

        String impronta = "";
        String firmatario = "";
        boolean firmatoDigitalmente = false;
        VerificaResponse fdrResponse = verificaFirmaAllegato(allegato, principale, bozza.getGroupId(), contesto, true);
        if (Validator.isNotNull(fdrResponse)) {
            if (Validator.isNotNull(fdrResponse.getImpronta())) {
                impronta = fdrResponse.getImpronta();
            }
            firmatario = formatFirmatari(fdrResponse.getFirmatari());
            firmatoDigitalmente = fdrResponse.isFirmato() && fdrResponse.isFirmaValida();
        }
        if (!firmatoDigitalmente) {
            throw new IllegalArgumentException("Allegato " + allegato.getNomeFile() + " non firmato digitalmente o firma non valida");
        }
        EsitoVerificaFirma esitoVerificaFirma = EsitoVerificaFirma.OK;

        FileService fileService = fileServiceFactory.getActiveFileService();
        File savedFile = fileService.saveRequestFile(
                allegato.getNomeFile(),
                allegato.getNomeFile(),
                allegato.getNomeFile(),
                servizio.getCodiceServizio(),
                bozza.getRichiestaId(),
                new ByteArrayInputStream(allegato.getData()),
                allegato.getMimeType(),
                user.getUserId(),
                bozza.getGroupId()
        );

        long allegatoId = counterLocalService.increment(AllegatoReferenteIstanza.class.getName());
        AllegatoReferenteIstanza allegatoModel = allegatoReferenteIstanzaLocalService.createAllegatoReferenteIstanza(allegatoId);
        allegatoModel.setGroupId(bozza.getGroupId());
        allegatoModel.setCompanyId(bozza.getCompanyId());
        allegatoModel.setUserId(user.getUserId());
        allegatoModel.setUserName(user.getFullName());
        allegatoModel.setRichiestaReferenteIstanzaId(richiestaReferenteIstanzaId);
        allegatoModel.setNome(allegato.getNomeFile());
        allegatoModel.setTitolo(allegato.getNomeFile());
        allegatoModel.setDescrizione(Validator.isNotNull(allegato.getDescrizione()) ? allegato.getDescrizione() : descrizioneDefault);
        allegatoModel.setPrincipale(principale);
        allegatoModel.setIdDocumentale(savedFile.getId());
        allegatoModel.setEsitoVerificaFirma(esitoVerificaFirma.name());
        allegatoModel.setFirmatoDigitalmente(firmatoDigitalmente);
        allegatoModel.setFirmatario(firmatario);
        allegatoModel.setImpronta(impronta);
        allegatoReferenteIstanzaLocalService.updateAllegatoReferenteIstanza(allegatoModel);
    }

    private String formatFirmatari(Set<String> firmatari) {
        if (Validator.isNull(firmatari) || firmatari.isEmpty()) {
            return "";
        }
        return String.join(",", firmatari);
    }

    private void validaEstensioneAllegato(AllegatoReferenteDTO allegato) {
        String nomeFile = allegato.getNomeFile();
        if (Validator.isNull(nomeFile)) {
            throw new IllegalArgumentException("Nome file mancante");
        }
        String lower = nomeFile.toLowerCase();
        if (!(lower.endsWith(".pdf") || lower.endsWith(".p7m"))) {
            throw new IllegalArgumentException("Formato file non ammesso. Sono accettati solo file .pdf e .p7m");
        }
    }

    public void modificaAllegatoBozza(long allegatoReferenteIstanzaId, AllegatoReferenteDTO nuovoAllegato) throws Exception {
        AllegatoReferenteIstanza esistente = allegatoReferenteIstanzaLocalService.fetchAllegatoReferenteIstanza(allegatoReferenteIstanzaId);
        if (Validator.isNull(esistente)) {
            throw new IllegalArgumentException("Allegato non trovato");
        }
        long richiestaReferenteIstanzaId = esistente.getRichiestaReferenteIstanzaId();
        boolean principale = esistente.isPrincipale();
        String descrizione = Validator.isNotNull(esistente.getDescrizione()) ? esistente.getDescrizione() : nuovoAllegato.getNomeFile();

        salvaAllegatoBozza(richiestaReferenteIstanzaId, nuovoAllegato, principale, descrizione);
        eliminaAllegatoBozza(allegatoReferenteIstanzaId);
    }

    public void eliminaAllegatoBozza(long allegatoReferenteIstanzaId) throws PortalException {
        AllegatoReferenteIstanza allegato = allegatoReferenteIstanzaLocalService.fetchAllegatoReferenteIstanza(allegatoReferenteIstanzaId);
        if (Validator.isNull(allegato)) {
            return;
        }
        RichiestaReferenteIstanza bozza = richiestaReferenteIstanzaLocalService.fetchRichiestaReferenteIstanza(allegato.getRichiestaReferenteIstanzaId());
        if (Validator.isNull(bozza) || !StatoRichiesta.IN_COMPILAZIONE.name().equals(bozza.getStato())) {
            throw new IllegalStateException("Allegato non eliminabile, la richiesta non e' in compilazione");
        }
        try {
            fileServiceFactory.getActiveFileService().deleteRequestFile(allegato.getIdDocumentale(), allegato.getGroupId());
        } catch (Exception e) {
            _log.warn("Errore cancellazione file " + allegato.getIdDocumentale(), e);
        }
        allegatoReferenteIstanzaLocalService.deleteAllegatoReferenteIstanza(allegatoReferenteIstanzaId);
    }

    public List<AllegatoReferenteDTO> getAllegatiBozza(long richiestaReferenteIstanzaId) {
        List<AllegatoReferenteIstanza> allegati = allegatoReferenteIstanzaLocalService.getByRichiestaReferenteIdAndPrincipale(richiestaReferenteIstanzaId, false);
        if (allegati == null || allegati.isEmpty()) {
            return new ArrayList<>();
        }
        List<AllegatoReferenteDTO> result = new ArrayList<>(allegati.size());
        for (AllegatoReferenteIstanza allegato : allegati) {
            AllegatoReferenteDTO dto = new AllegatoReferenteDTO();
            dto.setAllegatoReferenteId(allegato.getAllegatoReferenteIstanzaId());
            dto.setNomeFile(allegato.getNome());
            dto.setDescrizione(allegato.getDescrizione());
            dto.setImpronta(allegato.getImpronta());
            dto.setFirmatario(allegato.getFirmatario());
            dto.setFirmatoDigitalmente(allegato.isFirmatoDigitalmente());
            dto.setEsitoVerificaFirma(allegato.getEsitoVerificaFirma());
            result.add(dto);
        }
        return result;
    }

    public RichiestaReferenteIstanza getBozza(long richiestaReferenteIstanzaId) {
