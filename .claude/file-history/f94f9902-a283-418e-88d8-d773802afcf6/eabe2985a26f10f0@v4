    private Optional<CaricaDTO> findCaricaCertificataUtente(RichiestaDTO richiesta, String cfRichiedente) {
        if (Validator.isNull(richiesta) || Validator.isNull(cfRichiedente)) {
            return Optional.empty();
        }
        ObjectMapper objectMapper = new ObjectMapper();
        objectMapper.setPropertyNamingStrategy(PropertyNamingStrategies.KEBAB_CASE);
        objectMapper.disable(DeserializationFeature.FAIL_ON_UNKNOWN_PROPERTIES);

        try {
            RestResponse anagrafica = anagraficaUnicaStakeholderClient.getAnagrafica(
                    richiesta.getGroupId(),
                    richiesta.getContesto(),
                    TipoSoggetto.IMPRESA.name(),
                    richiesta.getPartitaIva()
            );

            Set<String> caricheAbilitate = Arrays.stream(registroImpresaConfiguration.codiciCaricheAbilitate().split(","))
                    .collect(Collectors.toSet());

            VisuraDTO visura = objectMapper.convertValue(anagrafica.getData(), VisuraDTO.class);

            String cfUpper = cfRichiedente.toUpperCase();
            return visura.getPersoneSede().getPersona().stream()
                    .filter(p -> cfUpper.equalsIgnoreCase(p.getPersonaFisica().getcFiscale()))
                    .flatMap(p -> p.getAttiConferimentoCariche().getAttoConferimentoCariche().stream())
                    .map(acc -> acc.getCariche().getCarica())
                    .filter(c -> caricheAbilitate.contains(c.getcCarica()))
                    .findFirst();
        } catch (AnagraficaNonTrovataException e) {
            return Optional.empty();
        }
    }

    private void avviaProcesso(RichiestaReferenteIstanza richiesta) throws PortalException {
        GestioneReferenteGroupConfiguration configuration = configurationProvider.getGroupConfiguration(GestioneReferenteGroupConfiguration.class, richiesta.getGroupId());
        Organization organization = organizationUtility.getSiteOrganization(richiesta.getGroupId());
        DominioIstanza dominio = DominioIstanza.valueOf(richiesta.getDominio());
        RichiestaDTO richiestaDTO = risolviRichiestaDTO(dominio, richiesta.getRichiestaId(), richiesta.getServizioId(), richiesta.getPartitaIva());
        boolean datiCertificati = isDatiCertificati(richiestaDTO, richiesta.getCodiceFiscale());

        List<String> gruppiReferenti = strategies.get(dominio).getGruppiReferenti(richiestaDTO);

        Map<String, Object> variables = new HashMap<>();
        variables.put("GRUPPI_REFERENTI", String.join(",", gruppiReferenti));
        variables.put("SERVIZIO_ID", richiesta.getServizioId());
        variables.put("CODICE_FISCALE", richiesta.getCodiceFiscale());
        variables.put("DATI_CERTIFICATI", datiCertificati);
        variables.put("DATA_INVIO", richiesta.getCreateDate().getTime());
        variables.put("DOMINIO", dominio.name());

        if (datiCertificati) {
            variables.put("ESITO_LAVORAZIONE", "POSITIVO");
        }

        String processInstanceId = camundaClient.startProcessInstance(
                String.valueOf(organization.getOrganizationId()),
                String.valueOf(organization.getOrganizationId()),
                configuration.codiceProcesso(),
                String.valueOf(richiesta.getRichiestaReferenteIstanzaId()),
                variables
        );

        setProcessInstanceId(richiesta.getRichiestaReferenteIstanzaId(), processInstanceId);
    }

