    }

    public void finalizzaBozza(long richiestaReferenteIstanzaId, AllegatoReferenteDTO documentoPrincipale, String qualifica) throws Exception {
        RichiestaReferenteIstanza bozza = richiestaReferenteIstanzaLocalService.getRichiestaReferenteIstanza(richiestaReferenteIstanzaId);
        if (!StatoRichiesta.IN_COMPILAZIONE.name().equals(bozza.getStato())) {
            throw new IllegalStateException("La richiesta " + richiestaReferenteIstanzaId + " non e' in compilazione");
        }

        verificaAssenzaRichiestaDuplicata(bozza);

        bozza.setQualifica(qualifica);

        DominioIstanza dominio = DominioIstanza.valueOf(bozza.getDominio());
        RichiestaDTO richiestaDTO = risolviRichiestaDTO(dominio, bozza.getRichiestaId(), bozza.getServizioId(), bozza.getPartitaIva());
        findCaricaCertificataUtente(richiestaDTO, bozza.getCodiceFiscale())
                .ifPresent(carica -> bozza.setQualificaInfocamere(carica.getcCarica() + " - " + carica.getValue()));

        richiestaReferenteIstanzaLocalService.updateRichiestaReferenteIstanza(bozza);

        salvaAllegatoBozza(richiestaReferenteIstanzaId, documentoPrincipale, true, "Istanza principale");
        setStatoRichiesta(richiestaReferenteIstanzaId, bozza.getGroupId(), bozza.getUserId(), StatoRichiesta.NUOVA.name(), bozza.getCompanyId());

        eliminaAltreRichiesteInCompilazione(bozza.getUserId(), richiestaReferenteIstanzaId);
    }

    /**
     * Stati che NON rendono "appesa" una richiesta di cambio referente, cioe' che non devono bloccare
     * l'invio di una nuova richiesta per la stessa pratica:
     * - IN_COMPILAZIONE: e' ancora una bozza;
     * - RIFIUTATA: e' stata respinta;
     * - ACCETTATA: ha gia' cambiato il referente. La pratica puo' essere "rimbalzata" N volte tra piu'
     *   rappresentanti legali, quindi una richiesta accettata non deve impedirne una successiva.
     * Di conseguenza una richiesta e' "appesa" (bloccante) solo se in stato NUOVA, PROTOCOLLATA o IN_LAVORAZIONE.
     */
    private static final List<String> STATI_RICHIESTA_NON_APPESA = Arrays.asList(
            StatoRichiesta.IN_COMPILAZIONE.name(),
            StatoRichiesta.RIFIUTATA.name(),
            StatoRichiesta.ACCETTATA.name());

    /**
     * Verifica l'ammissibilita' di una nuova richiesta di cambio referente
     */
    private void verificaAssenzaRichiestaDuplicata(RichiestaReferenteIstanza bozza) throws Exception {
        DominioIstanza dominio = DominioIstanza.valueOf(bozza.getDominio());

        // 1) La pratica non deve essere gia' in carico all'utente richiedente.
        RichiestaDTO richiestaAssociata = risolviRichiestaDTO(dominio, bozza.getRichiestaId(), bozza.getServizioId(), bozza.getPartitaIva());
        if (richiestaAssociata != null) {
            String cfTitolarePratica = richiestaAssociata.getCfRichiedente();
            if (Validator.isNotNull(cfTitolarePratica) && cfTitolarePratica.equalsIgnoreCase(bozza.getCodiceFiscale())) {
                throw new Exception(
                        "La pratica selezionata risulta già in carico all'utente richiedente. Non è possibile richiedere il cambio referente verso se stessi.");
            }
        }

        // 2) Non deve esistere gia' una richiesta "appesa" per la stessa pratica e lo stesso utente.
        boolean appesaEsistente = esisteRichiestaAppesa(
                bozza.getUserId(),
                bozza.getDominio(),
                bozza.getRichiestaId(),
                bozza.getProcedimentoId(),
                bozza.getPartitaIva(),
                bozza.getRichiestaReferenteIstanzaId());
        if (appesaEsistente) {
            throw new Exception(
                    "Esiste già una richiesta di cambio referente in corso per questa pratica. Non è possibile inviarne una nuova.");
        }
    }

    /**
     * Indica se esiste gia' una richiesta di cambio referente "appesa" (in stato diverso da
     * {@link #STATI_RICHIESTA_NON_APPESA}) per lo stesso utente e per la stessa pratica, identificata
     * dall'id istanza se presente, altrimenti dalla combinazione procedimento + partita IVA.
     *
     * @param escludiRichiestaReferenteIstanzaId id della richiesta da escludere dal controllo
     *        (la bozza corrente in fase di finalizzazione); usare 0 quando non c'e' nulla da escludere.
     */
    public boolean esisteRichiestaAppesa(long userId, String dominio, long richiestaId, long procedimentoId, String partitaIva,
                                         long escludiRichiestaReferenteIstanzaId) {
        Filters filtro = new Filters();
        filtro.setUserId(userId);
        filtro.setDominio(dominio);
        filtro.setStatiEsclusi(STATI_RICHIESTA_NON_APPESA);
        filtro.setStart(QueryUtil.ALL_POS);
        filtro.setEnd(QueryUtil.ALL_POS);

        if (richiestaId > 0) {
            filtro.setRichiestaId(richiestaId);
        } else {
            if (procedimentoId > 0) {
                filtro.setProcedimentoId(procedimentoId);
            }
            filtro.setPartitaIva(partitaIva);
        }

        List<RichiestaReferenteIstanza> esistenti = richiestaReferenteIstanzaLocalService.searchRichiestaReferente(filtro);
        if (!ListUtil.isNotNull(esistenti) || esistenti.isEmpty()) {
            return false;
        }
        return esistenti.stream()
                .anyMatch(r -> r.getRichiestaReferenteIstanzaId() != escludiRichiestaReferenteIstanzaId);
    }

    private void eliminaAltreRichiesteInCompilazione(long userId, long currentRichiestaReferenteIstanzaId) {
        Filters filtroInCompilazione = new Filters();
        filtroInCompilazione.setUserId(userId);
        filtroInCompilazione.setStato(StatoRichiesta.IN_COMPILAZIONE.name());
        filtroInCompilazione.setStart(QueryUtil.ALL_POS);
        filtroInCompilazione.setEnd(QueryUtil.ALL_POS);

        List<RichiestaReferenteIstanza> altreInCompilazione = richiestaReferenteIstanzaLocalService.searchRichiestaReferente(filtroInCompilazione);

        if (ListUtil.isNull(altreInCompilazione) || ListUtil.isEmpty(altreInCompilazione)) {
            return;
        }

        FileService fileService = fileServiceFactory.getActiveFileService();

        for (RichiestaReferenteIstanza altra : altreInCompilazione) {
            long altraId = altra.getRichiestaReferenteIstanzaId();
            if (altraId == currentRichiestaReferenteIstanzaId) {
                continue;
            }
            try {
                eliminaRichiestaInCompilazione(altra, fileService);
            } catch (Exception e) {
                _log.error("Errore eliminazione richiesta referente in compilazione " + altraId + " per userId " + userId, e);
            }
        }
    }

    private void eliminaRichiestaInCompilazione(RichiestaReferenteIstanza richiesta, FileService fileService) throws PortalException {
        long richiestaReferenteIstanzaId = richiesta.getRichiestaReferenteIstanzaId();

        List<AllegatoReferenteIstanza> allegatiNonPrincipali = allegatoReferenteIstanzaLocalService.getByRichiestaReferenteIdAndPrincipale(richiestaReferenteIstanzaId, false);
        List<AllegatoReferenteIstanza> allegatiPrincipali = allegatoReferenteIstanzaLocalService.getByRichiestaReferenteIdAndPrincipale(richiestaReferenteIstanzaId, true);

        List<AllegatoReferenteIstanza> tuttiAllegati = new ArrayList<>();
        if (ListUtil.isNotNull(allegatiNonPrincipali)) {
            tuttiAllegati.addAll(allegatiNonPrincipali);
        }
        if (ListUtil.isNotNull(allegatiPrincipali)) {
            tuttiAllegati.addAll(allegatiPrincipali);
        }

        for (AllegatoReferenteIstanza allegato : tuttiAllegati) {
            try {
                if (Validator.isNotNull(allegato.getIdDocumentale())) {
                    fileService.deleteRequestFile(allegato.getIdDocumentale(), allegato.getGroupId());
                }
            } catch (Exception e) {
                _log.warn("Errore cancellazione file " + allegato.getIdDocumentale() + " per allegato " + allegato.getAllegatoReferenteIstanzaId(), e);
            }
            allegatoReferenteIstanzaLocalService.deleteAllegatoReferenteIstanza(allegato.getAllegatoReferenteIstanzaId());
        }

        List<AttivitaRichiestaReferente> attivita = attivitaRichiestaReferenteLocalService.getAttivitaRichiestaReferenteByAttivitaRichiestaReferenteId(richiestaReferenteIstanzaId);
        if (ListUtil.isNotNull(attivita)) {
            for (AttivitaRichiestaReferente a : attivita) {
                attivitaRichiestaReferenteLocalService.deleteAttivitaRichiestaReferente(a.getAttivitaRichiestaReferenteId());
            }
        }

        richiestaReferenteIstanzaLocalService.deleteRichiestaReferenteIstanza(richiestaReferenteIstanzaId);
    }

