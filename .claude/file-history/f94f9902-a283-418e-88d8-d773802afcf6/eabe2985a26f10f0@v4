    /**
     * Genera e protocolla l'esito (PDF) per l'approvazione automatica. Idempotente: se l'esito risulta gia'
     * protocollato (path manuale, dove l'esito viene prodotto in {@link #lavoraPratica}), non fa nulla, evitando
     * duplicazioni quando il task BPMN "Aggiorna referente pratica" viene eseguito anche nel ramo manuale POSITIVO.
     */
    private void generaEsitoAutomaticoSeNecessario(RichiestaReferenteIstanza richiestaReferenteIstanza) throws Exception {
        if (Validator.isNotNull(richiestaReferenteIstanza.getNumeroProtocolloUscita())) {
            return;
        }

        long richiestaReferenteIstanzaId = richiestaReferenteIstanza.getRichiestaReferenteIstanzaId();
        DominioIstanza dominio = DominioIstanza.valueOf(richiestaReferenteIstanza.getDominio());

        RichiestaDTO richiestaDTO = risolviRichiestaDTO(
                dominio,
                richiestaReferenteIstanza.getRichiestaId(),
                richiestaReferenteIstanza.getServizioId(),
                richiestaReferenteIstanza.getPartitaIva());

        DatiPraticaDTO datiPraticaDTO = buildDatiPraticaDTO(richiestaReferenteIstanzaId);

        // Nessun operatore umano: utente di sistema solo per la titolarita' tecnica del documento;
        // nessuna credenziale OTP -> il PdfSigningProcessor applica esclusivamente il sigillo elettronico di sistema.
        User operatoreSistema = userLocalService.getDefaultUser(richiestaReferenteIstanza.getCompanyId());
        OtpCredentialsDTO otpCredentialsDTO = new OtpCredentialsDTO(null, null);

        referentChangePdfOrchestrator.processPdf(
                richiestaReferenteIstanza,
                operatoreSistema,
                new Date(),
                EsitoLavorazione.POSITIVO,
                otpCredentialsDTO,
                datiPraticaDTO,
                richiestaDTO,
                true);
    }

