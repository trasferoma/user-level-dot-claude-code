        }
    }

    private List<Task> searchPraticheCamunda(OperatoreSearchFiltersDTO filters) throws ConfigurationException {
        GestioneReferenteGroupConfiguration configuration = configurationProvider.getGroupConfiguration(GestioneReferenteGroupConfiguration.class, filters.getGroupId());

        SearchTaskQuery searchTaskQuery = new SearchTaskQuery();
        searchTaskQuery.setProcessDefinitionKey(configuration.codiceProcesso());
        searchTaskQuery.setFirstResult(filters.getStart());
        searchTaskQuery.setMaxResult(filters.getEnd() - filters.getStart());
        if (Validator.isNotNull(filters.getOperatoreUserId())) {
            searchTaskQuery.setAssignee(String.valueOf(filters.getOperatoreUserId()));
        }
        List<Task> allTasks = new ArrayList<>();
        if (filters.getServizioIds() == null || filters.getServizioIds().isEmpty()) {
            return allTasks;
        }
        for (Long servizioId : filters.getServizioIds().stream().distinct().collect(Collectors.toList())) {
            List<VariableQueryParameter> variables = new ArrayList<>();
            variables.add(new VariableQueryParameter("DOMINIO", filters.getDominio().name(), VariableQueryParameter.OperatorEnum.EQ));
            variables.add(new VariableQueryParameter("SERVIZIO_ID", servizioId, VariableQueryParameter.OperatorEnum.EQ));

            searchTaskQuery.setVariables(variables);
            List<Task> tasks = camundaClient.searchTasks(searchTaskQuery);
            allTasks.addAll(tasks);
        }

        allTasks = allTasks.stream().distinct().collect(Collectors.toList());
        return allTasks;
    }

