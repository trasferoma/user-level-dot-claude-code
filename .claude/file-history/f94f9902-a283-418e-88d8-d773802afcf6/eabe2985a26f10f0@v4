        DominioIstanza dominio = DominioIstanza.valueOf(richiestaReferenteIstanza.getDominio());
        DominioStrategy strategy = strategies.get(dominio);
        if (richiestaReferenteIstanza.getRichiestaId() > 0) {
            return strategy.getServizio(richiestaReferenteIstanza.getRichiestaId());
        }
        return strategy.getServizioByProcedimento(richiestaReferenteIstanza.getServizioId());
    }

    /**
     * Risolve il nome del procedimento/servizio associato alla richiesta di cambio referente,
     * utilizzato nel messaggio di conferma per il caso senza identificativo istanza (P.IVA + servizio/bando).
     */
    public String risolviNomeProcedimento(long richiestaReferenteIstanzaId) {
        try {
            RichiestaReferenteIstanza richiesta = richiestaReferenteIstanzaLocalService.getRichiestaReferenteIstanza(richiestaReferenteIstanzaId);
            ServizioDTO servizio = risolviServizio(richiesta);
            return servizio != null ? servizio.getNome() : null;
        } catch (Exception e) {
            _log.warn("Impossibile risolvere il nome del procedimento per la richiesta referente " + richiestaReferenteIstanzaId, e);
            return null;
        }
    }

    public RichiestaDTO risolviRichiestaDTO(DominioIstanza dominio, long richiestaId, long servizioId, String partitaIva) {
        if (richiestaId > 0) {
            return strategies.get(dominio).getRichiesta(richiestaId);
        }
        List<RichiestaDTO> richieste = getIstanzePresenti(dominio, servizioId, partitaIva);
        if (ListUtil.isNotNull(richieste) && ListUtil.isNotEmpty(richieste)) {
            return richieste.get(0);
        }
        return null;
    }
}
