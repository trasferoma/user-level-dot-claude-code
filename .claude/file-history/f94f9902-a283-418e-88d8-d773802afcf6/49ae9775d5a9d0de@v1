    public List<String> getGruppiReferenti(RichiestaDTO richiestaDTO) {
        try {
            Richiesta richiesta = richiestaLocalService.getRichiesta(richiestaDTO.getRichiestaId());
            return List.of(String.valueOf(richiesta.getSubOrganizationId()));
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
    }

    @Override
    public void aggiornaPratica(RichiestaReferenteIstanza richiestaReferenteIstanza) {
        try {
            User user = userLocalService.getUser(richiestaReferenteIstanza.getUserId());

            List<Richiesta> richiesteDaAggiornare = risolviRichiesteDaAggiornare(richiestaReferenteIstanza);

            for (Richiesta richiesta : richiesteDaAggiornare) {
                aggiornaSingolaRichiesta(richiesta, user, richiestaReferenteIstanza);
            }
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
    }

    private void aggiornaSingolaRichiesta(Richiesta richiesta, User user, RichiestaReferenteIstanza richiestaReferenteIstanza) {
        // Catturo il referente uscente e la data invio domanda PRIMA di sovrascrivere la richiesta
        long vecchioUserId = richiesta.getUserId();
        String vecchioUserName = richiesta.getUserName();
        Date dataInvioDomanda = richiesta.getDataInvio();

        richiesta.setUserId(user.getUserId());
        richiesta.setUserName(user.getFullName());
        richiesta.setCodiceFiscale(user.getScreenName().toUpperCase());

        richiestaLocalService.updateRichiesta(richiesta);

        if (Validator.isNotNull(richiesta.getProcessInstanceId())
                && camundaClient.existProcess(richiesta.getProcessInstanceId())) {
            camundaClient.updateProcessInstanceVariableByBusinessKey(richiesta.getProcessInstanceId(), List.of(
                    new Variable(CustomProcessVariables.DENOMINAZIONE_RICHIEDENTE, CustomProcessVariables.TYPE_STRING, user.getFullName())
            ));
        }

        referenteIstanzaHistoryService.registraNuovoReferente(richiesta.getRichiestaId(), richiestaReferenteIstanza, vecchioUserId, vecchioUserName, dataInvioDomanda);
    }

    protected Richiesta risolviRichiesta(RichiestaReferenteIstanza richiestaReferenteIstanza) {
        if (richiestaReferenteIstanza.getRichiestaId() > 0) {
            try {
                return richiestaLocalService.getRichiesta(richiestaReferenteIstanza.getRichiestaId());
            } catch (Exception e) {
                throw new RuntimeException(e);
            }
        }
        List<Richiesta> richieste = richiestaLocalService.getIstanzePresenti(
                richiestaReferenteIstanza.getServizioId(),
                richiestaReferenteIstanza.getPartitaIva());
        if (richieste == null || richieste.isEmpty()) {
            throw new RuntimeException("Richiesta non trovata per RichiestaReferenteIstanza id="
                    + richiestaReferenteIstanza.getRichiestaReferenteIstanzaId()
                    + ", servizioId=" + richiestaReferenteIstanza.getServizioId()
                    + ", partitaIva=" + richiestaReferenteIstanza.getPartitaIva());
        }
        return richieste.get(0);
    }

    private List<Richiesta> risolviRichiesteDaAggiornare(RichiestaReferenteIstanza richiestaReferenteIstanza) {
        if (richiestaReferenteIstanza.getRichiestaId() > 0) {
            try {
                return List.of(richiestaLocalService.getRichiesta(richiestaReferenteIstanza.getRichiestaId()));
            } catch (Exception e) {
                throw new RuntimeException(e);
            }
        }

        List<Richiesta> richieste = richiestaLocalService.getIstanzePresenti(
                richiestaReferenteIstanza.getServizioId(),
                richiestaReferenteIstanza.getPartitaIva());

        if (richieste == null || richieste.isEmpty()) {
            throw new RuntimeException("Nessuna Richiesta trovata per RichiestaReferenteIstanza id="
                    + richiestaReferenteIstanza.getRichiestaReferenteIstanzaId()
                    + ", servizioId=" + richiestaReferenteIstanza.getServizioId()
                    + ", partitaIva=" + richiestaReferenteIstanza.getPartitaIva());
        }

        return richieste;
    }

    @Override
    public List<RichiestaDTO> getIstanzePresenti(long servizioId, String partitaIva) {
        List<Richiesta> richieste = richiestaLocalService.getIstanzePresenti(servizioId, partitaIva);
        return richiestaToRichiestaDTOTransformer.transform(richieste);
    }

    @Override
    public DatiPraticaDTO buildDatiPraticaDTO(RichiestaReferenteIstanza richiestaReferenteIstanza) {
        try {
            long richiestaIstanzaId = richiestaReferenteIstanza.getRichiestaReferenteIstanzaId();
            long servizioId = richiestaReferenteIstanza.getServizioId();

            Richiesta richiesta = risolviRichiesta(richiestaReferenteIstanza);
            long richiestaId = richiesta.getRichiestaId();

            ServizioEnte servizioEnte = getServizioEnte(servizioId, richiestaId);
            Servizio servizio = servizioLocalService.getServizioById(servizioEnte.getServizioId());
            User user = userLocalService.getUser(richiesta.getUserId());

            Organization organization = organizationUtility.getSiteOrganization(richiesta.getGroupId());

            ServizioEnteOrganizzazione servizioEnteOrganizzazione = getServizioEnteOrganizzazione(richiesta, organization);

            String codiceAoo = resolveProtocolValue(
                    servizioEnte.getAooProtocollo(),
                    servizioEnteOrganizzazione != null ? servizioEnteOrganizzazione.getAooProtocollo() : null);

            String codiceUo = resolveProtocolValue(
                    servizioEnte.getUoProtocollo(),
                    servizioEnteOrganizzazione != null ? servizioEnteOrganizzazione.getUoProtocollo() : null);

            String fascicoloId = resolveProtocolValue(
                    servizioEnte.getFascicoloId(),
                    servizioEnteOrganizzazione != null ? servizioEnteOrganizzazione.getFascicoloId() : null);

            String titolarioId = resolveProtocolValue(
                    servizioEnte.getTitolarioId(),
                    servizioEnteOrganizzazione != null ? servizioEnteOrganizzazione.getTitolarioId() : null);

            TipoPersona tipoPersona = Validator.isNotNull(richiesta.getPartitaIva())
                    ? TipoPersona.GIURIDICA
                    : TipoPersona.FISICA;

            String codiceIstanzaPortale = servizio.getCodice()
                    + "/"
                    + richiestaId
                    + "/"
                    + richiestaIstanzaId
                    + "/cr/i";

            return new DatiPraticaDTO()
                    .setIndirizzoTelematico(richiesta.getEmail())
                    .setTipoPersona(tipoPersona)
                    .setCodiceFiscale(richiesta.getCodiceFiscale())
                    .setUserName(richiesta.getDenominazioneRichiedente())
                    .setCodice(servizio.getCodice())
                    .setContesto(Contesto.valueOf(servizioEnte.getContesto()))
                    .setCodiceIstanzaPortale(codiceIstanzaPortale)
                    .setTipoIstanza(TipoIstanzaPortaleServizi.SERVIZI_CAMBIO_REFERENTE.name())
                    .setMittenteInterno(servizioEnte.getMittenteInterno())
                    .setCodiceAOO(codiceAoo)
                    .setCodiceUO(codiceUo)
                    .setTipoProtocolloClient(servizioEnte.getTipoProtocolloClient())
                    .setClassifica(servizioEnte.getClassifica())
                    .setTipoDocumento(servizioEnte.getTipoDocumento())
                    .setIdPratica(servizioEnte.getIdPratica())
                    .setInCaricoA(servizioEnte.getInCaricoA())
                    .setFascicoloId(fascicoloId)
                    .setTitolarioId(titolarioId)
                    .setPartitaIva(richiesta.getPartitaIva())
                    .setNome(user.getFirstName())
                    .setCognome(user.getLastName());
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
    }

    private ServizioEnte getServizioEnte(long servizioEnteId, long richiestaId) throws Exception {
        Richiesta richiesta = richiestaLocalService.getRichiesta(richiestaId);
        Organization organization = organizationUtility.getSiteOrganization(richiesta.getGroupId());
        long organizationId = organization.getOrganizationId();
        ServizioEntePK pk = new ServizioEntePK(servizioEnteId, organizationId);
        return servizioEnteLocalService.getServizioEnte(pk);
    }

    private ServizioEnteOrganizzazione getServizioEnteOrganizzazione(Richiesta richiesta, Organization organization) {
        ServizioEnteOrganizzazionePK primaryKey = new ServizioEnteOrganizzazionePK();
        primaryKey.setServizioId(richiesta.getServizioId());
        primaryKey.setOrganizationId(organization.getOrganizationId());
        primaryKey.setSubOrganizationId(richiesta.getSubOrganizationId());
        return servizioEnteOrganizzazioneLocalService.fetchServizioEnteOrganizzazione(primaryKey);
    }

    private String resolveProtocolValue(String defaultValue, String overrideValue) {
        if (Validator.isBlank(overrideValue)) {
            return defaultValue;
        }
        return overrideValue;
    }
}
