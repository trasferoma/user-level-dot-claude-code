    }

    @Override
    public ServizioDTO getServizioByProcedimento(long idProcedimento) {
        try {
            Servizio servizio = servizioLocalService.getServizio(idProcedimento);

            ServizioDTO servizioDTO = new ServizioDTO();
            servizioDTO.setCodiceServizio(servizio.getCodice());
            servizioDTO.setServizioId(servizio.getServizioId());
            servizioDTO.setNome(servizio.getNome());
