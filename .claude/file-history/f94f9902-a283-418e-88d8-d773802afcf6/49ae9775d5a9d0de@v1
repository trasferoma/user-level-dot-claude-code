    @Override
    public boolean existsRichiesta(long richiestaId) {
        try {
            Richiesta richiesta = richiestaLocalService.fetchRichiesta(richiestaId);
            return Validator.isNotNull(richiesta);
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
    }

    @Override
    public boolean istanzePresenti(long servizioId, String partitaIva) {
        return richiestaLocalService.countIstanzePresenti(servizioId, partitaIva) > 0;
    }

    @Override
    public Contesto getContestoByProcedimento(long idProcedimento, long groupId) {
