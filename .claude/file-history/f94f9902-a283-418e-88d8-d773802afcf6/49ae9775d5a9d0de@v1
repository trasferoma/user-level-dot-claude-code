        } catch (Exception e) {
            throw new RuntimeException(e);
        }
    }

    @Override
    public ProtocolloRequest createProtocolloRequest(RichiestaReferenteIstanza richiestaReferenteIstanza) {
        try {
            Richiesta richiesta = risolviRichiesta(richiestaReferenteIstanza);

            Organization organization = organizationUtility.getSiteOrganization(richiesta.getGroupId());

            ServizioEntePK servizioEntePK = new ServizioEntePK(richiesta.getServizioId(), organization.getOrganizationId());
            ServizioEnte servizioEnte = servizioEnteLocalService.getServizioEnte(servizioEntePK);
            Servizio servizio = servizioLocalService.fetchServizio(richiesta.getServizioId());

            String canaleProtocolloServizioEnte = servizioEnte.getCanaleProtocollo();
            CanaleProtocollo canaleProtocollo = null;
            if (Validator.isNotNull(canaleProtocolloServizioEnte)) {
                canaleProtocollo = CanaleProtocollo.valueOf(canaleProtocolloServizioEnte);
            }

            ProtocolloRequest protocolloRequest = new ProtocolloRequest();
            protocolloRequest.setEntityId(String.valueOf(richiestaReferenteIstanza.getRichiestaReferenteIstanzaId()));
            String oggetto = richiesta.getOggetto();
            protocolloRequest.setOggetto(oggetto);

            String codiceIstanzaPortale = servizio.getCodice() + "/" + richiestaReferenteIstanza.getRichiestaReferenteIstanzaId();
            String tipoIstanzaPortale = TipoIstanzaPortaleServizi.SERVIZI_CAMBIO_REFERENTE.name();

            protocolloRequest.setCodiceIstanzaPortale(codiceIstanzaPortale);
            protocolloRequest.setTipoIstanzaPortale(tipoIstanzaPortale);

            if (Validator.isNotNull(servizioEnte.getTipoDocumento())) {
                protocolloRequest.setTipoDocumento(servizioEnte.getTipoDocumento());
            }

            if (Validator.isNotNull(servizioEnte.getMittenteInterno())) {
                protocolloRequest.setMittenteInterno(servizioEnte.getMittenteInterno());
            }

            if (Validator.isNotNull(servizioEnte.getIdPratica())) {
                protocolloRequest.setIdPratica(servizioEnte.getIdPratica());
            }

            if (Validator.isNotNull(servizioEnte.getInCaricoA())) {
                protocolloRequest.setInCaricoA(servizioEnte.getInCaricoA());
            }

            if (Validator.isNotNull(servizioEnte.getClassifica())) {
                protocolloRequest.setClassifica(servizioEnte.getClassifica());
            }

            if (Validator.isNotNull(servizioEnte.getTipoProtocolloClient())) {
                protocolloRequest.setTipoProtocolloClient(servizioEnte.getTipoProtocolloClient());
            }

            List<AllegatoReferenteIstanza> allegatiPrincipale = allegatoReferenteIstanzaLocalService.getByRichiestaReferenteIdAndPrincipale(richiesta.getRichiestaId(), true);
            if (allegatiPrincipale != null && !allegatiPrincipale.isEmpty()) {
                protocolloRequest.setDocumento(getDocumentoProtocollo(allegatiPrincipale.get(0)));
            }

            List<AllegatoReferenteIstanza> allegatiRichiesta = allegatoReferenteIstanzaLocalService.getByRichiestaReferenteIdAndPrincipale(richiesta.getRichiestaId(), false);
            if (allegatiRichiesta != null && !allegatiRichiesta.isEmpty()) {
                List<Documento> allegati = new ArrayList<Documento>();
                for (AllegatoReferenteIstanza allegatoRichiesta : allegatiRichiesta) {
                    allegati.add(getDocumentoProtocollo(allegatoRichiesta));
                }
                protocolloRequest.setAllegati(allegati);
            }
            Origine origine = new Origine();

            IndirizzoTelematico indirizzoTelematico = new IndirizzoTelematico();
            indirizzoTelematico.setValore(richiesta.getEmail());
            origine.setIndirizzoTelematico(indirizzoTelematico);

            Persona persona = new Persona();
            TipoPersona tipoPersona = TipoPersona.FISICA;
            if (Validator.isNotNull(richiesta.getPartitaIva())) {
                tipoPersona = TipoPersona.GIURIDICA;
                persona.setPartitaIva(richiesta.getPartitaIva());
            }

            persona.setTipoPersona(tipoPersona);

            persona.setCodiceFiscale(richiesta.getCodiceFiscale());
            persona.setDenominazione(richiesta.getDenominazioneRichiedente());

            User user = userLocalService.getUser(richiesta.getUserId());
            persona.setCognome(user.getLastName());
            persona.setNome(user.getFirstName());

            Mittente mittente = new Mittente();
            mittente.setPersona(persona);
            origine.setMittente(mittente);
            protocolloRequest.setOrigine(origine);

            protocolloRequest.setCanaleProtocollo(canaleProtocollo);

            ServizioEnteOrganizzazione servizioEnteOrganizzazione = null;
            ServizioEnteOrganizzazionePK servizioEnteOrganizzazionePK = new ServizioEnteOrganizzazionePK();
            servizioEnteOrganizzazionePK.setServizioId(richiesta.getServizioId());
            servizioEnteOrganizzazionePK.setOrganizationId(organization.getOrganizationId());
            servizioEnteOrganizzazionePK.setSubOrganizationId(richiesta.getSubOrganizationId());
            servizioEnteOrganizzazione = servizioEnteOrganizzazioneLocalService.getServizioEnteOrganizzazione(servizioEnteOrganizzazionePK);

            String aooProtocollo = servizioEnte.getAooProtocollo();
            String uoProtocollo = servizioEnte.getUoProtocollo();
            String fascicoloId = servizioEnte.getFascicoloId();
            String titolarioId = servizioEnte.getTitolarioId();

            if (Validator.isNotNull(servizioEnteOrganizzazione)) {
                if (!Validator.isBlank(servizioEnteOrganizzazione.getAooProtocollo())) {
                    aooProtocollo = servizioEnteOrganizzazione.getAooProtocollo();
                }


                if (!Validator.isBlank(servizioEnteOrganizzazione.getUoProtocollo())) {
                    uoProtocollo = servizioEnteOrganizzazione.getUoProtocollo();
                }


                if (!Validator.isBlank(servizioEnteOrganizzazione.getFascicoloId())) {
                    fascicoloId = servizioEnteOrganizzazione.getFascicoloId();
                }


                if (!Validator.isBlank(servizioEnteOrganizzazione.getTitolarioId())) {
                    titolarioId = servizioEnteOrganizzazione.getTitolarioId();
                }
            }

            protocolloRequest.setCodiceAOO(aooProtocollo);
            protocolloRequest.setCodiceUO(uoProtocollo);
            protocolloRequest.setFascicoloId(fascicoloId);
            protocolloRequest.setTitolarioId(titolarioId);

            Contesto contesto = Contesto.valueOf(servizioEnte.getContesto());
            protocolloRequest.setContesto(contesto);

            return protocolloRequest;
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
    }

    private Documento getDocumentoProtocollo(AllegatoReferenteIstanza allegatoReferenteIstanza) throws Exception {
        FileService fileService = fileServiceFactory.getActiveFileService();
        File file = fileService.getRequestFile(allegatoReferenteIstanza.getIdDocumentale(), allegatoReferenteIstanza.getGroupId());

        Documento documento = new Documento();
        documento.setContenuto(file.getInputStream().readAllBytes());
        documento.setNome(allegatoReferenteIstanza.getNome());
        documento.setOggetto(allegatoReferenteIstanza.getDescrizione());
        documento.setTipo(null);
        documento.setTipoMIME(null);
        documento.setTitolo(allegatoReferenteIstanza.getTitolo());

        return documento;
    }

