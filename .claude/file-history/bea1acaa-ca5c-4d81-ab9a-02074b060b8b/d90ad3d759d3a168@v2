package it.servizidigitali.common.fdr.service.impl;

import static org.assertj.core.api.Assertions.assertThat;
import static org.mockito.Mockito.mock;
import static org.mockito.Mockito.when;

import java.lang.reflect.Field;
import java.nio.charset.StandardCharsets;
import java.util.Collections;
import java.util.List;

import com.liferay.portal.kernel.module.configuration.ConfigurationProvider;

import it.servizidigitali.common.fdr.client.FirmaRemotaClient;
import it.servizidigitali.common.fdr.configuration.FirmaRemotaCommonEnteConfiguration;
import it.servizidigitali.common.fdr.dto.VerificaFirmaOptions;
import it.servizidigitali.common.fdr.dto.VerificaResponse;
import it.servizidigitali.common.utility.enumeration.Contesto;

import org.junit.Before;
import org.junit.Test;

/**
 * Test unitario di {@link FirmaRemotaServiceImpl}.
 *
 * <p>La classe sotto test non esegue alcuna operazione crittografica: sia la firma
 * ({@code applicaSigillo}) sia la verifica ({@code verificaFirma}) delegano a un provider
 * remoto tramite {@link FirmaRemotaClient}. Moccando le dipendenze, la firma e l'esito della
 * verifica sono entrambi simulati dal mock: questo test esercita quindi l'orchestrazione del
 * servizio (selezione del provider in base alla configurazione) e le regole di validazione di
 * {@code verificaFirma}, non la validita crittografica reale del documento.</p>
 */
public class FirmaRemotaServiceImplTest {

    private static final long GROUP_ID = 20123L;
    private static final long USER_ID = 456L;
    private static final Contesto CONTESTO = Contesto.SICI;
    private static final String PROVIDER = "TEST";
    private static final String TIPO_FIRMA = "PAdES";
    private static final String CF_FIRMATARIO = "RSSMRA80A01H501U";
    private static final String CODICE_OTP = "123456";
    private static final String PASSWORD = "secret";

    private FirmaRemotaServiceImpl firmaRemotaService;
    private ConfigurationProvider configurationProvider;
    private FirmaRemotaClient firmaRemotaClient;
    private FirmaRemotaCommonEnteConfiguration configuration;

    @Before
    public void setUp() throws Exception {
        configurationProvider = mock(ConfigurationProvider.class);
        firmaRemotaClient = mock(FirmaRemotaClient.class);
        configuration = mock(FirmaRemotaCommonEnteConfiguration.class);

        firmaRemotaService = new FirmaRemotaServiceImpl();
        setPrivateField(firmaRemotaService, "configurationProvider", configurationProvider);
        setPrivateField(firmaRemotaService, "firmaRemotaClient", Collections.singletonList(firmaRemotaClient));

        when(configurationProvider.getGroupConfiguration(FirmaRemotaCommonEnteConfiguration.class, GROUP_ID))
                .thenReturn(configuration);
        when(configuration.provider()).thenReturn(PROVIDER);
        when(firmaRemotaClient.getProviderName()).thenReturn(PROVIDER);
    }

    @Test
    public void verificaFirma_documentoValidoAppenaFirmato_confermaLaFirma() {
        byte[] documento = creaDocumento();
        byte[] documentoFirmato = "%PDF-1.4 documento firmato".getBytes(StandardCharsets.UTF_8);

        when(firmaRemotaClient.signWithPades(GROUP_ID, USER_ID, CONTESTO, documento, CODICE_OTP, PASSWORD))
                .thenReturn(documentoFirmato);
        when(firmaRemotaClient.verificaDocumentoFirmato(GROUP_ID, CONTESTO, documentoFirmato))
                .thenReturn(creaVerificaValida());

        byte[] firmato = firmaRemotaService.applicaSigillo(
                GROUP_ID, USER_ID, CONTESTO, documento, CODICE_OTP, PASSWORD);

        VerificaResponse verifica = firmaRemotaService.verificaFirma(
                GROUP_ID, CONTESTO, firmato, creaOptions());

        assertThat(verifica).isNotNull();
        assertThat(verifica.isFirmato()).isTrue();
        assertThat(verifica.isFirmaValida()).isTrue();
        assertThat(verifica.isSigilloQualificato()).isTrue();
        assertThat(verifica.getTipoFirma()).isEqualTo(TIPO_FIRMA);
        assertThat(verifica.getFirme()).contains(CF_FIRMATARIO);
    }

    private byte[] creaDocumento() {
        return "%PDF-1.4 documento di test".getBytes(StandardCharsets.UTF_8);
    }

    private VerificaResponse creaVerificaValida() {
        VerificaResponse response = new VerificaResponse();
        response.setFirmato(true);
        response.setFirmaValida(true);
        response.setSigilloQualificato(true);
        response.setTipoFirma(TIPO_FIRMA);
        response.setImpronta("impronta-test");
        response.setFirme(Collections.singleton(CF_FIRMATARIO));
        response.setFirmatari(Collections.singleton("Mario Rossi"));
        return response;
    }

    private VerificaFirmaOptions creaOptions() {
        List<String> tipiFirmaAmmessi = Collections.singletonList(TIPO_FIRMA);

        VerificaFirmaOptions options = new VerificaFirmaOptions();
        options.setDescrizione("Documento di test");
        options.setTipiFirmaAmmessi(tipiFirmaAmmessi);
        options.setVerificaSigilloQualificato(true);
        options.setVerificaFirmaCf(true);
        options.setCfLoggato(CF_FIRMATARIO);
        return options;
    }

    private static void setPrivateField(Object target, String fieldName, Object value) {
        try {
            Field field = target.getClass().getDeclaredField(fieldName);
            field.setAccessible(true);
            field.set(target, value);
        } catch (ReflectiveOperationException e) {
            throw new IllegalStateException("Impossibile impostare il campo " + fieldName, e);
        }
    }
}
