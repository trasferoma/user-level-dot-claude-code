package it.servizidigitali.common.fdr.client.api.impl;

import static org.assertj.core.api.Assertions.assertThat;

import java.util.Arrays;
import java.util.List;

import it.servizidigitali.common.fdr.client.api.dto.Certificato;
import it.servizidigitali.common.fdr.client.api.dto.VerificaSigilloResponse;
import it.servizidigitali.common.fdr.client.api.dto.VerificationResponse;
import it.servizidigitali.common.fdr.dto.VerificaResponse;

import org.junit.Test;

/**
 * Test unitario della mappatura {@link FirmaRemotaApiClient#mapResponse} dalla risposta SOAP
 * del servizio di verifica al DTO applicativo {@link VerificaResponse}.
 *
 * <p>La mappatura e l'unica logica deterministica e priva di I/O del flusso di verifica:
 * il metodo pubblico {@code verificaDocumentoFirmato} effettua una chiamata HTTP reale e qui
 * non viene esercitato. I controlli riguardano i comportamenti a piu alto rischio di
 * regressione: inclusione dei soli certificati validi, rimozione del prefisso {@code TINIT-}
 * dai codici fiscali e copia dei flag di esito.</p>
 */
public class FirmaRemotaApiClientTest {

    private static final String CF_CON_PREFISSO = "TINIT-RSSMRA80A01H501U";
    private static final String CF_SENZA_PREFISSO = "RSSMRA80A01H501U";
    private static final String FIRMATARIO = "Mario Rossi";
    private static final String TIPO_FIRMA = "PAdES";
    private static final String IMPRONTA = "a1b2c3d4";

    @Test
    public void mapResponse_documentoValidoFirmato_mappaEsitoECodiceFiscaleSenzaPrefisso() {
        Certificato certificatoValido = creaCertificato(CF_CON_PREFISSO, FIRMATARIO, true);
        VerificaSigilloResponse soapResponse = creaSoapResponse(true, true, true, Arrays.asList(certificatoValido));

        VerificaResponse verifica = FirmaRemotaApiClient.mapResponse(soapResponse);

        assertThat(verifica.isFirmato()).isTrue();
        assertThat(verifica.isFirmaValida()).isTrue();
        assertThat(verifica.isSigilloQualificato()).isTrue();
        assertThat(verifica.getTipoFirma()).isEqualTo(TIPO_FIRMA);
        assertThat(verifica.getImpronta()).isEqualTo(IMPRONTA);
        assertThat(verifica.getFirme()).containsExactly(CF_SENZA_PREFISSO);
        assertThat(verifica.getFirmatari()).containsExactly(FIRMATARIO);
    }

    @Test
    public void mapResponse_certificatoNonValido_vieneEscluso() {
        Certificato certificatoValido = creaCertificato(CF_CON_PREFISSO, FIRMATARIO, true);
        Certificato certificatoNonValido = creaCertificato("TINIT-VRDLGI70B02F205X", "Luigi Verdi", false);
        VerificaSigilloResponse soapResponse = creaSoapResponse(
                true, true, true, Arrays.asList(certificatoValido, certificatoNonValido));

        VerificaResponse verifica = FirmaRemotaApiClient.mapResponse(soapResponse);

        assertThat(verifica.getFirme()).containsExactly(CF_SENZA_PREFISSO);
        assertThat(verifica.getFirmatari()).containsExactly(FIRMATARIO);
    }

    @Test
    public void mapResponse_senzaCertificati_restituisceInsiemiVuotiSenzaErrori() {
        VerificaSigilloResponse soapResponse = creaSoapResponse(false, false, false, null);

        VerificaResponse verifica = FirmaRemotaApiClient.mapResponse(soapResponse);

        assertThat(verifica.isFirmato()).isFalse();
        assertThat(verifica.getFirme()).isEmpty();
        assertThat(verifica.getFirmatari()).isEmpty();
    }

    private Certificato creaCertificato(String codiceFiscale, String firmatario, boolean valido) {
        Certificato certificato = new Certificato();
        certificato.setCfFirmatario(codiceFiscale);
        certificato.setFirmatario(firmatario);
        certificato.setValido(valido);
        return certificato;
    }

    private VerificaSigilloResponse creaSoapResponse(
            boolean firmato, boolean firmaValida, boolean sigilloQualificato, List<Certificato> certificati) {

        VerificationResponse verificationResponse = new VerificationResponse();
        verificationResponse.setFirmato(firmato);
        verificationResponse.setFirmaValida(firmaValida);
        verificationResponse.setSigilloQualificato(sigilloQualificato);
        verificationResponse.setTipoFirma(TIPO_FIRMA);
        verificationResponse.setImpronta(IMPRONTA);
        verificationResponse.setCertificati(certificati);

        VerificaSigilloResponse soapResponse = new VerificaSigilloResponse();
        soapResponse.setVerificationResponse(verificationResponse);
        return soapResponse;
    }
}
