@Component(immediate = true, service = FirmaRemotaClient.class)
public class FirmaRemotaApiClient implements FirmaRemotaClient {
    private static final String CF_FIRMA_PREFIX = "TINIT-";
    private static final Log _log = LogFactoryUtil.getLog(FirmaRemotaApiClient.class);

    private static final String FLAG_YES = "1";
    private static final String CODICE_SIGILLO_ANY = "ANY";
    private static final int DATA_ODIERNA = 0;

    @Reference
    private ApiPugliaService apiPugliaService;

    @Reference
    private ConfigurationProvider configurationProvider;

    @Reference
    private UserLocalService userLocalService;

    @Override
    public String getProviderName() {
        return "API";
    }

    @Override
    public byte[] signWithPades(long groupId, long userId, Contesto contesto, byte[] pdf, String codiceOtpFirma, String password) {
        try {
            FirmaRemotaApiEnteConfiguration configuration = configurationProvider.getGroupConfiguration(FirmaRemotaApiEnteConfiguration.class, groupId);

            PadesSignatureRequest padesSignatureRequest = new PadesSignatureRequest();
            padesSignatureRequest.setAuth(createAuth(configuration, userId, codiceOtpFirma, password));
            padesSignatureRequest.setFiles(createFiles(pdf));
            padesSignatureRequest.setPadesParam(createPadesParam(configuration, userId));

            String requestBody = createMessage(padesSignatureRequest, configuration);
            AmbienteRiferimento ambienteRiferimentoEnum = AmbienteRiferimento.valueOf(configuration.ambienteRiferimento());
            String accessToken = apiPugliaService.getToken(groupId, ambienteRiferimentoEnum, contesto);

            HttpRequest httpRequest = HttpRequest.newBuilder()
                    .uri(new URI(configuration.getServiceUrl()))
                    .method("POST", HttpRequest.BodyPublishers.ofString(requestBody))
                    .header("Content-Type", "text/xml")
                    .header("Accept", "application/xml")
                    .header("Authorization", "Bearer " + accessToken)
                    .build();

            HttpClient httpClient = HttpClient
                    .newBuilder()
                    .build();

            HttpResponse<String> httpResponse = httpClient.send(httpRequest, HttpResponse.BodyHandlers.ofString());
            if (httpResponse.statusCode() != 200) {
                _log.error("Errore durante la firma digitale - Status: " + httpResponse.statusCode() + " - Response: " + httpResponse.body());
                throw new FirmaDigitaleRemotaException();
            }

            PadesSignatureResponse padesSignatureResponse = parseMessage(httpResponse.body(), PadesSignatureResponse.class);

            byte[] pdfSigillo = null;
            if(Validator.isNotNull(padesSignatureResponse) && Validator.isNotNull(padesSignatureResponse.getSignatureResponse())){
                String b64 = padesSignatureResponse.getSignatureResponse().getFiles().get(0).getData();

                if(Validator.isNotNull(b64)){
                    pdfSigillo = Base64.getDecoder().decode(b64.getBytes(StandardCharsets.UTF_8));
                }

            }

            return pdfSigillo;
        } catch (Exception e) {
            _log.error("Errore durante la firma digitale", e);
            throw new FirmaDigitaleRemotaException();
        }
    }

    @Override
    public VerificaResponse verificaDocumentoFirmato(long groupId, Contesto contesto, byte[] fileBytes) {
        try {
            FirmaRemotaApiEnteConfiguration configuration = configurationProvider.getGroupConfiguration(FirmaRemotaApiEnteConfiguration.class, groupId);

            Param param = new Param();
            param.setCodiceSigillo(CODICE_SIGILLO_ANY);
            String file = new String(Base64.getEncoder().encode(fileBytes), StandardCharsets.UTF_8);
            param.setFile(file);
            param.setTsDateValidity(DATA_ODIERNA);

            VerificaSigilloRequest verificaSigillo = new VerificaSigilloRequest();
            verificaSigillo.setParam(param);
            AmbienteRiferimento ambienteRiferimentoEnum = AmbienteRiferimento.valueOf(configuration.ambienteRiferimento());

            String accessToken = apiPugliaService.getToken(groupId, ambienteRiferimentoEnum, contesto);
            String requestBody = createMessage(verificaSigillo, configuration);

            HttpRequest httpRequest = HttpRequest.newBuilder()
                    .uri(new URI(configuration.getServiceUrl()))
                    .method("POST", HttpRequest.BodyPublishers.ofString(requestBody))
                    .header("Content-Type", "text/xml")
                    .header("Accept", "application/xml")
                    .header("Authorization", "Bearer " + accessToken)
                    .build();

            HttpClient httpClient = HttpClient
                    .newBuilder()
                    .build();

            HttpResponse<String> httpResponse = httpClient.send(httpRequest, HttpResponse.BodyHandlers.ofString());
            if (httpResponse.statusCode() != 200) {
                _log.error("Errore durante la verifica della firma - Status: " + httpResponse.statusCode() + " - Response: " + httpResponse.body());
                throw new ServizioNonDisponibileException("Si è verificato un errore durante la verifica della firma digitale.");
            }

            VerificaSigilloResponse verificaSigilloResponse = parseMessage(httpResponse.body(), VerificaSigilloResponse.class);
            return mapResponse(verificaSigilloResponse);
        } catch (ServizioNonDisponibileException e) {
            throw e;
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
    }

    // Visibilita di package per consentire il test unitario della mappatura.
    static VerificaResponse mapResponse(VerificaSigilloResponse verificaSigilloResponse) {
        Set<String> cfFirme = Optional.ofNullable(verificaSigilloResponse.getVerificationResponse())
                .map(VerificationResponse::getCertificati)
                .orElse(Collections.emptyList())
                .stream()
                .filter(Certificato::isValido)
                .map(Certificato::getCfFirmatario)
                .filter(Objects::nonNull)
                .map(s -> s.replace(CF_FIRMA_PREFIX, StringPool.BLANK))
                .collect(Collectors.toSet());
        Set<String> firmatari = Optional.ofNullable(verificaSigilloResponse.getVerificationResponse())
                .map(VerificationResponse::getCertificati)
                .orElse(Collections.emptyList())
                .stream()
                .filter(Certificato::isValido)
                .map(Certificato::getFirmatario)
                .filter(Objects::nonNull)
                .collect(Collectors.toSet());

        VerificaResponse response = new VerificaResponse();
        response.setFirmato(verificaSigilloResponse.getVerificationResponse().isFirmato());
        response.setFirmaValida(verificaSigilloResponse.getVerificationResponse().isFirmaValida());
        response.setImpronta(verificaSigilloResponse.getVerificationResponse().getImpronta());
        response.setTipoFirma(verificaSigilloResponse.getVerificationResponse().getTipoFirma());
        response.setSigilloQualificato(verificaSigilloResponse.getVerificationResponse().isSigilloQualificato());
        response.setFirme(cfFirme);
        response.setFirmatari(firmatari);
        return response;
    }

    private Files createFiles(byte[] bytes) {
        String encoded = new String(Base64.getEncoder().encode(bytes), StandardCharsets.UTF_8);

        File file = new File();
        file.setData(encoded);

        Pdf pdf = new Pdf();
        pdf.setFile(file);

        Files files = new Files();
        files.setPdf(pdf);
        return files;
    }

    private PadesParam createPadesParam(FirmaRemotaApiEnteConfiguration configuration, long userId) {
        PadesParam padesParam = new PadesParam();
        padesParam.setFlagVisibile(FLAG_YES.equals(configuration.isSignVisible()));

        if(userId > 0){
            padesParam.setPage(Integer.parseInt(configuration.getSignPageOperatore()));
            padesParam.setLeftx(Integer.parseInt(configuration.getSignLeftXOperatore()));
            padesParam.setLefty(Integer.parseInt(configuration.getSignLeftYOperatore()));
            padesParam.setRightx(Integer.parseInt(configuration.getSignRightXOperatore()));
            padesParam.setRighty(Integer.parseInt(configuration.getSignRightYOperatore()));
        }else{
            padesParam.setPage(Integer.parseInt(configuration.getSignPage()));
            padesParam.setLeftx(Integer.parseInt(configuration.getSignLeftX()));
            padesParam.setLefty(Integer.parseInt(configuration.getSignLeftY()));
            padesParam.setRightx(Integer.parseInt(configuration.getSignRightX()));
            padesParam.setRighty(Integer.parseInt(configuration.getSignRightY()));
        }


        padesParam.setPadesProfile(PadesProfile.PADESBES);
        return padesParam;
    }

    private Auth createAuth(FirmaRemotaApiEnteConfiguration configuration, long userId, String codiceOtpFirma, String password) throws Exception{
        String codiceCertificato = configuration.getSignCodiceCertificato();
        String codiceFiscale = configuration.getSignCodiceFiscale();
        String passwordSign = configuration.getSignPassword();
        String otpPassword = configuration.getSignOtp();

        if(userId > 0){
            User user = userLocalService.fetchUser(userId);
            String codiceCertificatoAttr = "codiceCertificato";
            String codiceFiscaleAttr = "codiceFiscale";
            if(Validator.isNotNull(user) && Validator.isNotNull(codiceOtpFirma) && Validator.isNotNull(password)){
                ExpandoBridge expandoBridge = user.getExpandoBridge();
                String codiceCertificatoExpando = (String) expandoBridge.getAttribute(codiceCertificatoAttr);
                String codiceFiscaleExpando = (String) expandoBridge.getAttribute(codiceFiscaleAttr);

                if(Validator.isNotNull(codiceCertificatoExpando)){
                    codiceCertificato = codiceCertificatoExpando;
                }

                if(Validator.isNotNull(codiceFiscaleExpando)){
                    codiceFiscale = codiceFiscaleExpando;
                }

                if(Validator.isNotNull(password)){
                    passwordSign = password;
                }

                if(Validator.isNotNull(codiceOtpFirma)){
                    otpPassword = codiceOtpFirma;
                }

                if(Validator.isNull(codiceCertificato) || Validator.isNull(codiceFiscale) || Validator.isNull(password) || Validator.isNull(otpPassword)){
                    throw new Exception("Credenziali FDR operatore mancanti! Controllare configurazione utenza");
                }
            }
        }

        Auth signatureAuth = new Auth();
        signatureAuth.setCodiceCertificato(codiceCertificato);
        signatureAuth.setCodiceFiscale(codiceFiscale);
        signatureAuth.setPassword(passwordSign);
        signatureAuth.setOtpPassword(otpPassword);
        return signatureAuth;
    }

    private <T> T parseMessage(String responseBody, Class<T> clazz) throws Exception {
        JAXBContext jaxbContext = JAXBContext.newInstance(
                PadesSignatureRequest.class, PadesSignatureResponse.class,
                VerificaSigilloRequest.class, VerificaSigilloResponse.class);

        ByteArrayInputStream bais = new ByteArrayInputStream(responseBody.getBytes());
        StreamSource source = new StreamSource(bais);

        MessageFactory messageFactory = new SOAPMessageFactory1_1Impl();
        SOAPMessage message = messageFactory.createMessage();
        SOAPPart soapPart = message.getSOAPPart();

        soapPart.setContent(source);

        SOAPBody soapBody = message.getSOAPBody();
        SOAPFault fault = soapBody.getFault();
        if (fault != null) {
            String faultCode = fault.getFaultCode();
            String faultString = fault.getFaultString();

            throw new Exception(faultString);
        } else {
            Unmarshaller unmarshaller = jaxbContext.createUnmarshaller();
            T response = (T) unmarshaller.unmarshal(soapBody.getFirstChild());
            return response;
        }
    }

    private String createMessage(Object o, FirmaRemotaApiEnteConfiguration configuration) throws Exception {
        DocumentBuilderFactory documentBuilderFactory = DocumentBuilderFactory.newInstance();
        DocumentBuilder documentBuilder = documentBuilderFactory.newDocumentBuilder();
        Document document = documentBuilder.newDocument();

        JAXBContext jaxbContext = JAXBContext.newInstance(
                PadesSignatureRequest.class, PadesSignatureResponse.class,
                VerificaSigilloRequest.class, VerificaSigilloResponse.class);

        Marshaller marshaller = jaxbContext.createMarshaller();
        marshaller.marshal(o, document);

        MessageFactory messageFactory = new SOAPMessageFactory1_1Impl();
        SOAPMessage soapMessage = messageFactory.createMessage();

        SOAPPart soapPart = soapMessage.getSOAPPart();
        SOAPEnvelope envelope = soapPart.getEnvelope();

        SOAPHeader header = envelope.getHeader();
        fillSecurity(header, configuration);

        SOAPBody body = envelope.getBody();
        body.addDocument(document);

        soapMessage.saveChanges();

        ByteArrayOutputStream baos = new ByteArrayOutputStream();
        soapMessage.writeTo(baos);
        return baos.toString();
    }

    private void fillSecurity(SOAPHeader header, FirmaRemotaApiEnteConfiguration configuration) throws SOAPException {
        String username = configuration.getSoapAuthUsername();
        String password = configuration.getSoapAuthPassword();

        SOAPElement securityHeader = header.addChildElement(new QName("http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-secext-1.0.xsd", "Security", "wsse"));

        SOAPElement usernameTokenHeader = securityHeader.addChildElement(new QName("http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-secext-1.0.xsd", "UsernameToken", "wsse"));

        SOAPElement usernameHeader = usernameTokenHeader.addChildElement(new QName("http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-secext-1.0.xsd", "Username", "wsse"));
        usernameHeader.setValue(username);

        SOAPElement passwordHeader = usernameTokenHeader.addChildElement(new QName("http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-secext-1.0.xsd", "Password", "wsse"));
        passwordHeader.setValue(password);
        passwordHeader.setAttribute("Type", "http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-username-token-profile-1.0#PasswordText");
    }

