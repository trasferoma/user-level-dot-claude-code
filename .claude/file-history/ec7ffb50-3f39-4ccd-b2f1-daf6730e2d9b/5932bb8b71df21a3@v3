<%@ include file="init.jsp" %>

<portlet:renderURL var="indietroURL">
    <portlet:param name="mvcRenderCommandName" value="/dettaglio_bando" />
    <portlet:param name="bandoId" value="${bandoId}" />
    <portlet:param name="queryTab" value="${queryTabParent}" />
</portlet:renderURL>

<h2>
	<a href="${indietroURL}" class="text-decoration-none" title="<liferay-ui:message key="indietro" />">
		<i class="fa fa-arrow-left" aria-hidden="true"></i>
	</a>
    <c:choose>
        <c:when test="${empty fase}">
            <liferay-ui:message key="dati-dettaglio-pratica-no-fase" arguments="${titleArgs}" />
        </c:when>

        <c:otherwise>
            <liferay-ui:message key="dati-dettaglio-pratica" arguments="${titleArgs}" />
        </c:otherwise>
    </c:choose>
</h2>

<%@ include file="dettaglio_domanda_bando_azioni.jsp" %>

<h3><liferay-ui:message key="servizi.esecuzione" /></h3>

<div name="collapseDiv" class="collapse-div collapse-background-active">

<liferay-portlet:renderURL varImpl="servizioEsecuzioneIteratorURL">
	<portlet:param name="mvcRenderCommandName"
		value="/dettaglio_domanda_bando" />
	<portlet:param name="domandaBandoId" value="${domandaBandoId}" />
	<portlet:param name="queryTab" value="${queryTab}" />
	<portlet:param name="queryTabParent" value="${queryTabParent}" />
	<portlet:param name="curServizioEsecuzione" value="${curServizioEsecuzione}" />
	<portlet:param name="deltaServizioEsecuzione" value="${deltaServizioEsecuzione}" />
</liferay-portlet:renderURL>

<liferay-ui:search-container total="${servizioEsecuzioneCount}"
	emptyResultsMessage="servizi-esecuzione-non-richiesti" curParam="curServizioEsecuzione"
	delta="${deltaServizioEsecuzione}" iteratorURL="${servizioEsecuzioneIteratorURL}">
	<liferay-ui:search-container-results results="${servizioEsecuzioneList}" />
	
		<liferay-ui:search-container-row className="it.servizidigitali.gestionebandi.operatore.frontend.dto.IntegrazioneRichiestaDTO"
	                             modelVar="elem">
		<fmt:formatDate value="${elem.data}" pattern="dd/MM/yyyy HH:mm" var="elemData" />
		
		<div class="collapse-header" id="heading${elem.istanzaFormId}">
		  <button class="text-decoration-none py-0" data-toggle="collapse" data-target="#collapse${elem.istanzaFormId}" aria-expanded="false" aria-controls="collapse${elem.istanzaFormId}">
		    <div class="d-flex justify-content-between">
			  <span class="text-uppercase">
		        ${elem.denominazione}
		      </span>
		      <span class="apri-collapse">Apri</span>
		      <span class="chiudi-collapse" >Chiudi</span>
		    </div>
            <c:if test="${!elem.codiceFormIntegrazionePresente and not empty elem.numeroProtocolloUscita}">
                <div class="d-flex short-info" id="shortInfo${elem.istanzaFormId}">
                    <small class="mr-3"><liferay-ui:message key="operatore" />:</small>
                    <c:if test="${elem.integrazione}">
                        <fmt:formatDate value="${elem.dataCreazione}" pattern="dd/MM/yyyy HH:mm" var="elemDataCreazione" />

                        <small class="mr-3"><liferay-ui:message key="data-invio-integrazione" />: ${elemDataCreazione}</small>
                    </c:if>
                    <small class="mr-3"><liferay-ui:message key="numero-protocollo-uscita" />: ${elem.numeroProtocolloUscita}</small>
                    <c:if test="${elem.dataProtocolloUscita != null}">
                        <fmt:formatDate value="${elem.dataProtocolloUscita}" pattern="dd/MM/yyyy HH:mm" var="elemDataProtocolloUscita" />

                        <small class="mr-3"><liferay-ui:message key="data-protocollo-uscita" />: ${elemDataProtocolloUscita}</small>
                    </c:if>
                </div>
            </c:if>
		    <div class="d-flex short-info" id="shortInfo${elem.istanzaFormId}">
                <small class="mr-3"><liferay-ui:message key="richiedente" />:</small>
                <c:if test="${not empty elem.dataInvio}">
                    <fmt:formatDate value="${elem.dataInvio}" pattern="dd/MM/yyyy HH:mm" var="elemDataInvio" />
                    <small class="mr-3"><liferay-ui:message key="data-invio-richiedente" />: ${elemDataInvio}</small>
                </c:if>
                <c:if test="${not empty elem.numeroProtocollo}">
                    <small class="mr-3"><liferay-ui:message key="numero-protocollo-ingresso" />: ${elem.numeroProtocollo}</small>
                </c:if>
                <c:if test="${elem.dataProtocollo != null}">
                    <fmt:formatDate value="${elem.dataProtocollo}" pattern="dd/MM/yyyy HH:mm" var="elemDataProtocollo" />

                    <small class="mr-3"><liferay-ui:message key="data-protocollo-ingresso" />: ${elemDataProtocollo}</small>
                </c:if>
                <small class="mr-3">
                    <liferay-ui:message key="stato" />:
                    <c:choose>
                        <c:when test="${elem.statoEsecuzione == 'CONFERMATA' and not empty elem.numeroProtocollo}">
                            <liferay-ui:message key="protocollata" />
                        </c:when>
                        <c:when test="${elem.statoEsecuzione == 'CONFERMATA'}">
                            <liferay-ui:message key="inviata" />
                        </c:when>
                        <c:when test="${elem.statoEsecuzione == 'VALIDATA' || elem.statoEsecuzione == 'BOZZA'}">
                            <liferay-ui:message key="bozza" />
                        </c:when>
                        <c:otherwise>
                            <liferay-ui:message key="${elem.statoEsecuzione}" />
                        </c:otherwise>
                    </c:choose>
                </small>
		    </div>
		  </button>
		</div>
		
		<portlet:renderURL var="dettaglioIntegrazioneBandoURL">
			<portlet:param name="mvcRenderCommandName" value="<%=ScrivaniaOperatoreBandiPortletKeys.DETTAGLIO_INTEGRAZIONI_BANDO_RENDER %>" />
			<portlet:param name="istanzaDomandaBandoId" value="${elem.istanzaFormId}" />
			<portlet:param name="queryTabParent" value="${queryTabParent}" />
			<portlet:param name="tipoDomanda" value="SERVIZI_ESECUZIONE" />
		</portlet:renderURL>

		<div id="collapse${elem.istanzaFormId}" class="collapse" role="region" aria-labelledby="heading${elem.istanzaFormId}">
			<div class="collapse-body py-3">
				<a class="btn btn-outline-primary mr-1 mt-1" href="${dettaglioIntegrazioneBandoURL}">
					<liferay-ui:message key="dettaglio" />
				</a>

				<c:if test="${not elem.esecuzioneIntegrazione and (elem.statoEsecuzione == 'CONFERMATA' or elem.statoEsecuzione == 'INTEGRATA')}">
                    <c:choose>
                        <c:when test="${not empty elem.numeroProtocollo}">
                            <a class="btn btn-outline-primary mr-1 mt-1"
                               href="javascript:void(0);"
                               data-toggle="modal"
                               data-target="#<portlet:namespace />ricevutaEsecuzioneIntegrazioneModal"
                               data-istanza-id-ricevuta="${elem.istanzaFormId}">
                               <liferay-ui:message key="ricevuta" />
                            </a>
                        </c:when>

                        <c:otherwise>
                            <button type="button"
                                    class="btn btn-outline-primary mr-1 mt-1"
                                    data-toggle="tooltip"
                                    data-placement="top"
                                    title="<liferay-ui:message key='conferma-ricezione-attesa-protocollazione-tooltip-attesa-protocollazione-tooltip' />"
                                    disabled>
                                <liferay-ui:message key="ricevuta" />
                            </button>
                        </c:otherwise>
                    </c:choose>
                </c:if>
		    </div>
		</div>
	</liferay-ui:search-container-row>

	<liferay-ui:search-iterator markupView="lexicon" />
</liferay-ui:search-container>
</div>


<%@ include file="dettaglio_domanda_bando_azioni.jsp" %>

<div class="modal fade" tabindex="-1" id="<portlet:namespace />ricevutaEsecuzioneIntegrazioneModal" style="display: none;">
    <portlet:actionURL var="ricevutaEsecuzioneIntegrazioneActionURL" name="/ricevutaEsecuzioneIntegrazione" />

    <aui:form action="${ricevutaEsecuzioneIntegrazioneActionURL}" name="ricevutaIntegrazioneForm">
        <aui:input type="hidden" name="istanzaDomandaBandoIdRicevuta" />
        <aui:input type="hidden" name="queryTab" value="${queryTab}" />

        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><liferay-ui:message key="ricevuta-esecuzione-integrazione" /></h5>
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body">
                    <span><liferay-ui:message key="ricevuta-esecuzione-integrazione-message" /></span>
                </div>
                <div class="modal-footer d-flex justify-content-end">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">
                        <liferay-ui:message key="annulla" />
                    </button>
                    <button type="submit" class="btn btn-primary ml-1">
                        <liferay-ui:message key="conferma" />
                    </button>
                </div>
            </div>
        </div>
    </aui:form>
</div>

<aui:script>
    AUI().use('aui-base', function(A) {
        var modalRicevuta = A.one('#<portlet:namespace />ricevutaEsecuzioneIntegrazioneModal');

        A.all('[data-target="#<portlet:namespace />ricevutaEsecuzioneIntegrazioneModal"]').on('click', function(event) {
            var istanzaId = event.currentTarget.getAttribute('data-istanza-id-ricevuta');
            modalRicevuta.one('input[name=<portlet:namespace />istanzaDomandaBandoIdRicevuta]').set('value', istanzaId);
        });
    });
</aui:script>