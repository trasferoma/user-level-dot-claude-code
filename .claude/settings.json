{
  "env": {
    "EDITOR": "code --wait"
  },
  "model": "opus[1m]",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /c/Users/fabio.dearcangelis/.claude/hooks/intro-progetto.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /c/Users/fabio.dearcangelis/.claude/hooks/autorizza-subagent.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "context7@context7-marketplace": true,
    "playwright@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "context7-marketplace": {
      "source": {
        "source": "github",
        "repo": "upstash/context7"
      }
    }
  },
  "effortLevel": "high",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "theme": "dark",
  "switchModelsOnFlag": true,
  "voiceEnabled": true
}
